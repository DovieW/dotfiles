[Unit]
Description=Use power-saver while the laptop lid is closed
After=graphical-session.target plasma-powerdevil.service
PartOf=graphical-session.target
StartLimitIntervalSec=5min
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/bin/dot-lid-power watch
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=graphical-session.target
