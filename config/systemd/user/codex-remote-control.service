[Unit]
Description=Codex app-server with Remote Control
Documentation=https://github.com/openai/codex/blob/main/codex-rs/app-server-daemon/README.md
Wants=network-online.target
After=network-online.target
ConditionFileIsExecutable=%h/.codex/packages/standalone/current/codex
StartLimitIntervalSec=5min
StartLimitBurst=5

[Service]
Type=oneshot
RemainAfterExit=yes
# A connected Desktop SSH client can launch this fallback after an abrupt daemon
# loss. The headless profile has one owner, so reclaim only that exact shape.
ExecStartPre=-/usr/bin/pkill -TERM -u %U -f "^.*codex( .*)? app-server --listen unix://$"
ExecStartPre=/usr/bin/sleep 1
ExecStart=%h/.codex/packages/standalone/current/codex app-server daemon bootstrap --remote-control
ExecReload=%h/.codex/packages/standalone/current/codex app-server daemon enable-remote-control
ExecStop=%h/.codex/packages/standalone/current/codex app-server daemon stop
TimeoutStartSec=120s
TimeoutStopSec=30s
Restart=on-failure
RestartSec=1s

[Install]
WantedBy=default.target
