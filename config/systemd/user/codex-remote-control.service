[Unit]
Description=Codex app-server with Remote Control
Documentation=https://help.openai.com/en/articles/11369540-using-codex-with-your-chatgpt-plan
Wants=network-online.target
After=network-online.target
ConditionFileIsExecutable=%h/.local/bin/codex

[Service]
Type=simple
ExecStart=%h/.local/bin/codex app-server --remote-control --listen unix://
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
