[Unit]
Description=Codex app-server with Remote Control
Documentation=https://github.com/openai/codex/blob/main/codex-rs/app-server-daemon/README.md
Wants=network-online.target
After=network-online.target
ConditionFileIsExecutable=%h/.codex/packages/standalone/current/codex

[Service]
Type=oneshot
RemainAfterExit=yes
# Let Codex own its control socket, persisted remote-control preference,
# pidfiles, and updater. The systemd unit only restores that native daemon after
# boot; running a second raw app-server makes Desktop fail with HTTP 409.
ExecStart=%h/.codex/packages/standalone/current/codex app-server daemon bootstrap --remote-control
ExecReload=%h/.codex/packages/standalone/current/codex app-server daemon enable-remote-control
ExecStop=%h/.codex/packages/standalone/current/codex app-server daemon stop
TimeoutStartSec=120s
TimeoutStopSec=30s

[Install]
WantedBy=default.target
