[Unit]
Description=Codex app-server with Remote Control
Documentation=https://github.com/openai/codex/blob/main/codex-rs/app-server-daemon/README.md
Wants=network-online.target
After=network-online.target
ConditionFileIsExecutable=%h/.codex/packages/standalone/current/codex

[Service]
Type=simple
# Keep one owner online: the native headless daemon while Desktop is closed,
# and Desktop's foreground app-server while the graphical application is open.
ExecStart=%h/.local/libexec/dotfiles/dot-codex-remote-control
Restart=on-failure
RestartSec=2s
TimeoutStopSec=30s

[Install]
WantedBy=default.target
