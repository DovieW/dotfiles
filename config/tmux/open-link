#!/usr/bin/env bash
set -euo pipefail

# tmux supplies the OSC 8 target and plain word first. For plain-text URLs,
# mouse_word is insufficient because tmux treats URL punctuation as word
# separators, so the binding also supplies the full line and mouse column.
hyperlink="${1#--hyperlink=}"
word="${2#--word=}"
mouse_x="${3#--mouse-x=}"
pane_left="${4#--pane-left=}"
line="${5#--line=}"

open_candidate() {
  local candidate="$1"
  local url

  [[ -n "$candidate" ]] || return 1

  case "$candidate" in
    http://*|https://*|mailto:*|file://*)
      url="$candidate"
      ;;
    www.*)
      url="https://$candidate"
      ;;
    *)
      return 1
      ;;
  esac

  if [[ "${DOT_TMUX_LINK_DRY_RUN:-0}" == "1" ]]; then
    printf '%s\n' "$url"
    return 0
  fi

  for opener in xdg-open wslview termux-open-url open; do
    if command -v "$opener" >/dev/null 2>&1; then
      nohup "$opener" "$url" >/dev/null 2>&1 &
      return 0
    fi
  done

  printf 'dot-open-link: no supported URL opener is installed\n' >&2
  return 2
}

for candidate in "$hyperlink" "$word"; do
  if open_candidate "$candidate"; then
    exit 0
  else
    status=$?
    (( status == 1 )) || exit "$status"
  fi
done

if [[ "$mouse_x" =~ ^[0-9]+$ && "$pane_left" =~ ^[0-9]+$ ]]; then
  column=$((mouse_x - pane_left))
  offset=0
  remaining="$line"

  while [[ "$remaining" =~ ^([[:space:]]*)([^[:space:]]+) ]]; do
    whitespace="${BASH_REMATCH[1]}"
    candidate="${BASH_REMATCH[2]}"
    start=$((offset + ${#whitespace}))
    end=$((start + ${#candidate}))

    if (( column >= start && column < end )); then
      open_candidate "$candidate" && exit 0
      status=$?
      (( status == 1 )) || exit "$status"
      break
    fi

    consumed=$((${#whitespace} + ${#candidate}))
    remaining="${remaining:consumed}"
    offset=$((offset + consumed))
  done
fi

exit 0
