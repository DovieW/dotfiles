#!/usr/bin/env bash
set -euo pipefail

if (( $# != 1 )); then
  echo "Usage: dot-rdp FILE.rdp" >&2
  exit 2
fi

rdp_file="$1"
if [[ ! -r "$rdp_file" ]]; then
  echo "dot-rdp: cannot read $rdp_file" >&2
  exit 2
fi

case "${rdp_file,,}" in
  *.rdp|*.rdpw) ;;
  *.remmina|*.rdpx)
    if command -v remmina >/dev/null 2>&1; then
      exec remmina -c "$rdp_file"
    fi
    echo "dot-rdp: Remmina is required to open $rdp_file" >&2
    exit 127
    ;;
  *)
    echo "dot-rdp: expected a .rdp, .rdpw, .remmina, or .rdpx file" >&2
    exit 2
    ;;
esac

# Restore the proven Remmina flow for token-bearing F5 webtop downloads. The
# helper creates a permission-locked, short-lived profile from the downloaded
# file and never commits or logs the company gateway, target, or token.
if LC_ALL=C tr -d '\000\r' <"$rdp_file" |
  grep -Eaiq '^gatewayaccesstoken:s:.+$'; then
  remmina_helper="${DOT_REMMINA_F5_HELPER:-$HOME/.local/bin/dot-remmina-f5}"
  if [[ ! -x "$remmina_helper" ]]; then
    message="The managed Remmina launcher is missing. Run: dot apply --profile kubuntu-laptop --tags rdp"
    echo "dot-rdp: $message" >&2
    command -v notify-send >/dev/null 2>&1 &&
      notify-send --app-name=Dotfiles "Remote Desktop needs repair" "$message"
    exit 127
  fi
  exec "$remmina_helper" "$rdp_file"
fi

client=""
for candidate in sdl-freerdp sdl-freerdp3; do
  if command -v "$candidate" >/dev/null 2>&1; then
    client="$candidate"
    break
  fi
done

if [[ -z "$client" ]]; then
  message="FreeRDP's SDL client is missing. Run: dot apply --profile kubuntu-laptop --tags rdp"
  echo "dot-rdp: $message" >&2
  command -v notify-send >/dev/null 2>&1 &&
    notify-send --app-name=Dotfiles "Remote Desktop is not installed" "$message"
  exit 127
fi

# The RDP file remains authoritative for the host, gateway, authentication,
# redirection, and multi-monitor policy. These client-side options guarantee a
# fullscreen, resize-aware Wayland experience without bypassing certificate
# checks.
client_options=(/f /dynamic-resolution)

# FreeRDP recommends its argument channel for sensitive values. Feed every
# argument over stdin rather than exposing even empty authentication switches
# (or a token-bearing RDP filename) in the process list.
printf '%s\n' "$rdp_file" "${client_options[@]}" |
  "$client" /args-from:stdin
