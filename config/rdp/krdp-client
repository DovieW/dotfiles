#!/usr/bin/env bash
set -euo pipefail

host="${1:-dovie-desktop-linux}"
user="${DOT_KRDP_USER:-dovie}"
if ! command -v kdialog >/dev/null 2>&1; then
  echo "KRdp requires kdialog for its private password prompt." >&2
  exit 1
fi

state_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/dotfiles"
install -d -m 0700 "$state_dir"
exec 9>"$state_dir/krdp-client.lock"
already_connected() {
  kdialog --sorry \
    "Desktop (KRdp) is already connected. Close its existing window before reconnecting."
}

if ! flock -n 9; then
  already_connected
  exit 1
fi

# The lock protects all launches made by the current managed wrapper. Also
# reject an older unmanaged XFreeRDP process that predates this lock, since two
# clients redirecting the same Wayland clipboard can destabilize both FreeRDP
# and clipboard managers such as CopyQ.
while read -r existing_pid; do
  [[ -r "/proc/$existing_pid/cmdline" ]] || continue
  mapfile -d '' -t existing_argv <"/proc/$existing_pid/cmdline" || true
  [[ "${existing_argv[0]##*/}" == "xfreerdp" ]] || continue
  for existing_arg in "${existing_argv[@]:1}"; do
    if [[ "$existing_arg" == "/v:${host}:3389" ]]; then
      already_connected
      exit 1
    fi
  done
done < <(pgrep -x xfreerdp || true)

client=""
for candidate in \
  "${HOMEBREW_PREFIX:-/home/linuxbrew/.linuxbrew}/bin/xfreerdp" \
  /home/linuxbrew/.linuxbrew/bin/xfreerdp; do
  if [[ -x "$candidate" ]] && "$candidate" /buildconfig 2>&1 | grep -q 'WITH_GFX_H264=ON'; then
    client="$candidate"
    break
  fi
done
if [[ -z "$client" ]]; then
  echo "KRdp requires Homebrew's H.264-capable XFreeRDP client." >&2
  echo "Run dot apply --profile kubuntu-laptop to install it." >&2
  exit 1
fi

password="$(kdialog --password "Password for ${user}@${host}")" || exit 1
printf '%s\n' "$password" | "$client" \
  "/v:${host}:3389" \
  "/u:${user}" \
  /from-stdin:force \
  /f \
  /size:2880x1800 \
  /smart-sizing:2880x1800 \
  +clipboard \
  /cert:tofu \
  /network:auto \
  /gfx
