#!/usr/bin/env bash
set -euo pipefail

host="${1:-dovie-desktop-linux}"
user="${DOT_KRDP_USER:-dovie}"
if ! command -v kdialog >/dev/null 2>&1; then
  echo "KRdp requires kdialog for its private password prompt." >&2
  exit 1
fi

state_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/dotfiles"
install -d -m 0700 "$state_dir"
exec 9>"$state_dir/krdp-client.lock"
already_connected() {
  kdialog --sorry \
    "Desktop (KRdp) is already connected. Close its existing window before reconnecting."
}

if ! flock -n 9; then
  already_connected
  exit 1
fi

# The lock protects all launches made by the current managed wrapper. Also
# reject an older unmanaged XFreeRDP process that predates this lock, since two
# clients redirecting the same Wayland clipboard can destabilize both FreeRDP
# and clipboard managers such as CopyQ.
while read -r existing_pid; do
  [[ -r "/proc/$existing_pid/cmdline" ]] || continue
  mapfile -d '' -t existing_argv <"/proc/$existing_pid/cmdline" || true
  [[ "${existing_argv[0]##*/}" == "xfreerdp" ]] || continue
  for existing_arg in "${existing_argv[@]:1}"; do
    if [[ "$existing_arg" == "/v:${host}:3389" ]]; then
      already_connected
      exit 1
    fi
  done
done < <(pgrep -x xfreerdp || true)

client=""
for candidate in \
  "${HOMEBREW_PREFIX:-/home/linuxbrew/.linuxbrew}/bin/xfreerdp" \
  /home/linuxbrew/.linuxbrew/bin/xfreerdp; do
  if [[ -x "$candidate" ]] && "$candidate" /buildconfig 2>&1 | grep -q 'WITH_GFX_H264=ON'; then
    client="$candidate"
    break
  fi
done
if [[ -z "$client" ]]; then
  echo "KRdp requires Homebrew's H.264-capable XFreeRDP client." >&2
  echo "Run dot apply --profile kubuntu-laptop to install it." >&2
  exit 1
fi

ssh_options=(-T -o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=5 -o ServerAliveCountMax=2)
if ! ssh "${ssh_options[@]}" "${user}@${host}" true; then
  kdialog --error "Could not reach ${host} through key-only SSH. Check its Tailscale and SSH connection."
  exit 1
fi

# KRdp shares a logged-in Plasma session. NoMachine's system service can show
# SDDM so the user can perform a normal password login (and unlock KWallet).
if ! ssh "${ssh_options[@]}" "${user}@${host}" \
    systemctl --user --quiet is-active plasma-kwin_wayland.service; then
  recovery_session="${DOT_KRDP_RECOVERY_SESSION:-$HOME/Documents/NoMachine/desktop.nxs}"
  recovery_client="${DOT_KRDP_RECOVERY_CLIENT:-$HOME/.local/bin/nomachine-client}"
  if [[ ( "$host" == dovie-desktop-linux || -n "${DOT_KRDP_RECOVERY_SESSION:-}" ) \
      && -f "$recovery_session" && -x "$recovery_client" ]]; then
    kdialog --msgbox "${host} is at its login screen. NoMachine will open so you can sign in to Plasma with your normal password. Close NoMachine after login to continue with KRdp."
    "$recovery_client" --session "$recovery_session" || exit 1
    if ! ssh "${ssh_options[@]}" "${user}@${host}" \
        systemctl --user --quiet is-active plasma-kwin_wayland.service; then
      kdialog --error "${host} is still at its login screen. Sign in to Plasma through NoMachine, then retry Desktop (KRdp)."
      exit 1
    fi
  else
    kdialog --error "${host} has no active Plasma session. Sign in at its login screen first. To enable remote login, install NoMachine and save a connection to ${host} as ${recovery_session}."
    exit 1
  fi
fi

password="$(kdialog --password "Password for ${user}@${host}")" || exit 1
client_pid=""
audio_pid=""
cleanup_session() {
  if [[ -n "$audio_pid" ]]; then
    kill "$audio_pid" 2>/dev/null || true
    wait "$audio_pid" 2>/dev/null || true
  fi
  if [[ -n "$client_pid" ]] && kill -0 "$client_pid" 2>/dev/null; then
    kill "$client_pid" 2>/dev/null || true
    wait "$client_pid" 2>/dev/null || true
  fi
  ssh "${ssh_options[@]}" "${user}@${host}" \
    .local/libexec/krdp-scale release </dev/null >/dev/null 2>&1 || true
}
if ! ssh "${ssh_options[@]}" "${user}@${host}" .local/libexec/krdp-scale prepare; then
  kdialog --error "Could not prepare the desktop display through key-only SSH. Check the desktop's SSH connection and managed KRdp configuration."
  exit 1
fi
trap cleanup_session EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
printf '%s\n' "$password" | "$client" \
  "/v:${host}:3389" \
  "/u:${user}" \
  /from-stdin:force \
  /f \
  /size:2880x1800 \
  /smart-sizing:2880x1800 \
  +clipboard \
  /cert:tofu \
  /network:auto \
  /gfx &
client_pid=$!
unset password
audio_helper="${DOT_KRDP_AUDIO_HELPER:-$HOME/.local/libexec/krdp-audio-client}"
if [[ -x "$audio_helper" ]]; then
  "$audio_helper" "$host" "$user" "$client_pid" 9>&- &
  audio_pid=$!
else
  echo "KRdp audio helper is missing; reapply the managed RDP configuration." >&2
fi
wait "$client_pid"
