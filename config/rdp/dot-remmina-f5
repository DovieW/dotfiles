#!/usr/bin/env python3
"""Launch an F5 gateway RDP download through an ephemeral Remmina profile."""

from __future__ import annotations

import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
import time


def fail(message: str) -> "NoReturn":
    print(f"dot-remmina-f5: {message}", file=sys.stderr)
    raise SystemExit(2)


def graphical_environment() -> dict[str, str]:
    environment = os.environ.copy()
    runtime = Path(f"/run/user/{os.getuid()}")
    environment.setdefault("XDG_RUNTIME_DIR", str(runtime))
    environment.setdefault(
        "DBUS_SESSION_BUS_ADDRESS", f"unix:path={runtime}/bus"
    )
    if not environment.get("WAYLAND_DISPLAY"):
        sockets = sorted(
            path.name
            for path in runtime.glob("wayland-*")
            if re.fullmatch(r"wayland-\d+", path.name)
        )
        if sockets:
            environment["WAYLAND_DISPLAY"] = sockets[0]
    environment["QT_QPA_PLATFORM"] = "wayland"
    return environment


def local_display() -> tuple[str, str, str, str]:
    """Return primary width, height, desktop scale, and device scale."""
    try:
        doctor = os.environ.get("DOT_KSCREEN_DOCTOR", "kscreen-doctor")
        result = subprocess.run(
            [doctor, "--json"],
            check=False,
            capture_output=True,
            text=True,
            env=graphical_environment(),
            timeout=15,
        )
        if result.returncode != 0:
            raise RuntimeError("KScreen query failed")
        outputs = [
            output
            for output in json.loads(result.stdout).get("outputs", [])
            if output.get("connected") and output.get("enabled")
        ]
        output = next(
            (candidate for candidate in outputs if candidate.get("primary")),
            outputs[0] if len(outputs) == 1 else None,
        )
        if output is None:
            raise ValueError("primary output is ambiguous")
        mode_id = str(output["currentModeId"])
        mode = next(
            mode
            for mode in output["modes"]
            if str(mode.get("id")) == mode_id
        )
        width = int(mode["size"]["width"])
        height = int(mode["size"]["height"])
        desktop_scale = round(float(output["scale"]) * 100)
        if width <= 0 or height <= 0 or not 100 <= desktop_scale <= 500:
            raise ValueError("invalid display geometry")
        device_scale = min(
            (100, 140, 180), key=lambda item: abs(item - desktop_scale)
        )
        return tuple(map(str, (width, height, desktop_scale, device_scale)))
    except (
        json.JSONDecodeError,
        KeyError,
        OSError,
        RuntimeError,
        StopIteration,
        subprocess.SubprocessError,
        TypeError,
        ValueError,
    ):
        # Preserve the established laptop behavior outside a graphical Plasma
        # session or when KScreen cannot identify a primary output.
        return "2880", "1800", "175", "180"


if len(sys.argv) != 2:
    fail("usage: dot-remmina-f5 FILE.rdp")

source = Path(sys.argv[1]).expanduser()
if not source.is_file():
    fail(f"cannot read {source}")
if shutil.which("remmina") is None:
    fail(
        "Remmina is not installed; run "
        "`dot apply --profile kubuntu-laptop --tags rdp`"
    )

resolution_width, resolution_height, desktop_scale, device_scale = local_display()

preferences_helper = Path(
    os.environ.get(
        "DOT_REMMINA_CONFIGURE",
        Path.home() / ".local/libexec/dotfiles/configure-remmina",
    )
)
if not preferences_helper.is_file():
    fail(
        "the managed Remmina preferences helper is missing; run "
        "`dot apply --profile kubuntu-laptop --tags rdp`"
    )
preferences = subprocess.run(
    [
        str(preferences_helper),
        "--desktop-scale",
        desktop_scale,
        "--device-scale",
        device_scale,
    ],
    check=False,
    capture_output=True,
    text=True,
)
if preferences.returncode != 0:
    fail(
        preferences.stderr.strip()
        or preferences.stdout.strip()
        or "could not configure Remmina display scaling"
    )

# F5 downloads can be UTF-8 or UTF-16LE. Removing NULs yields the ASCII field
# names and values used by these launch files without logging their token.
text = source.read_bytes().replace(b"\0", b"").decode("utf-8", "replace")
fields: dict[str, str] = {}
for raw_line in text.splitlines():
    line = raw_line.rstrip("\r")
    pieces = line.split(":", 2)
    if len(pieces) == 3:
        fields[pieces[0].strip().lower()] = pieces[2].strip()

server = fields.get("full address", "")
gateway = fields.get("gatewayhostname", "")
token = fields.get("gatewayaccesstoken", "")
if not (server and gateway and token):
    fail("the RDP file does not contain an F5 target, gateway, and access token")

runtime_base = Path(
    os.environ.get("XDG_RUNTIME_DIR", tempfile.gettempdir())
)
runtime_dir = runtime_base / f"dotfiles-remmina-{os.getuid()}"
runtime_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
runtime_dir.chmod(0o700)
profile = runtime_dir / "f5-current.remmina"

# This restores the useful core of the 2024 files-repository workflow. Request
# the active profile's physical display canvas and have Windows render it at
# the managed desktop scale.
# Remmina's profile view mode enters fullscreen after honoring the custom
# resolution; passing --enable-fullscreen on the command line would instead
# replace it with GTK's roughly 1644x1028 logical size and blur the result.
settings = {
    "name": server,
    "server": server,
    "gateway_server": gateway,
    "gatewayaccesstoken": token,
    "protocol": "RDP",
    "gateway_usage": "0",
    "gwtransp": "http",
    "username": "",
    "password": "",
    "gateway_username": "",
    "gateway_password": "",
    "disablepasswordstoring": "1",
    "keyboard_grab": "1",
    "resolution_mode": "0",
    "resolution_width": resolution_width,
    "resolution_height": resolution_height,
    "scale": "1",
    "viewmode": "4",
    "window_maximize": "1",
    "multimon": "0",
    "span": "0",
    "colordepth": "99",
    "network": "none",
    # Remmina quality 9 is its Best preset. The managed 0x80 mask enables
    # FreeRDP font smoothing without disabling themes, composition, or other
    # desktop effects. Quality 0 uses 0x6F and makes Windows text jagged.
    "quality": "9",
    "disableclipboard": "0",
    "sound": "local",
    "cert_ignore": "0",
    "ignore-tls-errors": "0",
    "authentication level": fields.get("authentication level", "0"),
    "sharesmartcard": "0",
    "shareprinter": "0",
    "microphone": "sys:pulse",
}

profile.write_text(
    "[remmina]\n"
    + "".join(
        f"{key}={value.replace(chr(10), '').replace(chr(13), '')}\n"
        for key, value in settings.items()
    ),
    encoding="utf-8",
)
profile.chmod(0o600)

try:
    completed = subprocess.run(
        ["remmina", "--connect", str(profile)],
        check=False,
    )
    # An already-running Remmina instance receives the file over its
    # single-instance channel and returns immediately. Give it time to parse
    # the profile before erasing the short-lived gateway token.
    if completed.returncode == 0:
        time.sleep(2)
    raise SystemExit(completed.returncode)
finally:
    profile.unlink(missing_ok=True)
