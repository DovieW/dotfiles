#!/usr/bin/env python3
"""Launch an F5 gateway RDP download through an ephemeral Remmina profile."""

from __future__ import annotations

import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import time


def fail(message: str) -> "NoReturn":
    print(f"dot-remmina-f5: {message}", file=sys.stderr)
    raise SystemExit(2)


if len(sys.argv) != 2:
    fail("usage: dot-remmina-f5 FILE.rdp")

source = Path(sys.argv[1]).expanduser()
if not source.is_file():
    fail(f"cannot read {source}")
if shutil.which("remmina") is None:
    fail(
        "Remmina is not installed; run "
        "`dot apply --profile kubuntu-laptop --tags rdp`"
    )

# F5 downloads can be UTF-8 or UTF-16LE. Removing NULs yields the ASCII field
# names and values used by these launch files without logging their token.
text = source.read_bytes().replace(b"\0", b"").decode("utf-8", "replace")
fields: dict[str, str] = {}
for raw_line in text.splitlines():
    line = raw_line.rstrip("\r")
    pieces = line.split(":", 2)
    if len(pieces) == 3:
        fields[pieces[0].strip().lower()] = pieces[2].strip()

server = fields.get("full address", "")
gateway = fields.get("gatewayhostname", "")
token = fields.get("gatewayaccesstoken", "")
if not (server and gateway and token):
    fail("the RDP file does not contain an F5 target, gateway, and access token")

runtime_base = Path(
    os.environ.get("XDG_RUNTIME_DIR", tempfile.gettempdir())
)
runtime_dir = runtime_base / f"dotfiles-remmina-{os.getuid()}"
runtime_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
runtime_dir.chmod(0o700)
profile = runtime_dir / "f5-current.remmina"

# This is the useful core of the 2024 files-repository workflow. Dynamic
# resolution lets the remote desktop follow the fullscreen drawable instead of
# hard-coding the panel's physical pixel dimensions. Remmina's global RDP
# preferences supply the matching 175% desktop scale and 180% device bucket.
settings = {
    "name": server,
    "server": server,
    "gateway_server": gateway,
    "gatewayaccesstoken": token,
    "protocol": "RDP",
    "gateway_usage": "0",
    "gwtransp": "http",
    "username": "",
    "password": "",
    "gateway_username": "",
    "gateway_password": "",
    "disablepasswordstoring": "1",
    "resolution_mode": "2",
    "scale": "2",
    "viewmode": "4",
    "window_maximize": "1",
    "multimon": "0",
    "span": "0",
    "colordepth": "99",
    "network": "none",
    "quality": "0",
    "disableclipboard": "1",
    "sound": "off",
    "cert_ignore": "0",
    "ignore-tls-errors": "0",
    "authentication level": fields.get("authentication level", "0"),
    "sharesmartcard": "0",
    "shareprinter": "0",
    "microphone": "",
}

profile.write_text(
    "[remmina]\n"
    + "".join(
        f"{key}={value.replace(chr(10), '').replace(chr(13), '')}\n"
        for key, value in settings.items()
    ),
    encoding="utf-8",
)
profile.chmod(0o600)

try:
    completed = subprocess.run(
        ["remmina", "--connect", str(profile)],
        check=False,
    )
    # An already-running Remmina instance receives the file over its
    # single-instance channel and returns immediately. Give it time to parse
    # the profile before erasing the short-lived gateway token.
    if completed.returncode == 0:
        time.sleep(2)
    raise SystemExit(completed.returncode)
finally:
    profile.unlink(missing_ok=True)
