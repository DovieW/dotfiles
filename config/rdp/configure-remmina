#!/usr/bin/env python3
"""Manage only the display-related Remmina preferences owned by dotfiles."""

from __future__ import annotations

import argparse
import os
from pathlib import Path
import tempfile


DESIRED = {
    "rdp_desktopOrientation": "0",
    # Remmina's Best preset: enable FreeRDP font smoothing and leave the
    # disable-performance flags clear. The profile selects this as quality 9.
    "rdp_quality_9": "80",
    "start_fullscreen": "true",
    "start_dynres": "false",
    # Keep the fullscreen canvas unobstructed: mode 2 disables the floating
    # toolbar and its edge-hover activation area completely.
    "fullscreen_toolbar_visibility": "2",
    "confirm_close": "false",
    "deny_screenshot_clipboard": "false",
    # Connection shortcuts use the configured Right Control host key.
    "shortcutkey_clipboard": "118",  # v
    "shortcutkey_minimize": "109",  # m
    "shortcutkey_viewonly": "65478",  # F9
}


def render(original: str, desired: dict[str, str]) -> str:
    lines = original.splitlines()
    section_start = next(
        (index for index, line in enumerate(lines) if line == "[remmina_pref]"),
        None,
    )
    if section_start is None:
        if lines and lines[-1]:
            lines.append("")
        lines.extend(["[remmina_pref]"])
        section_start = len(lines) - 1

    section_end = next(
        (
            index
            for index in range(section_start + 1, len(lines))
            if lines[index].startswith("[") and lines[index].endswith("]")
        ),
        len(lines),
    )
    seen: set[str] = set()
    for index in range(section_start + 1, section_end):
        key, separator, _value = lines[index].partition("=")
        if separator and key in desired:
            lines[index] = f"{key}={desired[key]}"
            seen.add(key)
    for key, value in desired.items():
        if key not in seen:
            lines.insert(section_end, f"{key}={value}")
            section_end += 1
    return "\n".join(lines) + "\n"


parser = argparse.ArgumentParser()
parser.add_argument("--check", action="store_true")
parser.add_argument("--desktop-scale", type=int)
parser.add_argument("--device-scale", type=int, choices=(100, 140, 180))
args = parser.parse_args()
if (args.desktop_scale is None) != (args.device_scale is None):
    parser.error("--desktop-scale and --device-scale must be supplied together")
desired = dict(DESIRED)
if args.desktop_scale is not None:
    if not 100 <= args.desktop_scale <= 500:
        parser.error("--desktop-scale must be between 100 and 500")
    desired.update(
        {
            "rdp_desktopScaleFactor": str(args.desktop_scale),
            "rdp_deviceScaleFactor": str(args.device_scale),
        }
    )

path = (
    Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    / "remmina/remmina.pref"
)
original = path.read_text(encoding="utf-8") if path.exists() else ""
managed = render(original, desired)

if args.check:
    if original == managed:
        print("Remmina fullscreen scaling is configured.")
        raise SystemExit(0)
    print("Remmina fullscreen scaling has drifted.")
    raise SystemExit(1)

if original == managed:
    print("Remmina fullscreen scaling already configured.")
    raise SystemExit(0)

path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
file_descriptor, temporary_name = tempfile.mkstemp(
    prefix=".remmina.pref.",
    dir=path.parent,
)
try:
    with os.fdopen(file_descriptor, "w", encoding="utf-8") as handle:
        handle.write(managed)
        handle.flush()
        os.fsync(handle.fileno())
    os.chmod(temporary_name, 0o600)
    os.replace(temporary_name, path)
finally:
    if os.path.exists(temporary_name):
        os.unlink(temporary_name)
print("CHANGED Remmina fullscreen scaling.")
