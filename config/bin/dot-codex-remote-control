#!/usr/bin/env bash
set -uo pipefail

readonly codex="$HOME/.codex/packages/standalone/current/codex"
readonly interval_seconds=2

if [[ ! -x "$codex" ]]; then
  printf 'Managed Codex CLI is missing: %s\n' "$codex" >&2
  exit 1
fi

stop_native_daemon() {
  "$codex" app-server daemon stop >/dev/null 2>&1 || true
}

start_native_daemon() {
  "$codex" app-server daemon bootstrap --remote-control >/dev/null 2>&1
}

shutdown() {
  stop_native_daemon
}
trap shutdown EXIT
trap 'exit 0' INT TERM

while true; do
  if pgrep -u "$(id -u)" -x ChatGPT >/dev/null 2>&1; then
    stop_native_daemon
  elif ! "$codex" app-server daemon version 2>/dev/null \
    | grep -q '"status":"running"'; then
    start_native_daemon || true
  fi
  sleep "$interval_seconds" &
  wait $!
done
