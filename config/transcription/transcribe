#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
INSTALLER="$ROOT/scripts/install-transcribe"
CURRENT="${XDG_DATA_HOME:-$HOME/.local/share}/dotfiles/transcribe/current/transcribe"

if [[ ! -x "$CURRENT" ]]; then
  printf 'Building the managed transcribe application for first use…\n' >&2
  "$INSTALLER" --install >&2
fi
exec "$CURRENT" "$@"
