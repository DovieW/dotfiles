# Powerlevel10k instant prompt must remain near the top.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

if [[ -n ${PROFILE_ZSH_STARTUP:-} ]]; then
  zmodload zsh/zprof 2>/dev/null || true
fi

DOTFILES_ROOT="${DOTFILES_ROOT:-$HOME/repos/dotfiles}"
[[ -r "$DOTFILES_ROOT/config/shell/common.sh" ]] && source "$DOTFILES_ROOT/config/shell/common.sh"

HISTFILE="${XDG_STATE_HOME:-$HOME/.local/state}/zsh/history"
mkdir -p "${HISTFILE:h}"
HISTSIZE=500000
SAVEHIST=500000
setopt AUTO_CD AUTO_PUSHD EXTENDED_GLOB GLOB_DOTS INTERACTIVE_COMMENTS
setopt SHARE_HISTORY HIST_IGNORE_ALL_DUPS HIST_IGNORE_DUPS HIST_IGNORE_SPACE
setopt HIST_REDUCE_BLANKS HIST_NO_STORE
unsetopt BEEP FLOW_CONTROL

autoload -Uz compinit
_dot_comp_dir="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
mkdir -p "$_dot_comp_dir"
_dot_comp_dump="$_dot_comp_dir/zcompdump-$ZSH_VERSION"
if [[ ! -f "$_dot_comp_dump" || "$_dot_comp_dump" -ot "$DOTFILES_ROOT/config/shell/zshrc" ]]; then
  compinit -d "$_dot_comp_dump"
else
  compinit -C -d "$_dot_comp_dump"
fi

[[ -r "$VP_HOME/env" ]] && source "$VP_HOME/env"

bindkey -e
bindkey '^[[A' history-beginning-search-backward
bindkey '^[[B' history-beginning-search-forward
bindkey '^P' history-beginning-search-backward
bindkey '^N' history-beginning-search-forward
bindkey '^[[1~' beginning-of-line
bindkey '^[[4~' end-of-line
bindkey '^[[1;5C' forward-word
bindkey '^[[1;5D' backward-word
bindkey '\e[3~' delete-char

if command -v fzf >/dev/null 2>&1; then
  eval "$(fzf --zsh 2>/dev/null)" || true
fi
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

_dot_brew_prefix=""
if command -v brew >/dev/null 2>&1; then
  _dot_brew_prefix="$(brew --prefix 2>/dev/null)"
fi

_dot_source_first() {
  local candidate
  for candidate in "$@"; do
    [[ -r "$candidate" ]] && source "$candidate" && return 0
  done
  return 1
}

_dot_source_first \
  "$_dot_brew_prefix/share/powerlevel10k/powerlevel10k.zsh-theme" \
  /usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme || true
[[ -r "$DOTFILES_ROOT/config/shell/p10k.zsh" ]] && source "$DOTFILES_ROOT/config/shell/p10k.zsh"

# Preserve Zsh's context-aware completion results, but select them through fzf
# on every ordinary Tab press. This must load after compinit and fzf's own
# bindings, but before plugins that wrap ZLE widgets.
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*' menu no
zstyle ':fzf-tab:*' fzf-flags \
  --height=70% --layout=reverse --border=rounded --info=inline-right \
  '--input-label= Completion ' \
  '--list-label= Matches ' \
  '--preview-label= Preview ' \
  '--prompt=Complete › ' \
  '--preview-window=right,50%,border-left,<50(down,45%,border-top)' \
  '--bind=ctrl-/:toggle-preview'
zstyle ':fzf-tab:complete:*:*' fzf-preview 'dot-fzf-preview "$realpath"'
zstyle ':fzf-tab:*' switch-group '<' '>'
_dot_source_first \
  "$_dot_brew_prefix/opt/fzf-tab/share/fzf-tab/fzf-tab.zsh" \
  "$_dot_brew_prefix/share/fzf-tab/fzf-tab.zsh" || true

# fzf-tab 1.3.0 drains pending input with `dd iflag=nonblock`. That read blocks
# indefinitely on the Ghostty + tmux PTY used here, before fzf can start.
# Redirect only fzf-tab's private drain command to `true`, then restore normal
# command resolution as soon as the widget returns.
if (( ${+widgets[fzf-tab-complete]} )); then
  zle -A fzf-tab-complete _dot_fzf_tab_upstream
  _dot_fzf_tab_complete() {
    local saved_dd="${commands[dd]-}"
    local saved_gdd="${commands[gdd]-}"
    local had_dd=${+commands[dd]}
    local had_gdd=${+commands[gdd]}
    local completion_status

    commands[dd]=/usr/bin/true
    commands[gdd]=/usr/bin/true
    zle _dot_fzf_tab_upstream
    completion_status=$?

    (( had_dd )) && commands[dd]="$saved_dd" || unset 'commands[dd]'
    (( had_gdd )) && commands[gdd]="$saved_gdd" || unset 'commands[gdd]'
    return "$completion_status"
  }
  zle -N fzf-tab-complete _dot_fzf_tab_complete
fi

_dot_source_first \
  "$_dot_brew_prefix/share/zsh-autosuggestions/zsh-autosuggestions.zsh" \
  /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh || true
_dot_source_first \
  "$_dot_brew_prefix/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" \
  /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh || true

ssh() { dot_ssh_select "$@"; }

if [[ -n ${PROFILE_ZSH_STARTUP:-} ]]; then
  zprof
fi
