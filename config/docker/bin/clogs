CONTAINER_NAME=`getContainer $1`

echo "Watching logs for ${CONTAINER_NAME}:"

while (docker logs ``--tail 10 -f $CONTAINER_NAME); do
    echo "$CONTAINER_NAME is not running,"
    sleep 1
    echo "Reconnecting..."
done

