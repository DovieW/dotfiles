#!/usr/bin/env bash
set -euo pipefail

if ! systemctl --user is-active --quiet ydotool.service; then
  echo "CopyQ paste requires the active ydotool user service." >&2
  exit 1
fi

# CopyQ closes before invoking this helper. Release any shortcut modifiers,
# allow the previous Wayland surface to regain focus, then paste without
# synthesizing text or inspecting clipboard contents.
ydotool key 29:0 42:0 54:0 56:0 125:0 126:0 >/dev/null
sleep 0.12
ydotool key 42:1 110:1 110:0 42:0 >/dev/null
