#!/usr/bin/env bash
set -euo pipefail

command -v fzf >/dev/null 2>&1 || {
  echo "git-switcher requires fzf." >&2
  exit 1
}

selection="$(
  git for-each-ref --format='%(refname:short)' refs/heads refs/remotes \
    | sed '/\\/HEAD$/d' \
    | sort -u \
    | fzf --prompt='Git branch: '
)"
[[ -n "$selection" ]] || exit 0

if git show-ref --verify --quiet "refs/heads/$selection"; then
  exec git switch "$selection"
fi

local_name="${selection#*/}"
if git show-ref --verify --quiet "refs/heads/$local_name"; then
  exec git switch "$local_name"
fi
exec git switch --track "$selection"
