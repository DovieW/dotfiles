# Ghostty opens the login shell directly. Start Herdr explicitly with `herdr`.

# Use epoll so idle terminal waits do not inflate Linux I/O pressure.
async-backend = epoll

font-family = FiraCode Nerd Font Mono
font-size = 12
font-feature = -calt
background = 07090d

cursor-style = bar
cursor-style-blink = false
cursor-opacity = 1

window-decoration = none
window-show-tab-bar = never
gtk-titlebar = false
scrollbar = never
maximize = true

mouse-hide-while-typing = true
# Herdr owns Ctrl+click while terminal mouse reporting is active.
link-url = false
copy-on-select = clipboard
confirm-close-surface = false
shell-integration = none

# Pass browser-style workspace navigation and search through to Herdr.
keybind = ctrl+tab=unbind
keybind = ctrl+shift+tab=unbind
keybind = ctrl+shift+a=unbind
# Ctrl-T is intentionally inactive, including inside Herdr panes.
keybind = ctrl+t=ignore
# Let Herdr reopen a closed workspace, rather than opening an outer tab.
keybind = ctrl+shift+t=unbind
