  "profiles": {
    "windows-classic": {
      "label": "Windows Classic",
      "description": "Full-width 40px bar with stable Windows-style icon tasks",
      "floating": false,
      "length_mode": "fill",
      "width_percent": 100,
      "height": 40,
      "task_manager": "icons",
      "spacers": true,
      "show_date": true
    },
    "windows-refined": {
      "label": "Windows Refined",
      "description": "Floating 94% bar with stable icon tasks and restrained margins",
      "floating": true,
      "length_mode": "custom",
      "width_percent": 94,
      "height": 44,
      "task_manager": "icons",
      "spacers": true,
      "show_date": true
    },
    "centered-compact": {
      "label": "Centered Compact",
      "description": "Floating 62% bar with left-aligned icon tasks, compact tray, and time",
      "floating": true,
      "length_mode": "custom",
      "width_percent": 62,
      "height": 46,
      "task_manager": "icons",
      "spacers": true,
      "show_date": false
    },
    "unified-pill": {
      "label": "Unified Pill",
      "description": "Fit-content floating pill with a stable Windows-style launcher order, tray, and time",
      "floating": true,
      "length_mode": "fit",
      "width_percent": null,
      "height": 48,
      "task_manager": "icons",
      "spacers": false,
      "show_date": false
    }
