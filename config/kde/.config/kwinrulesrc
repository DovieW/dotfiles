[General]
count=5
rules=dolphin-skip-taskbar,emoji-selector-ephemeral,ghostty-all-desktops,system-settings-ephemeral,bitwarden-ephemeral

[bitwarden-ephemeral]
Description=Keep Bitwarden out of persistent window lists
skippager=true
skippagerrule=2
skipswitcher=true
skipswitcherrule=2
skiptaskbar=true
skiptaskbarrule=2
wmclass=bitwarden
wmclassmatch=1

[dolphin-skip-taskbar]
Description=Keep Dolphin out of the taskbar
skiptaskbar=true
skiptaskbarrule=2
wmclass=org.kde.dolphin
wmclassmatch=1

[emoji-selector-ephemeral]
Description=Keep Emoji Selector out of persistent window lists
skippager=true
skippagerrule=2
skipswitcher=true
skipswitcherrule=2
skiptaskbar=true
skiptaskbarrule=2
wmclass=org.kde.plasma.emojier
wmclassmatch=1

[ghostty-all-desktops]
Description=Keep Ghostty on all virtual desktops
desktops=
desktopsrule=2
wmclass=com.mitchellh.ghostty
wmclassmatch=1

[system-settings-ephemeral]
Description=Keep System Settings out of persistent window lists
skippager=true
skippagerrule=2
skipswitcher=true
skipswitcherrule=2
skiptaskbar=true
skiptaskbarrule=2
wmclass=systemsettings
wmclassmatch=1
