[General]
count=5
rules=emoji-selector-ephemeral,emoji-picker-ephemeral,flameshot-ephemeral,system-settings-ephemeral,system-monitor-ephemeral

[emoji-selector-ephemeral]
Description=Keep Emoji Selector out of persistent window lists
skippager=true
skippagerrule=2
skipswitcher=true
skipswitcherrule=2
skiptaskbar=true
skiptaskbarrule=2
wmclass=org.kde.plasma.emojier
wmclassmatch=1

