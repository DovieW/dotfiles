#!/usr/bin/env bash
set -euo pipefail

readonly threshold="${DOT_LID_POWER_LOW_THRESHOLD:-20}"
readonly debounce_seconds="${DOT_LID_POWER_DEBOUNCE_SECONDS:-5}"
readonly ac_debounce_seconds="${DOT_LID_POWER_AC_DEBOUNCE_SECONDS:-30}"
readonly max_debounce_seconds="${DOT_LID_POWER_MAX_DEBOUNCE_SECONDS:-30}"
readonly busctl_command="${DOT_LID_POWER_BUSCTL:-busctl}"
readonly gdbus_command="${DOT_LID_POWER_GDBUS:-gdbus}"
readonly powerprofiles_command="${DOT_LID_POWER_POWERPROFILESCTL:-powerprofilesctl}"

read_property() {
  local object_path="$1"
  local interface="$2"
  local property="$3"

  "$busctl_command" get-property \
    org.freedesktop.UPower \
    "$object_path" \
    "$interface" \
    "$property" |
    awk 'NF >= 2 { print $2; exit }'
}

lid_is_closed() {
  read_property \
    /org/freedesktop/UPower \
    org.freedesktop.UPower \
    LidIsClosed
}

on_battery() {
  read_property \
    /org/freedesktop/UPower \
    org.freedesktop.UPower \
    OnBattery
}

battery_percentage() {
  read_property \
    /org/freedesktop/UPower/devices/DisplayDevice \
    org.freedesktop.UPower.Device \
    Percentage
}

desired_state() {
  local lid battery percentage
  lid="$(lid_is_closed)"
  battery="$(on_battery)"
  percentage="$(battery_percentage)"

  if [[ "$lid" == "true" ]]; then
    printf '%s|%s|%s\n' "$lid" power-saver ""
  elif [[ "$battery" != "true" ]]; then
    printf '%s|%s|%s\n' "$lid" performance 100
  elif awk -v percentage="$percentage" -v threshold="$threshold" \
    'BEGIN { exit !(percentage <= threshold) }'; then
    printf '%s|%s|%s\n' "$lid" power-saver 40
  else
    printf '%s|%s|%s\n' "$lid" balanced 100
  fi
}

desired_profile() {
  local lid profile brightness
  IFS='|' read -r lid profile brightness <<<"$(desired_state)"
  printf '%s\n' "$profile"
}

safe_unstable_state() {
  local lid percentage
  lid="$(lid_is_closed)"
  percentage="$(battery_percentage)"
  if [[ "$lid" == "true" ]]; then
    printf '%s|%s|%s\n' "$lid" power-saver ""
  elif awk -v percentage="$percentage" -v threshold="$threshold" \
    'BEGIN { exit !(percentage <= threshold) }'; then
    printf '%s|%s|%s\n' "$lid" power-saver 40
  else
    printf '%s|%s|%s\n' "$lid" balanced 100
  fi
}

state_debounce_seconds() {
  local state="$1" lid profile brightness
  IFS='|' read -r lid profile brightness <<<"$state"
  if [[ "$profile" == "performance" ]]; then
    printf '%s\n' "$ac_debounce_seconds"
  else
    printf '%s\n' "$debounce_seconds"
  fi
}

state_summary() {
  local lid battery percentage current expected
  lid="$(lid_is_closed)"
  battery="$(on_battery)"
  percentage="$(battery_percentage)"
  current="$("$powerprofiles_command" get)"
  expected="$(desired_profile)"

  printf 'lid=%s power=%s battery=%s%% profile=%s expected=%s\n' \
    "$([[ "$lid" == "true" ]] && printf closed || printf open)" \
    "$([[ "$battery" == "true" ]] && printf battery || printf AC)" \
    "$percentage" \
    "$current" \
    "$expected"
  [[ "$current" == "$expected" ]]
}

set_brightness() {
  local percentage="$1"
  [[ -n "$percentage" ]] || return 0
  if ! "$busctl_command" --user call \
    org.kde.Solid.PowerManagement \
    /org/kde/ScreenBrightness/display0 \
    org.kde.ScreenBrightness.Display \
    SetBrightness iu "$((percentage * 100))" 0 >/dev/null; then
    printf 'dot-lid-power: could not set display brightness to %s%%\n' \
      "$percentage" >&2
  fi
}

apply_state() {
  local state="$1" current lid expected brightness
  current="$("$powerprofiles_command" get)"
  IFS='|' read -r lid expected brightness <<<"$state"
  if [[ "$current" != "$expected" ]]; then
    printf 'dot-lid-power: changing profile %s -> %s\n' "$current" "$expected"
    if ! "$powerprofiles_command" set "$expected"; then
      printf 'dot-lid-power: could not set profile to %s; continuing to monitor events\n' \
        "$expected" >&2
      return 0
    fi
  fi
  set_brightness "$brightness"
}

reconcile() {
  apply_state "$(desired_state)"
}

wake_display() {
  if ! "$busctl_command" --user call \
    org.kde.Solid.PowerManagement \
    /org/kde/Solid/PowerManagement \
    org.kde.Solid.PowerManagement \
    wakeup >/dev/null; then
    printf 'dot-lid-power: PowerDevil could not wake the display\n' >&2
  fi
}

watch_events() {
  local previous_lid current_lid current_state event_line
  local candidate applied candidate_since unstable_since required_debounce
  local monitor_fd monitor_pid
  previous_lid="$(lid_is_closed)"
  candidate="$(desired_state)"
  applied=""
  candidate_since=$SECONDS
  unstable_since=$SECONDS

  coproc UPOWER_MONITOR { "$gdbus_command" monitor --system --dest org.freedesktop.UPower; }
  monitor_fd="${UPOWER_MONITOR[0]}"
  monitor_pid="$UPOWER_MONITOR_PID"

  while kill -0 "$monitor_pid" 2>/dev/null; do
    IFS= read -r -t 0.5 event_line <&"$monitor_fd" || true
    current_lid="$(lid_is_closed)"
    if [[ "$current_lid" != "$previous_lid" ]]; then
      reconcile
      applied="$(desired_state)"
      candidate="$applied"
      candidate_since=$SECONDS
      unstable_since=$SECONDS
      if [[ "$previous_lid" == "true" && "$current_lid" == "false" ]]; then
        wake_display
        printf 'dot-lid-power: lid opened; requested display wake\n'
      fi
      previous_lid="$current_lid"
    fi

    current_state="$(desired_state)"
    if [[ "$current_state" != "$candidate" ]]; then
      candidate="$current_state"
      candidate_since=$SECONDS
    fi
    if [[ "$candidate" == "$applied" ]]; then
      unstable_since=$SECONDS
    else
      required_debounce="$(state_debounce_seconds "$candidate")"
    fi
    if [[ "$candidate" != "$applied" ]] &&
      ((SECONDS - candidate_since >= required_debounce)); then
      apply_state "$candidate"
      applied="$candidate"
      unstable_since=$SECONDS
      printf 'dot-lid-power: applied stable state after %ss debounce\n' \
        "$required_debounce"
    elif [[ "$candidate" != "$applied" ]] &&
      ((SECONDS - unstable_since >= max_debounce_seconds)); then
      candidate="$(safe_unstable_state)"
      apply_state "$candidate"
      applied="$candidate"
      candidate_since=$SECONDS
      unstable_since=$SECONDS
      printf 'dot-lid-power: power source remained unstable for %ss; applied safe battery state\n' \
        "$max_debounce_seconds"
    fi
    sleep 1
  done
  wait "$monitor_pid"
}

case "${1:-}" in
  reconcile)
    reconcile
    ;;
  status)
    state_summary
    ;;
  watch)
    watch_events
    ;;
  *)
    printf 'Usage: dot-lid-power {reconcile|status|watch}\n' >&2
    exit 2
    ;;
esac
