#!/usr/bin/python3
"""Mute Plasma's default audio output on display timeout and sleep transitions."""

import logging
import os
import re
import subprocess
import time


OFF_SECONDS = 30 * 60
POLL_SECONDS = 10
LOGIN_SERVICE = "org.freedesktop.login1"
LOGIN_PATH = "/org/freedesktop/login1"
LOGIN_MANAGER = LOGIN_SERVICE + ".Manager"


def displays_off():
    result = subprocess.run(
        ["/usr/bin/kscreen-doctor", "--dpms", "show"],
        env={**os.environ, "LC_ALL": "C", "QT_QPA_PLATFORM": "wayland"},
        capture_output=True,
        text=True,
        check=True,
        timeout=2,
    )
    modes = re.findall(r"^dpms mode for screen .+: (on|off)$", result.stdout, re.M)
    if not modes:
        raise ValueError("KScreen reported no display power modes")
    return all(mode == "off" for mode in modes)


def mute_output(reason):
    try:
        subprocess.run(
            ["/usr/bin/wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "1"],
            capture_output=True,
            text=True,
            check=True,
            timeout=1,
        )
    except (OSError, subprocess.SubprocessError) as error:
        logging.warning("Could not mute output (%s): %s", reason, error)
        return False
    logging.info("Muted default audio output (%s)", reason)
    return True


class DisplayTimeout:
    def __init__(self):
        self.reset()

    def reset(self):
        self.off_since = None
        self.muted = False

    def update(self, off, now):
        if not off:
            self.reset()
        elif self.off_since is None:
            self.off_since = now
        elif not self.muted and now - self.off_since >= OFF_SECONDS:
            self.muted = mute_output("displays off for 30 minutes")


def watch():
    import gi

    gi.require_version("Gio", "2.0")
    from gi.repository import Gio, GLib

    bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
    display_timeout = DisplayTimeout()
    inhibitor = None
    resuming = None
    sleeping = False
    display_error = False

    def acquire_inhibitor():
        nonlocal inhibitor
        try:
            reply, fds = bus.call_with_unix_fd_list_sync(
                LOGIN_SERVICE, LOGIN_PATH, LOGIN_MANAGER, "Inhibit",
                GLib.Variant("(ssss)", (
                    "sleep", "Dotfiles audio mute", "Mute audio before sleep", "delay",
                )),
                GLib.VariantType.new("(h)"), Gio.DBusCallFlags.NONE, 1000, None, None,
            )
            inhibitor = fds.get(reply.unpack()[0])
        except GLib.Error as error:
            logging.warning("Could not obtain sleep delay inhibitor: %s", error)

    def poll_displays():
        nonlocal display_error
        if not sleeping:
            try:
                off = displays_off()
            except (OSError, ValueError, subprocess.SubprocessError) as error:
                if not display_error:
                    logging.warning("Could not read display power state: %s", error)
                display_error = True
                off = False
            else:
                display_error = False
            display_timeout.update(off, time.monotonic())
        return GLib.SOURCE_CONTINUE

    def prepare_for_sleep(_bus, _sender, _path, _interface, _signal, parameters):
        nonlocal inhibitor, resuming, sleeping
        sleeping = parameters.unpack()[0]
        display_timeout.reset()
        if resuming is not None:
            GLib.source_remove(resuming)
            resuming = None
        if sleeping:
            try:
                mute_output("before sleep")
            finally:
                if inhibitor is not None:
                    os.close(inhibitor)
                    inhibitor = None
            return

        # PipeWire or the default output may be unavailable just after wake.
        attempts_left = 5

        def mute_after_wake():
            nonlocal attempts_left, resuming
            attempts_left -= 1
            if mute_output("after waking") or attempts_left == 0:
                resuming = None
                return GLib.SOURCE_REMOVE
            return GLib.SOURCE_CONTINUE

        if mute_after_wake():
            resuming = GLib.timeout_add_seconds(2, mute_after_wake)
        if inhibitor is None:
            acquire_inhibitor()

    bus.signal_subscribe(
        LOGIN_SERVICE, LOGIN_MANAGER, "PrepareForSleep", LOGIN_PATH, None,
        Gio.DBusSignalFlags.NONE, prepare_for_sleep,
    )
    acquire_inhibitor()
    GLib.timeout_add_seconds(POLL_SECONDS, poll_displays)
    poll_displays()
    GLib.MainLoop().run()


if __name__ == "__main__":
    logging.basicConfig(level=logging.INFO, format="%(levelname)s: %(message)s")
    watch()
