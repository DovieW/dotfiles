#!/usr/bin/python3
"""Set Plasma's default output volume to zero on display and sleep events."""

import logging
import os
import subprocess
from pathlib import Path


OFF_SECONDS = 30 * 60
LOGIN_SERVICE = "org.freedesktop.login1"
LOGIN_PATH = "/org/freedesktop/login1"
LOGIN_MANAGER = LOGIN_SERVICE + ".Manager"


def zero_volume(reason):
    try:
        subprocess.run(
            ["/usr/bin/wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", "0"],
            capture_output=True,
            text=True,
            check=True,
            timeout=1,
        )
    except (OSError, subprocess.SubprocessError) as error:
        logging.warning("Could not set output volume to zero (%s): %s", reason, error)
        return False
    logging.info("Set default output volume to zero (%s)", reason)
    return True


class DisplayTimeout:
    def __init__(self, schedule, cancel):
        self.schedule = schedule
        self.cancel = cancel
        self.timer = None
        self.displays_off = False
        self.sleeping = False

    def update(self, displays_off, sleeping):
        was_off = self.displays_off and not self.sleeping
        self.displays_off = displays_off
        self.sleeping = sleeping
        is_off = displays_off and not sleeping
        if is_off and not was_off:
            self.timer = self.schedule(OFF_SECONDS, self.elapsed)
        elif not is_off and self.timer is not None:
            self.cancel(self.timer)
            self.timer = None

    def elapsed(self):
        self.timer = None
        zero_volume("displays off for 30 minutes")
        return False


def watch():
    import gi

    gi.require_version("Gio", "2.0")
    from gi.repository import Gio, GLib

    bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
    loop = GLib.MainLoop()
    display_timeout = DisplayTimeout(
        lambda seconds, callback: GLib.timeout_add(seconds * 1000, callback),
        GLib.source_remove,
    )
    inhibitor = None
    resuming = None

    def acquire_inhibitor():
        nonlocal inhibitor
        try:
            reply, fds = bus.call_with_unix_fd_list_sync(
                LOGIN_SERVICE, LOGIN_PATH, LOGIN_MANAGER, "Inhibit",
                GLib.Variant("(ssss)", (
                    "sleep", "Dotfiles audio volume", "Set volume to zero before sleep", "delay",
                )),
                GLib.VariantType.new("(h)"), Gio.DBusCallFlags.NONE, 1000, None, None,
            )
            inhibitor = fds.get(reply.unpack()[0])
        except GLib.Error as error:
            logging.warning("Could not obtain sleep delay inhibitor: %s", error)

    monitor = Gio.Subprocess.new(
        [str(Path.home() / ".local/bin/dot-display-power")],
        Gio.SubprocessFlags.STDOUT_PIPE,
    )
    states = Gio.DataInputStream.new(monitor.get_stdout_pipe())

    def display_changed(stream, result):
        try:
            line, _length = stream.read_line_finish_utf8(result)
        except GLib.Error:
            logging.exception("Could not read display power event")
            loop.quit()
            return
        if line is None:
            loop.quit()
            return
        display_timeout.update(line == "off", display_timeout.sleeping)
        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, display_changed)

    def prepare_for_sleep(_bus, _sender, _path, _interface, _signal, parameters):
        nonlocal inhibitor, resuming
        sleeping = parameters.unpack()[0]
        display_timeout.update(display_timeout.displays_off, sleeping)
        if resuming is not None:
            GLib.source_remove(resuming)
            resuming = None
        if sleeping:
            try:
                zero_volume("before sleep")
            finally:
                if inhibitor is not None:
                    os.close(inhibitor)
                    inhibitor = None
            return

        # PipeWire or the default output may be unavailable just after wake.
        attempts_left = 5

        def zero_after_wake():
            nonlocal attempts_left, resuming
            attempts_left -= 1
            if zero_volume("after waking") or attempts_left == 0:
                resuming = None
                return GLib.SOURCE_REMOVE
            return GLib.SOURCE_CONTINUE

        if zero_after_wake():
            resuming = GLib.timeout_add_seconds(2, zero_after_wake)
        if inhibitor is None:
            acquire_inhibitor()

    bus.signal_subscribe(
        LOGIN_SERVICE, LOGIN_MANAGER, "PrepareForSleep", LOGIN_PATH, None,
        Gio.DBusSignalFlags.NONE, prepare_for_sleep,
    )
    acquire_inhibitor()
    states.read_line_async(GLib.PRIORITY_DEFAULT, None, display_changed)
    loop.run()
    raise RuntimeError("Display power listener disconnected")


if __name__ == "__main__":
    logging.basicConfig(level=logging.INFO, format="%(levelname)s: %(message)s")
    watch()
