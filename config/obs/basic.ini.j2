[General]
Name=Dotfiles Native 60fps

[Video]
BaseCX={{ dot_obs_size.width }}
BaseCY={{ dot_obs_size.height }}
OutputCX={{ dot_obs_size.width }}
OutputCY={{ dot_obs_size.height }}
FPSType=0
FPSCommon=60
ScaleType=lanczos
ColorFormat=NV12
ColorSpace=709
ColorRange=Partial

[Audio]
SampleRate=48000
ChannelSetup=Stereo

[Output]
Mode=Advanced
FilenameFormatting=%CCYY-%MM-%DD %hh-%mm-%ss

[AdvOut]
RecType=Standard
RecFilePath={{ ansible_facts.env.HOME }}/Videos/OBS
RecFormat2=mkv
RecEncoder=obs_x264
RecAudioEncoder=ffmpeg_aac
RecTracks=1
Track1Bitrate=320
Track1Name=Recording mix
RecRescale=false
