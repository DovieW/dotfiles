[General]
Name=Dotfiles Laptop Meeting

[Video]
BaseCX={{ dot_obs_size.width }}
BaseCY={{ dot_obs_size.height }}
OutputCX=1280
OutputCY=800
FPSType=0
FPSCommon=30
ScaleType=lanczos
ColorFormat=NV12
ColorSpace=709
ColorRange=Partial

[Audio]
SampleRate=48000
ChannelSetup=Stereo

[Output]
Mode=Advanced
FilenameFormatting=%CCYY-%MM-%DD %hh-%mm-%ss

[AdvOut]
RecType=Standard
RecFilePath={{ ansible_facts.env.HOME }}/Videos/OBS
RecFormat2=hybrid_mp4
RecEncoder=obs_x264
RecAudioEncoder=ffmpeg_aac
RecTracks=1
Track1Bitrate=160
Track1Name=Recording mix
RecRescale=false
