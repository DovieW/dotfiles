#!/usr/bin/env bash
set -euo pipefail

# Browser state is recoverable; long-running agent work is not. A process may
# make itself easier (but not harder) for the kernel OOM killer to select.
if [[ -w /proc/self/oom_score_adj ]]; then
  printf '500\n' > /proc/self/oom_score_adj || true
fi

# Chromium's explicit Wayland color management can also wash out SDR desktop
# displays. Use the same workaround as the laptop without its OLED policy.
exec /usr/bin/google-chrome-stable \
  --disable-features=WaylandWpColorManagerV1 \
  "$@"
