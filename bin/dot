        )
    if profile.get("features", {}).get("rdp_files"):
        rdp_client = shutil.which("sdl-freerdp") or shutil.which(
            "sdl-freerdp3"
        )
        remmina_client = shutil.which("remmina")
        rdp_launcher = Path.home() / ".local/bin/dot-rdp"
        krdp_launcher = Path.home() / ".local/bin/krdp-client"
