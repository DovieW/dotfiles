            ROOT / "config/rdp/io.github.doview.dotfiles.rdp.desktop": Path.home()
            / ".local/share/applications/io.github.doview.dotfiles.rdp.desktop",
            ROOT / "config/rdp/io.github.doview.dotfiles.krdp.desktop": Path.home()
            / ".local/share/applications/io.github.doview.dotfiles.krdp.desktop",
            ROOT / "config/rdp/rdp-mime.xml": Path.home()
            / ".local/share/mime/packages/dot-rdp.xml",
        }
        for source, destination in rdp_mappings.items():
            file_changed = link_file(source, destination)
            changes += int(file_changed)
        remmina_preferences = run(
            [
                str(Path.home() / ".local/libexec/dotfiles/configure-remmina"),
            ],
            check=False,
            capture=True,
        )
        if remmina_preferences.returncode != 0:
            raise DotError(
                remmina_preferences.stderr.strip()
                or remmina_preferences.stdout.strip()
                or "Failed to configure Remmina scaling."
            )
        if remmina_preferences.stdout:
            print(remmina_preferences.stdout, end="")
        changes += remmina_preferences.stdout.count("CHANGED ")
        if command_exists("update-mime-database"):
            run(
                [
                    "update-mime-database",
                    str(Path.home() / ".local/share/mime"),
                ]
            )
        if command_exists("update-desktop-database"):
            run(
                [
                    "update-desktop-database",
                    str(Path.home() / ".local/share/applications"),
                ]
            )
        if command_exists("kbuildsycoca6"):
            run(["kbuildsycoca6", "--noincremental"], check=False)
        if command_exists("systemctl"):
            run(
                [
                    "systemctl",
                    "--user",
                    "try-restart",
                    "plasma-krunner.service",
                ],
                check=False,
            )
        if command_exists("xdg-mime"):
            for rdp_mime_type in (
                "application/x-rdp",
                "application/x-remmina",
            ):
                current_rdp_handler = run(
                    ["xdg-mime", "query", "default", rdp_mime_type],
                    check=False,
                    capture=True,
                ).stdout.strip()
                # Always write an explicit default. `xdg-mime query` can fall
                # back to mimeinfo.cache and report our desktop file even when
                # KDE's mimeapps.list has no Default Applications entry. In
                # that state Dolphin may still prefer Remmina's stock wrapper.
                run(
                    [
                        "xdg-mime",
                        "default",
                        "io.github.doview.dotfiles.rdp.desktop",
                        rdp_mime_type,
                    ]
                )
                if (
                    current_rdp_handler
                    != "io.github.doview.dotfiles.rdp.desktop"
                ):
                    changes += 1
    if features.get("lid_power_saver") and selected("power", "kde"):
        lid_mappings = {
            ROOT / "config/power/dot-lid-power": Path.home()
            / ".local/bin/dot-lid-power",
            ROOT / "config/systemd/user/dot-lid-power.service": Path.home()
            / ".config/systemd/user/dot-lid-power.service",
        }
        lid_files_changed = False
        for source, destination in lid_mappings.items():
            file_changed = copy_managed_file(source, destination)
            changes += int(file_changed)
            lid_files_changed = lid_files_changed or file_changed
        if command_exists("systemctl"):
            unit_name = "dot-lid-power.service"
            run(["systemctl", "--user", "daemon-reload"])
            enabled = run(
                ["systemctl", "--user", "is-enabled", "--quiet", unit_name],
                check=False,
            ).returncode == 0
            active = run(
                ["systemctl", "--user", "is-active", "--quiet", unit_name],
                check=False,
            ).returncode == 0
            if not enabled:
                run(["systemctl", "--user", "enable", "--now", unit_name])
                changes += 1
            elif not active or lid_files_changed:
                run(["systemctl", "--user", "restart", unit_name])
                changes += int(not active)
    if (features.get("wsl") or features.get("kde")) and selected("docker"):
        for tool in ("clogs", "cshell", "cycle"):
            source = ROOT / "config/docker/bin" / tool
            if source.exists():
                changes += int(link_file(source, Path.home() / ".local/bin" / tool))
    if features.get("codex_remote_control") and selected("codex", "config"):
        run([str(ROOT / "scripts/configure-codex")], cwd=ROOT)
        remote_mode = features.get("codex_remote_control_mode", "headless")
        if remote_mode not in {"desktop", "headless"}:
            raise DotError(f"Unsupported Codex Remote Control mode: {remote_mode}")
        obsolete_destinations = (
            Path.home() / ".local/bin/dot-chatgpt",
            Path.home() / ".local/libexec/dotfiles/dot-codex-remote-control",
        )
        for destination in obsolete_destinations:
            if destination.is_symlink():
                destination.unlink()
                changes += 1
        desktop_override = Path.home() / ".local/share/applications/chatgpt.desktop"
        if remote_mode == "headless":
            changes += int(
                link_file(
                    ROOT / "config/applications/chatgpt-headless.desktop",
                    desktop_override,
                )
            )
        elif desktop_override.is_symlink():
            desktop_override.unlink()
            changes += 1
        legacy_unit_names = (
            "codex-remote-control-refresh.service",
            "codex-remote-control-refresh.path",
        )
        systemd_user = Path.home() / ".config/systemd/user"
        if command_exists("systemctl"):
            for unit_name in legacy_unit_names:
                run(
                    ["systemctl", "--user", "disable", "--now", unit_name],
                    check=False,
                    capture=True,
                )
                for destination in (
                    systemd_user / unit_name,
                    systemd_user / "default.target.wants" / unit_name,
                ):
                    if destination.is_symlink():
                        destination.unlink()
                        changes += 1

        unit_name = "codex-remote-control.service"
        source = ROOT / "config/systemd/user" / unit_name
        destination = systemd_user / unit_name
        if remote_mode == "headless":
            changes += int(link_file(source, destination))
        elif destination.is_symlink():
            destination.unlink()
            changes += 1
        managed_codex = (
            Path.home() / ".codex/packages/standalone/current/codex"
        )
        if command_exists("systemctl") and managed_codex.exists():
            run(["systemctl", "--user", "daemon-reload"])
            enabled = run(
                ["systemctl", "--user", "is-enabled", "--quiet", unit_name],
                check=False,
            ).returncode == 0
            active = run(
                ["systemctl", "--user", "is-active", "--quiet", unit_name],
                check=False,
            ).returncode == 0
            if remote_mode == "desktop":
                if enabled or active:
                    run(
                        ["systemctl", "--user", "disable", "--now", unit_name],
                        check=False,
                    )
                    changes += 1
            desktop_running = remote_mode == "headless" and run(
                ["pgrep", "-u", str(os.getuid()), "-x", "ChatGPT"],
                check=False,
                capture=True,
            ).returncode == 0
            if desktop_running:
                raise DotError(
                    "ChatGPT Desktop is running on a headless Remote Control host. "
                    "Close it before applying the codex configuration."
                )
            daemon_settings = Path.home() / ".codex/app-server-daemon/settings.json"
            daemon_state = run(
                [str(managed_codex), "app-server", "daemon", "version"],
                check=False,
                capture=True,
            )
            daemon_running = False
            if daemon_state.returncode == 0:
                try:
                    daemon_running = (
                        json.loads(daemon_state.stdout).get("status") == "running"
                    )
                except json.JSONDecodeError:
                    pass
            if remote_mode == "headless" and not enabled:
                run(["systemctl", "--user", "enable", unit_name])
                changes += 1
            if remote_mode == "headless" and (
                not active
                or not daemon_running
                or not daemon_settings.is_file()
            ):
                run(["systemctl", "--user", "restart", unit_name])
                changes += 1
            if remote_mode == "headless" and command_exists("loginctl"):
                linger = run(
                    ["loginctl", "show-user", getpass.getuser(), "--property=Linger", "--value"],
                    check=False,
                    capture=True,
                )
                if linger.returncode != 0 or linger.stdout.strip() != "yes":
                    run(["loginctl", "enable-linger", getpass.getuser()])
                    changes += 1
        elif not managed_codex.exists():
            print(
                f"Managed Codex is missing at {managed_codex}; "
                "native Remote Control was not bootstrapped.",
                file=sys.stderr,
            )
    print(f"Applied {profile_name}: {changes} configuration change(s)")
    return changes


def inherit_graphical_session_environment() -> None:
    """Attach SSH maintenance commands to the active Plasma user session."""
    if os.environ.get("WAYLAND_DISPLAY") or not command_exists("systemctl"):
        return
    manager = run(
        ["systemctl", "--user", "show-environment"],
        check=False,
        capture=True,
    )
    if manager.returncode:
        return
    allowed = {
        "DBUS_SESSION_BUS_ADDRESS",
        "DISPLAY",
        "LANG",
        "LANGUAGE",
        "WAYLAND_DISPLAY",
        "XDG_CURRENT_DESKTOP",
        "XDG_RUNTIME_DIR",
    }
    for line in manager.stdout.splitlines():
        key, separator, value = line.partition("=")
        if separator and (key in allowed or key.startswith("LC_")) and value:
            if key in {"LANG", "LANGUAGE"} or key.startswith("LC_"):
                os.environ[key] = value
            else:
                os.environ.setdefault(key, value)
    if os.environ.get("WAYLAND_DISPLAY"):
        os.environ.setdefault("QT_QPA_PLATFORM", "wayland")


def upgrade_ansible_controller(
    profile: dict[str, Any], selected_tags: set[str], *, check: bool
) -> None:
    """Update Ansible before launching it, never from inside its own play."""
    if check or os.environ.get("DOTFILES_TESTING") == "1" or not command_exists("brew"):
        return
    packages = set(profile.get("packages", {}).get("brew", []))
    controllers = sorted(packages & {"ansible", "ansible-lint"})
    package_selected = not selected_tags or bool(
        selected_tags & {"all", "packages", "app-updates"}
    )
    if not controllers or not package_selected:
        return
    outdated = run(
        ["brew", "outdated", "--formula"], check=False, capture=True
    )
    outdated_formulae = set((outdated.stdout or "").splitlines())
    pending = [name for name in controllers if name in outdated_formulae]
    if pending:
        print(
            "Updating the Ansible controller before the managed play: "
            + ", ".join(pending)
        )
        run(["brew", "upgrade", *pending])


def cmd_apply(args: argparse.Namespace) -> None:
    profile = load_profile(args.profile)
    selected_tags = set((args.tags or "").replace(",", " ").split())
    upgrade_ansible_controller(profile, selected_tags, check=args.check)
    if profile.get("features", {}).get("kde"):
        inherit_graphical_session_environment()
    force_kde = getattr(args, "force_kde", False)
    skip_tags = getattr(args, "skip_tags", None)
    if args.direct or not command_exists("ansible-playbook"):
        direct_tags = set((args.tags or "").replace(",", " ").split())
        direct_kde_selected = (
            not direct_tags
            or "all" in direct_tags
            or "config" in direct_tags
            or "kde" in direct_tags
            or "lockscreen" in direct_tags
        )
        if profile.get("features", {}).get("kde") and direct_kde_selected and not args.check:
            only = (
                {".config/kscreenlockerrc", ".config/plasmashellrc"}
                if direct_tags == {"lockscreen"}
                else None
            )
            check_kde_apply_conflicts(force=force_kde, only=only)
        if profile["name"] == "termux" and not args.check:
            packages = profile.get("packages", {}).get("pkg", [])
            if packages:
                run(["pkg", "upgrade", "-y"])
                run(["pkg", "install", "-y", *packages])
        if profile.get("features", {}).get("vite_plus") and (
            not direct_tags
            or "all" in direct_tags
            or "config" in direct_tags
            or "packages" in direct_tags
            or "shell" in direct_tags
        ):
            mode = "--check" if args.check else "--ensure"
            run([str(ROOT / "scripts/install-vite-plus"), mode], cwd=ROOT)
        if profile.get("features", {}).get("codex_remote_control") and (
            not direct_tags
            or "all" in direct_tags
            or "config" in direct_tags
            or "packages" in direct_tags
            or "codex" in direct_tags
        ):
            mode = "--check" if args.check else "--ensure"
            run([str(ROOT / "scripts/install-codex"), mode], cwd=ROOT)
        if profile.get("features", {}).get("git") and (
            not direct_tags
            or "all" in direct_tags
            or "config" in direct_tags
            or "packages" in direct_tags
            or "git" in direct_tags
            or "app-updates" in direct_tags
        ):
            mode = "--check" if args.check else "--ensure"
            run([str(ROOT / "scripts/install-git-sync"), mode], cwd=ROOT)
        if not args.direct:
            print("ansible-playbook is unavailable; applying portable configuration directly.", file=sys.stderr)
        apply_direct(
            args.profile,
            force_kde=force_kde,
            selected_tags=direct_tags,
        )
        return
    package_apply_selected = not selected_tags or bool(
        selected_tags
        & {
            "packages",
            "docker",
            "gpu",
            "gestures",
            "clipboard",
            "chatgpt",
            "emoji",
            "rdp",
            "krdp",
            "keyboard",
            "keyd",
            "meshcentral",
            "memory",
            "nomachine",
            "tailscale",
            "touchpad",
            "vscode",
            "system-updates",
            "app-updates",
        }
    )
    kde_system_apply_selected = (
        profile.get("features", {}).get("kde", False)
        and (not selected_tags or bool(selected_tags & {"kde", "power"}))
    )
    managed_packages = profile.get("packages", {})
    privileged_packages = any(
        managed_packages.get(provider)
        for provider in ("apt", "deb", "snap")
    ) or profile.get("features", {}).get("docker_engine", False) or profile.get(
        "features", {}
    ).get("nvidia_driver", False) or profile.get("features", {}).get(
        "tailscale", False
    ) or profile.get("features", {}).get(
        "krdp_server", False
    ) or profile.get("features", {}).get(
        "memory_pressure_protection", False
    ) or (
        package_apply_selected
        and profile.get("features", {}).get("inputactions", False)
    )
    become_arguments = (
        ansible_become_arguments()
        if (package_apply_selected and privileged_packages) or kde_system_apply_selected
        else []
    )
    kde_apply_selected = (
        profile.get("features", {}).get("kde")
        and (
            not selected_tags
            or "all" in selected_tags
            or "config" in selected_tags
            or "kde" in selected_tags
            or "lockscreen" in selected_tags
        )
        and not args.check
    )
    if kde_apply_selected:
        only = (
            {".config/kscreenlockerrc", ".config/plasmashellrc"}
            if selected_tags == {"lockscreen"}
            else None
        )
        check_kde_apply_conflicts(force=force_kde, only=only)
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    runtime_profile = STATE_DIR / "runtime-profile.json"
    atomic_text(runtime_profile, json.dumps({"dot_profile_data": profile}, indent=2) + "\n", 0o600)
    command = [
        "ansible-playbook",
        "-i",
        str(ROOT / "ansible/inventory.ini"),
        str(ROOT / "ansible/local.yml"),
        "-e",
        f"dot_profile={normalize_profile(args.profile)}",
        "-e",
        f"@{runtime_profile}",
    ]
    if args.tags:
        command.extend(["--tags", args.tags])
    if skip_tags:
        command.extend(["--skip-tags", skip_tags])
    if args.check:
        command.append("--check")
    command.extend(become_arguments)
    apply_env = os.environ.copy()
    apply_env["ANSIBLE_CONFIG"] = str(ROOT / "ansible/ansible.cfg")
    apply_env["ANSIBLE_BECOME_PLUGINS"] = str(ROOT / "ansible/become_plugins")
    if force_kde:
        apply_env["DOTFILES_KDE_PREFLIGHT_OK"] = "1"
    run(command, cwd=ROOT, env=apply_env)
    if kde_apply_selected:
        record_kde_baseline()


def cmd_bootstrap(args: argparse.Namespace) -> None:
    profile = load_profile(args.profile)
    device = ensure_device(args.device)
    print(f"Profile: {profile['name']}; device: {device}")
    detected = infer_platform()
    if profile["name"] == "windows-host":
        required = ["git", "bw", "gh", "pwsh"]
        missing = [cmd for cmd in required if not command_exists(cmd)]
        if missing:
            print("Windows inventory-only mode. Install prerequisites manually:")
            print("  winget install Git.Git Bitwarden.CLI GitHub.cli Microsoft.PowerShell")
            raise DotError(f"Missing prerequisites: {', '.join(missing)}")
        return
    if detected == "termux":
        require_commands(["pkg"], "Run: pkg install git openssh python nodejs-lts zsh")
    else:
        require_commands(["git", "python3"], "Install Git and Python 3 with the system package manager.")
    state_path = STATE_DIR / "bootstrap" / f"{profile['name']}.json"
    state = load_json(state_path) if state_path.exists() else {
        "schema_version": 1,
        "profile": profile["name"],
        "device": device,
        "completed": [],
    }
    if state.get("profile") != profile["name"] or state.get("device") != device:
        raise DotError(f"Bootstrap state belongs to another profile or device: {state_path}")

    device_manifest = load_device_manifest(device)
    requested_state = getattr(args, "device_state", "auto")
    if requested_state == "auto":
        if device_manifest is not None:
            device_state = "existing"
            print(f"Recognized finalized computer: {device}")
        elif sys.stdin.isatty():
            print(
                f"No finalized device manifest exists for `{device}`.\n"
                "  1) New computer: install the safe baseline and create an agent handoff\n"
                "  2) Existing computer: require its tracked device manifest"
            )
            choice = input("Choice [1]: ").strip() or "1"
            if choice not in {"1", "2"}:
                raise DotError("Device-state choice must be 1 or 2.")
            device_state = "new" if choice == "1" else "existing"
        else:
            device_state = "new"
    else:
        device_state = requested_state
    if device_state == "existing" and device_manifest is None:
        raise DotError(
            f"This computer is not registered in {device_manifest_path(device)}. "
            "Choose new-computer baseline mode instead."
        )
    state["device_state"] = device_state

    def phase(name: str, action: Callable[[], None]) -> None:
        if name in state["completed"]:
            print(f"Bootstrap phase already complete: {name}")
            return
        print(f"Bootstrap phase: {name}")
        try:
            action()
        except (DotError, subprocess.CalledProcessError, OSError) as exc:
            report = write_bootstrap_support_report(
                profile["name"], device, name, exc
            )
            print(
                f"Bootstrap stopped in phase {name}. Sanitized support report: {report}",
                file=sys.stderr,
            )
            raise
        state["completed"].append(name)
        atomic_text(state_path, json.dumps(state, indent=2) + "\n", 0o600)

    phase(
        "prerequisites",
        lambda: run([str(ROOT / "scripts/bootstrap-prerequisites"), profile["name"]], cwd=ROOT),
    )
    if LINUXBREW_BIN.is_dir():
        os.environ["PATH"] = os.pathsep.join(
            [str(LINUXBREW_BIN), *os.environ.get("PATH", "").split(os.pathsep)]
        )
    require_commands(
        ["ansible-playbook", "bw", "gh"],
        "Bootstrap prerequisites are incomplete; remove the bootstrap state and retry.",
    )
    inferred = inferred_device_id()
    if device != inferred and sys.stdin.isatty():
        print(
            f"The system hostname is `{inferred}`, but bootstrap identity is `{device}`."
        )
        choice = input("Migrate the existing device identity to the hostname now? [Y/n]: ").strip().lower()
        if choice in {"", "y", "yes"}:
            cmd_device_rename(
                argparse.Namespace(
                    old_device=device,
                    new_device=inferred,
                    profile=profile["name"],
                )
            )
            device = inferred
            state["device"] = device
        elif choice not in {"n", "no"}:
            raise DotError("Identity-migration choice must be yes or no.")
    bootstrap_preflight(profile, device)
    if profile.get("features", {}).get("tailscale"):
        def configure_remote_support() -> None:
            cmd_apply(
                argparse.Namespace(
                    profile=args.profile,
                    tags="tailscale",
                    skip_tags=None,
                    check=False,
                    direct=False,
                    force_kde=False,
                )
            )
            status = run(
                ["tailscale", "status", "--json"],
                check=False,
                capture=True,
            )
            try:
                backend = json.loads(status.stdout or "{}").get("BackendState", "")
            except json.JSONDecodeError:
                backend = ""
            if status.returncode != 0 or backend != "Running":
                print(
                    "Tailscale enrollment is required before the long setup so this "
                    "computer can be supported remotely. Complete the browser flow now."
                )
                run(
                    [
                        "sudo",
                        "tailscale",
                        "up",
                        f"--advertise-tags={REMOTE_SUPPORT_TAILSCALE_TAG}",
                    ]
                )
            ip = run(["tailscale", "ip", "-4"], capture=True).stdout.strip()
            if not ip or "\n" in ip:
                raise DotError("Tailscale did not report one stable IPv4 address after enrollment.")
            enrolled = run(
                ["tailscale", "status", "--json"],
                capture=True,
            )
            try:
                active_tags = json.loads(enrolled.stdout).get("Self", {}).get("Tags", [])
            except json.JSONDecodeError:
                active_tags = []
            if REMOTE_SUPPORT_TAILSCALE_TAG not in active_tags:
                raise DotError(
                    f"Tailscale enrollment is missing {REMOTE_SUPPORT_TAILSCALE_TAG}; "
                    "approve the requested device tag in the tailnet policy or admin console."
                )
            run(
                [
                    str(ROOT / "scripts/bootstrap-remote-support"),
                    REMOTE_SUPPORT_GITHUB_USER,
                    ip,
                ],
                cwd=ROOT,
            )
            print(f"Remote support ready: ssh {getpass.getuser()}@{ip}")

        phase("remote-support", configure_remote_support)
    if not args.skip_secrets:
        def authenticate() -> None:
            if profile["name"] in {"kubuntu-laptop", "kubuntu-desktop"}:
                for executable in ("google-chrome-stable", "bitwarden"):
                    path = shutil.which(executable)
                    if path:
                        subprocess.Popen(
                            [path],
                            stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL,
                            start_new_session=True,
                        )
                print(
                    "Chrome and Bitwarden are installed and opening. Log in to Bitwarden "
                    "Desktop and enable its SSH agent before continuing."
                )
                if sys.stdin.isatty():
                    input("Press Enter to continue with GitHub and Bitwarden CLI authorization: ")
            cmd_secrets_sync(
                argparse.Namespace(profile=args.profile, device=device, no_register=False)
            )

        phase("identity", authenticate)
        phase(
            "repositories",
            lambda: cmd_repos_sync(argparse.Namespace(profile=args.profile)),
        )
    def apply_bootstrap_profile() -> None:
        cmd_apply(
            argparse.Namespace(
                profile=args.profile,
                tags=None,
                skip_tags=",".join(FINALIZATION_DEFERRED_TAGS),
                check=False,
                direct=False,
                force_kde=True,
            )
        )
        if device_state == "existing" and device_manifest:
            approved = device_manifest["approved_tags"]
            if approved:
                cmd_apply(
                    argparse.Namespace(
                        profile=args.profile,
                        tags=",".join(approved),
                        skip_tags=None,
                        check=False,
                        direct=False,
                        force_kde=True,
                    )
                )

    phase("profile", apply_bootstrap_profile)
    if device_state == "new":
        handoff = write_finalization_handoff(profile["name"], device)
        print(
            f"Baseline bootstrap completed for new computer {device}.\n"
            f"Open a fresh agent in {ROOT} and say: Finalize this computer.\n"
            f"Agent handoff: {handoff}"
        )
    else:
        print(
            f"Restored finalized computer {device}. "
            f"Run dot doctor --profile {profile['name']}."
        )


def cmd_finalize(args: argparse.Namespace) -> None:
    profile = load_profile(args.profile)
    device = ensure_device(getattr(args, "device", None))
    if args.finalize_action == "prepare":
        handoff = write_finalization_handoff(profile["name"], device)
        print(f"Finalization handoff written to {handoff}")
        print(f"Inventory written to {FINALIZATION_INVENTORY}")
        return
    manifest = load_device_manifest(device, required=args.finalize_action == "apply")
    if args.finalize_action == "status":
        if manifest:
            print(f"Finalized device: {device}; profile: {manifest['profile']}")
            print(f"Approved deferred tags: {', '.join(manifest['approved_tags']) or 'none'}")
        else:
            print(f"Unfinalized device: {device}")
            print(f"Run: dot finalize prepare --profile {profile['name']}")
        print(f"Handoff: {FINALIZATION_HANDOFF}")
        return
    if manifest["profile"] != profile["name"]:
        raise DotError(
            f"Device manifest profile {manifest['profile']} does not match {profile['name']}"
        )
    if profile.get("features", {}).get("tailscale"):
        ssh_ready = all(
            run(["systemctl", "is-active", "--quiet", service], check=False).returncode == 0
            for service in ("ssh", "tailscaled")
        )
        tailscale_status = run(
            ["tailscale", "status", "--json"],
            check=False,
            capture=True,
        )
        try:
            tailscale_running = (
                json.loads(tailscale_status.stdout or "{}").get("BackendState") == "Running"
            )
        except json.JSONDecodeError:
            tailscale_running = False
        sshd = run(["sudo", "sshd", "-T"], check=False, capture=True)
        secure_ssh = sshd.returncode == 0 and all(
            setting in sshd.stdout.splitlines()
            for setting in (
                "passwordauthentication no",
                "kbdinteractiveauthentication no",
                "permitrootlogin no",
                "pubkeyauthentication yes",
            )
        )
        if not (ssh_ready and tailscale_running and secure_ssh):
            raise DotError(
                "Finalization requires active Tailscale and secure normal OpenSSH. "
                "Rerun START-LINUX.sh to repair the remote-support phase."
            )
    approved = manifest["approved_tags"]
    if approved:
        cmd_apply(
            argparse.Namespace(
                profile=profile["name"],
                tags=",".join(approved),
                skip_tags=None,
                check=False,
                direct=False,
                force_kde=True,
            )
        )
    completion = {
        "schema_version": 1,
        "device_id": device,
        "profile": profile["name"],
        "manifest": str(device_manifest_path(device)),
        "commit": capture_inventory_command(["git", "rev-parse", "HEAD"]),
        "completed_at": dt.datetime.now(dt.timezone.utc).isoformat(),
    }
    path = STATE_DIR / "finalization" / f"{device}.json"
    atomic_text(path, json.dumps(completion, indent=2) + "\n", 0o600)
    write_finalization_handoff(profile["name"], device)
    print(f"Finalization policy applied for {device}; completion recorded at {path}")


def cmd_preflight(args: argparse.Namespace) -> None:
    profile = load_profile(args.profile)
    device = ensure_device(getattr(args, "device", None))
    bootstrap_preflight(profile, device)


def _bw_capture_session(action: str) -> tuple[str | None, int]:
    # Capture only the session token. Prompts and errors remain attached to the
    # terminal, while the token stays inside this process and is never exported.
    proc = subprocess.run(
        ["bw", action, "--raw"],
        check=False,
        text=True,
        stdout=subprocess.PIPE,
    )
    token = proc.stdout.strip()
    if proc.returncode == 0 and not token:
        raise DotError(f"Bitwarden {action} succeeded without returning a session token.")
    return (token if proc.returncode == 0 else None), proc.returncode


def _bw_password_session(
    action: str,
    password: str,
    *,
    email: str | None = None,
) -> tuple[str | None, int]:
    """Pass a password to Bitwarden through an inherited anonymous pipe."""
    read_fd, write_fd = os.pipe()
    try:
        os.write(write_fd, password.encode() + b"\n")
    finally:
        os.close(write_fd)
    command = ["bw", action]
    if action == "login" and email:
        command.append(email)
    command.extend(
        ["--passwordfile", f"/proc/self/fd/{read_fd}", "--raw"]
    )
    try:
        proc = subprocess.run(
            command,
            check=False,
            text=True,
            stdout=subprocess.PIPE,
            pass_fds=(read_fd,),
        )
    finally:
        os.close(read_fd)
    token = proc.stdout.strip()
    if proc.returncode == 0 and not token:
        raise DotError(
            f"Bitwarden {action} succeeded without returning a session token."
        )
    return (token if proc.returncode == 0 else None), proc.returncode


def _bw_unlock_session(email: str | None = None) -> tuple[str | None, int]:
    """Unlock, repairing stale CLI crypto state with the same password."""
    password = getpass.getpass("Bitwarden master password: ")
    try:
        session, returncode = _bw_password_session("unlock", password)
        if returncode == 0:
            return session, returncode
        if not email:
            return None, returncode
        print("Bitwarden CLI crypto state is stale; refreshing its login now.")
        run(["bw", "logout"], check=False, capture=True)
        return _bw_password_session("login", password, email=email)
    finally:
        password = ""


def _bw_should_lock_after_use() -> bool:
    return os.environ.get("DOTFILES_BW_LOCK_AFTER_USE", "").strip().lower() in {
        "1",
        "true",
        "yes",
        "on",
    }


def _bw_login_session() -> tuple[str, bool]:
    print("Bitwarden CLI login is required; completing it now.")
    session, returncode = _bw_capture_session("login")
    if returncode or session is None:
        raise DotError("Bitwarden login failed.")
    return session, _bw_should_lock_after_use()


def bw_session() -> tuple[str, bool]:
    require_commands(["bw"], "Install the Bitwarden CLI, then retry.")
    status = run(["bw", "status"], check=False, capture=True)
    if status.returncode:
        raise DotError("Could not read Bitwarden CLI status.")
    try:
        status_data = json.loads(status.stdout)
        state = status_data.get("status")
    except json.JSONDecodeError as exc:
        raise DotError("Bitwarden CLI returned invalid status data.") from exc

    session = os.environ.get("BW_SESSION")
    if state == "unlocked" and session:
        return session, False
    if state == "unauthenticated":
        return _bw_login_session()
    if state not in {"locked", "unlocked"}:
        raise DotError(f"Unsupported Bitwarden CLI status: {state or 'missing'}")

    email = status_data.get("userEmail")
    session, returncode = _bw_unlock_session(
        str(email) if isinstance(email, str) and email else None
    )
    if returncode == 0 and session is not None:
        return session, _bw_should_lock_after_use()
    raise DotError(
        "Bitwarden unlock and automatic stale-login recovery both failed."
    )


def bw_get_item(name: str, session: str, *, required: bool = True) -> dict[str, Any] | None:
    proc = run(["bw", "get", "item", name, "--session", session], check=False, capture=True)
    if proc.returncode:
        if required:
            raise DotError(f"Bitwarden item not found: {name}")
        return None
    return json.loads(proc.stdout)


def bw_create_item(item: dict[str, Any], session: str) -> dict[str, Any]:
    encoded = base64.b64encode(json.dumps(item).encode()).decode()
    # Read the encoded item from stdin so private material is never exposed in
    # the process list or an exception's command arguments.
    proc = subprocess.run(
        ["bw", "create", "item", "--session", session],
        input=encoded,
        check=True,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    return json.loads(proc.stdout)


def bw_edit_item(item: dict[str, Any], session: str) -> dict[str, Any]:
    encoded = base64.b64encode(json.dumps(item).encode()).decode()
    proc = subprocess.run(
        ["bw", "edit", "item", str(item["id"]), "--session", session],
        input=encoded,
        check=True,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    return json.loads(proc.stdout)


def bw_upsert_secure_note(
    name: str, notes: dict[str, Any], session: str
) -> dict[str, Any]:
    existing = bw_get_item(name, session, required=False)
    if existing is None:
        return bw_create_item(
            {
                "type": 2,
                "name": name,
                "notes": json.dumps(notes, indent=2),
                "secureNote": {"type": 0},
            },
            session,
        )
    existing.update(
        {
            "type": 2,
            "name": name,
            "notes": json.dumps(notes, indent=2),
            "secureNote": {"type": 0},
        }
    )
    return bw_edit_item(existing, session)


def normalize_meshcentral_enrollment(payload: dict[str, Any]) -> dict[str, Any]:
    try:
        schema_version = int(payload["schema_version"])
        server_url = str(payload["server_url"])
        installer_url = str(payload["installer_url"])
        mesh_id = str(payload["mesh_id"])
    except (KeyError, TypeError, ValueError) as exc:
        raise DotError("MeshCentral enrollment data is incomplete") from exc
    if schema_version != 1:
        raise DotError("Unsupported MeshCentral enrollment schema")
    server = urlparse(server_url)
    installer = urlparse(installer_url)
    if (
        server.scheme != "https"
        or not server.netloc
        or server.username
        or server.password
        or server.path not in ("", "/")
        or server.query
        or server.fragment
    ):
        raise DotError("MeshCentral server URL must be a plain HTTPS origin")
    query = parse_qs(installer.query)
    if (
        installer.scheme != "https"
        or installer.netloc != server.netloc
        or installer.path.rstrip("/") != "/meshagents"
        or query.get("script") != ["1"]
    ):
        raise DotError(
            "MeshCentral installer must be the HTTPS meshagents?script=1 URL "
            "from the same server"
        )
    if not re.fullmatch(r"[A-Za-z0-9_@$-]{64,2048}", mesh_id):
        raise DotError("MeshCentral device-group identifier is invalid")
    return {
        "schema_version": 1,
        "server_url": server_url.rstrip("/"),
        "installer_url": installer_url,
        "mesh_id": mesh_id,
    }


def parse_meshcentral_install_command(command: str) -> dict[str, Any]:
    installer_urls = []
    for candidate in re.findall(r"https://[^\s'\"\)]+", command):
        parsed = urlparse(candidate)
        if (
            parsed.path.rstrip("/") == "/meshagents"
            and parse_qs(parsed.query).get("script") == ["1"]
        ):
            installer_urls.append(candidate)
    invocation = re.search(
        r"(?:sudo(?:\s+-E)?\s+)?(?:\./|\S*/)?meshinstall\.sh\s+"
        r"(?P<server>['\"]?https://[^\s'\"]+['\"]?)\s+"
        r"(?P<mesh>['\"]?[A-Za-z0-9_@$-]{64,2048}['\"]?)"
        r"(?=\s|$|[;&|)])",
        command,
    )
    if not installer_urls or invocation is None:
        raise DotError(
            "Paste the complete Linux install command generated by MeshCentral"
        )
    return normalize_meshcentral_enrollment(
        {
            "schema_version": 1,
            "server_url": invocation.group("server").strip("'\""),
            "installer_url": installer_urls[0],
            "mesh_id": invocation.group("mesh").strip("'\""),
        }
    )


def key_parts(item: dict[str, Any]) -> tuple[str, str]:
    ssh = item.get("sshKey") or {}
    private = ssh.get("privateKey")
    public = ssh.get("publicKey")
    if not private or not public:
        raise DotError(f"Bitwarden SSH item {item.get('name')} lacks a private/public key pair")
    return private, public


def create_device_key(item_name: str, session: str) -> dict[str, Any]:
    with tempfile.TemporaryDirectory(prefix="dot-ssh-") as directory:
        key = Path(directory) / "id_ed25519"
        run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", item_name, "-f", str(key)])
        private = key.read_text(encoding="utf-8")
        public = key.with_suffix(".pub").read_text(encoding="utf-8").strip()
        fingerprint = run(["ssh-keygen", "-lf", str(key.with_suffix(".pub"))], capture=True).stdout.split()[1]
    item = {
        "type": 5,
        "name": item_name,
        "favorite": False,
        "sshKey": {
            "privateKey": private,
            "publicKey": public,
            "keyFingerprint": fingerprint,
        },
    }
    return bw_create_item(item, session)


def github_auth_state() -> tuple[bool, set[str]]:
    if not command_exists("gh"):
        return False, set()
    proc = run(["gh", "auth", "status", "--hostname", "github.com"], check=False, capture=True)
    output = f"{proc.stdout}\n{proc.stderr}"
    match = re.search(r"Token scopes:\s*(.+)", output)
    scopes = set(re.findall(r"'([^']+)'", match.group(1))) if match else set()
    return proc.returncode == 0, scopes


def ensure_github_authorization() -> None:
    require_commands(
        ["gh"],
        "Install GitHub CLI, then rerun bootstrap. On Debian/Ubuntu: sudo apt install gh",
    )
    authenticated, scopes = github_auth_state()
    scope_list = ",".join(sorted(GITHUB_REQUIRED_SCOPES))
    if not authenticated:
        print("GitHub authentication is required; opening the browser login flow.")
        run(
            [
                "gh",
                "auth",
                "login",
                "--hostname",
                "github.com",
                "--git-protocol",
                "ssh",
                "--web",
                "--scopes",
                scope_list,
            ]
        )
        authenticated, scopes = github_auth_state()
    missing = GITHUB_REQUIRED_SCOPES - scopes
    if authenticated and missing:
        print(f"GitHub needs SSH key-management permissions: {', '.join(sorted(missing))}")
        run(
            [
                "gh",
                "auth",
                "refresh",
                "--hostname",
                "github.com",
                "--scopes",
                ",".join(sorted(missing)),
            ]
        )
        authenticated, scopes = github_auth_state()
    missing = GITHUB_REQUIRED_SCOPES - scopes
    if not authenticated or missing:
        raise DotError(
            "GitHub CLI authorization is incomplete. Run: "
            f"gh auth refresh -h github.com -s {scope_list}"
        )


def github_register(public_path: Path, label: str) -> None:
    ensure_github_authorization()
    existing = run(["gh", "ssh-key", "list"], check=False, capture=True)
    public_text = public_path.read_text(encoding="utf-8").strip()
    public_key = " ".join(public_text.split()[:2])
    listed_keys = []
    for line in existing.stdout.splitlines():
        fields = line.split("\t")
        if len(fields) >= 3:
            listed_keys.append((fields[1].strip(), fields[-1].strip()))
    for key_type in ("authentication", "signing"):
        if (public_key, key_type) in listed_keys:
            continue
        proc = run(
            ["gh", "ssh-key", "add", str(public_path), "--title", label, "--type", key_type],
            check=False,
            capture=True,
        )
        if proc.returncode and "already" not in proc.stderr.lower():
            print(f"GitHub {key_type} registration failed: {proc.stderr.strip()}", file=sys.stderr)


def write_identity(profile: dict[str, Any], bootstrap: dict[str, Any], public_key: Path) -> None:
    account = profile.get("account", "personal")
    identity = bootstrap.get("git_identities", {}).get(account)
    if not identity:
        raise DotError(f"Bitwarden bootstrap item has no git identity for {account}")
    content = (
        "[user]\n"
        f"\tname = {identity['name']}\n"
        f"\temail = {identity['email']}\n"
        f"\tsigningkey = {public_key}\n"
    )
    identity_path = CONFIG_DIR / f"git-{account}.gitconfig"
    atomic_text(identity_path, content, 0o600)
    atomic_text(
        CONFIG_DIR / "git-active.gitconfig",
        f"[include]\n\tpath = {identity_path}\n",
        0o600,
    )


def cmd_secrets_sync(args: argparse.Namespace) -> None:
    profile = load_profile(args.profile)
    device = ensure_device(args.device)
    account = profile.get("account", "personal")
    if not args.no_register:
        # Complete browser authorization before unlocking Bitwarden so a vault
        # session is never held open while waiting on GitHub.
        ensure_github_authorization()
    session, should_lock = bw_session()
    try:
        bootstrap_item = bw_get_item(BW_BOOTSTRAP_ITEM, session)
        try:
            bootstrap = json.loads(bootstrap_item.get("notes") or "{}")
        except json.JSONDecodeError as exc:
            raise DotError(f"{BW_BOOTSTRAP_ITEM} notes must contain valid JSON: {exc}") from exc
        item_name = f"dotfiles/ssh/{account}/{device}"
        item = bw_get_item(item_name, session, required=False)
        if item is None:
            print(f"Creating per-device SSH key in Bitwarden: {item_name}")
            item = create_device_key(item_name, session)
        private, public = key_parts(item)
        ssh_dir = Path.home() / ".ssh"
        ssh_dir.mkdir(mode=0o700, exist_ok=True)
        public_path = ssh_dir / f"dotfiles-{account}-{device}.pub"
        atomic_text(public_path, public.rstrip() + "\n", 0o644)
        if profile.get("features", {}).get("materialize_ssh_key"):
            private_path = public_path.with_suffix("")
            atomic_text(private_path, private.rstrip() + "\n", 0o600)
        write_identity(profile, bootstrap, public_path)
        if not args.no_register:
            github_register(public_path, f"{device}-{account}")
    finally:
        if should_lock:
            run(["bw", "lock"], check=False)


def clear_stale_chrome_hostname_lock(old_hostname: str) -> bool:
    """Remove Chrome singleton metadata invalidated by an operating-system rename."""
    chrome_dir = Path.home() / ".config/google-chrome"
    lock_path = chrome_dir / "SingletonLock"
    if not lock_path.is_symlink():
        return False
    try:
        lock_target = os.readlink(lock_path)
    except OSError:
        return False
    if not lock_target.startswith(f"{old_hostname}-"):
        return False
    chrome_running = run(
        ["pgrep", "-x", "chrome"], check=False, capture=True
    ).returncode == 0
    if chrome_running:
        return False
    for name in ("SingletonCookie", "SingletonLock", "SingletonSocket"):
        path = chrome_dir / name
        if path.is_symlink():
            path.unlink()
    return True


def bitwarden_agent_public_keys() -> tuple[Path | None, list[str]]:
    """Read public keys from the active Bitwarden agent without unlocking the vault."""
    sockets = (
        Path.home() / ".bitwarden-ssh-agent.sock",
        Path.home() / "snap/bitwarden/current/.bitwarden-ssh-agent.sock",
    )
    active_socket = next((path for path in sockets if path.is_socket()), None)
    if active_socket is None:
        return None, []
    environment = os.environ.copy()
    environment["SSH_AUTH_SOCK"] = str(active_socket)
    try:
        result = run(
            ["ssh-add", "-L"],
            check=False,
            capture=True,
            env=environment,
            timeout=5,
        )
    except subprocess.TimeoutExpired:
        return active_socket, []
    return (
        active_socket,
        result.stdout.splitlines() if result.returncode == 0 else [],
    )


def cmd_device_restore_local(args: argparse.Namespace) -> None:
    """Repair local identity collision without renaming another device's key."""
    profile = load_profile(args.profile)
    desired = inferred_device_id()
    device_path = CONFIG_DIR / "device.json"
    if not device_path.exists():
        raise DotError(f"Dotfiles device identity does not exist: {device_path}")
    current = validate_device_id(load_json(device_path).get("device_id"))
    if current == desired:
        print(f"Local device identity is already {desired}.")
        return

    account = profile.get("account", "personal")
    desired_public = (
        Path.home() / ".ssh" / f"dotfiles-{account}-{desired}.pub"
    )
    if not desired_public.is_file():
        raise DotError(
            f"Refusing local identity repair because {desired_public} is missing. "
            "Use the new-computer bootstrap flow to create a distinct credential."
        )
    expected_key_parts = desired_public.read_text(encoding="utf-8").split()[:2]
    if len(expected_key_parts) != 2:
        raise DotError(f"Invalid device public key: {desired_public}")

    identity_path = CONFIG_DIR / f"git-{account}.gitconfig"
    signing_key = run(
        ["git", "config", "--file", str(identity_path), "--get", "user.signingkey"],
        check=False,
        capture=True,
    )
    configured_key = Path(signing_key.stdout.strip()).expanduser()
    if (
        signing_key.returncode != 0
        or not configured_key.is_file()
        or configured_key.resolve() != desired_public.resolve()
    ):
        raise DotError(
            "Refusing local identity repair because the configured Git signing "
            f"key is not {desired_public}."
        )

    agent_socket, agent_keys = bitwarden_agent_public_keys()
    agent_has_key = any(
        line.split()[:2] == expected_key_parts
        for line in agent_keys
        if len(line.split()) >= 2
    )
    if not agent_has_key:
        raise DotError(
            "Refusing local identity repair because the existing hostname key is "
            "not available from the Bitwarden SSH agent. Start and unlock "
            f"Bitwarden Desktop, confirm {desired_public}, and retry."
        )

    state_path = STATE_DIR / "bootstrap" / f"{profile['name']}.json"
    state = load_json(state_path) if state_path.exists() else None
    if state is not None:
        if state.get("device") not in {current, desired}:
            raise DotError(
                f"Bootstrap state belongs to {state.get('device')!r}; refusing "
                "a partial local identity repair."
            )
        state["device"] = desired
        atomic_text(state_path, json.dumps(state, indent=2) + "\n", 0o600)

    atomic_text(
        device_path,
        json.dumps({"schema_version": 1, "device_id": desired}, indent=2) + "\n",
        0o600,
    )
    write_finalization_handoff(profile["name"], desired)
    print(f"Restored local dotfiles identity: {current} -> {desired}")
    print(
        f"Verified {desired_public.name} through {agent_socket}; no Bitwarden "
        f"items, GitHub keys, or state belonging to {current} were renamed or removed."
    )


def cmd_device_rename(args: argparse.Namespace) -> None:
    profile = load_profile(args.profile)
    old = validate_device_id(args.old_device)
    new = validate_device_id(args.new_device)
    if old == new:
        raise DotError("Old and new device IDs are identical.")
    device_path = CONFIG_DIR / "device.json"
    if not device_path.exists():
        raise DotError(f"Dotfiles device identity does not exist: {device_path}")
    current = load_json(device_path).get("device_id")
    if current == new:
        print(f"Device identity is already {new}.")
        return
    if current != old:
        raise DotError(f"Current dotfiles device is {current!r}, not {old!r}.")
    hostname = socket.gethostname().lower()
    if hostname != new:
        raise DotError(
            f"System hostname is {hostname!r}. Rename and reboot the operating "
            f"system to {new!r} before migrating dotfiles identity."
        )
    account = profile.get("account", "personal")
    old_name = f"dotfiles/ssh/{account}/{old}"
    new_name = f"dotfiles/ssh/{account}/{new}"
    state_path = STATE_DIR / "bootstrap" / f"{profile['name']}.json"
    state = load_json(state_path) if state_path.exists() else None
    if state is not None and state.get("device") not in {old, new}:
        raise DotError(
            f"Bootstrap state belongs to {state.get('device')!r}; refusing a partial migration."
        )
    session, should_lock = bw_session()
    try:
        run(["bw", "sync", "--session", session], check=False, capture=True)
        old_item = bw_get_item(old_name, session, required=False)
        new_item = bw_get_item(new_name, session, required=False)
        if old_item is not None and new_item is not None:
            raise DotError(
                f"Both {old_name} and {new_name} exist in Bitwarden; refusing to choose one."
            )
        if old_item is None and new_item is None:
            raise DotError(
                f"Neither {old_name} nor {new_name} exists in Bitwarden; "
                "the prior identity phase cannot be migrated safely."
            )
        item = new_item
        if old_item is not None:
            old_item["name"] = new_name
            item = bw_edit_item(old_item, session)
        bootstrap = parse_bootstrap(session)
        private, public = key_parts(item)
        ssh_dir = Path.home() / ".ssh"
        ssh_dir.mkdir(mode=0o700, exist_ok=True)
        new_public = ssh_dir / f"dotfiles-{account}-{new}.pub"
        old_public = ssh_dir / f"dotfiles-{account}-{old}.pub"
        atomic_text(new_public, public.rstrip() + "\n", 0o644)
        if profile.get("features", {}).get("materialize_ssh_key"):
            atomic_text(new_public.with_suffix(""), private.rstrip() + "\n", 0o600)
        write_identity(profile, bootstrap, new_public)
        for old_path in (old_public, old_public.with_suffix("")):
            if old_path.exists() and old_path != new_public:
                old_path.unlink()
    finally:
        if should_lock:
            run(["bw", "lock"], check=False)

    if state is not None:
        state["device"] = new
        atomic_text(state_path, json.dumps(state, indent=2) + "\n", 0o600)
    atomic_text(
        device_path,
        json.dumps({"schema_version": 1, "device_id": new}, indent=2) + "\n",
        0o600,
    )
    chrome_lock_cleared = clear_stale_chrome_hostname_lock(old)
    write_finalization_handoff(profile["name"], new)
    print(f"Migrated dotfiles device identity: {old} -> {new}")
    if chrome_lock_cleared:
        print("Removed Chrome's stale single-instance lock from the old hostname.")
    print(
        "The existing GitHub authentication and signing keys remain valid; "
        "their historical web labels do not affect key identity."
    )


def cmd_secrets_initialize(args: argparse.Namespace) -> None:
    draft_path = Path(args.draft).expanduser()
    bootstrap = load_json(draft_path)
    if bootstrap.get("schema_version") != 1:
        raise DotError(f"{draft_path} must use bootstrap schema_version 1")
    session, should_lock = bw_session()
    try:
        run(["bw", "sync", "--session", session], check=False, capture=True)
        if bw_get_item(BW_BOOTSTRAP_ITEM, session, required=False) is not None:
            raise DotError(
                f"Bitwarden item {BW_BOOTSTRAP_ITEM} already exists; "
                "initialization will not overwrite it"
            )
        item = {
            "type": 2,
            "name": BW_BOOTSTRAP_ITEM,
            "favorite": False,
            "notes": json.dumps(bootstrap, indent=2),
            "secureNote": {"type": 0},
        }
        created = bw_create_item(item, session)
        if created.get("name") != BW_BOOTSTRAP_ITEM:
            raise DotError("Bitwarden returned an unexpected item after initialization")
        print(f"Created Bitwarden secure note: {BW_BOOTSTRAP_ITEM}")
    finally:
        if should_lock:
            run(["bw", "lock"], check=False)


def parse_bootstrap(session: str) -> dict[str, Any]:
    item = bw_get_item(BW_BOOTSTRAP_ITEM, session)
    try:
        return json.loads(item.get("notes") or "{}")
    except json.JSONDecodeError as exc:
        raise DotError(f"{BW_BOOTSTRAP_ITEM} notes are not valid JSON: {exc}") from exc


def repository_entries(manifest: dict[str, Any], source: str) -> list[dict[str, Any]]:
    entries = manifest.get("repositories", [])
    if not isinstance(entries, list):
        raise DotError(f"{source} repositories must be a list")
    normalized: list[dict[str, Any]] = []
    for entry in entries:
        if not isinstance(entry, dict) or not all(
            isinstance(entry.get(key), str) and entry[key]
            for key in ("name", "url", "path")
        ) or not isinstance(entry.get("profiles"), list):
            raise DotError(f"Invalid repository entry in {source}")
        normalized.append(entry)
    return normalized


def merged_repositories(private_manifest: dict[str, Any]) -> list[dict[str, Any]]:
    official = load_json(OFFICIAL_REPOSITORIES_FILE)
    if official.get("schema_version") != 1:
        raise DotError(f"Invalid official repository manifest: {OFFICIAL_REPOSITORIES_FILE}")
    merged: list[dict[str, Any]] = []
    by_name: dict[str, dict[str, Any]] = {}
    by_path: dict[str, dict[str, Any]] = {}
    for entry in [
        *repository_entries(official, str(OFFICIAL_REPOSITORIES_FILE)),
        *repository_entries(private_manifest, BW_BOOTSTRAP_ITEM),
    ]:
        prior = by_name.get(entry["name"]) or by_path.get(entry["path"])
        if prior:
            # Official profile ownership wins over a legacy private duplicate.
            comparable = ("name", "url", "path")
            if any(prior.get(key) != entry.get(key) for key in comparable):
                raise DotError(
                    "Repository manifest conflict for "
                    f"{entry['name']} at {entry['path']}"
                )
            continue
        copy = dict(entry)
        merged.append(copy)
        by_name[copy["name"]] = copy
        by_path[copy["path"]] = copy
    return merged


def github_https_url(url: str) -> str:
    match = re.fullmatch(r"git@github\.com:([^/]+)/(.+)", url)
    if not match:
        return url
    repository = match.group(2)
    if repository.endswith(".git"):
        repository = repository[:-4]
    return f"https://github.com/{match.group(1)}/{repository}.git"


def cmd_repos_sync(args: argparse.Namespace) -> None:
    profile_name = normalize_profile(args.profile)
    session, should_lock = bw_session()
    try:
        manifest = parse_bootstrap(session)
        repositories = merged_repositories(manifest)
        if command_exists("gh"):
            run(["gh", "auth", "setup-git"], check=False)
        for repo in repositories:
            if profile_name not in repo.get("profiles", []):
                continue
            destination = Path(os.path.expandvars(os.path.expanduser(repo["path"])))
            if (destination / ".git").exists():
                print(f"Updating {repo['name']}")
                run(["git", "-C", str(destination), "fetch", "--all", "--prune", "--tags"])
            elif destination.exists():
                raise DotError(f"Clone destination exists but is not a Git repository: {destination}")
            else:
                destination.parent.mkdir(parents=True, exist_ok=True)
                print(f"Cloning {repo['name']}")
                clone_url = github_https_url(repo["url"])
                run(["git", "clone", clone_url, str(destination)])
                if clone_url != repo["url"]:
                    run(["git", "-C", str(destination), "remote", "set-url", "origin", repo["url"]])
    finally:
        if should_lock:
            run(["bw", "lock"], check=False)


def cmd_package_add(args: argparse.Namespace) -> None:
    profile_name = normalize_profile(args.profile)
    path = PROFILE_DIR / f"{profile_name}.yml"
    profile = load_json(path)
    provider = args.provider
    if provider is None:
        catalog = load_json(ROOT / "packages/catalog.yml")
        entry = catalog.get("tools", {}).get(args.name)
        if entry:
            provider = entry["provider"]
        elif profile_name == "termux":
            provider = "pkg"
        elif profile_name == "windows-host":
            raise DotError("Windows packages are inventory-only; specify --provider winget, scoop, or psgallery.")
        else:
            provider = "brew"
    allowed = {"apt", "brew", "snap", "pkg", "winget", "scoop", "psgallery"}
    if provider not in allowed:
        raise DotError(f"Unsupported provider {provider}; choose one of {', '.join(sorted(allowed))}")
    packages = profile.setdefault("packages", {}).setdefault(provider, [])
    if args.name in packages:
        print(f"{args.name} already exists in {profile_name}:{provider}")
        return
    packages.append(args.name)
    packages.sort(key=str.casefold)
    atomic_text(path, json.dumps(profile, indent=2) + "\n")
    print(f"Added {args.name} to {profile_name}:{provider}; no commit was created.")
    if profile_name != "windows-host" and not args.no_apply:
        cmd_apply(argparse.Namespace(profile=profile_name, tags="packages", check=False, direct=False))


