                        "Move Window and Follow Left",
                    )
                )
                == [419430418]
                and kglobal_shortcut(
                    (
                        "kwin",
                        "dot-window-desktop-right",
                        "KWin",
                        "Move Window and Follow Right",
                    )
                )
                == [419430420]
                and kglobal_shortcut(
                    ("kwin", "Switch Window Left", "KWin", "Switch to Window to the Left")
                )
                == [0]
                and kglobal_shortcut(
                    ("kwin", "Switch Window Right", "KWin", "Switch to Window to the Right")
                )
                == [0]
            )
        except DotError:
            window_desktop_live_shortcuts_ok = False
        window_desktop_shortcuts_ok = (
            "dot-window-desktopEnabled=true" in kwin
            and window_desktop_script_loaded
            and window_desktop_live_shortcuts_ok
        )
        failures += not doctor_check(
            "move window and follow shortcuts",
            window_desktop_shortcuts_ok,
            "Alt+Meta+Left/Right moves the active window and follows it"
            if window_desktop_shortcuts_ok
            else "run dot apply --profile kubuntu-laptop --tags kde",
        )
        dolphin_taskbar_ok = all(
            value in dolphin_rules
            for value in (
                "wmclass=org.kde.dolphin",
                "wmclassmatch=1",
                "skippager=true",
                "skippagerrule=2",
                "skipswitcher=true",
                "skipswitcherrule=2",
                "skiptaskbar=true",
                "skiptaskbarrule=2",
            )
