            "hidden from the taskbar, pager, and Alt+Tab"
            if dolphin_taskbar_ok
            else "run dot apply --profile kubuntu-laptop --tags kde",
        )
        emoji_ephemeral_ok = all(
            value in dolphin_rules
            for value in (
                "[emoji-selector-ephemeral]",
