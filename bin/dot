        if profile.get("features", {}).get("touchpad_jump_workaround"):
            touchpad_quirk_source = (
                ROOT / "config/libinput/local-overrides.quirks"
            )
            touchpad_quirk_live = Path("/etc/libinput/local-overrides.quirks")
            touchpad_quirk_matches = (
                touchpad_quirk_live.is_file()
                and touchpad_quirk_live.read_bytes()
                == touchpad_quirk_source.read_bytes()
            )
            failures += not doctor_check(
                "touchpad jump workaround",
                touchpad_quirk_matches,
                "scoped libinput jump detection override installed"
                if touchpad_quirk_matches
                else "run dot apply --profile kubuntu-laptop --tags touchpad",
            )
            touchpad_event = next(
                (
                    Path("/dev/input") / event.name
                    for event in Path("/sys/class/input").glob("event*")
                    if (event / "device/name").is_file()
                    and (event / "device/name")
                    .read_text(encoding="utf-8")
                    .strip()
                    == "CIRQ1080:00 0488:1054 Touchpad"
                ),
                None,
            )
            active_quirks = (
                run(
                    ["libinput", "quirks", "list", str(touchpad_event)],
                    check=False,
                    capture=True,
                )
                if touchpad_event is not None and command_exists("libinput")
                else None
            )
            touchpad_quirk_active = (
                active_quirks is not None
                and active_quirks.returncode == 0
                and "ModelLenovoX1Gen6Touchpad=1" in active_quirks.stdout
            )
            failures += not doctor_check(
                "touchpad libinput match",
                touchpad_quirk_active,
                f"{touchpad_event}; jump detector override matched"
                if touchpad_quirk_active
                else "the managed override does not match the live touchpad",
