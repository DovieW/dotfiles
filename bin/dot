        ["tailscale"],
        "Run `dot apply --profile kubuntu-laptop --tags tailscale` first.",
    )
    action = args.tailscale_action
    if action == "status":
        status = run(["tailscale", "status"], check=False)
        if status.returncode:
            raise DotError(
                "Tailscale is not connected. Run `sudo tailscale up` to enroll "
                "or reconnect this machine."
            )
        return
    require_commands(["sudo"], "Install sudo before changing Tailscale state.")
    run(["sudo", "tailscale", action])


def cmd_secrets_meshcentral_agent(_args: argparse.Namespace) -> None:
    install_command = getpass.getpass("MeshCentral Linux install command: ")
    enrollment = parse_meshcentral_install_command(install_command)
    session, should_lock = bw_session()
    try:
        run(["bw", "sync", "--session", session], check=False, capture=True)
        bw_upsert_secure_note(BW_MESHCENTRAL_ITEM, enrollment, session)
        print(f"Stored and validated: {BW_MESHCENTRAL_ITEM}")
    finally:
        if should_lock:
            run(["bw", "lock"], check=False)


def meshcentral_service_state() -> tuple[bool, bool, bool, Path | None]:
    load_state = run(
        ["systemctl", "show", "meshagent.service", "--property=LoadState", "--value"],
        check=False,
        capture=True,
    )
    installed = load_state.returncode == 0 and load_state.stdout.strip() == "loaded"
    enabled = installed and run(
        ["systemctl", "is-enabled", "--quiet", "meshagent.service"],
        check=False,
    ).returncode == 0
    active = installed and run(
        ["systemctl", "is-active", "--quiet", "meshagent.service"],
        check=False,
    ).returncode == 0
    config = next((path for path in MESH_AGENT_CONFIG_PATHS if path.is_file()), None)
    return installed, enabled, active, config


def download_meshcentral_asset(
    url: str, destination: Path, *, private_url: bool = False
) -> bool:
    """Download one MeshCentral asset without exposing private URLs in argv."""
    command = [
        "curl",
        "--fail",
        "--show-error",
        "--silent",
        "--location",
        "--proto",
        "=https",
        "--tlsv1.2",
        "--output",
        str(destination),
    ]
    input_text = None
    if private_url:
        command.extend(["--config", "-"])
        input_text = f"url = {json.dumps(url)}\n"
    else:
        command.append(url)
    result = subprocess.run(
        command,
        check=False,
        text=True,
        input=input_text,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
    )
    return result.returncode == 0


def meshcentral_linux_agent_id() -> int:
    """Match the architecture mapping in MeshCentral's Linux installer."""
    machine = platform.machine().lower()
    if machine in {"x86_64", "amd64"}:
        return 6 if sys.maxsize > 2**32 else 5
    if machine in {"x86", "i386", "i486", "i586", "i686"}:
        return 5
    if machine in {"armv6l", "armv7l"}:
        return 25
    if machine in {"aarch64", "arm64"}:
        return 26
    if machine == "riscv64":
        return 45
    raise DotError(f"MeshCentral does not publish a Linux agent for {machine}")


def meshcentral_mesh_id_hex(mesh_id: str) -> str:
    encoded = mesh_id.replace("@", "+").replace("$", "/")
    encoded += "=" * (-len(encoded) % 4)
    try:
        raw = base64.b64decode(encoded, altchars=b"-_", validate=True)
    except (ValueError, binascii.Error) as exc:
        raise DotError("MeshCentral device-group identifier is not valid base64") from exc
    if len(raw) < 32:
        raise DotError("MeshCentral device-group identifier is unexpectedly short")
    return raw.hex().upper()


def validate_meshcentral_settings(
    settings_path: Path, enrollment: dict[str, Any]
) -> None:
    try:
        raw = settings_path.read_bytes()
        if not raw or len(raw) > 1024 * 1024 or b"\0" in raw:
            raise ValueError
        settings: dict[str, str] = {}
        for line in raw.decode("utf-8").splitlines():
            if "=" in line:
                key, value = line.split("=", 1)
                settings[key] = value
    except (OSError, UnicodeDecodeError, ValueError) as exc:
        raise DotError("MeshCentral returned invalid agent settings") from exc

    expected_mesh_id = "0x" + meshcentral_mesh_id_hex(enrollment["mesh_id"])
    if settings.get("MeshID", "").lower() != expected_mesh_id.lower():
        raise DotError("MeshCentral returned settings for a different device group")
    server = urlparse(enrollment["server_url"])
    agent_server = urlparse(settings.get("MeshServer", ""))
    try:
        server_port = server.port or 443
        agent_server_port = agent_server.port or 443
    except ValueError as exc:
        raise DotError("MeshCentral returned settings with an invalid server port") from exc
    if (
        agent_server.scheme != "wss"
        or agent_server.hostname != server.hostname
        or agent_server_port != server_port
        or not agent_server.path.endswith("/agent.ashx")
        or agent_server.username
        or agent_server.password
        or agent_server.query
        or agent_server.fragment
    ):
        raise DotError("MeshCentral returned settings for a different server")
    if not re.fullmatch(r"[0-9A-Fa-f]{64,}", settings.get("ServerID", "")):
        raise DotError("MeshCentral returned settings without a valid server identity")


def install_meshcentral_enrollment(enrollment: dict[str, Any]) -> None:
    """Download and run one already-validated MeshCentral enrollment."""
    with tempfile.TemporaryDirectory(prefix="dot-meshcentral-") as temp_dir:
        work_dir = Path(temp_dir)
        installer = Path(temp_dir) / "meshinstall.sh"
        if download_meshcentral_asset(enrollment["installer_url"], installer):
            if not installer.is_file() or installer.stat().st_size == 0:
                raise DotError("MeshCentral returned an empty installer")
            if not installer.read_bytes().startswith(b"#!"):
                raise DotError("MeshCentral returned an unexpected installer format")
            installer.chmod(0o700)
            run(
                [
                    "sudo",
                    str(installer),
                    enrollment["server_url"],
                    enrollment["mesh_id"],
                ]
            )
            return

        print(
            "MeshCentral's helper script is unavailable; using its native "
            "Linux agent installer."
        )
        agent = work_dir / "meshagent"
        settings = work_dir / "meshagent.msh"
        agent_url = (
            f"{enrollment['server_url']}/meshagents?"
            + urlencode({"id": meshcentral_linux_agent_id()})
        )
        settings_url = (
            f"{enrollment['server_url']}/meshsettings?"
            + urlencode({"id": enrollment["mesh_id"]})
        )
        if not download_meshcentral_asset(agent_url, agent):
            raise DotError("MeshCentral did not provide a native Linux agent")
        if not agent.is_file() or not agent.read_bytes().startswith(b"\x7fELF"):
            raise DotError("MeshCentral returned an unexpected Linux agent format")
        if not download_meshcentral_asset(settings_url, settings, private_url=True):
            raise DotError("MeshCentral did not provide device-group settings")
        validate_meshcentral_settings(settings, enrollment)
        agent.chmod(0o700)
        run(
            ["sudo", str(agent), "-fullinstall", "--copy-msh=1"],
            cwd=work_dir,
        )


def cmd_meshcentral(args: argparse.Namespace) -> None:
    action = args.meshcentral_action
    if action == "status":
        installed, enabled, active, config = meshcentral_service_state()
        print(f"MeshCentral agent installed: {'yes' if installed else 'no'}")
        print(f"MeshCentral service enabled: {'yes' if enabled else 'no'}")
        print(f"MeshCentral service active: {'yes' if active else 'no'}")
        print(f"MeshCentral configuration: {config or 'not found'}")
        if not installed:
            print("Enroll with `dot meshcentral enroll`.")
        return

    if platform.system() != "Linux":
        raise DotError("MeshCentral agent enrollment is currently supported on Linux")
    require_commands(
        ["curl", "sudo", "systemctl"],
        "Run `dot apply --profile kubuntu-laptop --tags meshcentral` first.",
    )
    if action in {"enroll", "enroll-and-store"}:
        if getattr(args, "install_command_stdin", False):
            install_command = sys.stdin.readline().rstrip("\n")
            if not install_command:
                raise DotError("MeshCentral install-command input was empty")
        else:
            install_command = getpass.getpass("MeshCentral Linux install command: ")
        enrollment = parse_meshcentral_install_command(install_command)
        if action == "enroll-and-store":
            session, should_lock = bw_session()
            try:
                run(["bw", "sync", "--session", session], check=False, capture=True)
                bw_upsert_secure_note(BW_MESHCENTRAL_ITEM, enrollment, session)
                print(f"Replaced and validated: {BW_MESHCENTRAL_ITEM}")
            finally:
                if should_lock:
                    run(["bw", "lock"], check=False)
    else:
        session, should_lock = bw_session()
        try:
            run(["bw", "sync", "--session", session], check=False, capture=True)
            item = bw_get_item(BW_MESHCENTRAL_ITEM, session)
            try:
                notes = json.loads(str(item.get("notes") or ""))
            except json.JSONDecodeError as exc:
                raise DotError(
                    f"Bitwarden item {BW_MESHCENTRAL_ITEM} is not valid JSON"
                ) from exc
            enrollment = normalize_meshcentral_enrollment(notes)
        finally:
            if should_lock:
                run(["bw", "lock"], check=False)

    install_meshcentral_enrollment(enrollment)
    installed, enabled, active, config = meshcentral_service_state()
    if not installed or not active:
        raise DotError(
            "MeshCentral installer completed, but meshagent.service is not active"
        )
    print(f"MeshCentral agent enrolled and active; configuration: {config or 'managed'}")


def emoji_picker_runtime() -> tuple[bool, str]:
    python_check = run(
        [
            "/usr/bin/python3",
            "-c",
            "import cairo, gi; "
            "gi.require_version('Pango', '1.0'); "
            "gi.require_version('PangoCairo', '1.0'); "
            "from gi.repository import PangoCairo; "
            "from PyQt6 import QtWidgets; "
            "surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, 1, 1); "
            "PangoCairo.create_layout(cairo.Context(surface))",
        ],
        check=False,
        capture=True,
    )
    missing_helpers = [
        command
        for command in ("ydotool", "wl-copy")
        if not command_exists(command)
    ]
    if python_check.returncode == 0 and not missing_helpers:
        return True, "PyQt6, Pango/Cairo, ydotool, and wl-copy available"

    missing = []
    if python_check.returncode != 0:
        missing.append("Ubuntu Python GUI/Pango bridge")
    missing.extend(missing_helpers)
    return False, "missing " + ", ".join(missing)


def clipboard_shortcuts_runtime() -> tuple[bool, str]:
    if not command_exists("gdbus") or not command_exists("qdbus6"):
        return False, "KDE shortcut services are unavailable"
    loaded = run(
        [
            "qdbus6",
            "org.kde.KWin",
            "/Scripting",
            "org.kde.kwin.Scripting.isScriptLoaded",
            "dot-clipboard",
        ],
        check=False,
        capture=True,
    ).stdout.strip() == "true"
    expected = {
        ("kwin", "dot-copyq-history-meta", "KWin", "Open Clipboard History (Meta+V)"): [268435542],
        ("kwin", "dot-copyq-history-ctrl", "KWin", "Open Clipboard History (Ctrl+Grave)"): [67108960],
        ("kwin", "dot-emoji-picker", "KWin", "Open Dotfiles Emoji Picker"): [268435502],
        ("org.kde.plasma.emojier.desktop", "_launch", "Emoji Selector", "Emoji Selector"): [0],
        ("plasmashell", "show-on-mouse-pos", "plasmashell", "Show Clipboard Items at Mouse Position"): [0],
    }
    try:
        assignments_ok = all(
            kglobal_shortcut(action_id) == keys
            for action_id, keys in expected.items()
        )
    except DotError as error:
        return False, str(error)
    callback_ok = managed_clipboard_callback_ok()
    if loaded and assignments_ok and callback_ok:
        return True, "KWin owns Meta+V, Ctrl+`, and Meta+.; live callback verified"
    if not callback_ok:
        return False, "KWin clipboard action has no live callback"
    return False, "KWin clipboard script or live key assignments drifted"


def copyq_runtime() -> tuple[bool, str]:
    """Validate the live server, monitor, graphical ownership, and paste path."""
    problems: list[str] = []
    copyq_bin = Path.home() / ".local/bin/copyq"
    systemd_user = Path.home() / ".config/systemd/user"
    desired_wants = systemd_user / "graphical-session.target.wants/dot-copyq.service"
    obsolete_wants = systemd_user / "default.target.wants/dot-copyq.service"
    if not desired_wants.is_symlink() or obsolete_wants.is_symlink():
        problems.append("CopyQ is not owned exclusively by graphical-session.target")
    for legacy in (
        Path.home() / ".config/autostart/copyq.desktop",
        Path.home() / ".config/autostart/com.github.hluk.copyq.desktop",
    ):
        enabled = legacy.is_symlink()
        if legacy.is_file() and not legacy.is_symlink():
            desktop = legacy.read_text(encoding="utf-8", errors="replace")
            enabled = not (
                "Hidden=true" in desktop
                or "X-GNOME-Autostart-enabled=false" in desktop
            )
        if enabled:
            problems.append(f"legacy autostart remains at {legacy}")

    service_active = run(
        ["systemctl", "--user", "is-active", "--quiet", "dot-copyq.service"],
        check=False,
    ).returncode == 0
    if not service_active:
        problems.append("dot-copyq.service is inactive")
    else:
        main_pid = run(
            ["systemctl", "--user", "show", "dot-copyq.service", "-p", "MainPID", "--value"],
            check=False,
            capture=True,
        ).stdout.strip()
        environ = Path(f"/proc/{main_pid}/environ")
        try:
            service_environment = environ.read_bytes().replace(b"\0", b"\n")
        except (OSError, ValueError):
            service_environment = b""
        if b"WAYLAND_DISPLAY=" not in service_environment:
            problems.append("CopyQ server was not launched inside a Wayland session")

    if not copyq_bin.is_file():
        problems.append("managed CopyQ launcher is missing")
    elif service_active:
        monitoring = run(
            [str(copyq_bin), "eval", "print(monitoring())"],
            check=False,
            capture=True,
        )
        if monitoring.returncode or monitoring.stdout.strip() != "true":
            problems.append("CopyQ clipboard monitoring is inactive")

    monitors = 0
    for proc in Path("/proc").iterdir():
        if not proc.name.isdigit():
            continue
        try:
            if proc.stat().st_uid != os.getuid():
                continue
            command = proc.joinpath("cmdline").read_bytes().replace(b"\0", b" ")
        except OSError:
            continue
        if b"--clipboard-access monitorClipboard" in command:
            monitors += 1
    if service_active and monitors != 1:
        problems.append(f"expected one CopyQ clipboard monitor, found {monitors}")

    ydotool_active = run(
        ["systemctl", "--user", "is-active", "--quiet", "ydotool.service"],
        check=False,
    ).returncode == 0
    if not ydotool_active:
        problems.append("ydotool.service is inactive")
    # With no username, id reports this process's effective supplementary
    # groups. Passing a username would read the updated account database and
    # falsely claim that a required logout/reboot had already happened.
    groups = run(["id", "-nG"], check=False, capture=True).stdout.split()
    if "dot-uinput" not in groups:
        problems.append("dot-uinput membership is pending a full logout or reboot")
    if "input" in groups:
        problems.append("broad physical input-group access is still effective")
    if not os.access("/dev/uinput", os.W_OK):
        problems.append("/dev/uinput is not writable by this session")

    if problems:
        return False, "; ".join(problems)
    return True, "one graphical server and monitor; narrow uinput and Wayland paste ready"


def cmd_clipboard(args: argparse.Namespace) -> None:
    action = getattr(args, "clipboard_action", "status")
    profile = getattr(args, "profile", None) or update_profile(None)
    if action == "status":
        run([str(ROOT / "scripts/install-copyq"), "--check"])
        run([str(ROOT / "scripts/configure-copyq"), "--check"])
        run([str(ROOT / "scripts/install-emoji-picker"), "--check"])
        runtime_ok, runtime_detail = emoji_picker_runtime()
        if not runtime_ok:
            raise DotError(
                f"Emoji Picker runtime is incomplete ({runtime_detail}). Run "
                f"`dot apply --profile {profile} --tags clipboard`."
            )
        print(f"Emoji Picker runtime: {runtime_detail}.")
        copyq_ok, copyq_detail = copyq_runtime()
        if not copyq_ok:
            raise DotError(
                f"CopyQ runtime is incomplete ({copyq_detail}). Run "
                f"`dot apply --profile {profile} --tags clipboard`, then fully log out or reboot."
            )
        print(f"CopyQ runtime: {copyq_detail}.")
        shortcuts_ok, shortcuts_detail = clipboard_shortcuts_runtime()
        if not shortcuts_ok:
            raise DotError(
                f"Clipboard shortcuts are incomplete ({shortcuts_detail}). Run "
                f"`dot apply --profile {profile} --tags clipboard`."
            )
        print(f"Clipboard shortcuts: {shortcuts_detail}.")
    elif action == "history":
        run([str(Path.home() / ".local/bin/dot-copyq-history")])
    elif action == "emoji":
        runtime_ok, runtime_detail = emoji_picker_runtime()
        if not runtime_ok:
            raise DotError(
                f"Emoji Picker cannot start ({runtime_detail}). Run "
                f"`dot apply --profile {profile} --tags clipboard`."
            )
        run([str(Path.home() / ".local/bin/emoji-picker")])
    elif action == "test":
        run([str(Path.home() / ".local/bin/dot-test-copyq-paste")])
    elif action in {"apply", "update"}:
        cmd_apply(
            argparse.Namespace(
                profile=profile,
                tags="clipboard",
                check=False,
                direct=False,
                force_kde=False,
            )
        )
    else:
        raise DotError(f"Unknown clipboard action: {action}")


def inputactions_effect_loaded() -> bool:
    if not command_exists("qdbus6"):
        return False
    result = run(
        [
            "qdbus6",
            "org.kde.KWin",
            "/Effects",
            "org.kde.kwin.Effects.isEffectLoaded",
            "kwin_gestures",
        ],
        check=False,
        capture=True,
    )
    return result.returncode == 0 and result.stdout.strip() == "true"


def cmd_gestures(args: argparse.Namespace) -> None:
    action = args.gestures_action
    if action == "disable":
        require_commands(
            ["kwriteconfig6"],
            "Install KDE command-line configuration tools.",
        )
        run(
            [
                "kwriteconfig6",
                "--file",
                "kwinrc",
                "--group",
                "Plugins",
                "--key",
                "kwin_gesturesEnabled",
                "false",
            ]
        )
        if command_exists("qdbus6") and inputactions_effect_loaded():
            run(
                [
                    "qdbus6",
                    "org.kde.KWin",
                    "/Effects",
                    "org.kde.kwin.Effects.unloadEffect",
                    "kwin_gestures",
                ]
            )
        print(
            "InputActions is disabled for this session and in the live KWin "
            "configuration. Re-enable it with `dot gestures enable`."
        )
        return

    if action == "enable":
        require_commands(
            ["inputactions", "kwriteconfig6", "qdbus6"],
            "Run `dot apply --profile kubuntu-laptop --tags gestures` first.",
        )
        run(
            [
                "kwriteconfig6",
                "--file",
                "kwinrc",
                "--group",
                "Plugins",
                "--key",
                "kwin_gesturesEnabled",
                "true",
            ]
        )
        if not inputactions_effect_loaded():
            loaded = run(
                [
                    "qdbus6",
                    "org.kde.KWin",
                    "/Effects",
                    "org.kde.kwin.Effects.loadEffect",
                    "kwin_gestures",
                ],
                check=False,
                capture=True,
            )
            if loaded.returncode != 0 or loaded.stdout.strip() != "true":
                raise DotError(
                    "KWin could not load InputActions. Log out and back in, "
                    "then run `dot gestures status`."
                )
        run(["inputactions", "config", "reload"])
        run(["inputactions", "config", "issues"])
        print("Windows-style touchpad gestures are enabled.")
        return

    if action == "reload":
        require_commands(
            ["inputactions"],
            "Run `dot apply --profile kubuntu-laptop --tags gestures` first.",
        )
        if not inputactions_effect_loaded():
            raise DotError("InputActions is disabled; run `dot gestures enable`.")
        copy_managed_file(
            ROOT / "config/inputactions/config.yaml",
            Path.home() / ".config/inputactions/config.yaml",
        )
        copy_managed_file(
            ROOT / "config/inputactions/dot-show-desktop",
            Path.home() / ".local/bin/dot-show-desktop",
        )
        run(["inputactions", "config", "reload"])
        run(["inputactions", "config", "issues"])
        print("Installed, reloaded, and validated the touchpad gesture configuration.")
        return

    build_check = run(
        [str(ROOT / "scripts/build-inputactions"), "--check"],
        check=False,
        capture=True,
    )
    config_source = ROOT / "config/inputactions/config.yaml"
    config_live = Path.home() / ".config/inputactions/config.yaml"
    helper_source = ROOT / "config/inputactions/dot-show-desktop"
    helper_live = Path.home() / ".local/bin/dot-show-desktop"
    config_matches = (
        config_live.is_file()
        and config_live.read_bytes() == config_source.read_bytes()
        and helper_live.is_file()
        and helper_live.read_bytes() == helper_source.read_bytes()
        and os.access(helper_live, os.X_OK)
    )
    issues = run(
        ["inputactions", "config", "issues"],
        check=False,
        capture=True,
    ) if command_exists("inputactions") and inputactions_effect_loaded() else None
    print(
        f"[{'OK' if build_check.returncode == 0 else 'FAIL'}] build: "
        f"{(build_check.stdout or build_check.stderr).strip()}"
    )
    print(
        f"[{'OK' if config_matches else 'FAIL'}] config: "
        f"{'matches dotfiles' if config_matches else 'run dot apply --profile kubuntu-laptop --tags gestures'}"
    )
    print(
        f"[{'OK' if inputactions_effect_loaded() else 'FAIL'}] KWin effect: "
        f"{'loaded' if inputactions_effect_loaded() else 'disabled or unavailable'}"
    )
    if issues is not None:
        detail = (issues.stdout or issues.stderr).strip() or "no configuration issues"
        print(f"[{'OK' if issues.returncode == 0 else 'FAIL'}] validation: {detail}")
    if (
        build_check.returncode != 0
        or not config_matches
        or not inputactions_effect_loaded()
        or (issues is not None and issues.returncode != 0)
    ):
        raise DotError("Touchpad gesture status has failing checks.")


def active_package_transactions() -> list[str]:
    """Find native package-manager mutations already running for this host."""
    active: set[str] = set()
    for command_line in Path("/proc").glob("[0-9]*/cmdline"):
        try:
            arguments = [
                value.decode(errors="replace")
                for value in command_line.read_bytes().split(b"\0")
                if value
            ]
        except (OSError, PermissionError):
            continue
        if not arguments:
            continue
        program = Path(arguments[0]).name
        if program in {"apt", "apt-get", "dpkg", "unattended-upgrade"}:
            active.add(" ".join(arguments[:3]))
        elif program == "snap" and any(
            action in arguments[1:]
            for action in {"refresh", "install", "remove", "revert"}
        ):
            active.add(" ".join(arguments[:3]))
    return sorted(active)


@dataclass(frozen=True)
class AvailableUpdate:
    name: str
    installed: str
    available: str


@dataclass(frozen=True)
class UpdateCheckResult:
    provider: str
    updates: tuple[AvailableUpdate, ...] = ()


def parse_apt_updates(output: str) -> tuple[AvailableUpdate, ...]:
    updates: list[AvailableUpdate] = []
    for line in output.splitlines():
        match = re.match(
            r"^Inst\s+(\S+)(?:\s+\[([^\]]+)\])?\s+\((\S+)",
            line,
        )
        if not match:
            continue
        updates.append(
            AvailableUpdate(
                name=match.group(1),
                installed=match.group(2) or "not installed",
                available=match.group(3),
            )
        )
    return tuple(updates)


def parse_snap_rows(output: str) -> dict[str, str]:
    versions: dict[str, str] = {}
    for line in output.splitlines():
        fields = line.split()
        if len(fields) >= 2 and fields[0] != "Name":
            versions[fields[0]] = fields[1]
    return versions


def parse_brew_updates(output: str) -> tuple[AvailableUpdate, ...]:
    try:
        payload = json.loads(output or "{}")
    except json.JSONDecodeError as error:
        raise DotError(f"Homebrew returned invalid update metadata: {error}") from error
    updates: list[AvailableUpdate] = []
    for formula in payload.get("formulae", []):
        installed_versions = formula.get("installed_versions") or []
        updates.append(
            AvailableUpdate(
                name=str(formula.get("name", "unknown")),
                installed=", ".join(str(version) for version in installed_versions)
                or "not installed",
                available=str(formula.get("current_version") or "unknown"),
            )
        )
    return tuple(updates)


def check_apt_updates() -> UpdateCheckResult:
    result = run(
        ["apt-get", "--simulate", "dist-upgrade"],
        check=False,
        capture=True,
    )
    if result.returncode:
        raise DotError((result.stderr or result.stdout).strip() or "APT check failed.")
    return UpdateCheckResult("APT", parse_apt_updates(result.stdout))


def check_snap_updates() -> UpdateCheckResult:
    available_result = run(
        ["snap", "refresh", "--list"],
        check=False,
        capture=True,
    )
    output = (available_result.stdout or available_result.stderr).strip()
    if available_result.returncode and "All snaps up to date" not in output:
        raise DotError(output or "Snap check failed.")
    if "All snaps up to date" in output:
        return UpdateCheckResult("Snap")
    available = parse_snap_rows(output)
    if not available:
        return UpdateCheckResult("Snap")
    installed_result = run(["snap", "list"], check=False, capture=True)
    if installed_result.returncode:
        raise DotError(
            (installed_result.stderr or installed_result.stdout).strip()
            or "Could not read installed Snap versions."
        )
    installed = parse_snap_rows(installed_result.stdout)
    return UpdateCheckResult(
        "Snap",
        tuple(
            AvailableUpdate(name, installed.get(name, "unknown"), version)
            for name, version in sorted(available.items())
        ),
    )


def check_brew_updates() -> UpdateCheckResult:
    result = run(
        ["brew", "outdated", "--formula", "--json=v2"],
        check=False,
        capture=True,
    )
    if result.returncode:
        raise DotError(
            (result.stderr or result.stdout).strip() or "Homebrew check failed."
        )
    return UpdateCheckResult("Homebrew", parse_brew_updates(result.stdout))


def check_external_deb_update(name: str) -> UpdateCheckResult:
    result = run(
        [str(ROOT / "scripts/fetch-external-deb"), name],
        check=False,
        capture=True,
    )
    if result.returncode:
        raise DotError(
            (result.stderr or result.stdout).strip() or f"Could not check {name}."
        )
    package_path = Path(result.stdout.strip())
    package_name = run(
        ["dpkg-deb", "--field", str(package_path), "Package"],
        capture=True,
    ).stdout.strip()
    available = run(
        ["dpkg-deb", "--field", str(package_path), "Version"],
        capture=True,
    ).stdout.strip()
    installed_result = run(
        ["dpkg-query", "-W", "-f=${Version}", package_name],
        check=False,
        capture=True,
    )
    installed = (
        installed_result.stdout.strip()
        if installed_result.returncode == 0
        else "not installed"
    )
    newer = installed_result.returncode != 0 or run(
        ["dpkg", "--compare-versions", available, "gt", installed],
        check=False,
    ).returncode == 0
    updates = (
        (AvailableUpdate(name, installed, available),)
        if newer
        else ()
    )
    return UpdateCheckResult(f"External / {name}", updates)


def check_nvim_updates() -> UpdateCheckResult:
    with tempfile.TemporaryDirectory(prefix="dot-nvim-check-") as directory:
        _, candidate_lock = prepare_nvim_candidate(Path(directory))
        current = json.loads(NVIM_LOCK_FILE.read_text()) if NVIM_LOCK_FILE.exists() else {}
        candidate = json.loads(candidate_lock.read_text())
    updates: list[AvailableUpdate] = []
    for name in sorted(set(current) | set(candidate)):
        if current.get(name) == candidate.get(name):
            continue
        before = current.get(name) or {}
        after = candidate.get(name) or {}
        updates.append(
            AvailableUpdate(
                name=name,
                installed=str(before.get("commit") or "not locked")[:12],
                available=str(after.get("commit") or "removed")[:12],
            )
        )
    return UpdateCheckResult("Neovim plugins", tuple(updates))


def parse_codex_release_version(output: str) -> str:
    try:
        payload = json.loads(output)
    except json.JSONDecodeError as error:
        raise DotError(f"Codex returned invalid release metadata: {error}") from error
    tag = str(payload.get("tag_name") or "")
    version = tag.removeprefix("rust-v")
    if not re.fullmatch(r"\d+\.\d+\.\d+(?:[-+][A-Za-z0-9.-]+)?", version):
        raise DotError("Codex release metadata did not contain a stable version.")
    return version


def check_codex_updates() -> UpdateCheckResult:
    codex = Path.home() / ".local/bin/codex"
    installed = "not installed"
    if codex.is_file() or codex.is_symlink():
        result = run([str(codex), "--version"], check=False, capture=True)
        if result.returncode:
            raise DotError((result.stderr or result.stdout).strip() or "Codex version check failed.")
        match = re.search(r"(\d+\.\d+\.\d+(?:[-+][A-Za-z0-9.-]+)?)", result.stdout)
        if not match:
            raise DotError("The installed Codex CLI did not report a version.")
        installed = match.group(1)
    metadata = run(
        [
            "curl",
            "--proto", "=https",
            "--tlsv1.2",
            "--fail",
            "--location",
            "--silent",
            "--show-error",
            "https://releases.openai.com/codex/channels/latest",
        ],
        check=False,
        capture=True,
        timeout=30,
    )
    if metadata.returncode:
        raise DotError((metadata.stderr or metadata.stdout).strip() or "Codex release check failed.")
    available = parse_codex_release_version(metadata.stdout)
    updates = () if installed == available else (
        AvailableUpdate("codex", installed, available),
    )
    return UpdateCheckResult("Codex CLI", updates)


def strip_ansi(text: str) -> str:
    return re.sub(r"\x1b\[[0-?]*[ -/]*[@-~]", "", text)


def check_vite_plus_updates() -> UpdateCheckResult:
    vp = Path.home() / ".vite-plus/bin/vp"
    if not vp.exists():
        raise DotError(f"Vite+ is missing at {vp}.")
    result = run([str(vp), "upgrade", "--check"], check=False, capture=True, timeout=60)
    output = strip_ansi("\n".join(part for part in (result.stdout, result.stderr) if part))
    if result.returncode:
        raise DotError(output.strip() or "Vite+ update check failed.")
    match = re.search(r"found vite-plus@(\S+) \(current: (\S+)\)", output)
    if not match:
        raise DotError("Vite+ did not report its current and available versions.")
    available, installed = match.groups()
    updates = () if installed == available else (
        AvailableUpdate("vite-plus", installed, available),
    )
    return UpdateCheckResult("Vite+", updates)


def render_update_result(result: UpdateCheckResult, elapsed: float) -> int:
    if not result.updates:
        print(f"[OK] {result.provider}: up to date ({elapsed:.1f}s)", flush=True)
        return 0
    print(
        f"[UPDATES] {result.provider}: {len(result.updates)} available "
        f"({elapsed:.1f}s)",
        flush=True,
    )
    width = max(len(update.name) for update in result.updates)
    for update in result.updates:
        print(
            f"  {update.name:<{width}}  {update.installed} -> {update.available}",
            flush=True,
        )
    return len(result.updates)


def report_pending_updates(profile: dict[str, Any], *, system: bool, apps: bool) -> None:
    checks: list[tuple[str, Callable[[], UpdateCheckResult]]] = []
    skipped: list[str] = []
    if system:
        if command_exists("apt-get"):
            checks.append(("APT", check_apt_updates))
        else:
            skipped.append("APT (apt-get is unavailable)")
    if apps:
        for provider, command, callback in (
            ("Snap", "snap", check_snap_updates),
            ("Homebrew", "brew", check_brew_updates),
        ):
            if command_exists(command):
                checks.append((provider, callback))
            else:
                skipped.append(f"{provider} ({command} is unavailable)")
        if profile.get("packages", {}).get("deb"):
            if command_exists("dpkg-deb") and command_exists("dpkg-query"):
                for name in profile["packages"]["deb"]:
                    checks.append(
                        (
                            f"External / {name}",
                            lambda package=name: check_external_deb_update(package),
                        )
                    )
            else:
                skipped.append("External Debian applications (dpkg tools unavailable)")
        if profile.get("features", {}).get("neovim"):
            if command_exists("nvim"):
                checks.append(("Neovim plugins", check_nvim_updates))
            else:
                skipped.append("Neovim plugins (nvim is unavailable)")
        if profile.get("features", {}).get("codex_remote_control"):
            if command_exists("curl"):
                checks.append(("Codex CLI", check_codex_updates))
            else:
                skipped.append("Codex CLI (curl is unavailable)")
        if profile.get("features", {}).get("vite_plus"):
            if (Path.home() / ".vite-plus/bin/vp").exists():
                checks.append(("Vite+", check_vite_plus_updates))
            else:
                skipped.append("Vite+ (managed command is unavailable)")

    for detail in skipped:
        print(f"[SKIP] {detail}", flush=True)
    if not checks:
        print("No supported update providers are available for this scope.")
        return

    started = time.monotonic()
    print(
        f"Checking {len(checks)} providers in parallel; results appear as they finish.",
        flush=True,
    )
    pending = 0
    failures: list[str] = []
    with ThreadPoolExecutor(
        max_workers=len(checks),
        thread_name_prefix="dot-update",
    ) as executor:
        submitted = {
            executor.submit(callback): (provider, time.monotonic())
            for provider, callback in checks
        }
        for future in as_completed(submitted):
            provider, provider_started = submitted[future]
            elapsed = time.monotonic() - provider_started
            try:
                pending += render_update_result(future.result(), elapsed)
            except Exception as error:
                failures.append(provider)
                print(f"[FAIL] {provider}: {error} ({elapsed:.1f}s)", flush=True)

    total_elapsed = time.monotonic() - started
    print(
        f"Summary: {pending} update(s), {len(checks) - len(failures)} successful "
        f"check(s), {len(failures)} failed ({total_elapsed:.1f}s).",
        flush=True,
    )
    if failures:
        raise DotError("Update checks failed: " + ", ".join(failures))


def update_profile(explicit: str | None) -> str:
    if explicit:
        return explicit
    detected = infer_platform()
    if detected == "linux":
        device = ensure_device()
        inferred = inferred_device_id()
        if device != inferred:
            raise DotError(
                "Refusing automatic profile selection because this computer's "
                f"hostname implies `{inferred}`, but its dotfiles identity is "
                f"`{device}`. Another device's profile must not be applied here. "
                "Choose the correct profile explicitly for this run, then repair "
                "the device identity through the managed device workflow."
            )
        manifest = load_device_manifest(device)
        return manifest["profile"] if manifest else "kubuntu-laptop"
    defaults = {
        "termux": "termux",
        "windows": "windows-host",
    }
    if detected in defaults:
        return defaults[detected]
    raise DotError(
        "This host has more than one applicable profile. "
        "Choose --profile wsl-personal or --profile wsl-work."
    )


def cmd_update(args: argparse.Namespace) -> None:
    profile_name = update_profile(getattr(args, "profile", None))
    profile = load_profile(profile_name)
    if profile.get("features", {}).get("windows_inventory_only"):
        raise DotError(
            "Windows is inventory-only; update applications with their native "
            "stable channels, then recapture the inventory."
        )
    system = bool(getattr(args, "system", False))
    apps = bool(getattr(args, "apps", False))
    if not system and not apps:
        system = apps = True
    if getattr(args, "check", False):
        report_pending_updates(profile, system=system, apps=apps)
        return
    blockers = active_package_transactions()
    if blockers:
        raise DotError(
            "Another package-manager transaction is already running:\n  "
            + "\n  ".join(blockers)
            + "\nWait for it to finish before running dot update."
        )
    selected_tags = []
    if system:
        selected_tags.append("system-updates")
    if apps:
        selected_tags.append("app-updates")
    cmd_apply(
        argparse.Namespace(
            profile=profile_name,
            tags=",".join(selected_tags),
            check=False,
            direct=False,
            force_kde=False,
        )
    )
    if apps and profile.get("features", {}).get("codex_remote_control"):
        cmd_codex_update(args)
    if apps and profile.get("features", {}).get("vite_plus"):
        cmd_vite_plus_update(args)
    if apps and profile.get("features", {}).get("shell"):
        cmd_transcribe_update(args)
    if apps and profile.get("features", {}).get("neovim"):
        cmd_nvim(
            argparse.Namespace(
                nvim_action="update",
                profile=profile_name,
                check=False,
                run_id=None,
            )
        )
        update_nvim_tools()
    categories = "system and application" if system and apps else (
        "system" if system else "application"
    )
    print(f"Updated all installed {categories} packages for {profile['name']}.")


def nvim_environment(root: Path | None = None) -> dict[str, str]:
    env = os.environ.copy()
    path_parts = env.get("PATH", "").split(os.pathsep)
    if str(LINUXBREW_BIN) not in path_parts:
        env["PATH"] = os.pathsep.join([str(LINUXBREW_BIN), *path_parts])
    if root is not None:
        env.update(
            {
                "XDG_CONFIG_HOME": str(root / "config"),
                "XDG_DATA_HOME": str(root / "data"),
                "XDG_STATE_HOME": str(root / "state"),
                "XDG_CACHE_HOME": str(root / "cache"),
            }
        )
    return env


def run_nvim_smoke(*, env: dict[str, str] | None = None) -> None:
    require_commands(["nvim"], "Run `dot apply --profile PROFILE --tags packages,nvim` first.")
    config_home = Path((env or os.environ).get("XDG_CONFIG_HOME", Path.home() / ".config"))
    smoke = config_home / "nvim/tests/smoke.lua"
    run(
        [
            "nvim",
            "--headless",
            "+lua vim.g.dovie_headless=true",
            f"+lua dofile({json.dumps(str(smoke))})",
            "+qa",
        ],
        env=env or nvim_environment(),
        capture=True,
        timeout=180,
    )


def prepare_nvim_candidate(root: Path) -> tuple[dict[str, str], Path]:
    candidate = root / "config/nvim"
    candidate.parent.mkdir(parents=True, exist_ok=True)
    shutil.copytree(NVIM_CONFIG_DIR, candidate)
    env = nvim_environment(root)
    run(
        ["nvim", "--headless", "+Lazy! update", "+qa"],
        env=env,
        capture=True,
        timeout=600,
    )
    if command_exists("stylua"):
        run(
            ["stylua", "--check", "init.lua", "lua", "tests"],
            cwd=candidate,
            env=env,
            capture=True,
        )
    run_nvim_smoke(env=env)
    return env, candidate / "lazy-lock.json"


def nvim_git_environment() -> dict[str, str]:
    env = os.environ.copy()
    if env.get("SSH_AUTH_SOCK") and Path(env["SSH_AUTH_SOCK"]).is_socket():
        return env
    candidates = (
        Path.home() / ".bitwarden-ssh-agent.sock",
        Path.home() / "snap/bitwarden/current/.bitwarden-ssh-agent.sock",
    )
    active = next((path for path in candidates if path.is_socket()), None)
    if active:
        env["SSH_AUTH_SOCK"] = str(active)
    return env


def require_clean_publishable_repo() -> None:
    status = run(["git", "status", "--porcelain"], cwd=ROOT, capture=True).stdout.strip()
    if status:
        raise DotError(
            "Neovim plugin publishing requires a clean dotfiles repository. "
            "Commit or discard the current changes first."
        )
    upstream = run(
        ["git", "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{upstream}"],
        cwd=ROOT,
        check=False,
        capture=True,
    )
    if upstream.returncode:
        raise DotError("The current dotfiles branch has no upstream tracking branch.")
    run(["git", "fetch", "--quiet"], cwd=ROOT, env=nvim_git_environment())
    local = run(["git", "rev-parse", "HEAD"], cwd=ROOT, capture=True).stdout.strip()
    remote = run(["git", "rev-parse", "@{upstream}"], cwd=ROOT, capture=True).stdout.strip()
    if local != remote:
        raise DotError(
            "The dotfiles branch is not synchronized with its upstream. "
            "Pull or push the existing commits before updating Neovim plugins."
        )


def save_nvim_lock_backup() -> str:
    run_id = dt.datetime.now().strftime("%Y%m%d-%H%M%S-%f")
    destination = NVIM_UPDATE_DIR / run_id
    destination.mkdir(parents=True, exist_ok=True)
    if NVIM_LOCK_FILE.exists():
        shutil.copy2(NVIM_LOCK_FILE, destination / "lazy-lock.json")
    atomic_text(
        destination / "metadata.json",
        json.dumps(
            {
                "schema_version": 1,
                "run_id": run_id,
                "created_at": dt.datetime.now(dt.timezone.utc).isoformat(),
                "head": run(["git", "rev-parse", "HEAD"], cwd=ROOT, capture=True).stdout.strip(),
            },
            indent=2,
        )
        + "\n",
        0o600,
    )
    return run_id


def publish_nvim_lock(message: str) -> None:
    changed = run(
        ["git", "status", "--porcelain", "--", str(NVIM_LOCK_FILE)],
        cwd=ROOT,
        capture=True,
    ).stdout.strip()
    other = run(
        ["git", "status", "--porcelain", "--", ".", f":(exclude){NVIM_LOCK_FILE.relative_to(ROOT)}"],
        cwd=ROOT,
        capture=True,
    ).stdout.strip()
    if not changed or other:
        raise DotError(
            "Refusing the automatic Neovim commit because the lockfile is not "
            "the repository's only change."
        )
    env = nvim_git_environment()
    run(["git", "add", str(NVIM_LOCK_FILE)], cwd=ROOT)
    run(["git", "commit", "-m", message], cwd=ROOT, env=env)
    run(["git", "push"], cwd=ROOT, env=env)


def restore_live_nvim_plugins() -> None:
    run(
        ["nvim", "--headless", "+Lazy! restore", "+qa"],
        env=nvim_environment(),
        capture=True,
        timeout=600,
    )
    run_nvim_smoke()


def update_nvim_tools() -> None:
    require_commands(
        ["nvim"],
        "Run `dot apply --profile PROFILE --tags packages,nvim` first.",
    )
    run(
        [
            "nvim",
            "--headless",
            "+Lazy! load nvim-lspconfig",
            "+MasonToolsUpdateSync",
            "+qa",
        ],
        env=nvim_environment(),
        timeout=1800,
    )
    run_nvim_smoke()
    print("Updated and verified Neovim's curated Mason language tools.")


def cmd_nvim(args: argparse.Namespace) -> None:
    profile_name = update_profile(getattr(args, "profile", None))
    profile = load_profile(profile_name)
    if not profile.get("features", {}).get("neovim"):
        raise DotError(f"Neovim is not enabled for {profile_name}.")
    action = args.nvim_action
    if action == "status":
        run_nvim_smoke()
        print("Neovim configuration and locked plugins passed the smoke test.")
        return
    if action == "tools":
        update_nvim_tools()
        return
    if action == "rollback":
        root = NVIM_UPDATE_DIR / args.run_id
        backup = root / "lazy-lock.json"
        if not backup.is_file():
            raise DotError(f"No Neovim plugin backup exists for {args.run_id}.")
        require_clean_publishable_repo()
        current = NVIM_LOCK_FILE.read_bytes()
        head_before = run(["git", "rev-parse", "HEAD"], cwd=ROOT, capture=True).stdout.strip()
        try:
            atomic_bytes(NVIM_LOCK_FILE, backup.read_bytes())
            restore_live_nvim_plugins()
            publish_nvim_lock(f"rollback Neovim plugins to {args.run_id}")
        except Exception:
            head_after = run(["git", "rev-parse", "HEAD"], cwd=ROOT, capture=True).stdout.strip()
            if head_after == head_before:
                run(
                    ["git", "restore", "--staged", "--", str(NVIM_LOCK_FILE)],
                    cwd=ROOT,
                    check=False,
                )
                atomic_bytes(NVIM_LOCK_FILE, current)
                restore_live_nvim_plugins()
            raise
        print(f"Restored, tested, committed, and pushed Neovim plugin lock {args.run_id}.")
        return

    publish = profile.get("account") != "work"
    if publish and not getattr(args, "check", False):
        require_clean_publishable_repo()
    with tempfile.TemporaryDirectory(prefix="dot-nvim-") as directory:
        _, candidate_lock = prepare_nvim_candidate(Path(directory))
        current = NVIM_LOCK_FILE.read_bytes() if NVIM_LOCK_FILE.exists() else b""
        candidate = candidate_lock.read_bytes()
    if candidate == current:
        print("Neovim plugins already match the latest compatible releases.")
        if not getattr(args, "check", False):
            restore_live_nvim_plugins()
        return
    if getattr(args, "check", False):
        before = json.loads(current or b"{}")
        after = json.loads(candidate)
        changed = sorted(
            name for name in set(before) | set(after) if before.get(name) != after.get(name)
        )
        print(f"Neovim plugins: {len(changed)} update(s) — {', '.join(changed)}")
        return
    if not publish:
        restore_live_nvim_plugins()
        print(
            "The work profile consumes the repository lockfile; plugin publishing "
            "is disabled on this profile."
        )
        return

    run_id = save_nvim_lock_backup()
    head_before = run(["git", "rev-parse", "HEAD"], cwd=ROOT, capture=True).stdout.strip()
    try:
        atomic_bytes(NVIM_LOCK_FILE, candidate)
        restore_live_nvim_plugins()
        run([str(ROOT / "tests/run")], cwd=ROOT)
        publish_nvim_lock("update Neovim plugins")
    except Exception:
        head_after = run(["git", "rev-parse", "HEAD"], cwd=ROOT, capture=True).stdout.strip()
        if head_after == head_before:
            run(
                ["git", "restore", "--staged", "--", str(NVIM_LOCK_FILE)],
                cwd=ROOT,
                check=False,
            )
            backup = NVIM_UPDATE_DIR / run_id / "lazy-lock.json"
            if backup.exists():
                atomic_bytes(NVIM_LOCK_FILE, backup.read_bytes())
                restore_live_nvim_plugins()
        raise
    print(f"Updated, tested, committed, and pushed Neovim plugins. Rollback ID: {run_id}")


def cmd_capture_kde(args: argparse.Namespace) -> None:
    selected = set(args.only or [])
    known_names = {Path(relative).name for relative in KDE_FILES}
    unknown = selected - known_names
    if unknown:
        raise DotError(
            "Unknown KDE capture file(s): "
            + ", ".join(sorted(unknown))
            + ". Choose from: "
            + ", ".join(sorted(known_names))
        )
    captured = 0
    for relative in KDE_FILES:
        if selected and Path(relative).name not in selected:
            continue
        source = Path.home() / relative
        if source.is_file():
            destination = kde_source(relative)
            content = portable_kde_content(relative, source.read_bytes())
            if relative in {PANEL_LAYOUT_FILE, PANEL_GEOMETRY_FILE}:
                content = portable_kde_content(
                    relative,
                    render_panel_profile(
                        relative,
                        content,
                        default_panel_profile(),
                    ),
                )
            captured += int(atomic_bytes(destination, content))
    record_kde_baseline()
    print(f"Captured {captured} changed KDE file(s). Display topology, wallets, caches, and history were excluded.")


def kde_file_diff(relative: str) -> list[str]:
    expected = kde_source(relative)
    actual = Path.home() / relative
    if not expected.exists() and not actual.exists():
        return []
    left = (
        portable_kde_content(relative, expected_kde_content(relative))
        .decode("utf-8", errors="replace")
        .splitlines(True)
        if expected.exists()
        else []
    )
    right = (
        portable_kde_content(relative, actual.read_bytes())
        .decode("utf-8", errors="replace")
        .splitlines(True)
        if actual.exists()
        else []
    )
    return list(
        difflib.unified_diff(
            left,
            right,
            fromfile=str(expected),
            tofile=str(actual),
        )
    )


def fzf_choose(
    rows: list[str],
    *,
    prompt: str,
    header: str = "",
    multi: bool = False,
    preview: str | None = None,
    with_nth: str = "1",
) -> list[str]:
    require_commands(["fzf"], "Install fzf, then rerun the command.")
    command = [
        "fzf",
        "--height=85%",
        "--layout=reverse",
        "--border=rounded",
        "--input-label= Search ",
        "--list-label= Actions ",
        f"--prompt={prompt}",
        "--delimiter=\t",
        f"--with-nth={with_nth}",
    ]
    if header:
        command.extend(["--header", header])
    if multi:
        command.extend(
            [
                "--multi",
                "--bind=ctrl-a:select-all,ctrl-d:deselect-all",
            ]
        )
    if preview:
        command.extend(
            [
                "--preview",
                preview,
                "--preview-window=right,65%,border-left",
                "--preview-label= Details ",
                "--bind=ctrl-/:toggle-preview",
            ]
        )
    proc = subprocess.run(
        command,
        input="\n".join(rows) + "\n",
        text=True,
        stdout=subprocess.PIPE,
        check=False,
    )
    if proc.returncode in (1, 130):
        return []
    if proc.returncode:
        raise DotError(f"fzf failed with exit code {proc.returncode}")
    return [line for line in proc.stdout.splitlines() if line]


def fzf_menu(
    items: list[tuple[str, str, str]],
    *,
    prompt: str,
    header: str = "Enter: select  Esc: back",
) -> str | None:
    """Show described actions while keeping their stable identifiers hidden."""
    if not items:
        return None
    width = min(38, max(len(label) for _, label, _ in items))
    rows = [
        f"{action}\t{label:<{width}}\t{description}"
        for action, label, description in items
    ]
    choice = fzf_choose(
        rows,
        prompt=prompt,
        header=f"{'ACTION':<{width}}  DESCRIPTION  ·  {header}",
        with_nth="2,3",
    )
    return choice[0].split("\t", 1)[0] if choice else None


def palette_pause() -> None:
    if sys.stdin.isatty():
        try:
            input("\nPress Enter to return to the menu… ")
        except EOFError:
            pass


def palette_execute(action: Any, *, pause: bool = True) -> bool:
    """Run a menu action without losing the surrounding navigation."""
    try:
        action()
    except DotError as exc:
        print(f"\ndot: {exc}", file=sys.stderr)
    except subprocess.CalledProcessError as exc:
        command = exc.cmd if isinstance(exc.cmd, list) else [str(exc.cmd)]
        rendered = " ".join(map(str, command))
        print(
            f"\ndot: {rendered} failed with exit code {exc.returncode}",
            file=sys.stderr,
        )
    except KeyboardInterrupt:
        print("\nCancelled.")
    if pause:
        palette_pause()
    return True


PROFILE_DESCRIPTIONS = {
    "kubuntu-laptop": "Native Kubuntu laptop with KDE and hardware integration",
    "kubuntu-desktop": "Native Kubuntu desktop with shared KDE workstation policy",
    "wsl-personal": "Personal Ubuntu environment inside Windows",
    "wsl-work": "Work Ubuntu environment inside Windows",
    "windows-host": "Inventory-only native Windows host",
    "termux": "Android Termux environment",
    "common-linux": "Shared Linux base manifest; not a physical machine",
}


def palette_profile(*, include_common: bool = False) -> str | None:
    names = sorted(
        path.stem
        for path in PROFILE_DIR.glob("*.yml")
        if include_common or path.stem != "common-linux"
    )
    return fzf_menu(
        [
            (
                name,
                name,
                PROFILE_DESCRIPTIONS.get(name, "Managed dotfiles profile"),
            )
            for name in names
        ],
        prompt="profile › ",
    )


def palette_text(label: str, *, default: str = "") -> str | None:
    suffix = f" [{default}]" if default else ""
    try:
        value = input(f"{label}{suffix}: ").strip()
    except (EOFError, KeyboardInterrupt):
        print()
        return None
    return value or default or None


def palette_confirm(label: str, description: str) -> bool:
    return (
        fzf_menu(
            [
                ("confirm", label, description),
                ("cancel", "Cancel", "Return without making changes"),
            ],
            prompt="confirm › ",
            header="Enter: choose  Esc: cancel",
        )
        == "confirm"
    )


def palette_backup_run_id(root: Path, *, prompt: str) -> str | None:
    items: list[tuple[str, str, str]] = []
    if root.is_dir():
        for path in sorted(root.iterdir(), reverse=True):
            if not path.is_dir():
                continue
            metadata_path = path / "metadata.json"
            manifest_path = path / "manifest.json"
            if metadata_path.is_file():
                metadata = load_json(metadata_path)
                detail = (
                    f"Created {metadata.get('created_at', 'unknown')} · "
                    f"base commit {str(metadata.get('head', 'unknown'))[:12]}"
                )
            elif manifest_path.is_file():
                manifest = load_json(manifest_path)
                targets = ", ".join(
                    Path(record.get("path", "")).name or record.get("path", "")
                    for record in manifest[:3]
                )
                if len(manifest) > 3:
                    targets += f", and {len(manifest) - 3} more"
                detail = f"Restore {len(manifest)} path(s) · {targets}"
            else:
                continue
            items.append((path.name, path.name, detail))
    if not items:
        print("No rollback snapshots are available.")
        palette_pause()
        return None
    return fzf_menu(items, prompt=prompt)


def palette_kde_files(*, prompt: str) -> list[str]:
    rows = [
        (
            Path(relative).name,
            KDE_LABELS[relative],
            str(Path.home() / relative),
        )
        for relative in KDE_FILES
    ]
    width = max(len(label) for _, label, _ in rows)
    choices = fzf_choose(
        [
            f"{name}\t{label:<{width}}\t{path}"
            for name, label, path in rows
        ],
        prompt=prompt,
        header=(
            f"{'SETTING':<{width}}  LIVE FILE  ·  "
            "Tab: toggle  Ctrl-A: all  Ctrl-D: none  Enter: continue"
        ),
        multi=True,
        with_nth="2,3",
    )
    return [choice.split("\t", 1)[0] for choice in choices]


def save_commit_message(selected: list[str]) -> str:
    labels = [KDE_LABELS[relative].lower() for relative in selected]
    if len(labels) == 1:
        return f"update {labels[0]}"
    if len(labels) == 2:
        return f"update {labels[0]} and {labels[1]}"
    return "update KDE settings"


def cmd_save(args: argparse.Namespace) -> None:
    preset = {
        "panel": {
            ".config/kdeglobals",
            ".config/kglobalshortcutsrc",
            ".config/krunnerrc",
            ".config/plasmarc",
            ".config/plasmashellrc",
            ".config/plasma-org.kde.plasma.desktop-appletsrc",
            ".local/share/color-schemes/GitHubDark.colors",
        },
        "spectacle": {
            ".config/spectaclerc",
            ".config/kglobalshortcutsrc",
        },
    }
    allowed = preset.get(args.target, set(KDE_FILES))
    drift: dict[str, list[str]] = {}
    for relative in KDE_FILES:
        if relative not in allowed:
            continue
        diff = kde_file_diff(relative)
        if diff:
            drift[relative] = diff
    if not drift:
        print("No managed configuration changes to save.")
        return

    if args.yes:
        selected = list(drift)
        action = "save"
    else:
        if not sys.stdin.isatty():
            raise DotError("Interactive selection is unavailable; rerun with --yes.")
        with tempfile.TemporaryDirectory(prefix="dot-fzf-") as directory:
            rows: list[str] = []
            for index, (relative, diff) in enumerate(drift.items()):
                preview_path = Path(directory) / f"{index}.diff"
                preview_path.write_text("".join(diff), encoding="utf-8")
                rows.append(
                    "\t".join(
                        [
                            KDE_LABELS[relative],
                            Path(relative).name,
                            str(preview_path),
                            relative,
                        ]
                    )
                )
            choices = fzf_choose(
                rows,
                prompt="Settings to save › ",
                header="Tab: toggle  Ctrl-A: all  Ctrl-D: none  Enter: continue",
                multi=True,
                preview="delta --paging=never < {3}",
                with_nth="1,2",
            )
            selected = [choice.split("\t", 3)[3] for choice in choices]
        if not selected:
            print("Nothing selected.")
            return
        action = fzf_menu(
            [
                (
                    "save",
                    "Save, validate, commit, and push",
                    "Record the selected live settings as the new source of truth",
                ),
                (
                    "capture",
                    "Capture without committing",
                    "Copy settings into dotfiles for manual review",
                ),
                ("cancel", "Cancel", "Leave live and repository settings unchanged"),
            ],
            prompt="Action › ",
            header="Enter: choose  Esc: cancel",
        )
        action = action or "cancel"
        if action == "cancel":
            print("Save cancelled.")
            return

    names = [Path(relative).name for relative in selected]
    paths = [kde_source(relative) for relative in selected]
    dirty_targets = run(
        ["git", "status", "--porcelain", "--", *map(str, paths)],
        cwd=ROOT,
        capture=True,
    ).stdout.strip()
    if dirty_targets:
        raise DotError(
            "Selected dotfiles already have uncommitted repository changes:\n"
            f"{dirty_targets}\nReview or commit them before capturing live state."
        )
    if action == "save":
        staged = run(["git", "diff", "--cached", "--quiet"], cwd=ROOT, check=False)
        if staged.returncode:
            raise DotError(
                "The Git index already contains staged changes. "
                "Commit or unstage them before saving settings."
            )

    originals = {
        path: path.read_bytes() if path.exists() else None
        for path in paths
    }
    cmd_capture_kde(argparse.Namespace(only=names))
    if action == "capture":
        print("Captured selected settings in dotfiles; they remain uncommitted.")
        return

    validation = run([str(ROOT / "tests/run")], cwd=ROOT, check=False)
    if validation.returncode:
        restore_captured_files(originals)
        record_kde_baseline()
        raise DotError("Validation failed; the repository capture was rolled back.")
    run(["git", "add", "--", *map(str, paths)], cwd=ROOT)
    run(["git", "commit", "-m", save_commit_message(selected)], cwd=ROOT)
    run(["git", "push"], cwd=ROOT)
    print("Saved and pushed the selected settings.")


def restore_captured_files(originals: dict[Path, bytes | None]) -> None:
    for path, content in originals.items():
        if content is None:
            if path.exists() or path.is_symlink():
                path.unlink()
        else:
            atomic_bytes(path, content)


def cmd_diff_kde(_args: argparse.Namespace) -> None:
    differences = 0
    output: list[str] = []
    for relative in KDE_FILES:
        diff = kde_file_diff(relative)
        if diff:
            differences += 1
            output.extend(diff)
    if differences:
        rendered = "".join(output)
        if command_exists("delta") and sys.stdout.isatty():
            proc = subprocess.run(
                ["delta", "--paging=always"],
                input=rendered,
                text=True,
                check=False,
            )
            if proc.returncode not in (0, 1):
                raise DotError(f"delta failed with exit code {proc.returncode}")
        else:
            sys.stdout.write(rendered)
        raise DotError(f"KDE drift found in {differences} file(s)")
    print("KDE allowlist matches.")


def cmd_lockscreen(args: argparse.Namespace) -> None:
    if args.lockscreen_action == "preview":
        link_file(LOCKSCREEN_PACKAGE_SOURCE, LOCKSCREEN_PACKAGE_DESTINATION)
        greeter = lockscreen_greeter_path()
        if greeter is None:
            raise DotError(
                "KScreenLocker greeter is unavailable; install plasma-workspace."
            )
        print("Opening the managed lock screen in KDE's non-locking test mode.")
        run(
            [
                str(greeter),
                "--testing",
                "--shell",
                LOCKSCREEN_PACKAGE_ID,
            ]
        )
        return

    if args.lockscreen_action == "stock":
        config = Path.home() / ".config/plasmashellrc"
        run_id = backup_paths([config])
        run(
            [
                "kwriteconfig6",
                "--file",
                "plasmashellrc",
                "--group",
                "Shell",
                "--key",
                "ShellPackage",
                "org.kde.plasma.desktop",
            ]
        )
        print(
            "Restored KDE's stock lock screen for future locks. "
            f"Backup created: {run_id}. Reapply the lockscreen tag to return "
            "to the managed theme."
        )
        return

    raise DotError(f"Unknown lock-screen action: {args.lockscreen_action}")


def cmd_rollback(args: argparse.Namespace) -> None:
    restore_backup(args.run_id)
    print(f"Restored backup {args.run_id}")


def kconfig_get(content: bytes, section: str, key: str) -> str | None:
    current = ""
    for line in content.decode("utf-8", errors="replace").splitlines():
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            current = stripped[1:-1]
        elif current == section and "=" in line:
            candidate, value = line.split("=", 1)
            if candidate.strip() == key:
                return value.strip()
    return None


def plasma_evaluate(script: str) -> str:
    if not command_exists("qdbus6"):
        raise DotError("qdbus6 is required to manage the live Plasma panel.")
    proc = run(
        [
            "qdbus6",
            "org.kde.plasmashell",
            "/PlasmaShell",
            "org.kde.PlasmaShell.evaluateScript",
            script,
        ],
        check=False,
        capture=True,
    )
    if proc.returncode:
        raise DotError(
            "Plasma rejected the panel script: "
            + (proc.stderr.strip() or f"exit code {proc.returncode}")
        )
    return proc.stdout.strip()


def panel_profile_script(profile_name: str) -> str:
    manifest = panel_manifest()
    profile = manifest["profiles"][profile_name]
    tray_policy = manifest["tray"]
    task_plugin = (
        "org.kde.plasma.taskmanager"
        if profile["task_manager"] == "labels"
        else "org.kde.plasma.icontasks"
    )
    length = (
        round(panel_screen_width() * profile["width_percent"] / 100)
        if profile["length_mode"] == "custom"
        else 0
    )
    values = {
        "profile": profile_name,
        "task": task_plugin,
        "height": profile["height"],
        "length_mode": profile["length_mode"],
        "length": length,
        "floating": profile["floating"],
        "spacers": profile["spacers"],
        "show_date": profile["show_date"],
        "launcher_icon": (
            str(ROOT / "config/kde/assets/windows11-launcher.svg")
            if manifest["launcher_icon"] == "windows11"
            else manifest["launcher_icon"]
        ),
        "tray_shown": ",".join(tray_policy["shown_items"]),
        "tray_hidden": ",".join(tray_policy["hidden_items"]),
        "tray_extra": ",".join(tray_policy["extra_items"]),
        "launchers": ",".join(manifest["launchers"]),
    }
    data = json.dumps(values)
    return f"""
const cfg = {data};
const oldPanels = panels();
// Preserve the user's live pinned applications and their drag-selected order
// when changing only the panel's visual profile. The manifest remains the
// fallback for a fresh installation, and `dot panel save` records live edits.
let launchers = cfg.launchers;
for (let i = 0; i < oldPanels.length; ++i) {{
    const oldTasks = oldPanels[i].widgets("org.kde.plasma.taskmanager").concat(
        oldPanels[i].widgets("org.kde.plasma.icontasks")
    );
    if (oldTasks.length) {{
        oldTasks[0].currentConfigGroup = ["General"];
        const liveLaunchers = oldTasks[0].readConfig("launchers", "");
        if (liveLaunchers) launchers = liveLaunchers;
        break;
    }}
}}
// Migrate the old launcher ID. That ID matched windows on other desktops, so
// Plasma intercepted clicks before our desktop-aware launcher could run.
launchers = launchers.replace(
    "applications:obsidian.desktop",
    "applications:dot-obsidian.desktop"
);
const panel = new Panel;
panel.location = "bottom";
panel.hiding = "autohide";
// Keep custom-width and fit-content panels centered on the screen, while the
// widgets inside every panel start at the left edge.
panel.alignment = "center";
panel.height = cfg.height;
panel.lengthMode = cfg.length_mode;
panel.offset = 0;
panel.floating = cfg.floating;
if (cfg.length_mode === "custom") {{
    panel.minimumLength = cfg.length;
    panel.maximumLength = cfg.length;
}}

function configure(widget, group, values) {{
    widget.currentConfigGroup = group;
    for (const key in values) widget.writeConfig(key, values[key]);
    widget.reloadConfig();
}}

// Plasma 6 can silently ignore index changes on existing locked panels. Build
// the replacement in final visual order so widgetIds and AppletOrder agree.
const kickoff = panel.addWidget("org.kde.plasma.kickoff");
configure(kickoff, ["General"], {{
    icon: cfg.launcher_icon,
    showAppsByName: "true",
    systemFavorites: "suspend\\\\,hibernate\\\\,reboot\\\\,shutdown"
}});
kickoff.globalShortcut = "Alt+F1";

const task = panel.addWidget(cfg.task);
configure(task, [], {{launchers: launchers}});
configure(task, ["General"], {{
    groupPopups: "true",
    groupingStrategy: "1",
    launchers: launchers,
    middleClickAction: "Close",
    onlyGroupWhenFull: "false",
    // Icon Tasks keeps pinned applications in their launcher positions when a
    // matching window opens. That gives every virtual desktop one stable,
    // manually draggable application order while still filtering its windows.
    separateLaunchers: "true",
    // Plasma's manual mode is 1. Mode 0 disables sorting *and* drag-reordering.
    sortingStrategy: "1",
    // Show running windows only on their virtual desktop. Pinned launchers keep
    // their manual order; KWin rules independently make rare apps global.
    showOnlyCurrentDesktop: "true",
    showOnlyCurrentScreen: "false",
    wheelEnabled: "false"
}});

let secondSpacer = null;
if (cfg.spacers) {{
    secondSpacer = panel.addWidget("org.kde.plasma.panelspacer");
    configure(secondSpacer, ["General"], {{expanding: "true"}});
}}

const tray = panel.addWidget("org.kde.plasma.systemtray");
configure(tray, ["General"], {{
    extraItems: cfg.tray_extra,
    knownItems: cfg.tray_extra,
    hiddenItems: cfg.tray_hidden,
    shownItems: cfg.tray_shown
}});
const clock = panel.addWidget("org.kde.plasma.digitalclock");
configure(clock, ["Appearance"], {{
    dateDisplayFormat: "BelowTime",
    dateFormat: "shortDate",
    showDate: cfg.show_date ? "true" : "false",
    showSeconds: "false"
}});

// Remove old panels only after the complete replacement exists.
for (let i = 0; i < oldPanels.length; ++i) oldPanels[i].remove();

const ds = desktops();
for (let i = 0; i < ds.length; ++i) {{
    ds[i].wallpaperPlugin = "org.kde.color";
    ds[i].currentConfigGroup = ["Wallpaper", "org.kde.color", "General"];
    ds[i].writeConfig("Color", "0,0,0");
    // Folder View is Kubuntu's default desktop containment. An allow-only
    // pattern that cannot match normal files keeps the desktop icon-free even
    // if Plasma or an update switches back to that containment.
    ds[i].currentConfigGroup = ["General"];
    ds[i].writeConfig("filterMode", "1");
    ds[i].writeConfig("filterPattern", ".dotfiles-never-show-desktop-icons");
    ds[i].reloadConfig();
}}
print("applied=" + cfg.profile + ";panel=" + panel.id);
"""


def panel_profile_matches(profile_name: str) -> tuple[bool, str]:
    manifest = panel_manifest()
    profile = manifest["profiles"].get(profile_name)
    if profile is None:
        return False, f"unknown profile {profile_name}"
    task_plugin = (
        "org.kde.plasma.taskmanager"
        if profile["task_manager"] == "labels"
        else "org.kde.plasma.icontasks"
    )
    tray_policy = manifest["tray"]
    probe = """
const ps=panels();
if (!ps.length) { print("missing"); }
else {
 const p=ps[0]; let types=[], trayShown="", trayHidden="", launcherIcon="", taskLaunchers="", taskSorting="", taskCurrentDesktop="", taskCurrentScreen="", taskMiddleClick="", taskSeparate="", taskOnlyGroupWhenFull="";
 for (let i=0;i<p.widgetIds.length;++i) {
  const w=p.widgetById(p.widgetIds[i]); if (w) {
   types.push(w.type);
   if (w.type==="org.kde.plasma.kickoff") {
    w.currentConfigGroup=["General"];
    launcherIcon=w.readConfig("icon","");
   }
   if (w.type==="org.kde.plasma.systemtray") {
    w.currentConfigGroup=["General"];
    trayShown=w.readConfig("shownItems","");
    trayHidden=w.readConfig("hiddenItems","");
   }
   if (w.type==="org.kde.plasma.taskmanager" || w.type==="org.kde.plasma.icontasks") {
   w.currentConfigGroup=["General"];
   taskLaunchers=w.readConfig("launchers","");
   taskSorting=w.readConfig("sortingStrategy","");
   taskCurrentDesktop=w.readConfig("showOnlyCurrentDesktop","");
   taskCurrentScreen=w.readConfig("showOnlyCurrentScreen","");
   taskMiddleClick=w.readConfig("middleClickAction","");
   taskSeparate=w.readConfig("separateLaunchers","");
   taskOnlyGroupWhenFull=w.readConfig("onlyGroupWhenFull","");
   }
  }
 }
 let black=true, iconFree=true; const ds=desktops();
 for (let i=0;i<ds.length;++i) {
  if (ds[i].wallpaperPlugin!=="org.kde.color") black=false;
  ds[i].currentConfigGroup=["General"];
  if (ds[i].type==="org.kde.plasma.folder" &&
      (ds[i].readConfig("filterMode","0")!=="1" ||
       ds[i].readConfig("filterPattern","")!==".dotfiles-never-show-desktop-icons")) {
   iconFree=false;
  }
 }
 print([
  p.lengthMode,p.height,p.hiding,p.alignment,p.floating,
  p.minimumLength,p.maximumLength,types.join(","),black,iconFree,
  trayShown,trayHidden,launcherIcon,taskLaunchers,taskSorting,taskCurrentDesktop,
  taskCurrentScreen,taskMiddleClick,taskSeparate,taskOnlyGroupWhenFull
 ].join("|"));
}
"""
    output = plasma_evaluate(probe)
    if output == "missing":
        return False, "no live panel"
    parts = output.split("|")
    if len(parts) != 20:
        return False, f"could not parse Plasma state: {output}"
    (
        length_mode,
        height,
        hiding,
        alignment,
        floating,
        minimum_length,
        maximum_length,
        types,
        black,
        icon_free,
        tray_shown,
        tray_hidden,
        launcher_icon,
        task_launchers,
        task_sorting,
        task_current_desktop,
        task_current_screen,
        task_middle_click,
        task_separate,
        task_only_group_when_full,
    ) = parts
    if length_mode != profile["length_mode"]:
        return False, "length mode does not match"
    if int(float(height)) != profile["height"]:
        return False, "height does not match"
    remote_panel_state = STATE_DIR / "remote-panel.json"
    remote_sessions_active = False
    if remote_panel_state.is_file():
        try:
            remote_sessions_active = bool(
                load_json(remote_panel_state).get("sessions", {})
            )
        except DotError:
            remote_sessions_active = False
    expected_hiding = {"autohide", "none"} if remote_sessions_active else {"autohide"}
    if hiding not in expected_hiding or alignment != "center":
        return False, "placement or hiding does not match"
    if (floating == "true") != bool(profile["floating"]):
        return False, "floating mode does not match"
    if profile["length_mode"] == "custom":
        expected_length = round(
            panel_screen_width() * profile["width_percent"] / 100
        )
        if int(float(minimum_length)) != expected_length or int(
            float(maximum_length)
        ) != expected_length:
            return False, "custom width does not match"
    expected_types = ["org.kde.plasma.kickoff"]
    expected_types.append(task_plugin)
    if profile["spacers"]:
        expected_types.append("org.kde.plasma.panelspacer")
    expected_types.extend(
        ["org.kde.plasma.systemtray", "org.kde.plasma.digitalclock"]
    )
    if types.split(",") != expected_types:
        return False, "widget order does not match"
    expected_launcher_icon = (
        str(ROOT / "config/kde/assets/windows11-launcher.svg")
        if manifest["launcher_icon"] == "windows11"
        else manifest["launcher_icon"]
    )
    if launcher_icon != expected_launcher_icon:
        return False, "launcher icon does not match"
    if task_sorting != "1":
        return False, "taskbar is not in manual drag-reordering mode"
    if task_current_desktop != "true":
        return False, "taskbar is showing windows from other virtual desktops"
    if task_current_screen != "false":
        return False, "taskbar is hiding windows from other screens"
    if task_middle_click != "Close":
        return False, "taskbar middle-click does not close windows"
    if task_separate != "true" or task_only_group_when_full != "false":
        return False, "taskbar launcher and grouping behavior does not match"
    if black != "true":
        return False, "desktop is not solid black"
    if icon_free != "true":
        return False, "desktop icons are not hidden"
    if set(filter(None, tray_shown.split(","))) != set(
        tray_policy["shown_items"]
    ):
        return False, "always-shown tray icons do not match"
    if set(filter(None, tray_hidden.split(","))) != set(
        tray_policy["hidden_items"]
    ):
        return False, "always-hidden tray icons do not match"
    notify_path = Path.home() / ".config/plasmanotifyrc"
    popup_position = kconfig_get(
        notify_path.read_bytes() if notify_path.is_file() else b"",
        "Notifications",
        "PopupPosition",
    )
    if popup_position != "BottomRight":
        return False, "notification popups are not anchored bottom-right"
    return True, str(profile["description"])


def panel_profile_items() -> list[tuple[str, str, str]]:
    selected = active_panel_profile()
    return [
        (
            name,
            ("● " if name == selected else "  ") + str(profile["label"]),
            str(profile["description"]),
        )
        for name, profile in panel_profiles().items()
    ]


def live_panel_tray_policy() -> dict[str, list[str]]:
    output = plasma_evaluate(
        """
const ps=panels();
if (!ps.length) { print("{}"); }
else {
 const trays=ps[0].widgets("org.kde.plasma.systemtray");
 if (!trays.length) { print("{}"); }
 else {
  const tray=trays[0]; tray.currentConfigGroup=["General"];
  function items(key) {
   const value=tray.readConfig(key,"");
   return value ? value.split(",").filter(item => item.length) : [];
  }
  print(JSON.stringify({
   shown_items: items("shownItems"),
   hidden_items: items("hiddenItems")
  }));
 }
}
"""
    )
    try:
        policy = json.loads(output)
    except json.JSONDecodeError as exc:
        raise DotError(f"Could not read Plasma's live tray policy: {output}") from exc
    if not all(isinstance(policy.get(key), list) for key in ("shown_items", "hidden_items")):
        raise DotError("The live Plasma panel has no readable System Tray policy.")
    return {
        key: list(dict.fromkeys(str(item) for item in policy[key] if str(item)))
        for key in ("shown_items", "hidden_items")
    }


def live_panel_launchers() -> list[str]:
    output = plasma_evaluate(
        """
const ps=panels(); let value="";
for (let i=0;i<ps.length && !value;++i) {
 const tasks=ps[i].widgets("org.kde.plasma.taskmanager").concat(
  ps[i].widgets("org.kde.plasma.icontasks"));
 if (tasks.length) {
  tasks[0].currentConfigGroup=["General"];
  value=tasks[0].readConfig("launchers","");
 }
}
print(value);
"""
    )
    return list(dict.fromkeys(item for item in output.split(",") if item))


def save_live_panel_tray_policy() -> None:
    dirty = run(
        ["git", "status", "--porcelain", "--", str(PANEL_PROFILES_FILE)],
        cwd=ROOT,
        capture=True,
    ).stdout.strip()
    if dirty:
        raise DotError(
            "The panel profile manifest already has uncommitted changes. "
            "Review or commit it before saving the live panel preferences."
        )
    staged = run(["git", "diff", "--cached", "--quiet"], cwd=ROOT, check=False)
    if staged.returncode:
        raise DotError(
            "The Git index already contains staged changes. "
            "Commit or unstage them before saving the live panel preferences."
        )

    policy = live_panel_tray_policy()
    launchers = live_panel_launchers()
    payload = panel_manifest()
    updated_tray = dict(payload["tray"])
    updated_tray.update(policy)
    if payload["tray"] == updated_tray and payload["launchers"] == launchers:
        print("The live panel preferences already match dotfiles.")
        return
    original = PANEL_PROFILES_FILE.read_bytes()
    payload["tray"] = updated_tray
    payload["launchers"] = launchers
    atomic_text(
        PANEL_PROFILES_FILE,
        json.dumps(payload, indent=2) + "\n",
        0o644,
    )
    committed = False
    try:
        panel_manifest()
        matches, detail = panel_profile_matches(active_panel_profile())
        if not matches:
            raise DotError(f"Captured panel preferences did not validate: {detail}")
        validation = run([str(ROOT / "tests/run")], cwd=ROOT, check=False)
        if validation.returncode:
            raise DotError("Validation failed after capturing panel preferences.")
        env = nvim_git_environment()
        run(["git", "add", "--", str(PANEL_PROFILES_FILE)], cwd=ROOT)
        run(
            ["git", "commit", "-m", "update Plasma panel preferences"],
            cwd=ROOT,
            env=env,
        )
        committed = True
        run(["git", "push"], cwd=ROOT, env=env)
    except Exception:
        if not committed:
            atomic_bytes(PANEL_PROFILES_FILE, original, 0o644)
            run(
                ["git", "restore", "--staged", "--", str(PANEL_PROFILES_FILE)],
                cwd=ROOT,
                check=False,
            )
        raise
    print("Saved, validated, committed, and pushed the live panel preferences.")


def switch_panel_profile(profile_name: str, *, force: bool = False) -> None:
    profiles = panel_profiles()
    if profile_name not in profiles:
        raise DotError(
            f"Unknown panel profile {profile_name!r}. Choose from: "
            + ", ".join(profiles)
        )
    current = active_panel_profile()
    matches_current, _current_detail = panel_profile_matches(current)
    if current == profile_name and matches_current and not force:
        print(f"Panel profile {profile_name} is already active.")
        return
    panel_paths = [
        Path.home() / PANEL_LAYOUT_FILE,
        Path.home() / PANEL_GEOMETRY_FILE,
    ]
    run_id = backup_paths(panel_paths)
    try:
        output = plasma_evaluate(panel_profile_script(profile_name))
        if f"applied={profile_name};" not in output:
            raise DotError(f"Plasma did not confirm the profile change: {output}")
        matches, detail = panel_profile_matches(profile_name)
        if not matches:
            raise DotError(f"Applied panel did not validate: {detail}")
        atomic_text(PANEL_PROFILE_STATE, profile_name + "\n", 0o600)
    except Exception:
        if matches_current:
            plasma_evaluate(panel_profile_script(current))
        raise
    print(
        f"Switched to {profiles[profile_name]['label']}. "
        f"Rollback ID: {run_id}"
    )


def cmd_panel(args: argparse.Namespace) -> None:
    action = getattr(args, "panel_action", None)
    if action == "list":
        selected = active_panel_profile()
        for name, profile in panel_profiles().items():
            marker = "*" if name == selected else " "
            print(f"{marker} {name:<18} {profile['label']}: {profile['description']}")
        return
    if action == "status":
        selected = active_panel_profile()
        matches, detail = panel_profile_matches(selected)
        state = "matches live Plasma" if matches else f"drift: {detail}"
        print(f"{selected}: {state}")
        return
    if action == "use":
        switch_panel_profile(args.profile_name)
        return
    if action == "save":
        save_live_panel_tray_policy()
        return
    if not sys.stdin.isatty():
        raise DotError("Interactive panel selection requires a terminal.")
    selected = fzf_menu(
        panel_profile_items(),
        prompt="panel profile › ",
        header="Type to filter  Enter: apply  Esc: cancel",
    )
    if selected:
        switch_panel_profile(selected)


def display_mode_items() -> list[tuple[str, str, str]]:
    manifest = load_json(
        ROOT / "config/display/lenovo-ideapad-pro-5-16iah10.json"
    )
    return [
        (name, str(item["label"]), str(item["description"]))
        for name, item in manifest["modes"].items()
    ]


def cmd_display(args: argparse.Namespace) -> None:
    script = str(ROOT / "scripts/configure-display")
    action = getattr(args, "display_action", None)
    if action == "list":
        run([script, "--list"])
        return
    if action == "status":
        run([script, "--status"])
        return
    if action == "use":
        run([script, "--ensure", "--mode", args.mode_name])
        return
    if not sys.stdin.isatty():
        raise DotError("Interactive display-mode selection requires a terminal.")
    selected = fzf_menu(
        display_mode_items(),
        prompt="display mode › ",
        header="Enter: apply immediately  Esc: cancel",
    )
    if selected:
        run([script, "--ensure", "--mode", selected])


def palette_apply(profile: str, tags: str | None = None, *, check: bool = False) -> None:
    cmd_apply(
        argparse.Namespace(
            profile=profile,
            tags=tags,
            check=check,
            direct=False,
            force_kde=False,
        )
    )


def palette_update_menu(profile: str) -> None:
    while True:
        action = fzf_menu(
            [
                (
                    "all",
                    "Update everything",
                    "System, apps, CLIs, Tmux, Neovim plugins, and Mason tools",
                ),
                (
                    "check",
                    "Check for pending updates",
                    "Read-only provider and Neovim plugin update report",
                ),
                (
                    "system",
                    "Update operating system",
                    "Upgrade every installed APT package from configured repositories",
                ),
                (
                    "apps",
                    "Update applications and tools",
                    "Apps, Brew, Tmux, Codex, Vite+, Neovim, and Mason",
                ),
                (
                    "nvim-plugins",
                    "Update Neovim plugins",
                    "Isolate, test, promote, sign, and push the plugin lock",
                ),
                (
                    "nvim-tools",
                    "Update Neovim language tools",
                    "Upgrade curated Mason LSP servers, formatters, and linters",
                ),
                (
                    "tmux",
                    "Update Tmux plugins",
                    "Update TPM and every configured Tmux plugin",
                ),
                ("codex", "Update Codex", "Install the latest stable standalone CLI"),
                ("vite", "Update Vite+", "Upgrade Vite+ from its stable channel"),
                (
                    "tailscale",
                    "Update Tailscale",
                    "Reconcile the official repository, package, and daemon",
                ),
                (
                    "gestures",
                    "Update InputActions",
                    "Build the latest compatible gesture plugin and apply its config",
                ),
                (
                    "font",
                    "Update terminal font",
                    "Install the latest stable FiraCode Nerd Font Mono",
                ),
                (
                    "clipboard",
                    "Update CopyQ",
                    "Upgrade CopyQ and the direct-insertion Emoji picker from stable releases",
                ),
                ("back", "Back", "Return to the main menu"),
            ],
            prompt="update › ",
        )
        if action in (None, "back"):
            return

        def execute() -> None:
            if action in {"all", "check", "system", "apps"}:
                cmd_update(
                    argparse.Namespace(
                        profile=profile,
                        system=action == "system",
                        apps=action == "apps",
                        check=action == "check",
                    )
                )
            elif action == "nvim-plugins":
                cmd_nvim(
                    argparse.Namespace(
                        nvim_action="update",
                        profile=profile,
                        check=False,
                        run_id=None,
                    )
                )
            elif action == "nvim-tools":
                update_nvim_tools()
            elif action == "tmux":
                palette_apply(profile, "tmux")
            elif action == "codex":
                cmd_codex_update(argparse.Namespace())
            elif action == "vite":
                cmd_vite_plus_update(argparse.Namespace())
            elif action == "tailscale":
                palette_apply(profile, "tailscale")
            elif action == "gestures":
                palette_apply(profile, "gestures")
            elif action == "font":
                palette_apply(profile, "fonts")
            elif action == "clipboard":
                cmd_clipboard(
                    argparse.Namespace(clipboard_action="update", profile=profile)
                )

        palette_execute(execute)


