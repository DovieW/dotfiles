        failures += not doctor_check(
            "NoMachine server",
            nomachine_status is not None and nomachine_status.returncode == 0,
            "server installed and running"
            if nomachine_status is not None and nomachine_status.returncode == 0
            else f"run dot apply --profile {profile['name']} --tags nomachine",
        )
    if profile.get("features", {}).get("shell"):
        failures += not doctor_check("zsh", command_exists("zsh"), shutil.which("zsh") or "not installed")
        dot_command = Path.home() / ".local/bin/dot"
        failures += not doctor_check(
            "dot command",
            dot_command.is_symlink() and dot_command.resolve() == (ROOT / "bin/dot").resolve(),
