        ("codex", "Codex Remote Control", "Repair the standalone CLI and persistent service"),
        ("back", "Back", "Return to the main menu"),
    ]
    while True:
        action = fzf_menu(items, prompt="apply › ")
        if action in (None, "back"):
            return
        if action == "panel":
            palette_execute(
                lambda: switch_panel_profile(active_panel_profile(), force=True)
            )
        else:
            palette_execute(
                lambda: palette_apply(
                    profile,
