            "vscode",
            "Visual Studio Code",
            "Install or repair Microsoft's latest stable native editor",
        ),
        (
            "rdp",
            "Remote Desktop files",
            "Install stock FreeRDP/Remmina and register fullscreen .rdp/.rdpw launching",
        ),
        (
            "panel",
            "Selected taskbar profile",
            f"Rebuild {active_panel_profile()} while preserving the live pinned order",
        ),
        (
            "lockscreen",
            "Lock screen",
            "Install the managed theme, private wallpaper, and fallback policy",
        ),
        ("shell", "Shell environment", "Apply Bash, Zsh, prompt, helpers, and Tmux files"),
        ("git", "Git configuration", "Apply identities, aliases, Delta, signing, and utilities"),
        ("tmux", "Tmux", "Apply Tmux configuration, TPM, and plugins"),
        ("nvim", "Neovim", "Apply config, locked plugins, parsers, and language tools"),
        ("docker", "Docker Engine", "Repair native engine, Compose, Buildx, and service state"),
        ("tailscale", "Tailscale", "Repair stable repository, package, and daemon"),
        (
            "nomachine",
            "NoMachine remote desktop",
            "Install the free edition and bind it to the Tailscale address",
        ),
