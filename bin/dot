        github_scheme = Path.home() / ".local/share/color-schemes/GitHubDark.colors"
        kdeglobals_path = Path.home() / ".config/kdeglobals"
        kdeglobals = kdeglobals_path.read_text(encoding="utf-8") if kdeglobals_path.exists() else ""
        github_scheme_ok = (
            github_scheme.exists()
            and kde_digest(".local/share/color-schemes/GitHubDark.colors", github_scheme)
            == kde_digest(
                ".local/share/color-schemes/GitHubDark.colors",
                kde_source(".local/share/color-schemes/GitHubDark.colors"),
            )
            and "ColorScheme=GitHubDark" in kdeglobals
            and "LookAndFeelPackage=org.kde.breezedark.desktop" in kdeglobals
        )
        failures += not doctor_check(
            "GitHub Dark KDE theme",
            github_scheme_ok,
            "GitHub Dark colors with native Breeze desktop components"
            if github_scheme_ok
            else "run dot apply --profile kubuntu-laptop --tags kde",
        )
        if command_exists("systemctl"):
            failures += not doctor_check(
                "Plasma Shell",
                plasma_session_active,
                "active"
                if plasma_session_active
                else "plasma-plasmashell.service is not active",
            )
        powerdevil_source = ROOT / "config/kde/.config/powerdevilrc"
        powerdevil_live = Path.home() / ".config/powerdevilrc"
        powerdevil_matches = (
            powerdevil_live.exists()
            and kde_digest(".config/powerdevilrc", powerdevil_live)
            == kde_digest(".config/powerdevilrc", powerdevil_source)
        )
        failures += not doctor_check(
            "automatic sleep policy",
            powerdevil_matches,
            "100% brightness on AC and battery; at 20% battery or below, "
            "40% brightness and power-saver; AC performance and battery balanced; "
            "lid ignored and automatic sleep disabled; power button sleeps"
            if powerdevil_matches
            else "run dot apply --profile kubuntu-laptop --tags kde",
        )
        if profile.get("features", {}).get("nvidia_driver"):
            recommended = run(
                ["ubuntu-drivers", "devices"],
                check=False,
                capture=True,
            )
            recommended_match = re.search(
                r"^driver\s+:\s+(nvidia-driver-\S+).*recommended\s*$",
                recommended.stdout,
                re.MULTILINE,
            )
            recommended_package = recommended_match.group(1) if recommended_match else ""
            installed_driver = run(
                ["dpkg-query", "-W", "-f=${db:Status-Status}", recommended_package],
                check=False,
                capture=True,
            ) if recommended_package else None
            failures += not doctor_check(
                "NVIDIA recommended driver",
                installed_driver is not None
                and installed_driver.returncode == 0
                and installed_driver.stdout.strip() == "installed",
                recommended_package or "Ubuntu reported no recommended driver",
            )
            nvidia_loaded = Path("/proc/driver/nvidia/version").exists()
            failures += not doctor_check(
                "NVIDIA runtime",
                nvidia_loaded,
                "NVIDIA kernel driver loaded"
                if nvidia_loaded
                else "reboot after dot apply --profile kubuntu-laptop --tags gpu",
            )
            nvidia_smi = run(
                ["nvidia-smi", "--query-gpu=name,driver_version", "--format=csv,noheader"],
                check=False,
                capture=True,
            )
            failures += not doctor_check(
                "NVIDIA userspace",
                nvidia_smi.returncode == 0,
                nvidia_smi.stdout.strip()
                if nvidia_smi.returncode == 0
                else "nvidia-smi cannot communicate with the loaded driver",
            )
            prime = run(["prime-select", "query"], check=False, capture=True)
            failures += not doctor_check(
                "NVIDIA PRIME mode",
                prime.returncode == 0 and prime.stdout.strip() == "on-demand",
                prime.stdout.strip() or "prime-select unavailable",
            )
            if not profile.get("features", {}).get(
                "nvidia_settings_autostart", True
            ):
                nvidia_autostart = (
                    Path.home()
                    / ".config/autostart/nvidia-settings-autostart.desktop"
                )
                nvidia_autostart_source = (
                    ROOT / "config/nvidia/nvidia-settings-autostart.desktop"
                )
                nvidia_autostart_disabled = (
                    nvidia_autostart.is_symlink()
                    and nvidia_autostart.resolve()
                    == nvidia_autostart_source.resolve()
                    and "Hidden=true"
                    in nvidia_autostart_source.read_text(encoding="utf-8")
                )
                failures += not doctor_check(
                    "NVIDIA settings autostart",
                    nvidia_autostart_disabled,
                    "disabled; PRIME on-demand remains available without a failed login unit"
                    if nvidia_autostart_disabled
                    else "run dot apply --profile kubuntu-laptop --tags gpu",
                )
            if not profile.get("features", {}).get("nvidia_dynamic_boost", True):
                dynamic_boost = run(
                    ["systemctl", "is-enabled", "nvidia-powerd.service"],
                    check=False,
                    capture=True,
                )
                failures += not doctor_check(
                    "NVIDIA Dynamic Boost workaround",
                    dynamic_boost.stdout.strip() in {"disabled", "masked"},
                    "disabled; normal GPU acceleration and runtime suspension remain available"
                    if dynamic_boost.stdout.strip() in {"disabled", "masked"}
                    else "run dot apply --profile kubuntu-laptop --tags gpu",
                )
        if profile.get("features", {}).get("lid_power_saver") and command_exists("busctl"):
            live_lid = run(
                [
                    "busctl",
                    "--user",
                    "call",
                    "org.kde.Solid.PowerManagement",
                    "/org/kde/Solid/PowerManagement/Actions/HandleButtonEvents",
                    "org.kde.Solid.PowerManagement.Actions.HandleButtonEvents",
                    "lidAction",
                ],
                check=False,
                capture=True,
            )
            failures += not doctor_check(
                "live lid action",
                live_lid.returncode == 0 and live_lid.stdout.strip() == "i 0",
                "do nothing"
                if live_lid.returncode == 0 and live_lid.stdout.strip() == "i 0"
                else "restart plasma-powerdevil.service or reapply the KDE profile",
            )
        if profile.get("features", {}).get("lid_power_saver"):
            logind_source = ROOT / "config/systemd/logind/60-dotfiles-lid.conf"
            logind_live = Path("/etc/systemd/logind.conf.d/60-dotfiles-lid.conf")
            logind_matches = (
                logind_live.exists()
                and logind_live.read_bytes() == logind_source.read_bytes()
            )
            failures += not doctor_check(
                "system lid fallback",
                logind_matches,
                "installed; guaranteed after reboot"
                if logind_matches
                else "run dot apply --profile kubuntu-laptop --tags kde",
            )
            lid_unit = "dot-lid-power.service"
            lid_enabled = run(
                ["systemctl", "--user", "is-enabled", "--quiet", lid_unit],
                check=False,
            ).returncode == 0
            lid_active = run(
                ["systemctl", "--user", "is-active", "--quiet", lid_unit],
                check=False,
            ).returncode == 0
            failures += not doctor_check(
                "lid power-saver service",
                lid_enabled and lid_active,
                "enabled and active"
                if lid_enabled and lid_active
                else "run dot apply --profile kubuntu-laptop --tags kde",
            )
            lid_status = run(
                [str(Path.home() / ".local/bin/dot-lid-power"), "status"],
                check=False,
                capture=True,
                timeout=5,
            )
            lid_detail = (lid_status.stdout or lid_status.stderr).strip()
            failures += not doctor_check(
                "lid-aware power profile",
                lid_status.returncode == 0,
                lid_detail or "the lid power controller could not read system state",
            )
        segoe = list((Path.home() / ".local/share/fonts").glob("**/SegUIVar.ttf"))
        failures += not doctor_check("Segoe UI Variable", bool(segoe), str(segoe[0]) if segoe else "not provisioned")
        ghostty_config = Path.home() / ".config/ghostty/config"
        ghostty_source = ROOT / "config/ghostty/config"
        ghostty_matches = (
            ghostty_config.exists()
            and ghostty_config.read_bytes() == ghostty_source.read_bytes()
        )
        terminal_application = run(
            [
                "kreadconfig6",
                "--file",
                "kdeglobals",
                "--group",
                "General",
                "--key",
                "TerminalService",
            ],
            check=False,
            capture=True,
        )
        ghostty_default = (
            terminal_application.returncode == 0
            and terminal_application.stdout.strip()
            == "com.mitchellh.ghostty.desktop"
        )
        failures += not doctor_check(
            "Ghostty configuration",
            command_exists("ghostty") and ghostty_matches and ghostty_default,
            "default frameless tmux frontend installed and configured"
            if command_exists("ghostty") and ghostty_matches and ghostty_default
            else "run dot apply --profile kubuntu-laptop --tags packages",
        )
        if profile.get("features", {}).get("firacode_nerd_font"):
            nerd_font_check = run(
                [
                    str(ROOT / "scripts/install-firacode-nerd-font"),
                    "--check",
                ],
                check=False,
                capture=True,
            )
            nerd_font_detail = (
                nerd_font_check.stdout or nerd_font_check.stderr
            ).strip()
            failures += not doctor_check(
                "terminal font",
                nerd_font_check.returncode == 0,
                nerd_font_detail or "FiraCode Nerd Font Mono check failed",
            )
    if profile.get("features", {}).get("vite_plus"):
        vite_plus_check = run(
            [str(ROOT / "scripts/install-vite-plus"), "--check"],
            check=False,
            capture=True,
        )
        vite_plus_detail = (vite_plus_check.stdout or vite_plus_check.stderr).strip()
        failures += not doctor_check(
            "Vite+",
            vite_plus_check.returncode == 0,
            vite_plus_detail or "managed Vite+ check failed",
        )
    if profile.get("features", {}).get("codex_remote_control"):
        remote_mode = profile.get("features", {}).get(
            "codex_remote_control_mode", "headless"
        )
        codex_config_check = run(
            [str(ROOT / "scripts/configure-codex"), "--check"],
            check=False,
            capture=True,
        )
        codex_config_detail = (
            codex_config_check.stdout or codex_config_check.stderr
        ).strip()
        failures += not doctor_check(
            "Codex default permissions",
            codex_config_check.returncode == 0,
            codex_config_detail or "managed Codex permissions check failed",
        )
        codex_check = run(
            [str(ROOT / "scripts/install-codex"), "--check"],
            check=False,
            capture=True,
        )
        codex_detail = (codex_check.stdout or codex_check.stderr).strip()
        failures += not doctor_check(
            "Codex standalone CLI",
            codex_check.returncode == 0,
            codex_detail or "standalone install check failed",
        )
        unit_name = "codex-remote-control.service"
        enabled = run(
            ["systemctl", "--user", "is-enabled", "--quiet", unit_name],
            check=False,
        ).returncode == 0
        active = run(
            ["systemctl", "--user", "is-active", "--quiet", unit_name],
            check=False,
        ).returncode == 0
        service_ok = (
            enabled and active
            if remote_mode == "headless"
            else not enabled and not active
        )
        failures += not doctor_check(
            "Codex Remote Control",
            service_ok,
            (
                "headless service enabled and active"
                if remote_mode == "headless"
                else "headless service disabled for ChatGPT Desktop ownership"
            )
            if service_ok
            else f"unexpected {unit_name} state for {remote_mode} mode",
        )
        managed_codex = (
            Path.home() / ".codex/packages/standalone/current/codex"
        )
        daemon_version = run(
            [str(managed_codex), "app-server", "daemon", "version"],
            check=False,
            capture=True,
        ) if managed_codex.is_file() else None
        daemon_status: dict[str, Any] = {}
        if daemon_version and daemon_version.returncode == 0:
            try:
                daemon_status = json.loads(daemon_version.stdout)
            except json.JSONDecodeError:
                pass
        running = daemon_status.get("status") == "running"
        reported_path = daemon_status.get("managedCodexPath", "")
        path_aligned = False
        if reported_path:
            try:
                path_aligned = Path(reported_path).resolve() == managed_codex.resolve()
            except OSError:
                pass
        desktop_server_running = run(
            [
                "pgrep",
                "-u",
                str(os.getuid()),
                "-f",
                r"^/usr/lib/chatgpt/resources/codex .*app-server",
            ],
            check=False,
            capture=True,
        ).returncode == 0
        remote_owner_healthy = (
            (running and path_aligned)
            if remote_mode == "headless"
            else not running or desktop_server_running
        )
        failures += not doctor_check(
            "Codex native Remote Control daemon",
            remote_owner_healthy,
            (
                "ChatGPT Desktop currently owns Remote Control"
                if desktop_server_running
                else (
                    "running from the managed standalone channel"
                    if remote_mode == "headless"
                    else "headless daemon is inactive in desktop mode"
                )
            )
            if remote_owner_healthy
            else (
                (daemon_version.stdout or daemon_version.stderr).strip()
                if daemon_version
                else f"missing executable: {managed_codex}"
            ),
        )
        daemon_settings = Path.home() / ".codex/app-server-daemon/settings.json"
        remote_enabled = False
        if daemon_settings.is_file():
            try:
                settings = load_json(daemon_settings)
                remote_enabled = bool(
                    settings.get("remote_control")
                    or settings.get("remoteControlEnabled")
                )
            except (OSError, ValueError):
                pass
        failures += not doctor_check(
            "Codex Remote Control preference",
            remote_enabled if remote_mode == "headless" else True,
            "persisted in the native daemon settings"
            if remote_enabled and remote_mode == "headless"
            else "owned by ChatGPT Desktop settings"
            if remote_mode == "desktop"
            else f"not enabled in {daemon_settings}",
        )
        linger = run(
            ["loginctl", "show-user", getpass.getuser(), "--property=Linger", "--value"],
            check=False,
            capture=True,
        )
        failures += not doctor_check(
            "Codex boot persistence",
            remote_mode == "desktop"
            or (linger.returncode == 0 and linger.stdout.strip() == "yes"),
            "systemd user lingering enabled"
            if remote_mode == "headless"
            and linger.returncode == 0
            and linger.stdout.strip() == "yes"
            else "not required for desktop-owned Remote Control"
            if remote_mode == "desktop"
            else "enable with loginctl enable-linger",
        )
    if failures:
        raise DotError(f"Doctor found {failures} failing check(s)")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="dot")
    sub = parser.add_subparsers(dest="command")
    bootstrap = sub.add_parser("bootstrap")
    bootstrap.add_argument("--profile", required=True)
    bootstrap.add_argument("--device")
    bootstrap.add_argument("--skip-secrets", action="store_true")
