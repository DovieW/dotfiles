def managed_clipboard_callback_ok() -> bool:
    """Prove the registered clipboard KWin action still has a live callback."""
    if not command_exists("qdbus6") or not command_exists("systemctl"):
        return False
    service = "dot-clipboard-probe.service"
    run(["systemctl", "--user", "stop", service], check=False, capture=True)
    try:
        invoked = run(
            [
                "qdbus6",
                "org.kde.kglobalaccel",
                "/component/kwin",
                "org.kde.kglobalaccel.Component.invokeShortcut",
                "dot-clipboard-probe",
            ],
            check=False,
            capture=True,
        )
        if invoked.returncode:
            return False
        deadline = time.monotonic() + 2
        while time.monotonic() < deadline:
            active = run(
                ["systemctl", "--user", "is-active", service],
                check=False,
                capture=True,
            )
            if active.stdout.strip() == "active":
                return True
            time.sleep(0.05)
        return False
    finally:
        run(["systemctl", "--user", "stop", service], check=False, capture=True)


