            "Repair instant clipboard captures and the editable-region UI without changing other KDE settings",
        ),
        (
            "clipboard",
            "Clipboard and Emoji picker",
            "Install CopyQ history plus the direct-insertion Wayland Emoji picker",
        ),
        (
            "display",
            "Internal OLED display",
            "Apply factory ICC, fixed-refresh display, accurate SDR, and RGB policy",
        ),
