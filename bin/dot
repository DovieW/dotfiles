def palette_repositories_menu(profile: str) -> None:
    while True:
        action = fzf_menu(
            [
                (
                    "sync",
                    "Sync managed repositories",
                    "Clone official repositories plus optional private Bitwarden entries",
                ),
                (
                    "add",
                    "Add a package",
                    "Choose a profile and provider, update its manifest, and optionally apply",
                ),
                (
                    "inventory",
                    "Show package inventory",
                    "Print inherited packages and enabled features for a selected profile",
                ),
                (
                    "git-status",
                    "Show dotfiles Git status",
                    "Display branch, upstream, staged, and working-tree state",
                ),
                ("back", "Back", "Return to the main menu"),
            ],
            prompt="repositories › ",
        )
        if action in (None, "back"):
            return
        if action == "sync":
            palette_execute(
                lambda: cmd_repos_sync(argparse.Namespace(profile=profile))
            )
        elif action == "inventory":
            selected_profile = palette_profile(include_common=True)
            if selected_profile:
                palette_execute(
                    lambda: print(
                        json.dumps(load_profile(selected_profile), indent=2)
                    )
                )
        elif action == "git-status":
            palette_execute(
                lambda: run(["git", "status", "--short", "--branch"], cwd=ROOT)
            )
        elif action == "add":
            package_name = palette_text("Package name")
            if not package_name:
                continue
            selected_profile = palette_profile(include_common=True)
            if not selected_profile:
                continue
            provider = fzf_menu(
                [
                    ("auto", "Automatic provider", "Use the canonical package catalog"),
                    ("apt", "APT", "System library, desktop, driver, or integration"),
                    ("brew", "Homebrew", "Modern shared Linux command-line tool"),
                    ("snap", "Snap", "Curated desktop exception"),
                    ("pkg", "Termux pkg", "Android Termux package"),
                    ("winget", "Winget inventory", "Record a Windows package ID"),
                    ("scoop", "Scoop inventory", "Record a Windows Scoop package"),
                    (
                        "psgallery",
                        "PowerShell Gallery inventory",
                        "Record a PowerShell module",
                    ),
                ],
                prompt="provider › ",
            )
            if provider is None:
                continue
            mode = fzf_menu(
                [
                    ("apply", "Add and apply", "Update the manifest and install it now"),
                    ("record", "Add only", "Update the manifest without installing"),
                    ("cancel", "Cancel", "Do not modify the manifest"),
                ],
                prompt="package action › ",
            )
            if mode in (None, "cancel"):
                continue
            palette_execute(
                lambda: cmd_package_add(
                    argparse.Namespace(
                        name=package_name,
                        profile=selected_profile,
                        provider=None if provider == "auto" else provider,
                        no_apply=mode == "record",
                    )
                )
            )


