            if krdp_panel_watcher_active
            else f"run dot apply --profile {profile['name']} --tags krdp",
        )
    if profile.get("features", {}).get("nomachine"):
        nomachine_server = Path("/etc/NX/nxserver")
        nomachine_status = (
            run(
                [str(nomachine_server), "--status"],
                check=False,
