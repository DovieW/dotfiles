def palette_panel_menu() -> None:
    while True:
        action = fzf_menu(
            [
                (
                    "status",
                    "Check live taskbar",
                    "Validate geometry, widget order, tray visibility, and desktop policy",
                ),
                (
                    "switch",
                    "Switch taskbar profile",
                    f"Choose one of four native Plasma layouts · {active_panel_profile()} active",
                ),
                (
                    "save-panel",
                    "Save taskbar preferences",
                    "Capture pinned order and tray visibility; validate, commit, and push",
                ),
                (
                    "reapply",
                    "Reapply selected profile",
                    "Rebuild the active taskbar from its declarative profile",
                ),
                (
                    "list",
                    "List taskbar profiles",
                    "Print every profile and its description",
                ),
                ("back", "Back", "Return to Save and configuration"),
            ],
            prompt="taskbar › ",
        )
        if action in (None, "back"):
            return
        if action == "switch":
            selected = fzf_menu(
                panel_profile_items(),
                prompt="panel profile › ",
                header="Type to filter  Enter: apply  Esc: back",
            )
            if selected:
                palette_execute(lambda: switch_panel_profile(selected))
            continue
        if action == "reapply":
            selected = active_panel_profile()
            palette_execute(lambda: switch_panel_profile(selected, force=True))
            continue
        panel_action = "save" if action == "save-panel" else action
        palette_execute(
            lambda: cmd_panel(
                argparse.Namespace(
                    panel_action=panel_action,
                    profile_name=None,
                )
            )
        )


def palette_configuration_menu(profile: str) -> None:
    while True:
        action = fzf_menu(
            [
                (
                    "save",
                    "Save changed settings",
                    "Select live KDE changes, validate, commit, and push",
                ),
                (
                    "save-panel",
                    "Save panel-adjacent settings",
                    "Capture launcher, appearance, KRunner, and shortcuts—not generated taskbar structure",
                ),
                (
                    "panel",
                    "Taskbar and System Tray",
                    "Status, profiles, tray visibility, repair, and saving",
                ),
                (
                    "display",
                    "Internal OLED color mode",
                    "Switch between the recorded Windows-native look and factory-accurate color",
                ),
                (
                    "save-spectacle",
                    "Save Spectacle",
                    "Capture screenshot preferences and keyboard shortcuts",
                ),
                (
                    "diff",
                    "Review KDE drift",
                    "Compare portable live settings against dotfiles with Delta",
                ),
                (
                    "capture",
                    "Capture KDE without committing",
                    "Copy all allowlisted live settings into the repository",
                ),
                (
                    "capture-selected",
                    "Capture selected KDE files",
                    "Choose one or more allowlisted live files without committing",
                ),
                (
                    "apply",
                    "Restore KDE from dotfiles",
                    "Safely apply the reviewed repository configuration",
                ),
                (
                    "lockscreen-preview",
                    "Preview managed lock screen",
                    "Open the theme in KDE's safe non-locking test mode",
                ),
                (
                    "lockscreen-apply",
                    "Apply managed lock screen",
                    "Install the theme, wallpaper, and correct media-control policy",
                ),
                (
                    "lockscreen-stock",
                    "Restore stock lock screen",
                    "Back up the live selection and use KDE's built-in theme",
                ),
                (
                    "force",
                    "Force-restore KDE from dotfiles",
                    "Back up and replace conflicting live KDE settings",
                ),
                (
                    "rollback",
                    "Restore a configuration backup",
                    "Choose a previous automatic file backup",
                ),
                ("back", "Back", "Return to the main menu"),
            ],
            prompt="configuration › ",
        )
        if action in (None, "back"):
            return
        if action == "rollback":
            run_id = palette_backup_run_id(BACKUP_DIR, prompt="rollback › ")
            if run_id and palette_confirm(
                "Restore selected backup",
                f"Replace current files with snapshot {run_id}",
            ):
                palette_execute(lambda: cmd_rollback(argparse.Namespace(run_id=run_id)))
            continue
        if action == "capture-selected":
            selected = palette_kde_files(prompt="KDE files › ")
            if selected:
                palette_execute(
                    lambda: cmd_capture_kde(argparse.Namespace(only=selected))
                )
            continue
        if action == "lockscreen-stock":
            if palette_confirm(
                "Restore KDE's stock lock screen",
                "The managed theme remains available and can be reapplied later",
            ):
                palette_execute(
                    lambda: cmd_lockscreen(
                        argparse.Namespace(lockscreen_action="stock")
                    )
                )
            continue
        if action == "panel":
            palette_panel_menu()
            continue
        if action == "display":
            palette_execute(
                lambda: cmd_display(
                    argparse.Namespace(display_action=None, mode_name=None)
                )
            )
            continue

        def execute() -> None:
            if action == "save":
                cmd_save(argparse.Namespace(target=None, yes=False))
            elif action == "save-panel":
                cmd_save(argparse.Namespace(target="panel", yes=False))
            elif action == "save-spectacle":
                cmd_save(argparse.Namespace(target="spectacle", yes=False))
            elif action == "diff":
                cmd_diff_kde(argparse.Namespace())
            elif action == "capture":
                cmd_capture_kde(argparse.Namespace(only=None))
            elif action == "apply":
                palette_apply(profile, "kde")
            elif action == "lockscreen-preview":
                cmd_lockscreen(
                    argparse.Namespace(lockscreen_action="preview")
                )
            elif action == "lockscreen-apply":
                palette_apply(profile, "lockscreen")
            elif action == "force":
                if not palette_confirm(
                    "Back up and replace live KDE settings",
                    "Use the reviewed repository version despite local drift",
                ):
                    return
                cmd_apply(
                    argparse.Namespace(
                        profile=profile,
                        tags="kde",
                        check=False,
                        direct=False,
                        force_kde=True,
                    )
                )

        palette_execute(execute)


