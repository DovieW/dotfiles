            powerdevil_live.exists()
            and kde_digest(".config/powerdevilrc", powerdevil_live)
            == kde_digest(".config/powerdevilrc", powerdevil_source)
        )
        failures += not doctor_check(
            "automatic sleep policy",
            powerdevil_matches,
            "100% brightness on AC and battery; at 20% battery or below, "
            "40% brightness and power-saver; AC performance and battery balanced; "
            "lid ignored and automatic sleep disabled; power button sleeps"
            if powerdevil_matches
            else "run dot apply --profile kubuntu-laptop --tags kde",
        )
        if profile.get("features", {}).get("nvidia_driver"):
            recommended = run(
                ["ubuntu-drivers", "devices"],
                check=False,
                capture=True,
            )
            recommended_match = re.search(
                r"^driver\s+:\s+(nvidia-driver-\S+).*recommended\s*$",
                recommended.stdout,
                re.MULTILINE,
            )
            recommended_package = recommended_match.group(1) if recommended_match else ""
            installed_driver = run(
                ["dpkg-query", "-W", "-f=${db:Status-Status}", recommended_package],
                check=False,
                capture=True,
            ) if recommended_package else None
            failures += not doctor_check(
                "NVIDIA recommended driver",
                installed_driver is not None
                and installed_driver.returncode == 0
                and installed_driver.stdout.strip() == "installed",
                recommended_package or "Ubuntu reported no recommended driver",
            )
            nvidia_loaded = Path("/proc/driver/nvidia/version").exists()
            failures += not doctor_check(
                "NVIDIA runtime",
                nvidia_loaded,
                "NVIDIA kernel driver loaded"
                if nvidia_loaded
                else "reboot after dot apply --profile kubuntu-laptop --tags gpu",
            )
            nvidia_smi = run(
                ["nvidia-smi", "--query-gpu=name,driver_version", "--format=csv,noheader"],
                check=False,
                capture=True,
            )
            failures += not doctor_check(
                "NVIDIA userspace",
                nvidia_smi.returncode == 0,
                nvidia_smi.stdout.strip()
                if nvidia_smi.returncode == 0
                else "nvidia-smi cannot communicate with the loaded driver",
            )
            prime = run(["prime-select", "query"], check=False, capture=True)
            failures += not doctor_check(
                "NVIDIA PRIME mode",
                prime.returncode == 0 and prime.stdout.strip() == "on-demand",
                prime.stdout.strip() or "prime-select unavailable",
            )
            if not profile.get("features", {}).get("nvidia_dynamic_boost", True):
                dynamic_boost = run(
                    ["systemctl", "is-enabled", "nvidia-powerd.service"],
                    check=False,
                    capture=True,
                )
                failures += not doctor_check(
                    "NVIDIA Dynamic Boost workaround",
                    dynamic_boost.stdout.strip() in {"disabled", "masked"},
                    "disabled; normal GPU acceleration and runtime suspension remain available"
                    if dynamic_boost.stdout.strip() in {"disabled", "masked"}
                    else "run dot apply --profile kubuntu-laptop --tags gpu",
                )
        if command_exists("busctl"):
            live_lid = run(
                [
                    "busctl",
                    "--user",
                    "call",
                    "org.kde.Solid.PowerManagement",
                    "/org/kde/Solid/PowerManagement/Actions/HandleButtonEvents",
                    "org.kde.Solid.PowerManagement.Actions.HandleButtonEvents",
                    "lidAction",
                ],
                check=False,
                capture=True,
            )
            failures += not doctor_check(
                "live lid action",
                live_lid.returncode == 0 and live_lid.stdout.strip() == "i 0",
                "do nothing"
                if live_lid.returncode == 0 and live_lid.stdout.strip() == "i 0"
                else "restart plasma-powerdevil.service or reapply the KDE profile",
            )
        logind_source = ROOT / "config/systemd/logind/60-dotfiles-lid.conf"
        logind_live = Path("/etc/systemd/logind.conf.d/60-dotfiles-lid.conf")
        logind_matches = (
            logind_live.exists()
            and logind_live.read_bytes() == logind_source.read_bytes()
        )
        failures += not doctor_check(
            "system lid fallback",
            logind_matches,
            "installed; guaranteed after reboot"
            if logind_matches
            else "run dot apply --profile kubuntu-laptop --tags kde",
        )
        if profile.get("features", {}).get("lid_power_saver"):
            lid_unit = "dot-lid-power.service"
            lid_enabled = run(
                ["systemctl", "--user", "is-enabled", "--quiet", lid_unit],
                check=False,
            ).returncode == 0
            lid_active = run(
                ["systemctl", "--user", "is-active", "--quiet", lid_unit],
                check=False,
            ).returncode == 0
            failures += not doctor_check(
                "lid power-saver service",
                lid_enabled and lid_active,
                "enabled and active"
                if lid_enabled and lid_active
                else "run dot apply --profile kubuntu-laptop --tags kde",
            )
            lid_status = run(
                [str(Path.home() / ".local/bin/dot-lid-power"), "status"],
                check=False,
                capture=True,
                timeout=5,
            )
            lid_detail = (lid_status.stdout or lid_status.stderr).strip()
            failures += not doctor_check(
                "lid-aware power profile",
                lid_status.returncode == 0,
                lid_detail or "the lid power controller could not read system state",
            )
        segoe = list((Path.home() / ".local/share/fonts").glob("**/SegUIVar.ttf"))
        failures += not doctor_check("Segoe UI Variable", bool(segoe), str(segoe[0]) if segoe else "not provisioned")
        ghostty_config = Path.home() / ".config/ghostty/config"
        ghostty_source = ROOT / "config/ghostty/config"
        ghostty_matches = (
            ghostty_config.exists()
            and ghostty_config.read_bytes() == ghostty_source.read_bytes()
        )
        terminal_application = run(
            [
                "kreadconfig6",
                "--file",
                "kdeglobals",
                "--group",
                "General",
                "--key",
                "TerminalService",
            ],
            check=False,
            capture=True,
        )
        ghostty_default = (
            terminal_application.returncode == 0
            and terminal_application.stdout.strip()
            == "com.mitchellh.ghostty.desktop"
        )
        failures += not doctor_check(
            "Ghostty configuration",
            command_exists("ghostty") and ghostty_matches and ghostty_default,
            "default frameless tmux frontend installed and configured"
            if command_exists("ghostty") and ghostty_matches and ghostty_default
            else "run dot apply --profile kubuntu-laptop --tags packages",
        )
        if profile.get("features", {}).get("firacode_nerd_font"):
            nerd_font_check = run(
                [
                    str(ROOT / "scripts/install-firacode-nerd-font"),
                    "--check",
                ],
                check=False,
                capture=True,
            )
            nerd_font_detail = (
                nerd_font_check.stdout or nerd_font_check.stderr
            ).strip()
            failures += not doctor_check(
                "terminal font",
                nerd_font_check.returncode == 0,
                nerd_font_detail or "FiraCode Nerd Font Mono check failed",
            )
    if profile.get("features", {}).get("vite_plus"):
        vite_plus_check = run(
            [str(ROOT / "scripts/install-vite-plus"), "--check"],
            check=False,
            capture=True,
        )
        vite_plus_detail = (vite_plus_check.stdout or vite_plus_check.stderr).strip()
        failures += not doctor_check(
            "Vite+",
            vite_plus_check.returncode == 0,
            vite_plus_detail or "managed Vite+ check failed",
        )
    if profile.get("features", {}).get("codex_remote_control"):
        codex_check = run(
            [str(ROOT / "scripts/install-codex"), "--check"],
            check=False,
            capture=True,
        )
        codex_detail = (codex_check.stdout or codex_check.stderr).strip()
        failures += not doctor_check(
            "Codex standalone CLI",
            codex_check.returncode == 0,
            codex_detail or "standalone install check failed",
        )
        unit_name = "codex-remote-control.service"
        enabled = run(
            ["systemctl", "--user", "is-enabled", "--quiet", unit_name],
            check=False,
        ).returncode == 0
        active = run(
            ["systemctl", "--user", "is-active", "--quiet", unit_name],
            check=False,
        ).returncode == 0
        failures += not doctor_check(
            "Codex Remote Control",
            enabled and active,
            "enabled and active"
            if enabled and active
            else f"{unit_name} is not {'enabled' if not enabled else 'active'}",
        )
        linger = run(
            ["loginctl", "show-user", getpass.getuser(), "--property=Linger", "--value"],
            check=False,
            capture=True,
        )
        failures += not doctor_check(
            "Codex boot persistence",
            linger.returncode == 0 and linger.stdout.strip() == "yes",
            "systemd user lingering enabled"
            if linger.returncode == 0 and linger.stdout.strip() == "yes"
            else "enable with loginctl enable-linger",
        )
    if failures:
        raise DotError(f"Doctor found {failures} failing check(s)")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="dot")
    sub = parser.add_subparsers(dest="command")
    bootstrap = sub.add_parser("bootstrap")
    bootstrap.add_argument("--profile", required=True)
    bootstrap.add_argument("--device")
    bootstrap.add_argument("--skip-secrets", action="store_true")
    bootstrap.set_defaults(func=cmd_bootstrap)
    apply = sub.add_parser("apply")
    apply.add_argument("--profile", required=True)
    apply.add_argument("--tags")
    apply.add_argument("--check", action="store_true")
    apply.add_argument("--direct", action="store_true")
    apply.add_argument(
        "--force-kde",
        action="store_true",
        help="replace conflicting live KDE files after backing them up",
    )
    apply.set_defaults(func=cmd_apply)
    doctor = sub.add_parser("doctor")
    doctor.add_argument("--profile", required=True)
    doctor.set_defaults(func=cmd_doctor)
    update = sub.add_parser("update")
    update.add_argument(
        "--profile",
        help="profile override; Kubuntu, Termux, and Windows infer their host profile",
    )
    update_scope = update.add_mutually_exclusive_group()
    update_scope.add_argument(
        "--system",
        action="store_true",
        help="update all installed operating-system packages",
    )
    update_scope.add_argument(
        "--apps",
        action="store_true",
        help="update all installed applications and developer tools",
    )
    update.add_argument(
        "--check",
        action="store_true",
        help="report pending updates without installing them",
    )
    update.set_defaults(func=cmd_update)
    nvim = sub.add_parser("nvim")
    nvim_sub = nvim.add_subparsers(dest="nvim_action", required=True)
    nvim_update = nvim_sub.add_parser("update")
    nvim_update.add_argument("--profile")
    nvim_update.add_argument(
        "--check",
        action="store_true",
        help="test a candidate update without changing the repository or live plugins",
    )
    nvim_update.set_defaults(func=cmd_nvim)
    nvim_status = nvim_sub.add_parser("status")
    nvim_status.add_argument("--profile")
    nvim_status.set_defaults(func=cmd_nvim, check=False, run_id=None)
    nvim_tools = nvim_sub.add_parser("tools")
    nvim_tools.add_argument("--profile")
    nvim_tools.set_defaults(func=cmd_nvim, check=False, run_id=None)
    nvim_rollback = nvim_sub.add_parser("rollback")
    nvim_rollback.add_argument("run_id")
    nvim_rollback.add_argument("--profile")
    nvim_rollback.set_defaults(func=cmd_nvim, check=False)
    package = sub.add_parser("package")
    package_sub = package.add_subparsers(dest="package_command", required=True)
    add = package_sub.add_parser("add")
    add.add_argument("name")
    add.add_argument("--profile", required=True)
    add.add_argument("--provider")
    add.add_argument("--no-apply", action="store_true")
    add.set_defaults(func=cmd_package_add)
    codex = sub.add_parser("codex")
    codex_sub = codex.add_subparsers(dest="codex_command", required=True)
    codex_install = codex_sub.add_parser("install")
    codex_install.set_defaults(func=cmd_codex_install)
    codex_update = codex_sub.add_parser("update")
    codex_update.set_defaults(func=cmd_codex_update)
    vite_plus = sub.add_parser("vite-plus")
    vite_plus_sub = vite_plus.add_subparsers(dest="vite_plus_command", required=True)
    vite_plus_install = vite_plus_sub.add_parser("install")
    vite_plus_install.set_defaults(func=cmd_vite_plus_install)
    vite_plus_update = vite_plus_sub.add_parser("update")
    vite_plus_update.set_defaults(func=cmd_vite_plus_update)
    tailscale = sub.add_parser("tailscale")
    tailscale.add_argument(
        "tailscale_action",
        choices=["status", "up", "down"],
    )
    tailscale.set_defaults(func=cmd_tailscale)
    gestures = sub.add_parser("gestures")
    gestures.add_argument(
        "gestures_action",
        choices=["status", "reload", "enable", "disable"],
    )
    gestures.set_defaults(func=cmd_gestures)
    repos = sub.add_parser("repos")
    repos_sub = repos.add_subparsers(dest="repos_command", required=True)
    sync = repos_sub.add_parser("sync")
    sync.add_argument("--profile", required=True)
    sync.set_defaults(func=cmd_repos_sync)
    secrets = sub.add_parser("secrets")
    secrets_sub = secrets.add_subparsers(dest="secrets_command", required=True)
    secret_initialize = secrets_sub.add_parser("initialize")
    secret_initialize.add_argument("--draft", required=True)
    secret_initialize.set_defaults(func=cmd_secrets_initialize)
    secret_sync = secrets_sub.add_parser("sync")
    secret_sync.add_argument("--profile", required=True)
    secret_sync.add_argument("--device")
    secret_sync.add_argument("--no-register", action="store_true")
    secret_sync.set_defaults(func=cmd_secrets_sync)
    capture = sub.add_parser("capture")
    capture.add_argument("target", choices=["kde"])
    capture.add_argument(
        "--only",
        action="append",
        metavar="NAME",
        help="capture only a named allowlisted file; may be repeated",
    )
    capture.set_defaults(func=cmd_capture_kde)
    save = sub.add_parser("save")
    save.add_argument("target", nargs="?", choices=["panel", "spectacle"])
    save.add_argument(
        "--yes",
        action="store_true",
        help="skip the interactive diff confirmation",
    )
    save.set_defaults(func=cmd_save)
    diff = sub.add_parser("diff")
    diff.add_argument("target", choices=["kde"])
    diff.set_defaults(func=cmd_diff_kde)
    rollback = sub.add_parser("rollback")
    rollback.add_argument("run_id")
    rollback.set_defaults(func=cmd_rollback)
    return parser


def main() -> int:
    try:
        args = build_parser().parse_args()
        if hasattr(args, "func"):
            args.func(args)
        else:
            cmd_palette()
        return 0
    except DotError as exc:
        print(f"dot: {exc}", file=sys.stderr)
        return 1
    except subprocess.CalledProcessError as exc:
        command = exc.cmd if isinstance(exc.cmd, list) else [str(exc.cmd)]
        program = Path(str(command[0])).name if command else "external command"
        print(f"dot: {program} failed with exit code {exc.returncode}", file=sys.stderr)
        if exc.stderr:
            print(exc.stderr.strip(), file=sys.stderr)
        return exc.returncode or 1


if __name__ == "__main__":
    raise SystemExit(main())
