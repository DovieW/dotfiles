    finally:
        run(["systemctl", "--user", "stop", service], check=False, capture=True)


def apply_direct(
    profile_name: str,
    *,
    force_kde: bool = False,
    selected_tags: set[str] | None = None,
) -> int:
    profile = load_profile(profile_name)
    features = profile.get("features", {})
    changes = 0
    selected_tags = selected_tags or set()
    apply_all = not selected_tags or "all" in selected_tags or "config" in selected_tags

    def selected(*tags: str) -> bool:
        return apply_all or bool(selected_tags.intersection(tags))

    force_kde = force_kde or os.environ.get("DOTFILES_KDE_PREFLIGHT_OK") == "1"
    lockscreen_files = {
        ".config/kscreenlockerrc",
        ".config/plasmashellrc",
    }
    lockscreen_only = (
        features.get("kde")
        and selected("lockscreen")
        and not selected("kde")
    )
    if features.get("kde") and selected("kde"):
        check_kde_apply_conflicts(force=force_kde)
    elif lockscreen_only:
        check_kde_apply_conflicts(force=force_kde, only=lockscreen_files)
    if features.get("shell") and selected("shell", "tmux"):
        mappings = {
            ROOT / "bin/dot": Path.home() / ".local/bin/dot",
            ROOT / "config/shell/bashrc": Path.home() / ".bashrc",
            ROOT / "config/shell/zshrc": Path.home() / ".zshrc",
            ROOT / "config/shell/p10k.zsh": Path.home() / ".p10k.zsh",
            ROOT / "config/shell/mbash": Path.home() / ".local/bin/mbash",
            ROOT / "config/shell/clip": Path.home() / ".local/bin/clip",
            ROOT / "config/shell/cclip": Path.home() / ".local/bin/cclip",
            ROOT / "config/fzf/fzfrc": Path.home() / ".config/fzf/fzfrc",
            ROOT / "config/fzf/preview": Path.home() / ".local/bin/dot-fzf-preview",
            ROOT / "config/tmux/tmux.conf": Path.home() / ".config/tmux/tmux.conf",
            ROOT / "config/tmux/open-link": Path.home() / ".local/bin/dot-open-link",
        }
        for source, destination in mappings.items():
            changes += int(link_file(source, destination))
        transcribe_current = (
            Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share"))
            / "dotfiles/transcribe/current/transcribe"
        )
        transcribe_source = (
            transcribe_current
            if transcribe_current.is_file()
            else ROOT / "config/transcription/transcribe"
        )
        changes += int(
            link_file(
                transcribe_source,
                Path.home() / ".local/bin/transcribe",
            )
        )
    if features.get("neovim") and selected("nvim"):
        changes += int(link_file(ROOT / "config/nvim", Path.home() / ".config/nvim"))
    if features.get("git") and selected("git"):
        include = ROOT / "config/git/root.gitconfig"
        proc = run(["git", "config", "--global", "--get-all", "include.path"], check=False, capture=True)
        includes = proc.stdout.splitlines() if proc.returncode == 0 else []
        if str(include) not in includes:
            run(["git", "config", "--global", "--add", "include.path", str(include)])
            changes += 1
        for tool in ("git-abort", "git-repo-analysis", "git-stage-executable", "git-switcher"):
            source = ROOT / "config/git/bin" / tool
            if source.exists():
                changes += int(link_file(source, Path.home() / ".local/bin" / tool))
    if features.get("tailscale") and selected("tailscale"):
        changes += int(
            link_file(
                ROOT / "config/tailscale/tailscale-systray.desktop",
                Path.home() / ".config/autostart/tailscale-systray.desktop",
            )
        )
    if (
        features.get("nvidia_driver")
        and not features.get("nvidia_settings_autostart", True)
        and selected("gpu", "kde")
    ):
        nvidia_autostart_changed = link_file(
            ROOT / "config/nvidia/nvidia-settings-autostart.desktop",
            Path.home() / ".config/autostart/nvidia-settings-autostart.desktop",
        )
        changes += int(nvidia_autostart_changed)
        if nvidia_autostart_changed and command_exists("systemctl"):
            run(["systemctl", "--user", "daemon-reload"], check=False)
            run(
                [
                    "systemctl",
                    "--user",
                    "reset-failed",
                    "app-nvidia\\x2dsettings\\x2dautostart@autostart.service",
                ],
                check=False,
            )
    if features.get("copyq") and selected("clipboard"):
        copyq_mappings = {
            ROOT / "config/copyq/dot-copyq-paste": Path.home() / ".local/bin/dot-copyq-paste",
            ROOT / "config/copyq/dot-copyq-history": Path.home() / ".local/bin/dot-copyq-history",
            ROOT / "scripts/test-copyq-paste": Path.home() / ".local/bin/dot-test-copyq-paste",
            ROOT / "config/copyq/io.github.doview.copyq-history.desktop": Path.home() / ".local/share/applications/io.github.doview.copyq-history.desktop",
            ROOT / "config/copyq/com.github.hluk.copyq.desktop": Path.home() / ".local/share/applications/com.github.hluk.copyq.desktop",
            ROOT / "config/kwin/dot-clipboard/metadata.json": Path.home() / ".local/share/kwin/scripts/dot-clipboard/metadata.json",
            ROOT / "config/kwin/dot-clipboard/contents/code/main.js": Path.home() / ".local/share/kwin/scripts/dot-clipboard/contents/code/main.js",
            ROOT / "config/systemd/user/dot-copyq-history.service": Path.home() / ".config/systemd/user/dot-copyq-history.service",
            ROOT / "config/systemd/user/dot-copyq.service": Path.home() / ".config/systemd/user/dot-copyq.service",
            ROOT / "config/systemd/user/dot-clipboard-probe.service": Path.home() / ".config/systemd/user/dot-clipboard-probe.service",
            ROOT / "config/systemd/user/dot-emoji-picker.service": Path.home() / ".config/systemd/user/dot-emoji-picker.service",
        }
        for source, destination in copyq_mappings.items():
            changes += int(link_file(source, destination))
        obsolete_autostart = Path.home() / ".config/autostart/copyq.desktop"
        legacy_autostarts = (
            obsolete_autostart,
            Path.home() / ".config/autostart/com.github.hluk.copyq.desktop",
        )
        for legacy_autostart in legacy_autostarts:
            legacy_managed = legacy_autostart.is_symlink()
            if legacy_autostart.is_file() and not legacy_autostart.is_symlink():
                legacy_text = legacy_autostart.read_text(
                    encoding="utf-8", errors="replace"
                )
                legacy_managed = bool(
                    "Name=CopyQ" in legacy_text
                    and "/dotfiles/apps/copyq/releases/" in legacy_text
                    and "X-GNOME-Autostart-enabled=true" in legacy_text
                )
            if legacy_managed:
                legacy_autostart.unlink()
                changes += 1
        if command_exists("systemctl"):
            run(["systemctl", "--user", "daemon-reload"])
            copyq_unit = "dot-copyq.service"
            systemd_user = Path.home() / ".config/systemd/user"
            desired_wants = (
                systemd_user / "graphical-session.target.wants" / copyq_unit
            )
            obsolete_wants = systemd_user / "default.target.wants" / copyq_unit
            active = run(
                ["systemctl", "--user", "is-active", "--quiet", copyq_unit],
                check=False,
            ).returncode == 0
            if obsolete_wants.is_symlink():
                obsolete_wants.unlink()
                changes += 1
            if not desired_wants.is_symlink():
                run(["systemctl", "--user", "enable", copyq_unit])
                changes += 1
            if not active and os.environ.get("WAYLAND_DISPLAY"):
                run(["systemctl", "--user", "start", copyq_unit])
                changes += 1
        if command_exists("update-desktop-database"):
            run(
                ["update-desktop-database", str(Path.home() / ".local/share/applications")],
                check=False,
            )
    if features.get("emoji_picker") and selected("emoji", "clipboard"):
        obsolete_emoji_override = (
            Path.home()
            / ".local/share/applications/org.kde.plasma.emojier.desktop"
        )
        if obsolete_emoji_override.is_symlink():
            obsolete_emoji_override.unlink()
            changes += 1
        emoji_mappings = {
            ROOT / "config/emoji-picker/config.json": Path.home() / ".config/emoji-picker/config.json",
            ROOT / "config/emoji-picker/io.github.doview.emoji-picker.desktop": Path.home() / ".local/share/applications/io.github.doview.emoji-picker.desktop",
        }
        for source, destination in emoji_mappings.items():
            changes += int(link_file(source, destination))
        if command_exists("update-desktop-database"):
            run(
                ["update-desktop-database", str(Path.home() / ".local/share/applications")],
                check=False,
            )
    if features.get("kde") and selected("screenshots", "kde"):
        if features.get("luna_ocr"):
            run([str(ROOT / "scripts/install-luna-ocr"), "--ensure"], cwd=ROOT)
        screenshot_mappings = {
            ROOT / "config/kwin/dot-screenshots/metadata.json": Path.home()
            / ".local/share/kwin/scripts/dot-screenshots/metadata.json",
            ROOT / "config/kwin/dot-screenshots/contents/code/main.js": Path.home()
            / ".local/share/kwin/scripts/dot-screenshots/contents/code/main.js",
            ROOT / "config/systemd/user/dot-flameshot-region-clipboard.service": Path.home()
            / ".config/systemd/user/dot-flameshot-region-clipboard.service",
            ROOT / "config/systemd/user/dot-flameshot-full-clipboard.service": Path.home()
            / ".config/systemd/user/dot-flameshot-full-clipboard.service",
            ROOT / "config/systemd/user/dot-active-window-clipboard.service": Path.home()
            / ".config/systemd/user/dot-active-window-clipboard.service",
            ROOT / "config/systemd/user/dot-flameshot-region-editor.service": Path.home()
            / ".config/systemd/user/dot-flameshot-region-editor.service",
            ROOT / "config/systemd/user/dot-screenshots-probe.service": Path.home()
            / ".config/systemd/user/dot-screenshots-probe.service",
            ROOT / "config/systemd/user/dot-luna-ocr-region.service": Path.home()
            / ".config/systemd/user/dot-luna-ocr-region.service",
