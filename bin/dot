            ["systemctl", "is-active", "--quiet", "systemd-oomd.service"],
            check=False,
        ).returncode == 0
        failures += not doctor_check(
            "Memory-pressure recovery",
            oomd_enabled and oomd_active,
            "systemd-oomd enabled and active"
            if oomd_enabled and oomd_active
            else f"run dot apply --profile {profile['name']} --tags memory",
        )
    if profile.get("features", {}).get("tailscale"):
        tailscale_package = run(
