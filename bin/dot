def palette_services_menu(profile: str) -> None:
    while True:
        action = fzf_menu(
            [
                ("tailscale-status", "Tailscale status", "Show tailnet connectivity and peers"),
                ("tailscale-install", "Install or repair Tailscale", "Apply package, repository, and daemon"),
                ("tailscale-up", "Join or reconnect Tailscale", "Open the explicit browser enrollment flow"),
                ("tailscale-down", "Disconnect Tailscale", "Stop tailnet connectivity without removing state"),
                ("meshcentral-status", "MeshCentral status", "Show agent enrollment, service, and configuration state"),
                ("meshcentral-prereqs", "Install MeshCentral prerequisites", "Install HTTPS tooling and repair an existing agent service"),
                ("meshcentral-enroll", "Enroll with MeshCentral", "Paste and validate a Linux agent invitation without retaining it"),
                ("nomachine-status", "NoMachine status", "Show server state and the Tailscale-only listener"),
                ("nomachine-install", "Install or repair NoMachine", "Install the free edition and bind it to Tailscale"),
                ("docker-status", "Docker status", "Show daemon, Compose, and Buildx runtime information"),
                ("docker-repair", "Install or repair Docker", "Apply native Engine, Compose, and Buildx"),
                ("codex-status", "Codex Remote Control status", "Show the persistent user service"),
                ("codex-install", "Install or repair Codex", "Install stable CLI and apply the service"),
                ("codex-update", "Update Codex", "Upgrade the standalone stable CLI"),
                ("vite-install", "Install or repair Vite+", "Install from the managed stable channel"),
                ("vite-update", "Update Vite+", "Upgrade from the stable channel"),
                ("gestures", "Touchpad gestures", "Status, reload, enable, or emergency-disable"),
                ("back", "Back", "Return to the main menu"),
            ],
            prompt="services › ",
        )
        if action in (None, "back"):
            return
        if action == "gestures":
            palette_gestures_menu()
            continue
        if action == "tailscale-down" and not palette_confirm(
            "Disconnect Tailscale",
            "Keep the node enrolled but take this machine off the tailnet",
        ):
            continue
        if action == "meshcentral-enroll" and not palette_confirm(
            "Enroll this laptop with MeshCentral",
            "Paste, validate, download, and run a Linux agent invitation",
        ):
            continue

        def execute() -> None:
            if action == "tailscale-status":
                cmd_tailscale(argparse.Namespace(tailscale_action="status"))
            elif action == "tailscale-install":
                palette_apply(profile, "tailscale")
            elif action in {"tailscale-up", "tailscale-down"}:
                cmd_tailscale(
                    argparse.Namespace(
                        tailscale_action=action.removeprefix("tailscale-")
                    )
                )
            elif action == "meshcentral-status":
                cmd_meshcentral(argparse.Namespace(meshcentral_action="status"))
            elif action == "meshcentral-prereqs":
                palette_apply(profile, "meshcentral")
            elif action == "meshcentral-enroll":
                cmd_meshcentral(argparse.Namespace(meshcentral_action="enroll"))
            elif action == "nomachine-status":
                run(["/etc/NX/nxserver", "--status"])
                run(["ss", "-lntup", "sport = :4000"])
            elif action == "nomachine-install":
                palette_apply(profile, "nomachine")
            elif action == "docker-status":
                run(["docker", "info"])
                run(["docker", "compose", "version"])
                run(["docker", "buildx", "version"])
            elif action == "docker-repair":
                palette_apply(profile, "docker")
            elif action == "codex-status":
                run(
                    [
                        "systemctl",
                        "--user",
                        "status",
                        "--no-pager",
                        "codex-remote-control.service",
                    ]
                )
            elif action == "codex-install":
                cmd_codex_install(argparse.Namespace())
                palette_apply(profile, "codex")
            elif action == "codex-update":
                cmd_codex_update(argparse.Namespace())
            elif action == "vite-install":
                cmd_vite_plus_install(argparse.Namespace())
            elif action == "vite-update":
                cmd_vite_plus_update(argparse.Namespace())

        palette_execute(execute)


def palette_diagnostics_menu(profile: str) -> None:
    while True:
        action = fzf_menu(
            [
                ("doctor", "Run complete doctor", "Inspect packages, services, credentials, KDE, and drift"),
                ("tests", "Run validation suite", "Execute schemas, unit tests, shell tests, and safety scans"),
                ("updates", "Check pending updates", "Read-only report across managed update providers"),
                ("drift", "Review KDE drift", "Compare live allowlisted settings against dotfiles"),
                (
                    "panel",
                    "Check taskbar and System Tray",
                    "Validate profile geometry, widget order, tray visibility, and desktop policy",
                ),
                ("nvim", "Test Neovim", "Run the managed headless smoke test"),
                ("gestures", "Test gestures", "Validate InputActions build, effect, and configuration"),
                ("services", "Show failed system services", "List failed system and user units"),
                ("git", "Show dotfiles Git status", "Inspect branch, upstream, index, and worktree"),
                ("back", "Back", "Return to the main menu"),
            ],
            prompt="diagnostics › ",
        )
        if action in (None, "back"):
            return

        def execute() -> None:
            if action == "doctor":
                cmd_doctor(argparse.Namespace(profile=profile))
            elif action == "tests":
                run([str(ROOT / "tests/run")], cwd=ROOT)
            elif action == "updates":
                cmd_update(
                    argparse.Namespace(
                        profile=profile,
                        system=False,
                        apps=False,
                        check=True,
                    )
                )
            elif action == "drift":
                cmd_diff_kde(argparse.Namespace())
            elif action == "panel":
                cmd_panel(
                    argparse.Namespace(
                        panel_action="status",
                        profile_name=None,
                    )
                )
            elif action == "nvim":
                cmd_nvim(
                    argparse.Namespace(
                        nvim_action="status",
                        profile=profile,
                        check=False,
                        run_id=None,
                    )
                )
            elif action == "gestures":
                cmd_gestures(argparse.Namespace(gestures_action="status"))
            elif action == "services":
                run(["systemctl", "--failed", "--no-pager"], check=False)
                run(["systemctl", "--user", "--failed", "--no-pager"], check=False)
            elif action == "git":
                run(["git", "status", "--short", "--branch"], cwd=ROOT)

        palette_execute(execute)


def palette_advanced_menu(profile: str) -> None:
    while True:
        action = fzf_menu(
            [
                ("bootstrap", "Bootstrap a profile", "Check prerequisites, apply, and optionally provision secrets"),
                ("secrets-sync", "Sync identity and SSH key", "Unlock Bitwarden and provision this device"),
                (
                    "secrets-sync-local",
                    "Sync secrets without GitHub",
                    "Provision local identity and key files without registering keys",
                ),
                ("secrets-init", "Initialize bootstrap note", "Create the private Bitwarden manifest from a local draft"),
                ("repos", "Sync repositories", "Clone or fetch repositories from the private manifest"),
                ("device", "Show device identity", "Display the stable logical device ID"),
                ("back", "Back", "Return to the main menu"),
            ],
            prompt="advanced › ",
        )
        if action in (None, "back"):
            return
        if action == "device":
            palette_execute(
                lambda: print(
                    json.dumps(
                        load_json(CONFIG_DIR / "device.json"),
                        indent=2,
                    )
                )
            )
            continue
        if action == "bootstrap":
            selected_profile = palette_profile()
            if not selected_profile:
                continue
            secret_mode = fzf_menu(
                [
                    ("secrets", "Bootstrap with secrets", "Provision identity, SSH, repositories, and profile"),
                    ("skip", "Bootstrap without secrets", "Apply only public packages and configuration"),
                    ("cancel", "Cancel", "Return without changing the machine"),
                ],
                prompt="bootstrap › ",
            )
            if secret_mode in (None, "cancel"):
                continue
            device = palette_text("Device ID", default=inferred_device_id())
            palette_execute(
                lambda: cmd_bootstrap(
                    argparse.Namespace(
                        profile=selected_profile,
                        device=device,
                        skip_secrets=secret_mode == "skip",
                    )
                )
            )
        elif action in {"secrets-sync", "secrets-sync-local"}:
            device = palette_text("Device ID", default=inferred_device_id())
            palette_execute(
                lambda: cmd_secrets_sync(
                    argparse.Namespace(
                        profile=profile,
                        device=device,
                        no_register=action == "secrets-sync-local",
                    )
                )
            )
        elif action == "secrets-init":
            draft = palette_text(
                "Permission-locked bootstrap draft",
                default=str(CONFIG_DIR / "bootstrap-draft.json"),
            )
            if draft and palette_confirm(
                "Create the Bitwarden bootstrap note",
                "This refuses to overwrite an existing dotfiles/bootstrap-v1 item",
            ):
                palette_execute(
                    lambda: cmd_secrets_initialize(
                        argparse.Namespace(draft=draft)
                    )
                )
        elif action == "repos":
            palette_execute(
                lambda: cmd_repos_sync(argparse.Namespace(profile=profile))
            )


def cmd_palette() -> None:
    if not sys.stdin.isatty():
        raise DotError("The interactive command palette requires a terminal; use `dot --help`.")
    try:
        profile = update_profile(None)
    except DotError:
        profile = palette_profile() or ""
    if not profile:
        return
    while True:
        action = fzf_menu(
            [
                ("update", "Update", "Update everything or choose an individual provider"),
                ("apply", "Apply and repair", "Reconcile a full profile or one subsystem"),
                ("configuration", "Save and configuration", "Capture, diff, apply, and rollback desktop settings"),
                ("neovim", "Neovim", "Test, update, repair, or rollback the editor environment"),
                ("clipboard", "Clipboard and Emoji", "CopyQ history and direct-insertion emoji tools"),
                ("repositories", "Repositories and packages", "Sync repos, add packages, and inspect manifests"),
                ("services", "Network and services", "Tailscale, MeshCentral, Docker, Codex, Vite+, and gestures"),
                ("diagnostics", "Diagnostics", "Doctor, tests, drift, update checks, and service failures"),
                ("advanced", "Bootstrap and secrets", "Device identity, Bitwarden, bootstrap, and repository setup"),
                ("profile", "Switch active profile", f"Currently using {profile}"),
                ("exit", "Exit", "Close the dot command palette"),
            ],
            prompt=f"dot [{profile}] › ",
            header="Type to filter  Enter: open  Esc: exit",
        )
        if action in (None, "exit"):
            return
        if action == "profile":
            profile = palette_profile() or profile
        elif action == "update":
            palette_update_menu(profile)
        elif action == "apply":
            palette_apply_menu(profile)
        elif action == "configuration":
            palette_configuration_menu(profile)
        elif action == "neovim":
            palette_neovim_menu(profile)
        elif action == "clipboard":
            palette_clipboard_menu(profile)
        elif action == "repositories":
            palette_repositories_menu(profile)
        elif action == "services":
            palette_services_menu(profile)
        elif action == "diagnostics":
            palette_diagnostics_menu(profile)
        elif action == "advanced":
            palette_advanced_menu(profile)


def doctor_check(label: str, ok: bool, detail: str) -> bool:
    print(f"[{'OK' if ok else 'FAIL'}] {label}: {detail}")
    return ok


def cmd_doctor(args: argparse.Namespace) -> None:
    profile = load_profile(args.profile)
    failures = 0
    expected_platform = {
        "kubuntu-laptop": "linux",
        "kubuntu-desktop": "linux",
        "wsl-personal": "wsl",
        "wsl-work": "wsl",
        "windows-host": "windows",
        "termux": "termux",
    }.get(profile["name"])
    actual_platform = infer_platform()
    failures += not doctor_check("platform", actual_platform == expected_platform, f"{actual_platform}; expected {expected_platform}")
    failures += not doctor_check("device", (CONFIG_DIR / "device.json").exists(), str(CONFIG_DIR / "device.json"))
    packages = profile.get("packages", {})
    apt_packages = packages.get("apt", [])
    if apt_packages and command_exists("dpkg-query"):
        missing_apt = []
        outdated_apt = []
        for package in apt_packages:
            proc = run(
                ["dpkg-query", "-W", "-f=${Version}", package],
                check=False,
                capture=True,
            )
            if proc.returncode:
                missing_apt.append(package)
                continue
            if command_exists("apt-cache") and command_exists("dpkg"):
                policy = run(["apt-cache", "policy", package], check=False, capture=True)
                candidate = next(
                    (
                        line.split(":", 1)[1].strip()
                        for line in policy.stdout.splitlines()
                        if line.strip().startswith("Candidate:")
                    ),
                    "",
                )
                if candidate and candidate != "(none)":
                    comparison = run(
                        ["dpkg", "--compare-versions", proc.stdout.strip(), "ge", candidate],
                        check=False,
                    )
                    if comparison.returncode != 0:
                        outdated_apt.append(f"{package} ({proc.stdout.strip()} < {candidate})")
        failures += not doctor_check(
            "APT packages",
            not missing_apt and not outdated_apt,
            "all present at latest repository candidates"
            if not missing_apt and not outdated_apt
            else "; ".join(
                part
                for part in (
                    f"missing {', '.join(missing_apt)}" if missing_apt else "",
                    f"outdated {', '.join(outdated_apt)}" if outdated_apt else "",
                )
                if part
            ),
        )
    deb_packages = packages.get("deb", [])
    if deb_packages and command_exists("dpkg-query") and command_exists("dpkg-deb"):
        stale_deb = []
        for package in deb_packages:
            installed = run(
                ["dpkg-query", "-W", "-f=${Version}", package],
                check=False,
                capture=True,
            )
            latest_asset = run(
                [str(ROOT / "scripts/fetch-external-deb"), package],
                check=False,
                capture=True,
            )
            if installed.returncode or latest_asset.returncode:
                stale_deb.append(package)
                continue
            latest = run(
                ["dpkg-deb", "--field", latest_asset.stdout.strip(), "Version"],
                check=False,
                capture=True,
            )
            if latest.returncode or installed.stdout.strip() != latest.stdout.strip():
                stale_deb.append(
                    f"{package} ({installed.stdout.strip() or 'missing'} -> "
                    f"{latest.stdout.strip() or 'unknown'})"
                )
        failures += not doctor_check(
            "External Debian packages",
            not stale_deb,
            "all at latest stable releases"
            if not stale_deb
            else f"missing or outdated {', '.join(stale_deb)}",
        )
    brew_packages = packages.get("brew", [])
    if brew_packages:
        if not command_exists("brew"):
            failures += not doctor_check("Homebrew packages", False, "brew is not installed")
        else:
            proc = run(["brew", "list", "--formula"], check=False, capture=True)
            installed = set(proc.stdout.splitlines())
            missing_brew = [package for package in brew_packages if package not in installed]
            outdated = run(["brew", "outdated", "--formula"], check=False, capture=True)
            outdated_brew = sorted(set(outdated.stdout.splitlines()) & set(brew_packages))
            failures += not doctor_check(
                "Homebrew packages",
                not missing_brew and not outdated_brew,
                "all present at latest stable releases"
                if not missing_brew and not outdated_brew
                else "; ".join(
                    part
                    for part in (
                        f"missing {', '.join(missing_brew)}" if missing_brew else "",
                        f"outdated {', '.join(outdated_brew)}" if outdated_brew else "",
                    )
                    if part
                ),
            )
    pkg_packages = packages.get("pkg", [])
    if pkg_packages and command_exists("pkg"):
        proc = run(["pkg", "list-installed"], check=False, capture=True)
        installed_pkg = {line.split("/", 1)[0] for line in proc.stdout.splitlines() if "/" in line}
        missing_pkg = [package for package in pkg_packages if package not in installed_pkg]
        failures += not doctor_check(
            "Termux packages",
            not missing_pkg,
            "all present; pkg upgrade supplies latest stable repository releases"
            if not missing_pkg
            else f"missing {', '.join(missing_pkg)}",
        )
    snap_packages = packages.get("snap", [])
    if snap_packages:
        proc = run(["snap", "list"], check=False, capture=True)
        installed_snaps = {line.split()[0] for line in proc.stdout.splitlines()[1:] if line.split()}
        missing_snaps = [
            package
            for package in snap_packages
            if package not in installed_snaps and not command_exists(package)
        ]
        failures += not doctor_check(
            "Snap packages",
            not missing_snaps,
            "all present" if not missing_snaps else f"missing {', '.join(missing_snaps)}",
        )
    if profile.get("features", {}).get("docker_engine"):
        docker_packages = (
            "containerd.io",
            "docker-buildx-plugin",
            "docker-ce",
            "docker-ce-cli",
            "docker-compose-plugin",
        )
        missing_docker = []
        for package in docker_packages:
            installed = run(
                ["dpkg-query", "-W", "-f=${db:Status-Status}", package],
                check=False,
                capture=True,
            )
            if installed.returncode != 0 or installed.stdout.strip() != "installed":
                missing_docker.append(package)
        failures += not doctor_check(
            "Docker packages",
            not missing_docker,
            "official engine, Compose, and Buildx installed"
            if not missing_docker
            else f"missing {', '.join(missing_docker)}",
        )
        docker_location = shutil.which("docker")
        docker_path = Path(docker_location) if docker_location else None
        failures += not doctor_check(
            "Docker CLI ownership",
            docker_path is not None and docker_path.resolve() == Path("/usr/bin/docker"),
            str(docker_path) if docker_path is not None else "not installed",
        )
        docker_active = run(
            ["systemctl", "is-active", "--quiet", "docker"],
            check=False,
        ).returncode == 0
        containerd_active = run(
            ["systemctl", "is-active", "--quiet", "containerd"],
            check=False,
        ).returncode == 0
        failures += not doctor_check(
            "Docker services",
            docker_active and containerd_active,
            "docker and containerd active"
            if docker_active and containerd_active
            else "run dot apply --profile " + profile["name"] + " --tags docker",
        )
        try:
            import grp

            docker_group = grp.getgrnam("docker")
            has_docker_group = (
                getpass.getuser() in docker_group.gr_mem
                or os.getgid() == docker_group.gr_gid
            )
        except (ImportError, KeyError):
            has_docker_group = False
        failures += not doctor_check(
            "Docker socket access",
            has_docker_group,
            "user is assigned to docker group; log out and back in after first apply"
