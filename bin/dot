def cmd_tailscale(args: argparse.Namespace) -> None:
    require_commands(
        ["tailscale"],
        "Run `dot apply --profile kubuntu-laptop --tags tailscale` first.",
    )
    action = args.tailscale_action
    if action == "status":
        status = run(["tailscale", "status"], check=False)
        if status.returncode:
            raise DotError(
                "Tailscale is not connected. Run `sudo tailscale up` to enroll "
                "or reconnect this machine."
            )
        return
    require_commands(["sudo"], "Install sudo before changing Tailscale state.")
    run(["sudo", "tailscale", action])


def inputactions_effect_loaded() -> bool:
    if not command_exists("qdbus6"):
        return False
    result = run(
        [
            "qdbus6",
            "org.kde.KWin",
            "/Effects",
            "org.kde.kwin.Effects.isEffectLoaded",
            "kwin_gestures",
        ],
        check=False,
        capture=True,
    )
    return result.returncode == 0 and result.stdout.strip() == "true"


def cmd_gestures(args: argparse.Namespace) -> None:
    action = args.gestures_action
    if action == "disable":
        require_commands(
            ["kwriteconfig6"],
            "Install KDE command-line configuration tools.",
        )
        run(
            [
                "kwriteconfig6",
                "--file",
                "kwinrc",
                "--group",
                "Plugins",
                "--key",
                "kwin_gesturesEnabled",
                "false",
            ]
        )
        if command_exists("qdbus6") and inputactions_effect_loaded():
            run(
                [
                    "qdbus6",
                    "org.kde.KWin",
                    "/Effects",
                    "org.kde.kwin.Effects.unloadEffect",
                    "kwin_gestures",
                ]
            )
        print(
            "InputActions is disabled for this session and in the live KWin "
            "configuration. Re-enable it with `dot gestures enable`."
        )
        return

    if action == "enable":
        require_commands(
            ["inputactions", "kwriteconfig6", "qdbus6"],
            "Run `dot apply --profile kubuntu-laptop --tags gestures` first.",
        )
        run(
            [
                "kwriteconfig6",
                "--file",
                "kwinrc",
                "--group",
                "Plugins",
                "--key",
                "kwin_gesturesEnabled",
                "true",
            ]
        )
        if not inputactions_effect_loaded():
            loaded = run(
                [
                    "qdbus6",
                    "org.kde.KWin",
                    "/Effects",
                    "org.kde.kwin.Effects.loadEffect",
                    "kwin_gestures",
                ],
                check=False,
                capture=True,
            )
            if loaded.returncode != 0 or loaded.stdout.strip() != "true":
                raise DotError(
                    "KWin could not load InputActions. Log out and back in, "
                    "then run `dot gestures status`."
                )
        run(["inputactions", "config", "reload"])
        run(["inputactions", "config", "issues"])
        print("Windows-style touchpad gestures are enabled.")
        return

    if action == "reload":
        require_commands(
            ["inputactions"],
            "Run `dot apply --profile kubuntu-laptop --tags gestures` first.",
        )
        if not inputactions_effect_loaded():
            raise DotError("InputActions is disabled; run `dot gestures enable`.")
        copy_managed_file(
            ROOT / "config/inputactions/config.yaml",
            Path.home() / ".config/inputactions/config.yaml",
        )
        copy_managed_file(
            ROOT / "config/inputactions/dot-show-desktop",
            Path.home() / ".local/bin/dot-show-desktop",
        )
        run(["inputactions", "config", "reload"])
        run(["inputactions", "config", "issues"])
        print("Installed, reloaded, and validated the touchpad gesture configuration.")
        return

    build_check = run(
        [str(ROOT / "scripts/build-inputactions"), "--check"],
        check=False,
        capture=True,
    )
    config_source = ROOT / "config/inputactions/config.yaml"
    config_live = Path.home() / ".config/inputactions/config.yaml"
    helper_source = ROOT / "config/inputactions/dot-show-desktop"
    helper_live = Path.home() / ".local/bin/dot-show-desktop"
    config_matches = (
        config_live.is_file()
        and config_live.read_bytes() == config_source.read_bytes()
        and helper_live.is_file()
        and helper_live.read_bytes() == helper_source.read_bytes()
        and os.access(helper_live, os.X_OK)
    )
    issues = run(
        ["inputactions", "config", "issues"],
        check=False,
        capture=True,
    ) if command_exists("inputactions") and inputactions_effect_loaded() else None
    print(
        f"[{'OK' if build_check.returncode == 0 else 'FAIL'}] build: "
        f"{(build_check.stdout or build_check.stderr).strip()}"
    )
    print(
        f"[{'OK' if config_matches else 'FAIL'}] config: "
        f"{'matches dotfiles' if config_matches else 'run dot apply --profile kubuntu-laptop --tags gestures'}"
    )
    print(
        f"[{'OK' if inputactions_effect_loaded() else 'FAIL'}] KWin effect: "
        f"{'loaded' if inputactions_effect_loaded() else 'disabled or unavailable'}"
    )
    if issues is not None:
        detail = (issues.stdout or issues.stderr).strip() or "no configuration issues"
        print(f"[{'OK' if issues.returncode == 0 else 'FAIL'}] validation: {detail}")
    if (
        build_check.returncode != 0
        or not config_matches
        or not inputactions_effect_loaded()
        or (issues is not None and issues.returncode != 0)
    ):
        raise DotError("Touchpad gesture status has failing checks.")


def active_package_transactions() -> list[str]:
    """Find native package-manager mutations already running for this host."""
    active: set[str] = set()
    for command_line in Path("/proc").glob("[0-9]*/cmdline"):
        try:
            arguments = [
                value.decode(errors="replace")
                for value in command_line.read_bytes().split(b"\0")
                if value
            ]
        except (OSError, PermissionError):
            continue
        if not arguments:
            continue
        program = Path(arguments[0]).name
        if program in {"apt", "apt-get", "dpkg", "unattended-upgrade"}:
            active.add(" ".join(arguments[:3]))
        elif program == "snap" and any(
            action in arguments[1:]
            for action in {"refresh", "install", "remove", "revert"}
        ):
            active.add(" ".join(arguments[:3]))
    return sorted(active)


def report_pending_updates(profile: dict[str, Any], *, system: bool, apps: bool) -> None:
    pending = 0
    if system and command_exists("apt-get"):
        apt = run(["apt-get", "--simulate", "dist-upgrade"], check=False, capture=True)
        if apt.returncode:
            raise DotError((apt.stderr or apt.stdout).strip() or "APT update check failed.")
        apt_packages = re.findall(r"^Inst\s+(\S+)", apt.stdout, re.MULTILINE)
        pending += len(apt_packages)
        detail = ", ".join(apt_packages[:12])
        if len(apt_packages) > 12:
            detail += f", and {len(apt_packages) - 12} more"
        print(f"APT: {len(apt_packages)} update(s){f' — {detail}' if detail else ''}")

    if apps and command_exists("snap"):
        snap = run(["snap", "refresh", "--list"], check=False, capture=True)
        snap_output = (snap.stdout or snap.stderr).strip()
        if snap.returncode and "All snaps up to date" not in snap_output:
            raise DotError(snap_output or "Snap update check failed.")
        snap_lines = [
            line
            for line in snap_output.splitlines()
            if line.strip() and not line.startswith("Name") and "up to date" not in line
        ]
        pending += len(snap_lines)
        print(f"Snap: {len(snap_lines)} update(s)")

    if apps and command_exists("brew"):
        brew = run(["brew", "outdated", "--formula"], check=False, capture=True)
        if brew.returncode:
            raise DotError((brew.stderr or brew.stdout).strip() or "Homebrew update check failed.")
        brew_packages = [line for line in brew.stdout.splitlines() if line.strip()]
        pending += len(brew_packages)
        print(f"Homebrew: {len(brew_packages)} update(s)")

    if apps and profile.get("packages", {}).get("deb"):
        external_updates: list[str] = []
        for name in profile["packages"]["deb"]:
            resolved = run(
                [str(ROOT / "scripts/fetch-external-deb"), name],
                check=False,
                capture=True,
            )
            if resolved.returncode:
                raise DotError(
                    (resolved.stderr or resolved.stdout).strip()
                    or f"Could not check {name}."
                )
            package_path = Path(resolved.stdout.strip())
            package_name = run(
                ["dpkg-deb", "--field", str(package_path), "Package"],
                capture=True,
            ).stdout.strip()
            available = run(
                ["dpkg-deb", "--field", str(package_path), "Version"],
                capture=True,
            ).stdout.strip()
            installed = run(
                ["dpkg-query", "-W", "-f=${Version}", package_name],
                check=False,
                capture=True,
            )
            newer = installed.returncode != 0 or run(
                ["dpkg", "--compare-versions", available, "gt", installed.stdout.strip()],
                check=False,
            ).returncode == 0
            if newer:
                external_updates.append(name)
        pending += len(external_updates)
        print(
            f"External applications: {len(external_updates)} update(s)"
            f"{f' — {', '.join(external_updates)}' if external_updates else ''}"
        )

    print(f"Total provider updates currently visible: {pending}")


def update_profile(explicit: str | None) -> str:
    if explicit:
        return explicit
    detected = infer_platform()
    defaults = {
        "linux": "kubuntu-laptop",
        "termux": "termux",
        "windows": "windows-host",
    }
    if detected in defaults:
        return defaults[detected]
    raise DotError(
        "This host has more than one applicable profile. "
        "Choose --profile wsl-personal or --profile wsl-work."
    )


def cmd_update(args: argparse.Namespace) -> None:
    profile_name = update_profile(getattr(args, "profile", None))
    profile = load_profile(profile_name)
    if profile.get("features", {}).get("windows_inventory_only"):
        raise DotError(
            "Windows is inventory-only; update applications with their native "
            "stable channels, then recapture the inventory."
        )
    system = bool(getattr(args, "system", False))
    apps = bool(getattr(args, "apps", False))
    if not system and not apps:
        system = apps = True
    if getattr(args, "check", False):
        report_pending_updates(profile, system=system, apps=apps)
        if apps and profile.get("features", {}).get("neovim"):
            cmd_nvim(
                argparse.Namespace(
                    nvim_action="update",
                    profile=profile_name,
                    check=True,
                    run_id=None,
                )
            )
        return
    blockers = active_package_transactions()
    if blockers:
        raise DotError(
            "Another package-manager transaction is already running:\n  "
            + "\n  ".join(blockers)
            + "\nWait for it to finish before running dot update."
        )
    selected_tags = []
    if system:
        selected_tags.append("system-updates")
    if apps:
        selected_tags.append("app-updates")
    cmd_apply(
        argparse.Namespace(
            profile=profile_name,
            tags=",".join(selected_tags),
            check=False,
            direct=False,
            force_kde=False,
        )
    )
    if apps and profile.get("features", {}).get("codex_remote_control"):
        cmd_codex_update(args)
    if apps and profile.get("features", {}).get("vite_plus"):
        cmd_vite_plus_update(args)
    if apps and profile.get("features", {}).get("neovim"):
        cmd_nvim(
            argparse.Namespace(
                nvim_action="update",
                profile=profile_name,
                check=False,
                run_id=None,
            )
        )
        update_nvim_tools()
    categories = "system and application" if system and apps else (
        "system" if system else "application"
    )
    print(f"Updated all installed {categories} packages for {profile['name']}.")


def nvim_environment(root: Path | None = None) -> dict[str, str]:
    env = os.environ.copy()
    path_parts = env.get("PATH", "").split(os.pathsep)
    if str(LINUXBREW_BIN) not in path_parts:
        env["PATH"] = os.pathsep.join([str(LINUXBREW_BIN), *path_parts])
    if root is not None:
        env.update(
            {
                "XDG_CONFIG_HOME": str(root / "config"),
                "XDG_DATA_HOME": str(root / "data"),
                "XDG_STATE_HOME": str(root / "state"),
                "XDG_CACHE_HOME": str(root / "cache"),
            }
        )
    return env


def run_nvim_smoke(*, env: dict[str, str] | None = None) -> None:
    require_commands(["nvim"], "Run `dot apply --profile PROFILE --tags packages,nvim` first.")
    config_home = Path((env or os.environ).get("XDG_CONFIG_HOME", Path.home() / ".config"))
    smoke = config_home / "nvim/tests/smoke.lua"
    run(
        [
            "nvim",
            "--headless",
            "+lua vim.g.dovie_headless=true",
            f"+lua dofile({json.dumps(str(smoke))})",
            "+qa",
        ],
        env=env or nvim_environment(),
        capture=True,
        timeout=180,
    )


def prepare_nvim_candidate(root: Path) -> tuple[dict[str, str], Path]:
    candidate = root / "config/nvim"
    candidate.parent.mkdir(parents=True, exist_ok=True)
    shutil.copytree(NVIM_CONFIG_DIR, candidate)
    env = nvim_environment(root)
    run(
        ["nvim", "--headless", "+Lazy! update", "+qa"],
        env=env,
        capture=True,
        timeout=600,
    )
    if command_exists("stylua"):
        run(
            ["stylua", "--check", "init.lua", "lua", "tests"],
            cwd=candidate,
            env=env,
        )
    run_nvim_smoke(env=env)
    return env, candidate / "lazy-lock.json"


def nvim_git_environment() -> dict[str, str]:
    env = os.environ.copy()
    if env.get("SSH_AUTH_SOCK") and Path(env["SSH_AUTH_SOCK"]).is_socket():
        return env
    candidates = (
        Path.home() / ".bitwarden-ssh-agent.sock",
        Path.home() / "snap/bitwarden/current/.bitwarden-ssh-agent.sock",
    )
    active = next((path for path in candidates if path.is_socket()), None)
    if active:
        env["SSH_AUTH_SOCK"] = str(active)
    return env


def require_clean_publishable_repo() -> None:
    status = run(["git", "status", "--porcelain"], cwd=ROOT, capture=True).stdout.strip()
    if status:
        raise DotError(
            "Neovim plugin publishing requires a clean dotfiles repository. "
            "Commit or discard the current changes first."
        )
    upstream = run(
        ["git", "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{upstream}"],
        cwd=ROOT,
        check=False,
        capture=True,
    )
    if upstream.returncode:
        raise DotError("The current dotfiles branch has no upstream tracking branch.")
    run(["git", "fetch", "--quiet"], cwd=ROOT, env=nvim_git_environment())
    local = run(["git", "rev-parse", "HEAD"], cwd=ROOT, capture=True).stdout.strip()
    remote = run(["git", "rev-parse", "@{upstream}"], cwd=ROOT, capture=True).stdout.strip()
    if local != remote:
        raise DotError(
            "The dotfiles branch is not synchronized with its upstream. "
            "Pull or push the existing commits before updating Neovim plugins."
        )


def save_nvim_lock_backup() -> str:
    run_id = dt.datetime.now().strftime("%Y%m%d-%H%M%S-%f")
    destination = NVIM_UPDATE_DIR / run_id
    destination.mkdir(parents=True, exist_ok=True)
    if NVIM_LOCK_FILE.exists():
        shutil.copy2(NVIM_LOCK_FILE, destination / "lazy-lock.json")
    atomic_text(
        destination / "metadata.json",
        json.dumps(
            {
                "schema_version": 1,
                "run_id": run_id,
                "created_at": dt.datetime.now(dt.timezone.utc).isoformat(),
                "head": run(["git", "rev-parse", "HEAD"], cwd=ROOT, capture=True).stdout.strip(),
            },
            indent=2,
        )
        + "\n",
        0o600,
    )
    return run_id


def publish_nvim_lock(message: str) -> None:
    changed = run(
        ["git", "status", "--porcelain", "--", str(NVIM_LOCK_FILE)],
        cwd=ROOT,
        capture=True,
    ).stdout.strip()
    other = run(
        ["git", "status", "--porcelain", "--", ".", f":(exclude){NVIM_LOCK_FILE.relative_to(ROOT)}"],
        cwd=ROOT,
        capture=True,
    ).stdout.strip()
    if not changed or other:
        raise DotError(
            "Refusing the automatic Neovim commit because the lockfile is not "
            "the repository's only change."
        )
    env = nvim_git_environment()
    run(["git", "add", str(NVIM_LOCK_FILE)], cwd=ROOT)
    run(["git", "commit", "-m", message], cwd=ROOT, env=env)
    run(["git", "push"], cwd=ROOT, env=env)


def restore_live_nvim_plugins() -> None:
    run(
        ["nvim", "--headless", "+Lazy! restore", "+qa"],
        env=nvim_environment(),
        capture=True,
        timeout=600,
    )
    run_nvim_smoke()


def update_nvim_tools() -> None:
    require_commands(
        ["nvim"],
        "Run `dot apply --profile PROFILE --tags packages,nvim` first.",
    )
    run(
        [
            "nvim",
            "--headless",
            "+Lazy! load nvim-lspconfig",
            "+MasonToolsUpdateSync",
            "+qa",
        ],
        env=nvim_environment(),
        timeout=1800,
    )
    run_nvim_smoke()
    print("Updated and verified Neovim's curated Mason language tools.")


def cmd_nvim(args: argparse.Namespace) -> None:
    profile_name = update_profile(getattr(args, "profile", None))
    profile = load_profile(profile_name)
    if not profile.get("features", {}).get("neovim"):
        raise DotError(f"Neovim is not enabled for {profile_name}.")
    action = args.nvim_action
    if action == "status":
        run_nvim_smoke()
        print("Neovim configuration and locked plugins passed the smoke test.")
        return
    if action == "tools":
        update_nvim_tools()
        return
    if action == "rollback":
        root = NVIM_UPDATE_DIR / args.run_id
        backup = root / "lazy-lock.json"
        if not backup.is_file():
            raise DotError(f"No Neovim plugin backup exists for {args.run_id}.")
        require_clean_publishable_repo()
        current = NVIM_LOCK_FILE.read_bytes()
        head_before = run(["git", "rev-parse", "HEAD"], cwd=ROOT, capture=True).stdout.strip()
        try:
            atomic_bytes(NVIM_LOCK_FILE, backup.read_bytes())
            restore_live_nvim_plugins()
            publish_nvim_lock(f"rollback Neovim plugins to {args.run_id}")
        except Exception:
            head_after = run(["git", "rev-parse", "HEAD"], cwd=ROOT, capture=True).stdout.strip()
            if head_after == head_before:
                run(
                    ["git", "restore", "--staged", "--", str(NVIM_LOCK_FILE)],
                    cwd=ROOT,
                    check=False,
                )
                atomic_bytes(NVIM_LOCK_FILE, current)
                restore_live_nvim_plugins()
            raise
        print(f"Restored, tested, committed, and pushed Neovim plugin lock {args.run_id}.")
        return

    publish = profile.get("account") != "work"
    if publish and not getattr(args, "check", False):
        require_clean_publishable_repo()
    with tempfile.TemporaryDirectory(prefix="dot-nvim-") as directory:
        _, candidate_lock = prepare_nvim_candidate(Path(directory))
        current = NVIM_LOCK_FILE.read_bytes() if NVIM_LOCK_FILE.exists() else b""
        candidate = candidate_lock.read_bytes()
    if candidate == current:
        print("Neovim plugins already match the latest compatible releases.")
        if not getattr(args, "check", False):
            restore_live_nvim_plugins()
        return
    if getattr(args, "check", False):
        before = json.loads(current or b"{}")
        after = json.loads(candidate)
        changed = sorted(
            name for name in set(before) | set(after) if before.get(name) != after.get(name)
        )
        print(f"Neovim plugins: {len(changed)} update(s) — {', '.join(changed)}")
        return
    if not publish:
        restore_live_nvim_plugins()
        print(
            "The work profile consumes the repository lockfile; plugin publishing "
            "is disabled on this profile."
        )
        return

    run_id = save_nvim_lock_backup()
    head_before = run(["git", "rev-parse", "HEAD"], cwd=ROOT, capture=True).stdout.strip()
    try:
        atomic_bytes(NVIM_LOCK_FILE, candidate)
        restore_live_nvim_plugins()
        run([str(ROOT / "tests/run")], cwd=ROOT)
        publish_nvim_lock("update Neovim plugins")
    except Exception:
        head_after = run(["git", "rev-parse", "HEAD"], cwd=ROOT, capture=True).stdout.strip()
        if head_after == head_before:
            run(
                ["git", "restore", "--staged", "--", str(NVIM_LOCK_FILE)],
                cwd=ROOT,
                check=False,
            )
            backup = NVIM_UPDATE_DIR / run_id / "lazy-lock.json"
            if backup.exists():
                atomic_bytes(NVIM_LOCK_FILE, backup.read_bytes())
                restore_live_nvim_plugins()
        raise
    print(f"Updated, tested, committed, and pushed Neovim plugins. Rollback ID: {run_id}")


def cmd_capture_kde(args: argparse.Namespace) -> None:
    selected = set(args.only or [])
    known_names = {Path(relative).name for relative in KDE_FILES}
    unknown = selected - known_names
    if unknown:
        raise DotError(
            "Unknown KDE capture file(s): "
            + ", ".join(sorted(unknown))
            + ". Choose from: "
            + ", ".join(sorted(known_names))
        )
    captured = 0
    for relative in KDE_FILES:
        if selected and Path(relative).name not in selected:
            continue
        source = Path.home() / relative
        if source.is_file():
            destination = kde_source(relative)
            content = portable_kde_content(relative, source.read_bytes())
            captured += int(atomic_bytes(destination, content))
    record_kde_baseline()
    print(f"Captured {captured} changed KDE file(s). Display topology, wallets, caches, and history were excluded.")


def kde_file_diff(relative: str) -> list[str]:
    expected = kde_source(relative)
    actual = Path.home() / relative
    if not expected.exists() and not actual.exists():
        return []
    left = (
        portable_kde_content(relative, expected.read_bytes())
        .decode("utf-8", errors="replace")
        .splitlines(True)
        if expected.exists()
        else []
    )
    right = (
        portable_kde_content(relative, actual.read_bytes())
        .decode("utf-8", errors="replace")
        .splitlines(True)
        if actual.exists()
        else []
    )
    return list(
        difflib.unified_diff(
            left,
            right,
            fromfile=str(expected),
            tofile=str(actual),
        )
    )


def fzf_choose(
    rows: list[str],
    *,
    prompt: str,
    header: str = "",
    multi: bool = False,
    preview: str | None = None,
    with_nth: str = "1",
) -> list[str]:
    require_commands(["fzf"], "Install fzf, then rerun the command.")
    command = [
        "fzf",
        "--height=85%",
        "--layout=reverse",
        "--border=rounded",
        "--input-label= Search ",
        "--list-label= Actions ",
        f"--prompt={prompt}",
        "--delimiter=\t",
        f"--with-nth={with_nth}",
    ]
    if header:
        command.extend(["--header", header])
    if multi:
        command.extend(
            [
                "--multi",
                "--bind=ctrl-a:select-all,ctrl-d:deselect-all",
            ]
        )
    if preview:
        command.extend(
            [
                "--preview",
                preview,
                "--preview-window=right,65%,border-left",
                "--preview-label= Details ",
                "--bind=ctrl-/:toggle-preview",
            ]
        )
    proc = subprocess.run(
        command,
        input="\n".join(rows) + "\n",
        text=True,
        stdout=subprocess.PIPE,
        check=False,
    )
    if proc.returncode in (1, 130):
        return []
    if proc.returncode:
        raise DotError(f"fzf failed with exit code {proc.returncode}")
    return [line for line in proc.stdout.splitlines() if line]


def fzf_menu(
    items: list[tuple[str, str, str]],
    *,
    prompt: str,
    header: str = "Enter: select  Esc: back",
) -> str | None:
    """Show described actions while keeping their stable identifiers hidden."""
    if not items:
        return None
    width = min(38, max(len(label) for _, label, _ in items))
    rows = [
        f"{action}\t{label:<{width}}\t{description}"
        for action, label, description in items
    ]
    choice = fzf_choose(
        rows,
        prompt=prompt,
        header=f"{'ACTION':<{width}}  DESCRIPTION  ·  {header}",
        with_nth="2,3",
    )
    return choice[0].split("\t", 1)[0] if choice else None


def palette_pause() -> None:
    if sys.stdin.isatty():
        try:
            input("\nPress Enter to return to the menu… ")
        except EOFError:
            pass


def palette_execute(action: Any, *, pause: bool = True) -> bool:
    """Run a menu action without losing the surrounding navigation."""
    try:
        action()
    except DotError as exc:
        print(f"\ndot: {exc}", file=sys.stderr)
    except subprocess.CalledProcessError as exc:
        command = exc.cmd if isinstance(exc.cmd, list) else [str(exc.cmd)]
        rendered = " ".join(map(str, command))
        print(
            f"\ndot: {rendered} failed with exit code {exc.returncode}",
            file=sys.stderr,
        )
    except KeyboardInterrupt:
        print("\nCancelled.")
    if pause:
        palette_pause()
    return True


PROFILE_DESCRIPTIONS = {
    "kubuntu-laptop": "Native Kubuntu laptop with KDE and hardware integration",
    "wsl-personal": "Personal Ubuntu environment inside Windows",
    "wsl-work": "Work Ubuntu environment inside Windows",
    "windows-host": "Inventory-only native Windows host",
    "termux": "Android Termux environment",
    "common-linux": "Shared Linux base manifest; not a physical machine",
}


def palette_profile(*, include_common: bool = False) -> str | None:
    names = sorted(
        path.stem
        for path in PROFILE_DIR.glob("*.yml")
        if include_common or path.stem != "common-linux"
    )
    return fzf_menu(
        [
            (
                name,
                name,
                PROFILE_DESCRIPTIONS.get(name, "Managed dotfiles profile"),
            )
            for name in names
        ],
        prompt="profile › ",
    )


def palette_text(label: str, *, default: str = "") -> str | None:
    suffix = f" [{default}]" if default else ""
    try:
        value = input(f"{label}{suffix}: ").strip()
    except (EOFError, KeyboardInterrupt):
        print()
        return None
    return value or default or None


def palette_confirm(label: str, description: str) -> bool:
    return (
        fzf_menu(
            [
                ("confirm", label, description),
                ("cancel", "Cancel", "Return without making changes"),
            ],
            prompt="confirm › ",
            header="Enter: choose  Esc: cancel",
        )
        == "confirm"
    )


def palette_backup_run_id(root: Path, *, prompt: str) -> str | None:
    items: list[tuple[str, str, str]] = []
    if root.is_dir():
        for path in sorted(root.iterdir(), reverse=True):
            if not path.is_dir():
                continue
            metadata_path = path / "metadata.json"
            manifest_path = path / "manifest.json"
            if metadata_path.is_file():
                metadata = load_json(metadata_path)
                detail = (
                    f"Created {metadata.get('created_at', 'unknown')} · "
                    f"base commit {str(metadata.get('head', 'unknown'))[:12]}"
                )
            elif manifest_path.is_file():
                manifest = load_json(manifest_path)
                targets = ", ".join(
                    Path(record.get("path", "")).name or record.get("path", "")
                    for record in manifest[:3]
                )
                if len(manifest) > 3:
                    targets += f", and {len(manifest) - 3} more"
                detail = f"Restore {len(manifest)} path(s) · {targets}"
            else:
                continue
            items.append((path.name, path.name, detail))
    if not items:
        print("No rollback snapshots are available.")
        palette_pause()
        return None
    return fzf_menu(items, prompt=prompt)


def palette_kde_files(*, prompt: str) -> list[str]:
    rows = [
        (
            Path(relative).name,
            KDE_LABELS[relative],
            str(Path.home() / relative),
        )
        for relative in KDE_FILES
    ]
    width = max(len(label) for _, label, _ in rows)
    choices = fzf_choose(
        [
            f"{name}\t{label:<{width}}\t{path}"
            for name, label, path in rows
        ],
        prompt=prompt,
        header=(
            f"{'SETTING':<{width}}  LIVE FILE  ·  "
            "Tab: toggle  Ctrl-A: all  Ctrl-D: none  Enter: continue"
        ),
        multi=True,
        with_nth="2,3",
    )
    return [choice.split("\t", 1)[0] for choice in choices]


def save_commit_message(selected: list[str]) -> str:
    labels = [KDE_LABELS[relative].lower() for relative in selected]
    if len(labels) == 1:
        return f"update {labels[0]}"
    if len(labels) == 2:
        return f"update {labels[0]} and {labels[1]}"
    return "update KDE settings"


def cmd_save(args: argparse.Namespace) -> None:
    preset = {
        "panel": {
            ".config/kdeglobals",
            ".config/kglobalshortcutsrc",
            ".config/krunnerrc",
            ".config/plasmarc",
            ".config/plasmashellrc",
            ".config/plasma-org.kde.plasma.desktop-appletsrc",
            ".local/share/color-schemes/GitHubDark.colors",
        },
        "spectacle": {
            ".config/spectaclerc",
            ".config/kglobalshortcutsrc",
        },
    }
    allowed = preset.get(args.target, set(KDE_FILES))
    drift: dict[str, list[str]] = {}
    for relative in KDE_FILES:
        if relative not in allowed:
            continue
        diff = kde_file_diff(relative)
        if diff:
            drift[relative] = diff
    if not drift:
        print("No managed configuration changes to save.")
        return

    if args.yes:
        selected = list(drift)
        action = "save"
    else:
        if not sys.stdin.isatty():
            raise DotError("Interactive selection is unavailable; rerun with --yes.")
        with tempfile.TemporaryDirectory(prefix="dot-fzf-") as directory:
            rows: list[str] = []
            for index, (relative, diff) in enumerate(drift.items()):
                preview_path = Path(directory) / f"{index}.diff"
                preview_path.write_text("".join(diff), encoding="utf-8")
                rows.append(
                    "\t".join(
                        [
                            KDE_LABELS[relative],
                            Path(relative).name,
                            str(preview_path),
                            relative,
                        ]
                    )
                )
            choices = fzf_choose(
                rows,
                prompt="Settings to save › ",
                header="Tab: toggle  Ctrl-A: all  Ctrl-D: none  Enter: continue",
                multi=True,
                preview="delta --paging=never < {3}",
                with_nth="1,2",
            )
            selected = [choice.split("\t", 3)[3] for choice in choices]
        if not selected:
            print("Nothing selected.")
            return
        action = fzf_menu(
            [
                (
                    "save",
                    "Save, validate, commit, and push",
                    "Record the selected live settings as the new source of truth",
                ),
                (
                    "capture",
                    "Capture without committing",
                    "Copy settings into dotfiles for manual review",
                ),
                ("cancel", "Cancel", "Leave live and repository settings unchanged"),
            ],
            prompt="Action › ",
            header="Enter: choose  Esc: cancel",
        )
        action = action or "cancel"
        if action == "cancel":
            print("Save cancelled.")
            return

    names = [Path(relative).name for relative in selected]
    paths = [kde_source(relative) for relative in selected]
    dirty_targets = run(
        ["git", "status", "--porcelain", "--", *map(str, paths)],
        cwd=ROOT,
        capture=True,
    ).stdout.strip()
    if dirty_targets:
        raise DotError(
            "Selected dotfiles already have uncommitted repository changes:\n"
            f"{dirty_targets}\nReview or commit them before capturing live state."
        )
    if action == "save":
        staged = run(["git", "diff", "--cached", "--quiet"], cwd=ROOT, check=False)
        if staged.returncode:
            raise DotError(
                "The Git index already contains staged changes. "
                "Commit or unstage them before saving settings."
            )

    originals = {
        path: path.read_bytes() if path.exists() else None
        for path in paths
    }
    cmd_capture_kde(argparse.Namespace(only=names))
    if action == "capture":
        print("Captured selected settings in dotfiles; they remain uncommitted.")
        return

    validation = run([str(ROOT / "tests/run")], cwd=ROOT, check=False)
    if validation.returncode:
        restore_captured_files(originals)
        record_kde_baseline()
        raise DotError("Validation failed; the repository capture was rolled back.")
    run(["git", "add", "--", *map(str, paths)], cwd=ROOT)
    run(["git", "commit", "-m", save_commit_message(selected)], cwd=ROOT)
    run(["git", "push"], cwd=ROOT)
    print("Saved and pushed the selected settings.")


def restore_captured_files(originals: dict[Path, bytes | None]) -> None:
    for path, content in originals.items():
        if content is None:
            if path.exists() or path.is_symlink():
                path.unlink()
        else:
            atomic_bytes(path, content)


def cmd_diff_kde(_args: argparse.Namespace) -> None:
    differences = 0
    output: list[str] = []
    for relative in KDE_FILES:
        diff = kde_file_diff(relative)
        if diff:
            differences += 1
            output.extend(diff)
    if differences:
        rendered = "".join(output)
        if command_exists("delta") and sys.stdout.isatty():
            proc = subprocess.run(
                ["delta", "--paging=always"],
                input=rendered,
                text=True,
                check=False,
            )
            if proc.returncode not in (0, 1):
                raise DotError(f"delta failed with exit code {proc.returncode}")
        else:
            sys.stdout.write(rendered)
        raise DotError(f"KDE drift found in {differences} file(s)")
    print("KDE allowlist matches.")


def cmd_rollback(args: argparse.Namespace) -> None:
    restore_backup(args.run_id)
    print(f"Restored backup {args.run_id}")


def palette_apply(profile: str, tags: str | None = None, *, check: bool = False) -> None:
    cmd_apply(
        argparse.Namespace(
            profile=profile,
            tags=tags,
            check=check,
            direct=False,
            force_kde=False,
        )
    )


def palette_update_menu(profile: str) -> None:
    while True:
        action = fzf_menu(
            [
                (
                    "all",
                    "Update everything",
                    "System, apps, CLIs, Tmux, Neovim plugins, and Mason tools",
                ),
                (
                    "check",
                    "Check for pending updates",
                    "Read-only provider and Neovim plugin update report",
                ),
                (
                    "system",
                    "Update operating system",
                    "Upgrade every installed APT package from configured repositories",
                ),
                (
                    "apps",
                    "Update applications and tools",
                    "Apps, Brew, Tmux, Codex, Vite+, Neovim, and Mason",
                ),
                (
                    "nvim-plugins",
                    "Update Neovim plugins",
                    "Isolate, test, promote, sign, and push the plugin lock",
                ),
                (
                    "nvim-tools",
                    "Update Neovim language tools",
                    "Upgrade curated Mason LSP servers, formatters, and linters",
                ),
                (
                    "tmux",
                    "Update Tmux plugins",
                    "Update TPM and every configured Tmux plugin",
                ),
                ("codex", "Update Codex", "Install the latest stable standalone CLI"),
                ("vite", "Update Vite+", "Upgrade Vite+ from its stable channel"),
                (
                    "tailscale",
                    "Update Tailscale",
                    "Reconcile the official repository, package, and daemon",
                ),
                (
                    "gestures",
                    "Update InputActions",
                    "Build the latest compatible gesture plugin and apply its config",
                ),
                (
                    "font",
                    "Update terminal font",
                    "Install the latest stable FiraCode Nerd Font Mono",
                ),
                ("back", "Back", "Return to the main menu"),
            ],
            prompt="update › ",
        )
        if action in (None, "back"):
            return

        def execute() -> None:
            if action in {"all", "check", "system", "apps"}:
                cmd_update(
                    argparse.Namespace(
                        profile=profile,
                        system=action == "system",
                        apps=action == "apps",
                        check=action == "check",
                    )
                )
            elif action == "nvim-plugins":
                cmd_nvim(
                    argparse.Namespace(
                        nvim_action="update",
                        profile=profile,
                        check=False,
                        run_id=None,
                    )
                )
            elif action == "nvim-tools":
                update_nvim_tools()
            elif action == "tmux":
                palette_apply(profile, "tmux")
            elif action == "codex":
                cmd_codex_update(argparse.Namespace())
            elif action == "vite":
                cmd_vite_plus_update(argparse.Namespace())
            elif action == "tailscale":
                palette_apply(profile, "tailscale")
            elif action == "gestures":
                palette_apply(profile, "gestures")
            elif action == "font":
                palette_apply(profile, "fonts")

        palette_execute(execute)


def palette_apply_menu(profile: str) -> None:
    items = [
        ("all", "Apply complete profile", "Reconcile every declared package and configuration"),
        ("check", "Check complete profile", "Preview Ansible changes without applying them"),
        ("packages", "Packages and applications", "Install every package declared by this profile"),
        ("config", "Portable configuration", "Repair managed links and copied application settings"),
        ("kde", "KDE desktop", "Apply captured Plasma, shortcuts, panel, and power settings"),
        ("shell", "Shell environment", "Apply Bash, Zsh, prompt, helpers, and Tmux files"),
        ("git", "Git configuration", "Apply identities, aliases, Delta, signing, and utilities"),
        ("tmux", "Tmux", "Apply Tmux configuration, TPM, and plugins"),
        ("nvim", "Neovim", "Apply config, locked plugins, parsers, and language tools"),
        ("docker", "Docker Engine", "Repair native engine, Compose, Buildx, and service state"),
        ("tailscale", "Tailscale", "Repair stable repository, package, and daemon"),
        ("gpu", "NVIDIA GPU", "Apply Ubuntu's recommended driver and PRIME policy"),
        ("gestures", "Touchpad gestures", "Build and apply Windows-style InputActions gestures"),
        ("touchpad", "Touchpad workaround", "Apply the scoped libinput jump-detection override"),
        ("fonts", "Fonts", "Provision terminal and Windows-compatible fonts"),
        ("codex", "Codex Remote Control", "Repair the standalone CLI and persistent service"),
        ("back", "Back", "Return to the main menu"),
    ]
    while True:
        action = fzf_menu(items, prompt="apply › ")
        if action in (None, "back"):
            return
        palette_execute(
            lambda: palette_apply(
                profile,
                None if action in {"all", "check"} else action,
                check=action == "check",
            )
        )


def palette_configuration_menu(profile: str) -> None:
    while True:
        action = fzf_menu(
            [
                (
                    "save",
                    "Save changed settings",
                    "Select live KDE changes, validate, commit, and push",
                ),
                (
                    "save-panel",
                    "Save panel and palette",
                    "Capture the taskbar, launcher, appearance, and shortcuts",
                ),
                (
                    "save-spectacle",
                    "Save Spectacle",
                    "Capture screenshot preferences and keyboard shortcuts",
                ),
                (
                    "diff",
                    "Review KDE drift",
                    "Compare portable live settings against dotfiles with Delta",
                ),
                (
                    "capture",
                    "Capture KDE without committing",
                    "Copy all allowlisted live settings into the repository",
                ),
                (
                    "capture-selected",
                    "Capture selected KDE files",
                    "Choose one or more allowlisted live files without committing",
                ),
                (
                    "apply",
                    "Restore KDE from dotfiles",
                    "Safely apply the reviewed repository configuration",
                ),
                (
                    "force",
                    "Force-restore KDE from dotfiles",
                    "Back up and replace conflicting live KDE settings",
                ),
                (
                    "rollback",
                    "Restore a configuration backup",
                    "Choose a previous automatic file backup",
                ),
                ("back", "Back", "Return to the main menu"),
            ],
            prompt="configuration › ",
        )
        if action in (None, "back"):
            return
        if action == "rollback":
            run_id = palette_backup_run_id(BACKUP_DIR, prompt="rollback › ")
            if run_id and palette_confirm(
                "Restore selected backup",
                f"Replace current files with snapshot {run_id}",
            ):
                palette_execute(lambda: cmd_rollback(argparse.Namespace(run_id=run_id)))
            continue
        if action == "capture-selected":
            selected = palette_kde_files(prompt="KDE files › ")
            if selected:
                palette_execute(
                    lambda: cmd_capture_kde(argparse.Namespace(only=selected))
                )
            continue

        def execute() -> None:
            if action == "save":
                cmd_save(argparse.Namespace(target=None, yes=False))
            elif action == "save-panel":
                cmd_save(argparse.Namespace(target="panel", yes=False))
            elif action == "save-spectacle":
                cmd_save(argparse.Namespace(target="spectacle", yes=False))
            elif action == "diff":
                cmd_diff_kde(argparse.Namespace())
            elif action == "capture":
                cmd_capture_kde(argparse.Namespace(only=None))
            elif action == "apply":
                palette_apply(profile, "kde")
            elif action == "force":
                if not palette_confirm(
                    "Back up and replace live KDE settings",
                    "Use the reviewed repository version despite local drift",
                ):
                    return
                cmd_apply(
                    argparse.Namespace(
                        profile=profile,
                        tags="kde",
                        check=False,
                        direct=False,
                        force_kde=True,
                    )
                )

        palette_execute(execute)


def palette_neovim_menu(profile: str) -> None:
    while True:
        action = fzf_menu(
            [
                (
                    "status",
                    "Test current configuration",
                    "Run the headless runtime, parser, mapping, and plugin smoke test",
                ),
                (
                    "check",
                    "Check plugin updates",
                    "Test a candidate plugin graph without changing live state",
                ),
                (
                    "update",
                    "Update plugins",
                    "Test, promote, sign, commit, and push the plugin lock",
                ),
                (
                    "tools",
                    "Update language tools",
                    "Upgrade curated Mason servers, formatters, and linters",
                ),
                (
                    "apply",
                    "Repair Neovim installation",
                    "Apply config, restore locked plugins, and install language tools",
                ),
                (
                    "rollback",
                    "Rollback plugins",
                    "Choose, test, commit, and push a previous plugin lock",
                ),
                ("back", "Back", "Return to the main menu"),
            ],
            prompt="Neovim › ",
        )
        if action in (None, "back"):
            return
        if action == "rollback":
            run_id = palette_backup_run_id(NVIM_UPDATE_DIR, prompt="Neovim rollback › ")
            if run_id and palette_confirm(
                "Rollback Neovim plugins",
                f"Restore, test, commit, and push lock {run_id}",
            ):
                palette_execute(
                    lambda: cmd_nvim(
                        argparse.Namespace(
                            nvim_action="rollback",
                            profile=profile,
                            check=False,
                            run_id=run_id,
                        )
                    )
                )
            continue

        def execute() -> None:
            if action == "apply":
                palette_apply(profile, "nvim")
            elif action == "tools":
                update_nvim_tools()
            else:
                cmd_nvim(
                    argparse.Namespace(
                        nvim_action="status" if action == "status" else "update",
                        profile=profile,
                        check=action == "check",
                        run_id=None,
                    )
                )

        palette_execute(execute)


def palette_repositories_menu(profile: str) -> None:
    while True:
        action = fzf_menu(
            [
                (
                    "sync",
                    "Sync managed repositories",
                    "Read the private Bitwarden manifest and clone or fetch repositories",
                ),
                (
                    "add",
                    "Add a package",
                    "Choose a profile and provider, update its manifest, and optionally apply",
                ),
                (
                    "inventory",
                    "Show package inventory",
                    "Print inherited packages and enabled features for a selected profile",
                ),
                (
                    "git-status",
                    "Show dotfiles Git status",
                    "Display branch, upstream, staged, and working-tree state",
                ),
                ("back", "Back", "Return to the main menu"),
            ],
            prompt="repositories › ",
        )
        if action in (None, "back"):
            return
        if action == "sync":
            palette_execute(
                lambda: cmd_repos_sync(argparse.Namespace(profile=profile))
            )
        elif action == "inventory":
            selected_profile = palette_profile(include_common=True)
            if selected_profile:
                palette_execute(
                    lambda: print(
                        json.dumps(load_profile(selected_profile), indent=2)
                    )
                )
        elif action == "git-status":
            palette_execute(
                lambda: run(["git", "status", "--short", "--branch"], cwd=ROOT)
            )
        elif action == "add":
            package_name = palette_text("Package name")
            if not package_name:
                continue
            selected_profile = palette_profile(include_common=True)
            if not selected_profile:
                continue
            provider = fzf_menu(
                [
                    ("auto", "Automatic provider", "Use the canonical package catalog"),
                    ("apt", "APT", "System library, desktop, driver, or integration"),
                    ("brew", "Homebrew", "Modern shared Linux command-line tool"),
                    ("snap", "Snap", "Curated desktop exception"),
                    ("pkg", "Termux pkg", "Android Termux package"),
                    ("winget", "Winget inventory", "Record a Windows package ID"),
                    ("scoop", "Scoop inventory", "Record a Windows Scoop package"),
                    (
                        "psgallery",
                        "PowerShell Gallery inventory",
                        "Record a PowerShell module",
                    ),
                ],
                prompt="provider › ",
            )
            if provider is None:
                continue
            mode = fzf_menu(
                [
                    ("apply", "Add and apply", "Update the manifest and install it now"),
                    ("record", "Add only", "Update the manifest without installing"),
                    ("cancel", "Cancel", "Do not modify the manifest"),
                ],
                prompt="package action › ",
            )
            if mode in (None, "cancel"):
                continue
            palette_execute(
                lambda: cmd_package_add(
                    argparse.Namespace(
                        name=package_name,
                        profile=selected_profile,
                        provider=None if provider == "auto" else provider,
                        no_apply=mode == "record",
                    )
                )
            )


def palette_gestures_menu() -> None:
    while True:
        action = fzf_menu(
            [
                ("status", "Show gesture status", "Check build, config, KWin effect, and issues"),
                ("reload", "Reload gesture configuration", "Apply repository mappings immediately"),
                ("enable", "Enable custom gestures", "Load InputActions and Windows-style mappings"),
                ("disable", "Emergency-disable gestures", "Unload the custom KWin effect"),
                ("back", "Back", "Return to the previous menu"),
            ],
            prompt="gestures › ",
        )
        if action in (None, "back"):
            return
        if action == "disable" and not palette_confirm(
            "Disable custom gestures",
            "Unload InputActions now; it can be enabled again from this menu",
        ):
            continue
        palette_execute(
            lambda: cmd_gestures(argparse.Namespace(gestures_action=action))
        )


def palette_services_menu(profile: str) -> None:
    while True:
        action = fzf_menu(
            [
                ("tailscale-status", "Tailscale status", "Show tailnet connectivity and peers"),
                ("tailscale-install", "Install or repair Tailscale", "Apply package, repository, and daemon"),
                ("tailscale-up", "Join or reconnect Tailscale", "Open the explicit browser enrollment flow"),
                ("tailscale-down", "Disconnect Tailscale", "Stop tailnet connectivity without removing state"),
                ("docker-status", "Docker status", "Show daemon, Compose, and Buildx runtime information"),
                ("docker-repair", "Install or repair Docker", "Apply native Engine, Compose, and Buildx"),
                ("codex-status", "Codex Remote Control status", "Show the persistent user service"),
                ("codex-install", "Install or repair Codex", "Install stable CLI and apply the service"),
                ("codex-update", "Update Codex", "Upgrade the standalone stable CLI"),
                ("vite-install", "Install or repair Vite+", "Install from the managed stable channel"),
                ("vite-update", "Update Vite+", "Upgrade from the stable channel"),
                ("gestures", "Touchpad gestures", "Status, reload, enable, or emergency-disable"),
                ("back", "Back", "Return to the main menu"),
            ],
            prompt="services › ",
        )
        if action in (None, "back"):
            return
        if action == "gestures":
            palette_gestures_menu()
            continue
        if action == "tailscale-down" and not palette_confirm(
            "Disconnect Tailscale",
            "Keep the node enrolled but take this machine off the tailnet",
        ):
            continue

        def execute() -> None:
            if action == "tailscale-status":
                cmd_tailscale(argparse.Namespace(tailscale_action="status"))
            elif action == "tailscale-install":
                palette_apply(profile, "tailscale")
            elif action in {"tailscale-up", "tailscale-down"}:
                cmd_tailscale(
                    argparse.Namespace(
                        tailscale_action=action.removeprefix("tailscale-")
                    )
                )
            elif action == "docker-status":
                run(["docker", "info"])
                run(["docker", "compose", "version"])
                run(["docker", "buildx", "version"])
            elif action == "docker-repair":
                palette_apply(profile, "docker")
            elif action == "codex-status":
                run(
                    [
                        "systemctl",
                        "--user",
                        "status",
                        "--no-pager",
                        "codex-remote-control.service",
                    ]
                )
            elif action == "codex-install":
                cmd_codex_install(argparse.Namespace())
                palette_apply(profile, "codex")
            elif action == "codex-update":
                cmd_codex_update(argparse.Namespace())
            elif action == "vite-install":
                cmd_vite_plus_install(argparse.Namespace())
            elif action == "vite-update":
                cmd_vite_plus_update(argparse.Namespace())

        palette_execute(execute)


def palette_diagnostics_menu(profile: str) -> None:
    while True:
        action = fzf_menu(
            [
                ("doctor", "Run complete doctor", "Inspect packages, services, credentials, KDE, and drift"),
                ("tests", "Run validation suite", "Execute schemas, unit tests, shell tests, and safety scans"),
                ("updates", "Check pending updates", "Read-only report across managed update providers"),
                ("drift", "Review KDE drift", "Compare live allowlisted settings against dotfiles"),
                ("nvim", "Test Neovim", "Run the managed headless smoke test"),
                ("gestures", "Test gestures", "Validate InputActions build, effect, and configuration"),
                ("services", "Show failed system services", "List failed system and user units"),
                ("git", "Show dotfiles Git status", "Inspect branch, upstream, index, and worktree"),
                ("back", "Back", "Return to the main menu"),
            ],
            prompt="diagnostics › ",
        )
        if action in (None, "back"):
            return

        def execute() -> None:
            if action == "doctor":
                cmd_doctor(argparse.Namespace(profile=profile))
            elif action == "tests":
                run([str(ROOT / "tests/run")], cwd=ROOT)
            elif action == "updates":
                cmd_update(
                    argparse.Namespace(
                        profile=profile,
                        system=False,
                        apps=False,
                        check=True,
                    )
                )
            elif action == "drift":
                cmd_diff_kde(argparse.Namespace())
            elif action == "nvim":
                cmd_nvim(
                    argparse.Namespace(
                        nvim_action="status",
                        profile=profile,
                        check=False,
                        run_id=None,
                    )
                )
            elif action == "gestures":
                cmd_gestures(argparse.Namespace(gestures_action="status"))
            elif action == "services":
                run(["systemctl", "--failed", "--no-pager"], check=False)
                run(["systemctl", "--user", "--failed", "--no-pager"], check=False)
            elif action == "git":
                run(["git", "status", "--short", "--branch"], cwd=ROOT)

        palette_execute(execute)


def palette_advanced_menu(profile: str) -> None:
    while True:
        action = fzf_menu(
            [
                ("bootstrap", "Bootstrap a profile", "Check prerequisites, apply, and optionally provision secrets"),
                ("secrets-sync", "Sync identity and SSH key", "Unlock Bitwarden and provision this device"),
                (
                    "secrets-sync-local",
                    "Sync secrets without GitHub",
                    "Provision local identity and key files without registering keys",
                ),
                ("secrets-init", "Initialize bootstrap note", "Create the private Bitwarden manifest from a local draft"),
                ("repos", "Sync repositories", "Clone or fetch repositories from the private manifest"),
                ("device", "Show device identity", "Display the stable logical device ID"),
                ("back", "Back", "Return to the main menu"),
            ],
            prompt="advanced › ",
        )
        if action in (None, "back"):
            return
        if action == "device":
            palette_execute(
                lambda: print(
                    json.dumps(
                        load_json(CONFIG_DIR / "device.json"),
                        indent=2,
                    )
                )
            )
            continue
        if action == "bootstrap":
            selected_profile = palette_profile()
            if not selected_profile:
                continue
            secret_mode = fzf_menu(
                [
                    ("secrets", "Bootstrap with secrets", "Provision identity, SSH, repositories, and profile"),
                    ("skip", "Bootstrap without secrets", "Apply only public packages and configuration"),
                    ("cancel", "Cancel", "Return without changing the machine"),
                ],
                prompt="bootstrap › ",
            )
            if secret_mode in (None, "cancel"):
                continue
            device = palette_text("Device ID", default=inferred_device_id())
            palette_execute(
                lambda: cmd_bootstrap(
                    argparse.Namespace(
                        profile=selected_profile,
                        device=device,
                        skip_secrets=secret_mode == "skip",
                    )
                )
            )
        elif action in {"secrets-sync", "secrets-sync-local"}:
            device = palette_text("Device ID", default=inferred_device_id())
            palette_execute(
                lambda: cmd_secrets_sync(
                    argparse.Namespace(
                        profile=profile,
                        device=device,
                        no_register=action == "secrets-sync-local",
                    )
                )
            )
        elif action == "secrets-init":
            draft = palette_text(
                "Permission-locked bootstrap draft",
                default=str(CONFIG_DIR / "bootstrap-draft.json"),
            )
            if draft and palette_confirm(
                "Create the Bitwarden bootstrap note",
                "This refuses to overwrite an existing dotfiles/bootstrap-v1 item",
            ):
                palette_execute(
                    lambda: cmd_secrets_initialize(
                        argparse.Namespace(draft=draft)
                    )
                )
        elif action == "repos":
            palette_execute(
                lambda: cmd_repos_sync(argparse.Namespace(profile=profile))
            )


def cmd_palette() -> None:
    if not sys.stdin.isatty():
        raise DotError("The interactive command palette requires a terminal; use `dot --help`.")
    try:
        profile = update_profile(None)
    except DotError:
        profile = palette_profile() or ""
    if not profile:
        return
    while True:
        action = fzf_menu(
            [
                ("update", "Update", "Update everything or choose an individual provider"),
                ("apply", "Apply and repair", "Reconcile a full profile or one subsystem"),
                ("configuration", "Save and configuration", "Capture, diff, apply, and rollback desktop settings"),
                ("neovim", "Neovim", "Test, update, repair, or rollback the editor environment"),
                ("repositories", "Repositories and packages", "Sync repos, add packages, and inspect manifests"),
                ("services", "Network and services", "Tailscale, Docker, Codex, Vite+, and gestures"),
                ("diagnostics", "Diagnostics", "Doctor, tests, drift, update checks, and service failures"),
                ("advanced", "Bootstrap and secrets", "Device identity, Bitwarden, bootstrap, and repository setup"),
                ("profile", "Switch active profile", f"Currently using {profile}"),
                ("exit", "Exit", "Close the dot command palette"),
            ],
            prompt=f"dot [{profile}] › ",
            header="Type to filter  Enter: open  Esc: exit",
        )
        if action in (None, "exit"):
            return
        if action == "profile":
            profile = palette_profile() or profile
        elif action == "update":
            palette_update_menu(profile)
        elif action == "apply":
            palette_apply_menu(profile)
        elif action == "configuration":
            palette_configuration_menu(profile)
        elif action == "neovim":
            palette_neovim_menu(profile)
        elif action == "repositories":
            palette_repositories_menu(profile)
        elif action == "services":
            palette_services_menu(profile)
        elif action == "diagnostics":
            palette_diagnostics_menu(profile)
        elif action == "advanced":
            palette_advanced_menu(profile)


def doctor_check(label: str, ok: bool, detail: str) -> bool:
    print(f"[{'OK' if ok else 'FAIL'}] {label}: {detail}")
    return ok


def cmd_doctor(args: argparse.Namespace) -> None:
    profile = load_profile(args.profile)
    failures = 0
    expected_platform = {
        "kubuntu-laptop": "linux",
        "wsl-personal": "wsl",
        "wsl-work": "wsl",
        "windows-host": "windows",
        "termux": "termux",
    }.get(profile["name"])
    actual_platform = infer_platform()
    failures += not doctor_check("platform", actual_platform == expected_platform, f"{actual_platform}; expected {expected_platform}")
    failures += not doctor_check("device", (CONFIG_DIR / "device.json").exists(), str(CONFIG_DIR / "device.json"))
    packages = profile.get("packages", {})
    apt_packages = packages.get("apt", [])
    if apt_packages and command_exists("dpkg-query"):
        missing_apt = []
        outdated_apt = []
        for package in apt_packages:
            proc = run(
                ["dpkg-query", "-W", "-f=${Version}", package],
                check=False,
                capture=True,
            )
            if proc.returncode:
                missing_apt.append(package)
                continue
            if command_exists("apt-cache") and command_exists("dpkg"):
                policy = run(["apt-cache", "policy", package], check=False, capture=True)
                candidate = next(
                    (
                        line.split(":", 1)[1].strip()
                        for line in policy.stdout.splitlines()
                        if line.strip().startswith("Candidate:")
                    ),
                    "",
                )
                if candidate and candidate != "(none)":
                    comparison = run(
                        ["dpkg", "--compare-versions", proc.stdout.strip(), "ge", candidate],
                        check=False,
                    )
                    if comparison.returncode != 0:
                        outdated_apt.append(f"{package} ({proc.stdout.strip()} < {candidate})")
        failures += not doctor_check(
            "APT packages",
            not missing_apt and not outdated_apt,
            "all present at latest repository candidates"
            if not missing_apt and not outdated_apt
            else "; ".join(
                part
                for part in (
                    f"missing {', '.join(missing_apt)}" if missing_apt else "",
                    f"outdated {', '.join(outdated_apt)}" if outdated_apt else "",
                )
                if part
            ),
        )
    deb_packages = packages.get("deb", [])
    if deb_packages and command_exists("dpkg-query") and command_exists("dpkg-deb"):
        stale_deb = []
        for package in deb_packages:
            installed = run(
                ["dpkg-query", "-W", "-f=${Version}", package],
                check=False,
                capture=True,
            )
            latest_asset = run(
                [str(ROOT / "scripts/fetch-external-deb"), package],
                check=False,
                capture=True,
            )
            if installed.returncode or latest_asset.returncode:
                stale_deb.append(package)
                continue
            latest = run(
                ["dpkg-deb", "--field", latest_asset.stdout.strip(), "Version"],
                check=False,
                capture=True,
            )
            if latest.returncode or installed.stdout.strip() != latest.stdout.strip():
                stale_deb.append(
                    f"{package} ({installed.stdout.strip() or 'missing'} -> "
                    f"{latest.stdout.strip() or 'unknown'})"
                )
        failures += not doctor_check(
            "External Debian packages",
            not stale_deb,
            "all at latest stable releases"
            if not stale_deb
            else f"missing or outdated {', '.join(stale_deb)}",
        )
    brew_packages = packages.get("brew", [])
    if brew_packages:
        if not command_exists("brew"):
            failures += not doctor_check("Homebrew packages", False, "brew is not installed")
        else:
            proc = run(["brew", "list", "--formula"], check=False, capture=True)
            installed = set(proc.stdout.splitlines())
            missing_brew = [package for package in brew_packages if package not in installed]
            outdated = run(["brew", "outdated", "--formula"], check=False, capture=True)
            outdated_brew = sorted(set(outdated.stdout.splitlines()) & set(brew_packages))
            failures += not doctor_check(
                "Homebrew packages",
                not missing_brew and not outdated_brew,
                "all present at latest stable releases"
                if not missing_brew and not outdated_brew
                else "; ".join(
                    part
                    for part in (
                        f"missing {', '.join(missing_brew)}" if missing_brew else "",
                        f"outdated {', '.join(outdated_brew)}" if outdated_brew else "",
                    )
                    if part
                ),
            )
    pkg_packages = packages.get("pkg", [])
    if pkg_packages and command_exists("pkg"):
        proc = run(["pkg", "list-installed"], check=False, capture=True)
        installed_pkg = {line.split("/", 1)[0] for line in proc.stdout.splitlines() if "/" in line}
        missing_pkg = [package for package in pkg_packages if package not in installed_pkg]
        failures += not doctor_check(
            "Termux packages",
            not missing_pkg,
            "all present; pkg upgrade supplies latest stable repository releases"
            if not missing_pkg
            else f"missing {', '.join(missing_pkg)}",
        )
    snap_packages = packages.get("snap", [])
    if snap_packages:
        proc = run(["snap", "list"], check=False, capture=True)
        installed_snaps = {line.split()[0] for line in proc.stdout.splitlines()[1:] if line.split()}
        missing_snaps = [
            package
            for package in snap_packages
            if package not in installed_snaps and not command_exists(package)
        ]
        failures += not doctor_check(
            "Snap packages",
            not missing_snaps,
            "all present" if not missing_snaps else f"missing {', '.join(missing_snaps)}",
        )
    if profile.get("features", {}).get("docker_engine"):
        docker_packages = (
            "containerd.io",
            "docker-buildx-plugin",
            "docker-ce",
            "docker-ce-cli",
            "docker-compose-plugin",
        )
        missing_docker = []
        for package in docker_packages:
            installed = run(
                ["dpkg-query", "-W", "-f=${db:Status-Status}", package],
                check=False,
                capture=True,
            )
            if installed.returncode != 0 or installed.stdout.strip() != "installed":
                missing_docker.append(package)
        failures += not doctor_check(
            "Docker packages",
            not missing_docker,
            "official engine, Compose, and Buildx installed"
            if not missing_docker
            else f"missing {', '.join(missing_docker)}",
        )
        docker_location = shutil.which("docker")
        docker_path = Path(docker_location) if docker_location else None
        failures += not doctor_check(
            "Docker CLI ownership",
            docker_path is not None and docker_path.resolve() == Path("/usr/bin/docker"),
            str(docker_path) if docker_path is not None else "not installed",
        )
        docker_active = run(
            ["systemctl", "is-active", "--quiet", "docker"],
            check=False,
        ).returncode == 0
        containerd_active = run(
            ["systemctl", "is-active", "--quiet", "containerd"],
            check=False,
        ).returncode == 0
        failures += not doctor_check(
            "Docker services",
            docker_active and containerd_active,
            "docker and containerd active"
            if docker_active and containerd_active
            else "run dot apply --profile " + profile["name"] + " --tags docker",
        )
        try:
            import grp

            docker_group = grp.getgrnam("docker")
            has_docker_group = (
                getpass.getuser() in docker_group.gr_mem
                or os.getgid() == docker_group.gr_gid
            )
        except (ImportError, KeyError):
            has_docker_group = False
        failures += not doctor_check(
            "Docker socket access",
            has_docker_group,
            "user is assigned to docker group; log out and back in after first apply"
            if has_docker_group
            else "user is not assigned to docker group",
        )
        compose = run(["docker", "compose", "version"], check=False, capture=True)
        buildx = run(["docker", "buildx", "version"], check=False, capture=True)
        failures += not doctor_check(
            "Docker plugins",
            compose.returncode == 0 and buildx.returncode == 0,
            "Compose and Buildx available"
            if compose.returncode == 0 and buildx.returncode == 0
            else "Docker Compose or Buildx plugin is unavailable",
        )
        if profile.get("features", {}).get("wsl"):
            systemd_ready = Path("/run/systemd/system").is_dir()
            docker_socket = Path("/var/run/docker.sock")
            socket_target = str(docker_socket.resolve()) if docker_socket.exists() else ""
            desktop_integration = socket_target.startswith("/mnt/wsl/docker-desktop/")
            failures += not doctor_check(
                "WSL native Docker mode",
                systemd_ready and not desktop_integration,
                "systemd active; Docker Desktop integration absent"
                if systemd_ready and not desktop_integration
                else "enable WSL systemd and disable Docker Desktop WSL integration",
            )
    if profile.get("features", {}).get("tailscale"):
        tailscale_package = run(
            ["dpkg-query", "-W", "-f=${db:Status-Status}", "tailscale"],
            check=False,
            capture=True,
        )
        failures += not doctor_check(
            "Tailscale package",
            tailscale_package.returncode == 0
            and tailscale_package.stdout.strip() == "installed",
            "official stable package installed"
            if tailscale_package.returncode == 0
            and tailscale_package.stdout.strip() == "installed"
            else f"run dot apply --profile {profile['name']} --tags tailscale",
        )
        tailscaled_enabled = run(
            ["systemctl", "is-enabled", "--quiet", "tailscaled"],
            check=False,
        ).returncode == 0
        tailscaled_active = run(
            ["systemctl", "is-active", "--quiet", "tailscaled"],
            check=False,
        ).returncode == 0
        failures += not doctor_check(
            "Tailscale service",
            tailscaled_enabled and tailscaled_active,
            "tailscaled enabled and active"
            if tailscaled_enabled and tailscaled_active
            else f"run dot apply --profile {profile['name']} --tags tailscale",
        )
        tailscale_status = (
            run(
                ["tailscale", "status", "--json"],
                check=False,
                capture=True,
            )
            if command_exists("tailscale")
            else None
        )
        try:
            tailscale_state = json.loads(
                tailscale_status.stdout if tailscale_status is not None else "{}"
            ).get("BackendState", "")
        except json.JSONDecodeError:
            tailscale_state = ""
        failures += not doctor_check(
            "Tailscale enrollment",
            tailscale_status is not None
            and tailscale_status.returncode == 0
            and tailscale_state == "Running",
            "joined to a tailnet"
            if tailscale_status is not None
            and tailscale_status.returncode == 0
            and tailscale_state == "Running"
            else "run sudo tailscale up and authenticate with the browser URL",
        )
    if profile.get("features", {}).get("shell"):
        failures += not doctor_check("zsh", command_exists("zsh"), shutil.which("zsh") or "not installed")
        dot_command = Path.home() / ".local/bin/dot"
