                ["git", "config", "--get", "user.signingkey"],
                check=False,
                capture=True,
            )
            signing_key_path = Path(signing_key_result.stdout.strip()).expanduser()
            expected_key = (
                signing_key_path.read_text(encoding="utf-8").strip()
                if signing_key_result.returncode == 0 and signing_key_path.is_file()
                else ""
