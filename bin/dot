#!/usr/bin/env python3
"""One entry point for Dovie's reproducible environment."""

from __future__ import annotations

import argparse
import base64
import datetime as dt
import difflib
import getpass
import hashlib
import json
import os
from pathlib import Path
import platform
import re
import shutil
import socket
import subprocess
import sys
import tempfile
from typing import Any


ROOT = Path(__file__).resolve().parents[1]
LINUXBREW_BIN = Path("/home/linuxbrew/.linuxbrew/bin")
if LINUXBREW_BIN.is_dir():
    path_parts = os.environ.get("PATH", "").split(os.pathsep)
    if str(LINUXBREW_BIN) not in path_parts:
        os.environ["PATH"] = os.pathsep.join([str(LINUXBREW_BIN), *path_parts])
PROFILE_DIR = ROOT / "profiles"
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "dotfiles"
CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "dotfiles"
BACKUP_DIR = STATE_DIR / "backups"
BW_BOOTSTRAP_ITEM = "dotfiles/bootstrap-v1"
GITHUB_REQUIRED_SCOPES = {"admin:public_key", "admin:ssh_signing_key"}
KDE_FILES = (
    ".config/kdeglobals",
    ".config/kwinrc",
    ".config/kglobalshortcutsrc",
    ".config/spectaclerc",
    ".config/kcminputrc",
    ".config/kscreenlockerrc",
    ".config/plasmarc",
    ".config/plasma-org.kde.plasma.desktop-appletsrc",
    ".local/share/konsole/Dovie.profile",
)
KDE_BASELINE = STATE_DIR / "kde-baseline.json"
KDE_IGNORED_KEYS = {
    ".config/kscreenlockerrc": {
        ("Greeter][Wallpaper][org.kde.image][General", "DarkLightScheduleState"),
    },
    ".config/spectaclerc": {
        ("ImageSave", "lastImageSaveLocation"),
    },
}
KDE_IGNORED_SECTIONS = {
    ".config/plasma-org.kde.plasma.desktop-appletsrc": {"ScreenMapping"},
}
KDE_LABELS = {
    ".config/kdeglobals": "KDE appearance",
    ".config/kwinrc": "Windows, desktops, and tiling",
    ".config/kglobalshortcutsrc": "Keyboard shortcuts",
    ".config/spectaclerc": "Spectacle preferences",
    ".config/kcminputrc": "Mouse and input",
    ".config/kscreenlockerrc": "Lock screen",
    ".config/plasmarc": "Plasma appearance",
    ".config/plasma-org.kde.plasma.desktop-appletsrc": "Panels and widgets",
    ".local/share/konsole/Dovie.profile": "Konsole profile",
}


class DotError(RuntimeError):
    pass


def run(
    args: list[str],
    *,
    check: bool = True,
    capture: bool = False,
    env: dict[str, str] | None = None,
    cwd: Path | None = None,
) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        args,
        check=check,
        text=True,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.PIPE if capture else None,
        env=env,
        cwd=cwd,
    )


def load_json(path: Path) -> dict[str, Any]:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise DotError(f"Cannot read {path}: {exc}") from exc


def merge(left: dict[str, Any], right: dict[str, Any]) -> dict[str, Any]:
    result = json.loads(json.dumps(left))
    for key, value in right.items():
        if key == "inherits":
            continue
        if isinstance(value, dict) and isinstance(result.get(key), dict):
            result[key] = merge(result[key], value)
        elif isinstance(value, list) and isinstance(result.get(key), list):
            result[key] = list(dict.fromkeys(result[key] + value))
        else:
            result[key] = value
    return result


def normalize_profile(name: str) -> str:
    return "common-linux" if name == "common" else name


def load_profile(name: str, stack: tuple[str, ...] = ()) -> dict[str, Any]:
    name = normalize_profile(name)
    if name in stack:
        raise DotError(f"Profile inheritance cycle: {' -> '.join(stack + (name,))}")
    path = PROFILE_DIR / f"{name}.yml"
    data = load_json(path)
    if data.get("schema_version") != 1 or data.get("name") != name:
        raise DotError(f"Invalid profile header in {path}")
    combined: dict[str, Any] = {"inherits": [], "features": {}, "packages": {}}
    for parent in data.get("inherits", []):
        combined = merge(combined, load_profile(parent, stack + (name,)))
    return merge(combined, data)


def atomic_text(path: Path, text: str, mode: int | None = None) -> bool:
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.exists() and path.read_text(encoding="utf-8") == text:
        if mode is not None:
            path.chmod(mode)
        return False
    temp = path.with_name(f".{path.name}.dot-tmp")
    temp.write_text(text, encoding="utf-8")
    if mode is not None:
        temp.chmod(mode)
    temp.replace(path)
    return True


def atomic_bytes(path: Path, content: bytes, mode: int | None = None) -> bool:
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.exists() and path.read_bytes() == content:
        if mode is not None:
            path.chmod(mode)
        return False
    temp = path.with_name(f".{path.name}.dot-tmp")
    temp.write_bytes(content)
    if mode is not None:
        temp.chmod(mode)
    temp.replace(path)
    return True


def infer_platform() -> str:
    if os.environ.get("TERMUX_VERSION") or Path("/data/data/com.termux").exists():
        return "termux"
    if platform.system() == "Windows":
        return "windows"
    try:
        if "microsoft" in Path("/proc/version").read_text().lower():
            return "wsl"
    except OSError:
        pass
    return "linux"


def inferred_device_id() -> str:
    host = socket.gethostname()
    if infer_platform() == "wsl":
        command = Path("/mnt/c/Windows/System32/hostname.exe")
        if command.exists():
            proc = run([str(command)], check=False, capture=True)
            if proc.returncode == 0 and proc.stdout.strip():
                host = proc.stdout.strip()
    value = re.sub(r"[^a-z0-9-]+", "-", host.lower()).strip("-")
    return value or "unnamed-device"


def ensure_device(explicit: str | None = None) -> str:
    path = CONFIG_DIR / "device.json"
    existing = load_json(path) if path.exists() else {}
    device = explicit or existing.get("device_id") or inferred_device_id()
    payload = {"schema_version": 1, "device_id": device}
    atomic_text(path, json.dumps(payload, indent=2) + "\n", 0o600)
    return device


def command_exists(name: str) -> bool:
    return shutil.which(name) is not None


def require_commands(names: list[str], remediation: str) -> None:
    missing = [name for name in names if not command_exists(name)]
    if missing:
        raise DotError(f"Missing prerequisites: {', '.join(missing)}\n{remediation}")


def ansible_become_arguments() -> list[str]:
    if hasattr(os, "geteuid") and os.geteuid() == 0:
        return []
    require_commands(["sudo"], "Install sudo or run the privileged operation as root.")
    if sys.stdin.isatty():
        print("Administrator access is required to update managed system packages.")
        return ["--ask-become-pass"]
    passwordless = run(["sudo", "-n", "true"], check=False, capture=True)
    if passwordless.returncode == 0:
        return []
    raise DotError(
        "Administrator access is required for managed system packages. "
        "Run this command in an interactive terminal so Ansible can request the password."
    )


def backup_paths(paths: list[Path]) -> str:
    run_id = dt.datetime.now().strftime("%Y%m%d-%H%M%S-%f")
    destination = BACKUP_DIR / run_id
    manifest: list[dict[str, Any]] = []
    for path in paths:
        expanded = path.expanduser()
        record: dict[str, Any] = {"path": str(expanded), "existed": expanded.exists()}
        if expanded.exists() and expanded.is_file():
            relative = str(expanded).lstrip("/")
            target = destination / "files" / relative
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(expanded, target)
            record["backup"] = str(target)
        manifest.append(record)
    destination.mkdir(parents=True, exist_ok=True)
    atomic_text(destination / "manifest.json", json.dumps(manifest, indent=2) + "\n", 0o600)
    return run_id


def link_file(source: Path, destination: Path) -> bool:
    destination = destination.expanduser()
    if destination.is_symlink() and destination.resolve() == source.resolve():
        return False
    if destination.exists() or destination.is_symlink():
        backup_paths([destination])
        destination.unlink()
    destination.parent.mkdir(parents=True, exist_ok=True)
    destination.symlink_to(source)
    return True


def copy_managed_file(source: Path, destination: Path) -> bool:
    """Deploy an app-owned file without letting the app mutate the repository."""
    destination = destination.expanduser()
    content = source.read_bytes()
    mode = source.stat().st_mode & 0o777
    if not destination.is_symlink() and destination.exists() and destination.read_bytes() == content:
        destination.chmod(mode)
        return False
    if destination.exists() or destination.is_symlink():
        backup_paths([destination])
        destination.unlink()
    return atomic_bytes(destination, content, mode)


def portable_kde_content(relative: str, content: bytes) -> bytes:
    """Remove runtime residue from an otherwise portable KConfig file."""
    ignored_keys = KDE_IGNORED_KEYS.get(relative, set())
    ignored_sections = KDE_IGNORED_SECTIONS.get(relative, set())
    section = ""
    kept: list[str] = []
    for line in content.decode("utf-8").splitlines(keepends=True):
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            section = stripped[1:-1]
            if section in ignored_sections:
                continue
        if section in ignored_sections:
            continue
        key = stripped.split("=", 1)[0] if "=" in stripped else ""
        if (section, key) in ignored_keys:
            continue
        kept.append(line)
    normalized = "".join(kept).rstrip()
    return (normalized + "\n").encode("utf-8") if normalized else b""


def kde_digest(relative: str, path: Path) -> str:
    return hashlib.sha256(portable_kde_content(relative, path.read_bytes())).hexdigest()


def copy_managed_kde_file(relative: str, source: Path, destination: Path) -> bool:
    content = portable_kde_content(relative, source.read_bytes())
    mode = source.stat().st_mode & 0o777
    if (
        not destination.is_symlink()
        and destination.exists()
        and portable_kde_content(relative, destination.read_bytes()) == content
    ):
        destination.chmod(mode)
        return False
    if destination.exists() or destination.is_symlink():
        backup_paths([destination])
        destination.unlink()
    return atomic_bytes(destination, content, mode)


def kde_baseline() -> dict[str, str]:
    if not KDE_BASELINE.exists():
        return {}
    payload = load_json(KDE_BASELINE)
    return {
        str(path): str(digest)
        for path, digest in payload.get("files", {}).items()
    }


def record_kde_baseline() -> None:
    """Record only files whose repository and live copies currently agree."""
    files: dict[str, str] = {}
    for relative in KDE_FILES:
        expected = ROOT / "config/kde" / relative
        actual = Path.home() / relative
        if (
            expected.is_file()
            and actual.is_file()
            and not actual.is_symlink()
            and portable_kde_content(relative, expected.read_bytes())
            == portable_kde_content(relative, actual.read_bytes())
        ):
            files[relative] = kde_digest(relative, expected)
    payload = {"schema_version": 1, "files": files}
    atomic_text(KDE_BASELINE, json.dumps(payload, indent=2) + "\n", 0o600)


def check_kde_apply_conflicts(*, force: bool = False) -> None:
    if force:
        return
    baseline = kde_baseline()
    conflicts: list[str] = []
    for relative in KDE_FILES:
        expected = ROOT / "config/kde" / relative
        actual = Path.home() / relative
        if not expected.is_file() or not actual.is_file() or actual.is_symlink():
            continue
        expected_digest = kde_digest(relative, expected)
        actual_digest = kde_digest(relative, actual)
        if expected_digest == actual_digest:
            continue
        previous_digest = baseline.get(relative)
        if previous_digest is None:
            reason = "has uncaptured local state"
        elif actual_digest == previous_digest:
            continue
        elif expected_digest == previous_digest:
            reason = "has newer local changes"
        else:
            reason = "changed both locally and in dotfiles"
        conflicts.append(f"{actual} {reason}")
    if conflicts:
        detail = "\n  ".join(conflicts)
        raise DotError(
            "Refusing to overwrite KDE configuration drift:\n"
            f"  {detail}\n"
            "Review with `dot diff kde`, then capture the intended files with "
            "`dot capture kde --only NAME`; use --force-kde only for an "
            "intentional repository-to-machine replacement."
        )


def apply_direct(profile_name: str, *, force_kde: bool = False) -> int:
    profile = load_profile(profile_name)
    features = profile.get("features", {})
    changes = 0
    force_kde = force_kde or os.environ.get("DOTFILES_KDE_PREFLIGHT_OK") == "1"
    if features.get("kde"):
        check_kde_apply_conflicts(force=force_kde)
    if features.get("shell"):
        mappings = {
            ROOT / "bin/dot": Path.home() / ".local/bin/dot",
            ROOT / "config/shell/bashrc": Path.home() / ".bashrc",
            ROOT / "config/shell/zshrc": Path.home() / ".zshrc",
            ROOT / "config/shell/p10k.zsh": Path.home() / ".p10k.zsh",
            ROOT / "config/shell/mbash": Path.home() / ".local/bin/mbash",
        }
        for source, destination in mappings.items():
            changes += int(link_file(source, destination))
    if features.get("git"):
        include = ROOT / "config/git/root.gitconfig"
        proc = run(["git", "config", "--global", "--get-all", "include.path"], check=False, capture=True)
        includes = proc.stdout.splitlines() if proc.returncode == 0 else []
        if str(include) not in includes:
            run(["git", "config", "--global", "--add", "include.path", str(include)])
            changes += 1
        for tool in ("git-abort", "git-repo-analysis", "git-stage-executable", "git-switcher"):
            source = ROOT / "config/git/bin" / tool
            if source.exists():
                changes += int(link_file(source, Path.home() / ".local/bin" / tool))
    if features.get("kde"):
        for relative in KDE_FILES:
            source = ROOT / "config/kde" / relative
            if source.exists():
                destination = Path.home() / relative
                changes += int(copy_managed_kde_file(relative, source, destination))
        record_kde_baseline()
        desktop_mappings = {
            ROOT / "config/alacritty/alacritty.toml": Path.home() / ".config/alacritty/alacritty.toml",
            ROOT / "config/lazygit/config.yml": Path.home() / ".config/lazygit/config.yml",
            ROOT / "config/lazydocker/config.yml": Path.home() / ".config/lazydocker/config.yml",
            ROOT / "config/mpv/input.conf": Path.home() / ".config/mpv/input.conf",
            ROOT / "config/mpv/mpv.conf": Path.home() / ".config/mpv/mpv.conf",
            ROOT / "config/mpv/script-opts/thumbfast.conf": Path.home() / ".config/mpv/script-opts/thumbfast.conf",
            ROOT / "config/flameshot/hereshot": Path.home() / ".local/bin/hereshot",
        }
        for source, destination in desktop_mappings.items():
            changes += int(copy_managed_file(source, destination))
    if features.get("wsl") or features.get("kde"):
        for tool in ("clogs", "cshell", "cycle"):
            source = ROOT / "config/docker/bin" / tool
            if source.exists():
                changes += int(link_file(source, Path.home() / ".local/bin" / tool))
    if features.get("codex_remote_control"):
        unit_name = "codex-remote-control.service"
        source = ROOT / "config/systemd/user" / unit_name
        destination = Path.home() / ".config/systemd/user" / unit_name
        unit_changed = link_file(source, destination)
        changes += int(unit_changed)
        codex = Path.home() / ".local/bin/codex"
        if command_exists("systemctl") and codex.exists():
            # The unit is linked into place, so its contents can change even
            # when the destination symlink itself is already correct.
            run(["systemctl", "--user", "daemon-reload"])
            enabled = run(
                ["systemctl", "--user", "is-enabled", "--quiet", unit_name],
                check=False,
            ).returncode == 0
            active = run(
                ["systemctl", "--user", "is-active", "--quiet", unit_name],
                check=False,
            ).returncode == 0
            if not enabled or not active:
                run(["systemctl", "--user", "enable", "--now", unit_name])
                changes += 1
            if command_exists("loginctl"):
                linger = run(
                    ["loginctl", "show-user", getpass.getuser(), "--property=Linger", "--value"],
                    check=False,
                    capture=True,
                )
                if linger.returncode != 0 or linger.stdout.strip() != "yes":
                    run(["loginctl", "enable-linger", getpass.getuser()])
                    changes += 1
        elif not codex.exists():
            print(
                f"Codex standalone CLI is missing at {codex}; "
                f"{unit_name} was installed but not enabled.",
                file=sys.stderr,
            )
    print(f"Applied {profile_name}: {changes} configuration change(s)")
    return changes


def cmd_apply(args: argparse.Namespace) -> None:
    profile = load_profile(args.profile)
    force_kde = getattr(args, "force_kde", False)
    if args.direct or not command_exists("ansible-playbook"):
        if profile["name"] == "termux" and not args.check:
            packages = profile.get("packages", {}).get("pkg", [])
            if packages:
                run(["pkg", "upgrade", "-y"])
                run(["pkg", "install", "-y", *packages])
        if profile.get("features", {}).get("vite_plus"):
            mode = "--check" if args.check else "--ensure"
            run([str(ROOT / "scripts/install-vite-plus"), mode], cwd=ROOT)
        if profile.get("features", {}).get("codex_remote_control"):
            mode = "--check" if args.check else "--ensure"
            run([str(ROOT / "scripts/install-codex"), mode], cwd=ROOT)
        if not args.direct:
            print("ansible-playbook is unavailable; applying portable configuration directly.", file=sys.stderr)
        apply_direct(args.profile, force_kde=force_kde)
        return
    selected_tags = set((args.tags or "").replace(",", " ").split())
    package_apply_selected = not selected_tags or "packages" in selected_tags
    managed_packages = profile.get("packages", {})
    privileged_packages = any(
        managed_packages.get(provider)
        for provider in ("apt", "deb", "snap")
    )
    become_arguments = (
        ansible_become_arguments()
        if package_apply_selected and privileged_packages
        else []
    )
    direct_apply_selected = not selected_tags or bool(
        selected_tags & {"config", "shell", "git", "kde"}
    )
    kde_apply_selected = (
        profile.get("features", {}).get("kde")
        and direct_apply_selected
        and not args.check
    )
    if kde_apply_selected:
        check_kde_apply_conflicts(force=force_kde)
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    runtime_profile = STATE_DIR / "runtime-profile.json"
    atomic_text(runtime_profile, json.dumps({"dot_profile_data": profile}, indent=2) + "\n", 0o600)
    command = [
        "ansible-playbook",
        "-i",
        str(ROOT / "ansible/inventory.ini"),
        str(ROOT / "ansible/local.yml"),
        "-e",
        f"dot_profile={normalize_profile(args.profile)}",
        "-e",
        f"@{runtime_profile}",
    ]
    if args.tags:
        command.extend(["--tags", args.tags])
    if args.check:
        command.append("--check")
    command.extend(become_arguments)
    apply_env = os.environ.copy()
    if force_kde:
        apply_env["DOTFILES_KDE_PREFLIGHT_OK"] = "1"
    run(command, cwd=ROOT, env=apply_env)
    if kde_apply_selected:
        record_kde_baseline()


def cmd_bootstrap(args: argparse.Namespace) -> None:
    profile = load_profile(args.profile)
    device = ensure_device(args.device)
    print(f"Profile: {profile['name']}; device: {device}")
    detected = infer_platform()
    if profile["name"] == "windows-host":
        required = ["git", "bw", "gh", "pwsh"]
        missing = [cmd for cmd in required if not command_exists(cmd)]
        if missing:
            print("Windows inventory-only mode. Install prerequisites manually:")
            print("  winget install Git.Git Bitwarden.CLI GitHub.cli Microsoft.PowerShell")
            raise DotError(f"Missing prerequisites: {', '.join(missing)}")
        return
    if detected == "termux":
        require_commands(["pkg"], "Run: pkg install git openssh python nodejs-lts zsh")
    else:
        require_commands(["git", "python3"], "Install Git and Python 3 with the system package manager.")
    if not args.skip_secrets:
        cmd_secrets_sync(argparse.Namespace(profile=args.profile, device=device, no_register=False))
    cmd_apply(
        argparse.Namespace(
            profile=args.profile,
            tags=None,
            check=False,
            direct=False,
            force_kde=True,
        )
    )


def bw_session() -> tuple[str, bool]:
    require_commands(["bw"], "Install Bitwarden CLI, then run `bw login`.")
    status = run(["bw", "status"], capture=True)
    state = json.loads(status.stdout).get("status")
    if state == "unauthenticated":
        raise DotError("Bitwarden CLI is not logged in. Run `bw login` once, then retry.")
    if state == "unlocked":
        session = os.environ.get("BW_SESSION")
        if session:
            return session, False
    # Capture only the session token. The password prompt is written to stderr
    # and must remain attached to the terminal so it is visible to the user.
    proc = subprocess.run(
        ["bw", "unlock", "--raw"],
        check=True,
        text=True,
        stdout=subprocess.PIPE,
    )
    return proc.stdout.strip(), True


def bw_get_item(name: str, session: str, *, required: bool = True) -> dict[str, Any] | None:
    proc = run(["bw", "get", "item", name, "--session", session], check=False, capture=True)
    if proc.returncode:
        if required:
            raise DotError(f"Bitwarden item not found: {name}")
        return None
    return json.loads(proc.stdout)


def bw_create_item(item: dict[str, Any], session: str) -> dict[str, Any]:
    encoded = base64.b64encode(json.dumps(item).encode()).decode()
    # Read the encoded item from stdin so private material is never exposed in
    # the process list or an exception's command arguments.
    proc = subprocess.run(
        ["bw", "create", "item", "--session", session],
        input=encoded,
        check=True,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    return json.loads(proc.stdout)


def key_parts(item: dict[str, Any]) -> tuple[str, str]:
    ssh = item.get("sshKey") or {}
    private = ssh.get("privateKey")
    public = ssh.get("publicKey")
    if not private or not public:
        raise DotError(f"Bitwarden SSH item {item.get('name')} lacks a private/public key pair")
    return private, public


def create_device_key(item_name: str, session: str) -> dict[str, Any]:
    with tempfile.TemporaryDirectory(prefix="dot-ssh-") as directory:
        key = Path(directory) / "id_ed25519"
        run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", item_name, "-f", str(key)])
        private = key.read_text(encoding="utf-8")
        public = key.with_suffix(".pub").read_text(encoding="utf-8").strip()
        fingerprint = run(["ssh-keygen", "-lf", str(key.with_suffix(".pub"))], capture=True).stdout.split()[1]
    item = {
        "type": 5,
        "name": item_name,
        "favorite": False,
        "sshKey": {
            "privateKey": private,
            "publicKey": public,
            "keyFingerprint": fingerprint,
        },
    }
    return bw_create_item(item, session)


def github_auth_state() -> tuple[bool, set[str]]:
    if not command_exists("gh"):
        return False, set()
    proc = run(["gh", "auth", "status", "--hostname", "github.com"], check=False, capture=True)
    output = f"{proc.stdout}\n{proc.stderr}"
    match = re.search(r"Token scopes:\s*(.+)", output)
    scopes = set(re.findall(r"'([^']+)'", match.group(1))) if match else set()
    return proc.returncode == 0, scopes


def ensure_github_authorization() -> None:
    require_commands(
        ["gh"],
        "Install GitHub CLI, then rerun bootstrap. On Debian/Ubuntu: sudo apt install gh",
    )
    authenticated, scopes = github_auth_state()
    scope_list = ",".join(sorted(GITHUB_REQUIRED_SCOPES))
    if not authenticated:
        print("GitHub authentication is required; opening the browser login flow.")
        run(
            [
                "gh",
                "auth",
                "login",
                "--hostname",
                "github.com",
                "--git-protocol",
                "ssh",
                "--web",
                "--scopes",
                scope_list,
            ]
        )
        authenticated, scopes = github_auth_state()
    missing = GITHUB_REQUIRED_SCOPES - scopes
    if authenticated and missing:
        print(f"GitHub needs SSH key-management permissions: {', '.join(sorted(missing))}")
        run(
            [
                "gh",
                "auth",
                "refresh",
                "--hostname",
                "github.com",
                "--scopes",
                ",".join(sorted(missing)),
            ]
        )
        authenticated, scopes = github_auth_state()
    missing = GITHUB_REQUIRED_SCOPES - scopes
    if not authenticated or missing:
        raise DotError(
            "GitHub CLI authorization is incomplete. Run: "
            f"gh auth refresh -h github.com -s {scope_list}"
        )


def github_register(public_path: Path, label: str) -> None:
    ensure_github_authorization()
    existing = run(["gh", "ssh-key", "list"], check=False, capture=True)
    public_text = public_path.read_text(encoding="utf-8").strip()
    public_key = " ".join(public_text.split()[:2])
    listed_keys = []
    for line in existing.stdout.splitlines():
        fields = line.split("\t")
        if len(fields) >= 3:
            listed_keys.append((fields[1].strip(), fields[-1].strip()))
    for key_type in ("authentication", "signing"):
        if (public_key, key_type) in listed_keys:
            continue
        proc = run(
            ["gh", "ssh-key", "add", str(public_path), "--title", label, "--type", key_type],
            check=False,
            capture=True,
        )
        if proc.returncode and "already" not in proc.stderr.lower():
            print(f"GitHub {key_type} registration failed: {proc.stderr.strip()}", file=sys.stderr)


def write_identity(profile: dict[str, Any], bootstrap: dict[str, Any], public_key: Path) -> None:
    account = profile.get("account", "personal")
    identity = bootstrap.get("git_identities", {}).get(account)
    if not identity:
        raise DotError(f"Bitwarden bootstrap item has no git identity for {account}")
    content = (
        "[user]\n"
        f"\tname = {identity['name']}\n"
        f"\temail = {identity['email']}\n"
        f"\tsigningkey = {public_key}\n"
    )
    identity_path = CONFIG_DIR / f"git-{account}.gitconfig"
    atomic_text(identity_path, content, 0o600)
    atomic_text(
        CONFIG_DIR / "git-active.gitconfig",
        f"[include]\n\tpath = {identity_path}\n",
        0o600,
    )


def cmd_secrets_sync(args: argparse.Namespace) -> None:
    profile = load_profile(args.profile)
    device = ensure_device(args.device)
    account = profile.get("account", "personal")
    if not args.no_register:
        # Complete browser authorization before unlocking Bitwarden so a vault
        # session is never held open while waiting on GitHub.
        ensure_github_authorization()
    session, should_lock = bw_session()
    try:
        bootstrap_item = bw_get_item(BW_BOOTSTRAP_ITEM, session)
        try:
            bootstrap = json.loads(bootstrap_item.get("notes") or "{}")
        except json.JSONDecodeError as exc:
            raise DotError(f"{BW_BOOTSTRAP_ITEM} notes must contain valid JSON: {exc}") from exc
        item_name = f"dotfiles/ssh/{account}/{device}"
        item = bw_get_item(item_name, session, required=False)
        if item is None:
            print(f"Creating per-device SSH key in Bitwarden: {item_name}")
            item = create_device_key(item_name, session)
        private, public = key_parts(item)
        ssh_dir = Path.home() / ".ssh"
        ssh_dir.mkdir(mode=0o700, exist_ok=True)
        public_path = ssh_dir / f"dotfiles-{account}-{device}.pub"
        atomic_text(public_path, public.rstrip() + "\n", 0o644)
        if profile.get("features", {}).get("materialize_ssh_key"):
            private_path = public_path.with_suffix("")
            atomic_text(private_path, private.rstrip() + "\n", 0o600)
        write_identity(profile, bootstrap, public_path)
        if not args.no_register:
            github_register(public_path, f"{device}-{account}")
    finally:
        if should_lock:
            run(["bw", "lock"], check=False)


def cmd_secrets_initialize(args: argparse.Namespace) -> None:
    draft_path = Path(args.draft).expanduser()
    bootstrap = load_json(draft_path)
    if bootstrap.get("schema_version") != 1:
        raise DotError(f"{draft_path} must use bootstrap schema_version 1")
    session, should_lock = bw_session()
    try:
        run(["bw", "sync", "--session", session], check=False, capture=True)
        if bw_get_item(BW_BOOTSTRAP_ITEM, session, required=False) is not None:
            raise DotError(
                f"Bitwarden item {BW_BOOTSTRAP_ITEM} already exists; "
                "initialization will not overwrite it"
            )
        item = {
            "type": 2,
            "name": BW_BOOTSTRAP_ITEM,
            "favorite": False,
            "notes": json.dumps(bootstrap, indent=2),
            "secureNote": {"type": 0},
        }
        created = bw_create_item(item, session)
        if created.get("name") != BW_BOOTSTRAP_ITEM:
            raise DotError("Bitwarden returned an unexpected item after initialization")
        print(f"Created Bitwarden secure note: {BW_BOOTSTRAP_ITEM}")
    finally:
        if should_lock:
            run(["bw", "lock"], check=False)


def parse_bootstrap(session: str) -> dict[str, Any]:
    item = bw_get_item(BW_BOOTSTRAP_ITEM, session)
    try:
        return json.loads(item.get("notes") or "{}")
    except json.JSONDecodeError as exc:
        raise DotError(f"{BW_BOOTSTRAP_ITEM} notes are not valid JSON: {exc}") from exc


def cmd_repos_sync(args: argparse.Namespace) -> None:
    profile_name = normalize_profile(args.profile)
    session, should_lock = bw_session()
    try:
        manifest = parse_bootstrap(session)
        for repo in manifest.get("repositories", []):
            if profile_name not in repo.get("profiles", []):
                continue
            destination = Path(os.path.expandvars(os.path.expanduser(repo["path"])))
            if (destination / ".git").exists():
                print(f"Updating {repo['name']}")
                run(["git", "-C", str(destination), "fetch", "--all", "--prune", "--tags"])
            elif destination.exists():
                raise DotError(f"Clone destination exists but is not a Git repository: {destination}")
            else:
                destination.parent.mkdir(parents=True, exist_ok=True)
                print(f"Cloning {repo['name']}")
                run(["git", "clone", repo["url"], str(destination)])
    finally:
        if should_lock:
            run(["bw", "lock"], check=False)


def cmd_package_add(args: argparse.Namespace) -> None:
    profile_name = normalize_profile(args.profile)
    path = PROFILE_DIR / f"{profile_name}.yml"
    profile = load_json(path)
    provider = args.provider
    if provider is None:
        catalog = load_json(ROOT / "packages/catalog.yml")
        entry = catalog.get("tools", {}).get(args.name)
        if entry:
            provider = entry["provider"]
        elif profile_name == "termux":
            provider = "pkg"
        elif profile_name == "windows-host":
            raise DotError("Windows packages are inventory-only; specify --provider winget, scoop, or psgallery.")
        else:
            provider = "brew"
    allowed = {"apt", "brew", "snap", "pkg", "winget", "scoop", "psgallery"}
    if provider not in allowed:
        raise DotError(f"Unsupported provider {provider}; choose one of {', '.join(sorted(allowed))}")
    packages = profile.setdefault("packages", {}).setdefault(provider, [])
    if args.name in packages:
        print(f"{args.name} already exists in {profile_name}:{provider}")
        return
    packages.append(args.name)
    packages.sort(key=str.casefold)
    atomic_text(path, json.dumps(profile, indent=2) + "\n")
    print(f"Added {args.name} to {profile_name}:{provider}; no commit was created.")
    if profile_name != "windows-host" and not args.no_apply:
        cmd_apply(argparse.Namespace(profile=profile_name, tags="packages", check=False, direct=False))


def cmd_codex_install(_args: argparse.Namespace) -> None:
    run([str(ROOT / "scripts/install-codex"), "--install"], cwd=ROOT)


def cmd_codex_update(_args: argparse.Namespace) -> None:
    run([str(ROOT / "scripts/install-codex"), "--update"], cwd=ROOT)
    print(
        "The supervised Remote Control service keeps its current process until "
        "the next restart. Restarting it now would disconnect active remote sessions."
    )


def cmd_vite_plus_install(_args: argparse.Namespace) -> None:
    run([str(ROOT / "scripts/install-vite-plus"), "--install"], cwd=ROOT)


def cmd_vite_plus_update(_args: argparse.Namespace) -> None:
    run([str(ROOT / "scripts/install-vite-plus"), "--update"], cwd=ROOT)


def cmd_update(args: argparse.Namespace) -> None:
    profile = load_profile(args.profile)
    if profile.get("features", {}).get("windows_inventory_only"):
        raise DotError(
            "Windows is inventory-only; update applications with their native "
            "stable channels, then recapture the inventory."
        )
    cmd_apply(
        argparse.Namespace(
            profile=args.profile,
            tags="packages",
            check=False,
            direct=False,
            force_kde=False,
        )
    )
    if profile.get("features", {}).get("codex_remote_control"):
        cmd_codex_update(args)
    if profile.get("features", {}).get("vite_plus"):
        cmd_vite_plus_update(args)
    print(f"Updated managed programs for {profile['name']} to their latest stable releases.")


def cmd_capture_kde(args: argparse.Namespace) -> None:
    selected = set(args.only or [])
    known_names = {Path(relative).name for relative in KDE_FILES}
    unknown = selected - known_names
    if unknown:
        raise DotError(
            "Unknown KDE capture file(s): "
            + ", ".join(sorted(unknown))
            + ". Choose from: "
            + ", ".join(sorted(known_names))
        )
    captured = 0
    for relative in KDE_FILES:
        if selected and Path(relative).name not in selected:
            continue
        source = Path.home() / relative
        if source.is_file():
            destination = ROOT / "config/kde" / relative
            content = portable_kde_content(relative, source.read_bytes())
            captured += int(atomic_bytes(destination, content))
    record_kde_baseline()
    print(f"Captured {captured} changed KDE file(s). Display topology, wallets, caches, and history were excluded.")


def kde_file_diff(relative: str) -> list[str]:
    expected = ROOT / "config/kde" / relative
    actual = Path.home() / relative
    if not expected.exists() and not actual.exists():
        return []
    left = (
        portable_kde_content(relative, expected.read_bytes())
        .decode("utf-8", errors="replace")
        .splitlines(True)
        if expected.exists()
        else []
    )
    right = (
        portable_kde_content(relative, actual.read_bytes())
        .decode("utf-8", errors="replace")
        .splitlines(True)
        if actual.exists()
        else []
    )
    return list(
        difflib.unified_diff(
            left,
            right,
            fromfile=str(expected),
            tofile=str(actual),
        )
    )


def fzf_choose(
    rows: list[str],
    *,
    prompt: str,
    header: str = "",
    multi: bool = False,
    preview: str | None = None,
    with_nth: str = "1",
) -> list[str]:
    require_commands(["fzf"], "Install fzf, then rerun the command.")
    command = [
        "fzf",
        "--height=85%",
        "--layout=reverse",
        "--border=rounded",
        f"--prompt={prompt}",
        "--delimiter=\t",
        f"--with-nth={with_nth}",
    ]
    if header:
        command.extend(["--header", header])
    if multi:
        command.extend(
            [
                "--multi",
                "--bind=ctrl-a:select-all,ctrl-d:deselect-all",
            ]
        )
    if preview:
        command.extend(
            [
                "--preview",
                preview,
                "--preview-window=right,65%,border-left",
            ]
        )
    proc = subprocess.run(
        command,
        input="\n".join(rows) + "\n",
        text=True,
        stdout=subprocess.PIPE,
        check=False,
    )
    if proc.returncode in (1, 130):
        return []
    if proc.returncode:
        raise DotError(f"fzf failed with exit code {proc.returncode}")
    return [line for line in proc.stdout.splitlines() if line]


def save_commit_message(selected: list[str]) -> str:
    labels = [KDE_LABELS[relative].lower() for relative in selected]
    if len(labels) == 1:
        return f"update {labels[0]}"
    if len(labels) == 2:
        return f"update {labels[0]} and {labels[1]}"
    return "update KDE settings"


def cmd_save(args: argparse.Namespace) -> None:
    preset = {
        "spectacle": {
            ".config/spectaclerc",
            ".config/kglobalshortcutsrc",
        },
    }
    allowed = preset.get(args.target, set(KDE_FILES))
    drift: dict[str, list[str]] = {}
    for relative in KDE_FILES:
        if relative not in allowed:
            continue
        diff = kde_file_diff(relative)
        if diff:
            drift[relative] = diff
    if not drift:
        print("No managed configuration changes to save.")
        return

    if args.yes:
        selected = list(drift)
        action = "save"
    else:
        if not sys.stdin.isatty():
            raise DotError("Interactive selection is unavailable; rerun with --yes.")
        with tempfile.TemporaryDirectory(prefix="dot-fzf-") as directory:
            rows: list[str] = []
            for index, (relative, diff) in enumerate(drift.items()):
                preview_path = Path(directory) / f"{index}.diff"
                preview_path.write_text("".join(diff), encoding="utf-8")
                rows.append(
                    "\t".join(
                        [
                            KDE_LABELS[relative],
                            Path(relative).name,
                            str(preview_path),
                            relative,
                        ]
                    )
                )
            choices = fzf_choose(
                rows,
                prompt="Settings to save › ",
                header="Tab: toggle  Ctrl-A: all  Ctrl-D: none  Enter: continue",
                multi=True,
                preview="delta --paging=never < {3}",
                with_nth="1,2",
            )
            selected = [choice.split("\t", 3)[3] for choice in choices]
        if not selected:
            print("Nothing selected.")
            return
        action_rows = [
            "Save, validate, commit, and push\tsave",
            "Capture in dotfiles without committing\tcapture",
            "Cancel\tcancel",
        ]
        action_choice = fzf_choose(
            action_rows,
            prompt="Action › ",
            header="Enter: choose  Esc: cancel",
        )
        action = action_choice[0].split("\t", 1)[1] if action_choice else "cancel"
        if action == "cancel":
            print("Save cancelled.")
            return

    names = [Path(relative).name for relative in selected]
    paths = [ROOT / "config/kde" / relative for relative in selected]
    dirty_targets = run(
        ["git", "status", "--porcelain", "--", *map(str, paths)],
        cwd=ROOT,
        capture=True,
    ).stdout.strip()
    if dirty_targets:
        raise DotError(
            "Selected dotfiles already have uncommitted repository changes:\n"
            f"{dirty_targets}\nReview or commit them before capturing live state."
        )
    if action == "save":
        staged = run(["git", "diff", "--cached", "--quiet"], cwd=ROOT, check=False)
        if staged.returncode:
            raise DotError(
                "The Git index already contains staged changes. "
                "Commit or unstage them before saving settings."
            )

    originals = {
        path: path.read_bytes() if path.exists() else None
        for path in paths
    }
    cmd_capture_kde(argparse.Namespace(only=names))
    if action == "capture":
        print("Captured selected settings in dotfiles; they remain uncommitted.")
        return

    validation = run([str(ROOT / "tests/run")], cwd=ROOT, check=False)
    if validation.returncode:
        restore_captured_files(originals)
        record_kde_baseline()
        raise DotError("Validation failed; the repository capture was rolled back.")
    run(["git", "add", "--", *map(str, paths)], cwd=ROOT)
    run(["git", "commit", "-m", save_commit_message(selected)], cwd=ROOT)
    run(["git", "push"], cwd=ROOT)
    print("Saved and pushed the selected settings.")


def restore_captured_files(originals: dict[Path, bytes | None]) -> None:
    for path, content in originals.items():
        if content is None:
            if path.exists() or path.is_symlink():
                path.unlink()
        else:
            atomic_bytes(path, content)


def cmd_diff_kde(_args: argparse.Namespace) -> None:
    differences = 0
    output: list[str] = []
    for relative in KDE_FILES:
        diff = kde_file_diff(relative)
        if diff:
            differences += 1
            output.extend(diff)
    if differences:
        rendered = "".join(output)
        if command_exists("delta") and sys.stdout.isatty():
            proc = subprocess.run(
                ["delta", "--paging=always"],
                input=rendered,
                text=True,
                check=False,
            )
            if proc.returncode not in (0, 1):
                raise DotError(f"delta failed with exit code {proc.returncode}")
        else:
            sys.stdout.write(rendered)
        raise DotError(f"KDE drift found in {differences} file(s)")
    print("KDE allowlist matches.")


def cmd_rollback(args: argparse.Namespace) -> None:
    root = BACKUP_DIR / args.run_id
    manifest = load_json(root / "manifest.json")
    for record in manifest:
        path = Path(record["path"])
        if record.get("existed") and record.get("backup"):
            backup = Path(record["backup"])
            atomic_bytes(path, backup.read_bytes())
        elif not record.get("existed") and (path.exists() or path.is_symlink()):
            path.unlink()
    print(f"Restored backup {args.run_id}")


def cmd_palette() -> None:
    if not sys.stdin.isatty():
        raise DotError("The interactive command palette requires a terminal; use `dot --help`.")
    rows = [
        "Save configuration changes\tsave",
        "Review configuration drift\tdiff",
        "Apply Kubuntu profile\tapply",
        "Update managed programs\tupdate",
        "Run Kubuntu doctor\tdoctor",
        "Run validation suite\ttest",
        "Exit\texit",
    ]
    choice = fzf_choose(
        rows,
        prompt="dot › ",
        header="Type to filter  Enter: run  Esc: exit",
    )
    action = choice[0].split("\t", 1)[1] if choice else "exit"
    if action == "save":
        cmd_save(argparse.Namespace(target=None, yes=False))
    elif action == "diff":
        cmd_diff_kde(argparse.Namespace())
    elif action == "apply":
        cmd_apply(
            argparse.Namespace(
                profile="kubuntu-laptop",
                tags=None,
                check=False,
                direct=False,
                force_kde=False,
            )
        )
    elif action == "update":
        cmd_update(argparse.Namespace(profile="kubuntu-laptop"))
    elif action == "doctor":
        cmd_doctor(argparse.Namespace(profile="kubuntu-laptop"))
    elif action == "test":
        run([str(ROOT / "tests/run")], cwd=ROOT)


def doctor_check(label: str, ok: bool, detail: str) -> bool:
    print(f"[{'OK' if ok else 'FAIL'}] {label}: {detail}")
    return ok


def cmd_doctor(args: argparse.Namespace) -> None:
    profile = load_profile(args.profile)
    failures = 0
    expected_platform = {
        "kubuntu-laptop": "linux",
        "wsl-personal": "wsl",
        "wsl-work": "wsl",
        "windows-host": "windows",
        "termux": "termux",
    }.get(profile["name"])
    actual_platform = infer_platform()
    failures += not doctor_check("platform", actual_platform == expected_platform, f"{actual_platform}; expected {expected_platform}")
    failures += not doctor_check("device", (CONFIG_DIR / "device.json").exists(), str(CONFIG_DIR / "device.json"))
    packages = profile.get("packages", {})
    apt_packages = packages.get("apt", [])
    if apt_packages and command_exists("dpkg-query"):
        missing_apt = []
        outdated_apt = []
        for package in apt_packages:
            proc = run(
                ["dpkg-query", "-W", "-f=${Version}", package],
                check=False,
                capture=True,
            )
            if proc.returncode:
                missing_apt.append(package)
                continue
            if command_exists("apt-cache") and command_exists("dpkg"):
                policy = run(["apt-cache", "policy", package], check=False, capture=True)
                candidate = next(
                    (
                        line.split(":", 1)[1].strip()
                        for line in policy.stdout.splitlines()
                        if line.strip().startswith("Candidate:")
                    ),
                    "",
                )
                if candidate and candidate != "(none)":
                    comparison = run(
                        ["dpkg", "--compare-versions", proc.stdout.strip(), "ge", candidate],
                        check=False,
                    )
                    if comparison.returncode != 0:
                        outdated_apt.append(f"{package} ({proc.stdout.strip()} < {candidate})")
        failures += not doctor_check(
            "APT packages",
            not missing_apt and not outdated_apt,
            "all present at latest repository candidates"
            if not missing_apt and not outdated_apt
            else "; ".join(
                part
                for part in (
                    f"missing {', '.join(missing_apt)}" if missing_apt else "",
                    f"outdated {', '.join(outdated_apt)}" if outdated_apt else "",
                )
                if part
            ),
        )
    deb_packages = packages.get("deb", [])
    if deb_packages and command_exists("dpkg-query") and command_exists("dpkg-deb"):
        stale_deb = []
        for package in deb_packages:
            installed = run(
                ["dpkg-query", "-W", "-f=${Version}", package],
                check=False,
                capture=True,
            )
            latest_asset = run(
                [str(ROOT / "scripts/fetch-external-deb"), package],
                check=False,
                capture=True,
            )
            if installed.returncode or latest_asset.returncode:
                stale_deb.append(package)
                continue
            latest = run(
                ["dpkg-deb", "--field", latest_asset.stdout.strip(), "Version"],
                check=False,
                capture=True,
            )
            if latest.returncode or installed.stdout.strip() != latest.stdout.strip():
                stale_deb.append(
                    f"{package} ({installed.stdout.strip() or 'missing'} -> "
                    f"{latest.stdout.strip() or 'unknown'})"
                )
        failures += not doctor_check(
            "External Debian packages",
            not stale_deb,
            "all at latest stable releases"
            if not stale_deb
            else f"missing or outdated {', '.join(stale_deb)}",
        )
    brew_packages = packages.get("brew", [])
    if brew_packages:
        if not command_exists("brew"):
            failures += not doctor_check("Homebrew packages", False, "brew is not installed")
        else:
            proc = run(["brew", "list", "--formula"], check=False, capture=True)
            installed = set(proc.stdout.splitlines())
            missing_brew = [package for package in brew_packages if package not in installed]
            outdated = run(["brew", "outdated", "--formula"], check=False, capture=True)
            outdated_brew = sorted(set(outdated.stdout.splitlines()) & set(brew_packages))
            failures += not doctor_check(
                "Homebrew packages",
                not missing_brew and not outdated_brew,
                "all present at latest stable releases"
                if not missing_brew and not outdated_brew
                else "; ".join(
                    part
                    for part in (
                        f"missing {', '.join(missing_brew)}" if missing_brew else "",
                        f"outdated {', '.join(outdated_brew)}" if outdated_brew else "",
                    )
                    if part
                ),
            )
    pkg_packages = packages.get("pkg", [])
    if pkg_packages and command_exists("pkg"):
        proc = run(["pkg", "list-installed"], check=False, capture=True)
        installed_pkg = {line.split("/", 1)[0] for line in proc.stdout.splitlines() if "/" in line}
        missing_pkg = [package for package in pkg_packages if package not in installed_pkg]
        failures += not doctor_check(
            "Termux packages",
            not missing_pkg,
            "all present; pkg upgrade supplies latest stable repository releases"
            if not missing_pkg
            else f"missing {', '.join(missing_pkg)}",
        )
    snap_packages = packages.get("snap", [])
    if snap_packages:
        proc = run(["snap", "list"], check=False, capture=True)
        installed_snaps = {line.split()[0] for line in proc.stdout.splitlines()[1:] if line.split()}
        missing_snaps = [
            package
            for package in snap_packages
            if package not in installed_snaps and not command_exists(package)
        ]
        failures += not doctor_check(
            "Snap packages",
            not missing_snaps,
            "all present" if not missing_snaps else f"missing {', '.join(missing_snaps)}",
        )
    if profile.get("features", {}).get("shell"):
        failures += not doctor_check("zsh", command_exists("zsh"), shutil.which("zsh") or "not installed")
        dot_command = Path.home() / ".local/bin/dot"
        failures += not doctor_check(
            "dot command",
            dot_command.is_symlink() and dot_command.resolve() == (ROOT / "bin/dot").resolve(),
            str(dot_command),
        )
        failures += not doctor_check("mbash", (Path.home() / ".local/bin/mbash").exists(), "minimal Bash entry point")
        login_shell = os.environ.get("SHELL", "")
        if os.name != "nt":
            try:
                import pwd

                login_shell = pwd.getpwnam(getpass.getuser()).pw_shell
            except (ImportError, KeyError):
                pass
        failures += not doctor_check(
            "login shell",
            login_shell.endswith("/zsh"),
            login_shell,
        )
    if profile.get("features", {}).get("git"):
        include = str(ROOT / "config/git/root.gitconfig")
        proc = run(["git", "config", "--global", "--get-all", "include.path"], check=False, capture=True)
        failures += not doctor_check("git include", include in proc.stdout.splitlines(), include)
        identity = CONFIG_DIR / f"git-{profile.get('account', 'personal')}.gitconfig"
        failures += not doctor_check("git identity", identity.exists(), str(identity))
        failures += not doctor_check("Bitwarden CLI", command_exists("bw"), shutil.which("bw") or "not installed")
        failures += not doctor_check("GitHub CLI", command_exists("gh"), shutil.which("gh") or "not installed")
        gh_authenticated, gh_scopes = github_auth_state()
        missing_scopes = GITHUB_REQUIRED_SCOPES - gh_scopes
        failures += not doctor_check(
            "GitHub authorization",
            gh_authenticated and not missing_scopes,
            "authenticated with SSH key-management scopes"
            if gh_authenticated and not missing_scopes
            else f"missing {', '.join(sorted(missing_scopes)) or 'authentication'}",
        )
        if profile["name"] == "kubuntu-laptop":
            agent_sockets = [
                Path.home() / ".bitwarden-ssh-agent.sock",
                Path.home() / "snap/bitwarden/current/.bitwarden-ssh-agent.sock",
            ]
            active_socket = next((path for path in agent_sockets if path.is_socket()), None)
            failures += not doctor_check(
                "Bitwarden SSH agent",
                active_socket is not None,
                str(active_socket or agent_sockets[0]),
            )
    if profile.get("features", {}).get("kde"):
        session = os.environ.get("XDG_SESSION_DESKTOP", "")
        failures += not doctor_check("KDE session", "KDE" in session.upper(), session or "unknown")
        failures += not doctor_check("display state", True, "host-local; portable kscreen state is intentionally excluded")
        segoe = list((Path.home() / ".local/share/fonts").glob("**/SegUIVar.ttf"))
        failures += not doctor_check("Segoe UI Variable", bool(segoe), str(segoe[0]) if segoe else "not provisioned")
    if profile.get("features", {}).get("vite_plus"):
        vite_plus_check = run(
            [str(ROOT / "scripts/install-vite-plus"), "--check"],
            check=False,
            capture=True,
        )
        vite_plus_detail = (vite_plus_check.stdout or vite_plus_check.stderr).strip()
        failures += not doctor_check(
            "Vite+",
            vite_plus_check.returncode == 0,
            vite_plus_detail or "managed Vite+ check failed",
        )
    if profile.get("features", {}).get("codex_remote_control"):
        codex_check = run(
            [str(ROOT / "scripts/install-codex"), "--check"],
            check=False,
            capture=True,
        )
        codex_detail = (codex_check.stdout or codex_check.stderr).strip()
        failures += not doctor_check(
            "Codex standalone CLI",
            codex_check.returncode == 0,
            codex_detail or "standalone install check failed",
        )
        unit_name = "codex-remote-control.service"
        enabled = run(
            ["systemctl", "--user", "is-enabled", "--quiet", unit_name],
            check=False,
        ).returncode == 0
        active = run(
            ["systemctl", "--user", "is-active", "--quiet", unit_name],
            check=False,
        ).returncode == 0
        failures += not doctor_check(
            "Codex Remote Control",
            enabled and active,
            "enabled and active"
            if enabled and active
            else f"{unit_name} is not {'enabled' if not enabled else 'active'}",
        )
        linger = run(
            ["loginctl", "show-user", getpass.getuser(), "--property=Linger", "--value"],
            check=False,
            capture=True,
        )
        failures += not doctor_check(
            "Codex boot persistence",
            linger.returncode == 0 and linger.stdout.strip() == "yes",
            "systemd user lingering enabled"
            if linger.returncode == 0 and linger.stdout.strip() == "yes"
            else "enable with loginctl enable-linger",
        )
    if failures:
        raise DotError(f"Doctor found {failures} failing check(s)")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="dot")
    sub = parser.add_subparsers(dest="command")
    bootstrap = sub.add_parser("bootstrap")
    bootstrap.add_argument("--profile", required=True)
    bootstrap.add_argument("--device")
    bootstrap.add_argument("--skip-secrets", action="store_true")
    bootstrap.set_defaults(func=cmd_bootstrap)
    apply = sub.add_parser("apply")
    apply.add_argument("--profile", required=True)
    apply.add_argument("--tags")
    apply.add_argument("--check", action="store_true")
    apply.add_argument("--direct", action="store_true")
    apply.add_argument(
        "--force-kde",
        action="store_true",
        help="replace conflicting live KDE files after backing them up",
    )
    apply.set_defaults(func=cmd_apply)
    doctor = sub.add_parser("doctor")
    doctor.add_argument("--profile", required=True)
    doctor.set_defaults(func=cmd_doctor)
    update = sub.add_parser("update")
    update.add_argument("--profile", required=True)
    update.set_defaults(func=cmd_update)
    package = sub.add_parser("package")
    package_sub = package.add_subparsers(dest="package_command", required=True)
    add = package_sub.add_parser("add")
    add.add_argument("name")
    add.add_argument("--profile", required=True)
    add.add_argument("--provider")
    add.add_argument("--no-apply", action="store_true")
    add.set_defaults(func=cmd_package_add)
    codex = sub.add_parser("codex")
    codex_sub = codex.add_subparsers(dest="codex_command", required=True)
    codex_install = codex_sub.add_parser("install")
    codex_install.set_defaults(func=cmd_codex_install)
    codex_update = codex_sub.add_parser("update")
    codex_update.set_defaults(func=cmd_codex_update)
    vite_plus = sub.add_parser("vite-plus")
    vite_plus_sub = vite_plus.add_subparsers(dest="vite_plus_command", required=True)
    vite_plus_install = vite_plus_sub.add_parser("install")
    vite_plus_install.set_defaults(func=cmd_vite_plus_install)
    vite_plus_update = vite_plus_sub.add_parser("update")
    vite_plus_update.set_defaults(func=cmd_vite_plus_update)
    repos = sub.add_parser("repos")
    repos_sub = repos.add_subparsers(dest="repos_command", required=True)
    sync = repos_sub.add_parser("sync")
    sync.add_argument("--profile", required=True)
    sync.set_defaults(func=cmd_repos_sync)
    secrets = sub.add_parser("secrets")
    secrets_sub = secrets.add_subparsers(dest="secrets_command", required=True)
    secret_initialize = secrets_sub.add_parser("initialize")
    secret_initialize.add_argument("--draft", required=True)
    secret_initialize.set_defaults(func=cmd_secrets_initialize)
    secret_sync = secrets_sub.add_parser("sync")
    secret_sync.add_argument("--profile", required=True)
    secret_sync.add_argument("--device")
    secret_sync.add_argument("--no-register", action="store_true")
    secret_sync.set_defaults(func=cmd_secrets_sync)
    capture = sub.add_parser("capture")
    capture.add_argument("target", choices=["kde"])
    capture.add_argument(
        "--only",
        action="append",
        metavar="NAME",
        help="capture only a named allowlisted file; may be repeated",
    )
    capture.set_defaults(func=cmd_capture_kde)
    save = sub.add_parser("save")
    save.add_argument("target", nargs="?", choices=["spectacle"])
    save.add_argument(
        "--yes",
        action="store_true",
        help="skip the interactive diff confirmation",
    )
    save.set_defaults(func=cmd_save)
    diff = sub.add_parser("diff")
    diff.add_argument("target", choices=["kde"])
    diff.set_defaults(func=cmd_diff_kde)
    rollback = sub.add_parser("rollback")
    rollback.add_argument("run_id")
    rollback.set_defaults(func=cmd_rollback)
    return parser


def main() -> int:
    try:
        args = build_parser().parse_args()
        if hasattr(args, "func"):
            args.func(args)
        else:
            cmd_palette()
        return 0
    except DotError as exc:
        print(f"dot: {exc}", file=sys.stderr)
        return 1
    except subprocess.CalledProcessError as exc:
        command = exc.cmd if isinstance(exc.cmd, list) else [str(exc.cmd)]
        program = Path(str(command[0])).name if command else "external command"
        print(f"dot: {program} failed with exit code {exc.returncode}", file=sys.stderr)
        if exc.stderr:
            print(exc.stderr.strip(), file=sys.stderr)
        return exc.returncode or 1


if __name__ == "__main__":
    raise SystemExit(main())
