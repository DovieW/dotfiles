                capture=True,
            )
            if installed.returncode != 0 or installed.stdout.strip() != "installed":
                missing_memory_packages.append(package)
        failures += not doctor_check(
            "Memory-pressure packages",
            not missing_memory_packages,
            "zram generator and systemd-oomd installed"
            if not missing_memory_packages
            else f"missing {', '.join(missing_memory_packages)}",
        )
        active_swaps = run(
            ["swapon", "--show=NAME,TYPE,SIZE,PRIO", "--noheadings"],
