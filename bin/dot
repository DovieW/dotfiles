            tailscale_state = ""
        failures += not doctor_check(
            "Tailscale enrollment",
            tailscale_status is not None
            and tailscale_status.returncode == 0
            and tailscale_state == "Running",
            "joined to a tailnet"
            if tailscale_status is not None
            and tailscale_status.returncode == 0
            and tailscale_state == "Running"
            else "run sudo tailscale up and authenticate with the browser URL",
        )
    if profile.get("features", {}).get("meshcentral_agent"):
        mesh_installed, mesh_enabled, mesh_active, mesh_config = (
            meshcentral_service_state()
