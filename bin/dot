class DotError(RuntimeError):
    pass


def kde_source(relative: str) -> Path:
    return KDE_SOURCE_OVERRIDES.get(relative, ROOT / "config/kde" / relative)


def run(
    args: list[str],
    *,
    check: bool = True,
    capture: bool = False,
    env: dict[str, str] | None = None,
    cwd: Path | None = None,
    timeout: float | None = None,
) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        args,
        check=check,
        text=True,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.PIPE if capture else None,
        env=env,
        cwd=cwd,
        timeout=timeout,
    )


def load_json(path: Path) -> dict[str, Any]:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise DotError(f"Cannot read {path}: {exc}") from exc


def merge(left: dict[str, Any], right: dict[str, Any]) -> dict[str, Any]:
    result = json.loads(json.dumps(left))
    for key, value in right.items():
        if key == "inherits":
            continue
        if isinstance(value, dict) and isinstance(result.get(key), dict):
            result[key] = merge(result[key], value)
        elif isinstance(value, list) and isinstance(result.get(key), list):
            result[key] = list(dict.fromkeys(result[key] + value))
        else:
            result[key] = value
    return result


def normalize_profile(name: str) -> str:
    return "common-linux" if name == "common" else name


def load_profile(name: str, stack: tuple[str, ...] = ()) -> dict[str, Any]:
    name = normalize_profile(name)
    if name in stack:
        raise DotError(f"Profile inheritance cycle: {' -> '.join(stack + (name,))}")
    path = PROFILE_DIR / f"{name}.yml"
    data = load_json(path)
    if data.get("schema_version") != 1 or data.get("name") != name:
        raise DotError(f"Invalid profile header in {path}")
    combined: dict[str, Any] = {"inherits": [], "features": {}, "packages": {}}
    for parent in data.get("inherits", []):
        combined = merge(combined, load_profile(parent, stack + (name,)))
    return merge(combined, data)


def atomic_text(path: Path, text: str, mode: int | None = None) -> bool:
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.exists() and path.read_text(encoding="utf-8") == text:
        if mode is not None:
            path.chmod(mode)
        return False
    temp = path.with_name(f".{path.name}.dot-tmp")
    temp.write_text(text, encoding="utf-8")
    if mode is not None:
        temp.chmod(mode)
    temp.replace(path)
    return True


def atomic_bytes(path: Path, content: bytes, mode: int | None = None) -> bool:
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.exists() and path.read_bytes() == content:
        if mode is not None:
            path.chmod(mode)
        return False
    temp = path.with_name(f".{path.name}.dot-tmp")
    temp.write_bytes(content)
    if mode is not None:
        temp.chmod(mode)
    temp.replace(path)
    return True


def infer_platform() -> str:
    if os.environ.get("TERMUX_VERSION") or Path("/data/data/com.termux").exists():
        return "termux"
    if platform.system() == "Windows":
        return "windows"
    try:
        if "microsoft" in Path("/proc/version").read_text().lower():
            return "wsl"
    except OSError:
        pass
    return "linux"


def inferred_device_id() -> str:
    host = socket.gethostname()
    if infer_platform() == "wsl":
        command = Path("/mnt/c/Windows/System32/hostname.exe")
        if command.exists():
            proc = run([str(command)], check=False, capture=True)
            if proc.returncode == 0 and proc.stdout.strip():
                host = proc.stdout.strip()
    value = re.sub(r"[^a-z0-9-]+", "-", host.lower()).strip("-")
    return value or "unnamed-device"


def validate_device_id(device: Any) -> str:
    if not isinstance(device, str) or not re.fullmatch(r"[a-z0-9](?:[a-z0-9-]{0,62})", device):
        raise DotError(
            "Device ID must be 1-63 lowercase letters, numbers, or hyphens, "
            "starting with a letter or number."
        )
    return device


def ensure_device(explicit: str | None = None) -> str:
    path = CONFIG_DIR / "device.json"
    existing = load_json(path) if path.exists() else {}
    device = explicit if explicit is not None else (existing.get("device_id") or inferred_device_id())
    validate_device_id(device)
    payload = {"schema_version": 1, "device_id": device}
    atomic_text(path, json.dumps(payload, indent=2) + "\n", 0o600)
    return device


def device_manifest_path(device: str) -> Path:
    return DEVICE_DIR / f"{device}.yml"


def load_device_manifest(device: str, required: bool = False) -> dict[str, Any] | None:
    path = device_manifest_path(device)
    if not path.exists():
        if required:
            raise DotError(
                f"No finalized device manifest exists at {path}. "
                "Treat this as a new computer and run `dot finalize prepare`."
            )
        return None
    manifest = load_json(path)
    if (
        manifest.get("schema_version") != 1
        or manifest.get("device_id") != device
        or not isinstance(manifest.get("profile"), str)
        or manifest.get("finalized") is not True
        or not isinstance(manifest.get("approved_tags"), list)
        or not all(isinstance(tag, str) for tag in manifest.get("approved_tags", []))
        or len(set(manifest.get("approved_tags", []))) != len(manifest.get("approved_tags", []))
    ):
        raise DotError(f"Invalid finalized device manifest: {path}")
    unknown = set(manifest["approved_tags"]) - set(FINALIZATION_DEFERRED_TAGS)
    if unknown:
        raise DotError(
            f"Device manifest contains unsupported finalization tags: {', '.join(sorted(unknown))}"
        )
    return manifest


def capture_inventory_command(command: list[str]) -> str:
    if not command_exists(command[0]):
        return "unavailable"
    proc = run(command, check=False, capture=True)
    output = (proc.stdout or proc.stderr).strip()
    return output if output else f"exit {proc.returncode}; no output"


def machine_inventory(profile: str, device: str) -> dict[str, Any]:
    dmi = {}
    for name in ("sys_vendor", "product_name", "product_version"):
        path = Path("/sys/class/dmi/id") / name
        try:
            dmi[name] = path.read_text(encoding="utf-8").strip()
        except OSError:
            dmi[name] = "unavailable"
    os_release = {}
    try:
        for line in Path("/etc/os-release").read_text(encoding="utf-8").splitlines():
            if "=" in line:
                key, value = line.split("=", 1)
                os_release[key] = value.strip().strip('"')
    except OSError:
        pass
    bootstrap_state = STATE_DIR / "bootstrap" / f"{profile}.json"
    return {
        "schema_version": 1,
        "generated_at": dt.datetime.now(dt.timezone.utc).isoformat(),
        "device_id": device,
        "profile": profile,
        "repository": {"path": str(ROOT), "commit": capture_inventory_command(["git", "rev-parse", "HEAD"])},
        "platform": infer_platform(),
        "hostname": socket.gethostname(),
        "kernel": platform.release(),
        "architecture": platform.machine(),
        "os_release": {key: os_release.get(key, "") for key in ("ID", "VERSION_ID", "PRETTY_NAME")},
        "dmi": dmi,
        "cpu": capture_inventory_command(["lscpu"]),
        "pci": capture_inventory_command(["lspci", "-nnk"]),
        "usb": capture_inventory_command(["lsusb"]),
        "graphics_recommendation": capture_inventory_command(["ubuntu-drivers", "devices"]),
        "bootstrap_state": load_json(bootstrap_state) if bootstrap_state.exists() else {},
        "deferred_tags": list(FINALIZATION_DEFERRED_TAGS),
    }


def write_finalization_handoff(profile: str, device: str) -> Path:
    inventory = machine_inventory(profile, device)
    atomic_text(FINALIZATION_INVENTORY, json.dumps(inventory, indent=2) + "\n", 0o600)
    manifest = device_manifest_path(device)
    handoff = f"""# Finalize this computer

This file was generated by `dot finalize prepare`. A fresh coding agent must
read `{ROOT / 'AGENTS.md'}` and `{ROOT / 'docs/finalize-computer.md'}` before
changing or applying this machine.

## Objective

Finalize logical device `{device}` for profile `{profile}` without turning
machine-specific hardware assumptions into global profile policy.

## Current state

- Repository: `{ROOT}`
- Commit: `{inventory['repository']['commit']}`
- Inventory: `{FINALIZATION_INVENTORY}`
- Expected device manifest: `{manifest}`
- Baseline bootstrap deliberately deferred: {', '.join(FINALIZATION_DEFERRED_TAGS)}

## Required completion

1. Inspect the inventory and live machine with read-only commands.
2. Decide which deferred tags apply and whether generic hardware detection
   should be improved instead of adding a device exception.
3. Create the versioned device manifest using
   `devices/example-device.yml` as the schema reference.
4. Run the repository tests and relevant check-mode or targeted validation.
5. Run `dot finalize apply --profile {profile}` only after reviewing the
   resulting device policy.
6. Re-run `dot doctor --profile {profile}`, documenting expected enrollment or
   reboot boundaries separately from failures.
7. Commit and push the durable repository changes. Refresh DOTBOOT only when a
   currently attached removable device has been freshly identified by serial.

Do not store passwords, tokens, raw hardware serial numbers, product UUIDs,
vault exports, or private keys in the repository or this handoff.
"""
    atomic_text(FINALIZATION_HANDOFF, handoff, 0o600)
    return FINALIZATION_HANDOFF


def bootstrap_preflight(profile: dict[str, Any], device: str) -> dict[str, Any]:
    expected_platform = {
        "kubuntu-laptop": "linux",
        "kubuntu-desktop": "linux",
        "wsl-personal": "wsl",
        "wsl-work": "wsl",
        "termux": "termux",
    }.get(profile["name"])
    actual_platform = infer_platform()
    failures = []
    warnings = []
    if expected_platform and actual_platform != expected_platform:
        failures.append(f"platform is {actual_platform}; expected {expected_platform}")
    inferred = inferred_device_id()
    if device != inferred:
        failures.append(
            f"system hostname implies {inferred!r}, but dotfiles identity is {device!r}; "
            f"run `{ROOT / 'bin/dot'} device rename {device} {inferred} "
            f"--profile {profile['name']}`"
        )
    free_bytes = shutil.disk_usage(Path.home()).free
    if free_bytes < 4 * 1024**3:
        failures.append(f"home filesystem has only {free_bytes / 1024**3:.1f} GiB free")
    tmp_options = capture_inventory_command(["findmnt", "-n", "-o", "OPTIONS", "/tmp"])
    if "noexec" in tmp_options.split(","):
        warnings.append("/tmp is noexec; managed installers will use executable app storage")
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="exec-probe-", dir=STATE_DIR) as directory:
        probe = Path(directory) / "probe.sh"
        probe.write_text("#!/bin/sh\nexit 0\n", encoding="utf-8")
        probe.chmod(0o700)
        executable_home = run([str(probe)], check=False).returncode == 0
    if not executable_home:
        failures.append(f"managed executable storage under {STATE_DIR} is mounted noexec")
    dpkg_audit = (
        capture_inventory_command(["dpkg", "--audit"])
        if command_exists("dpkg")
        else "unavailable"
    )
    if dpkg_audit not in {"exit 0; no output", "unavailable"}:
        failures.append("dpkg reports interrupted or incomplete package configuration")
    result = {
        "schema_version": 1,
        "generated_at": dt.datetime.now(dt.timezone.utc).isoformat(),
        "profile": profile["name"],
        "device_id": device,
        "platform": actual_platform,
        "inferred_device_id": inferred,
        "free_gib": round(free_bytes / 1024**3, 1),
        "tmp_mount_options": tmp_options,
        "executable_managed_storage": executable_home,
        "dpkg_audit": dpkg_audit,
        "warnings": warnings,
        "failures": failures,
    }
    atomic_text(BOOTSTRAP_PREFLIGHT, json.dumps(result, indent=2) + "\n", 0o600)
    for warning in warnings:
        print(f"Bootstrap preflight warning: {warning}")
    if failures:
        raise DotError(
            "Bootstrap preflight failed:\n- " + "\n- ".join(failures)
            + f"\nDetails: {BOOTSTRAP_PREFLIGHT}"
        )
    print(
        f"Bootstrap preflight passed for {device}: {result['free_gib']} GiB free; "
        "package state and executable storage are healthy."
    )
    return result


def write_bootstrap_support_report(
    profile: str, device: str, phase: str, error: BaseException
) -> Path:
    state_path = STATE_DIR / "bootstrap" / f"{profile}.json"
    state = load_json(state_path) if state_path.exists() else {}
    report = f"""DOTFILES BOOTSTRAP SUPPORT REPORT
generated_at: {dt.datetime.now(dt.timezone.utc).isoformat()}
profile: {profile}
device: {device}
hostname: {socket.gethostname()}
platform: {infer_platform()}
repository: {ROOT}
commit: {capture_inventory_command(['git', 'rev-parse', 'HEAD'])}
failed_phase: {phase}
error_type: {type(error).__name__}
error: {error}
bootstrap_state: {json.dumps(state, sort_keys=True)}
preflight: {BOOTSTRAP_PREFLIGHT}
finalization_handoff: {FINALIZATION_HANDOFF}

This report intentionally excludes passwords, tokens, vault data, network
addresses, hardware serials, product UUIDs, and raw Ansible logs.
"""
    atomic_text(BOOTSTRAP_SUPPORT, report, 0o600)
    return BOOTSTRAP_SUPPORT


def command_exists(name: str) -> bool:
    return shutil.which(name) is not None


def require_clean_pushed_head() -> tuple[str, str]:
    status = run(["git", "status", "--porcelain"], cwd=ROOT, capture=True).stdout
    if status.strip():
        raise DotError("Bootstrap media requires a clean dotfiles worktree.")
    branch = run(
        ["git", "symbolic-ref", "--quiet", "--short", "HEAD"],
        cwd=ROOT,
        check=False,
        capture=True,
    )
    if branch.returncode or not branch.stdout.strip():
        raise DotError("Bootstrap media cannot be built from a detached HEAD.")
    upstream = run(
        ["git", "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{upstream}"],
        cwd=ROOT,
        check=False,
        capture=True,
    )
    if upstream.returncode:
        raise DotError("The current branch has no upstream.")
    run(["git", "fetch", "--quiet", "origin"], cwd=ROOT)
    head = run(["git", "rev-parse", "HEAD"], cwd=ROOT, capture=True).stdout.strip()
    remote = run(["git", "rev-parse", "@{upstream}"], cwd=ROOT, capture=True).stdout.strip()
    if head != remote:
        raise DotError("Bootstrap media requires HEAD to match its fetched upstream.")
    return branch.stdout.strip(), head


def build_bootstrap_media(destination: Path) -> dict[str, Any]:
    branch, commit = require_clean_pushed_head()
    if destination.exists() and any(destination.iterdir()):
        raise DotError(f"Bootstrap staging destination is not empty: {destination}")
    destination.mkdir(parents=True, exist_ok=True)
    payload = destination / "payload"
    payload.mkdir()
    for source in BOOTSTRAP_MEDIA_SOURCE.iterdir():
        if source.is_file():
            shutil.copy2(source, destination / source.name)
    bundle = payload / "dotfiles.bundle"
    run(
        ["git", "bundle", "create", str(bundle), f"refs/heads/{branch}"],
        cwd=ROOT,
    )
    run(["git", "bundle", "verify", str(bundle)], cwd=ROOT, capture=True)
    manifest = {
        "schema_version": 1,
        "created_utc": dt.datetime.now(dt.timezone.utc).isoformat(),
        "branch": branch,
        "commit": commit,
        "origin": "git@github.com:DovieW/dotfiles.git",
        "profiles": ["kubuntu-laptop", "kubuntu-desktop", "windows-host", "wsl-personal", "wsl-work"],
        "contains_secrets": False,
    }
    atomic_text(destination / "manifest.json", json.dumps(manifest, indent=2) + "\n")
    checksum_paths = sorted(
        path for path in destination.rglob("*")
        if path.is_file() and path.name != "SHA256SUMS"
    )
    checksums = "".join(
        f"{hashlib.sha256(path.read_bytes()).hexdigest()}  {path.relative_to(destination).as_posix()}\n"
        for path in checksum_paths
    )
    atomic_text(destination / "SHA256SUMS", checksums)
    return manifest


def verify_bootstrap_media(path: Path) -> dict[str, Any]:
    root = path.resolve()
    checksums = root / "SHA256SUMS"
    if not checksums.is_file():
        raise DotError(f"Missing bootstrap checksum file: {checksums}")
    for line in checksums.read_text(encoding="utf-8").splitlines():
        match = re.fullmatch(r"([0-9a-f]{64})  (.+)", line)
        if not match:
            raise DotError(f"Invalid bootstrap checksum line: {line!r}")
        candidate = (root / match.group(2)).resolve()
        if root not in candidate.parents or not candidate.is_file():
            raise DotError(f"Unsafe or missing bootstrap payload path: {match.group(2)}")
        actual = hashlib.sha256(candidate.read_bytes()).hexdigest()
        if actual != match.group(1):
            raise DotError(f"Bootstrap payload checksum mismatch: {match.group(2)}")
    manifest = load_json(root / "manifest.json")
    if manifest.get("schema_version") != 1 or manifest.get("contains_secrets") is not False:
        raise DotError("Invalid or unsafe bootstrap media manifest.")
    run(["git", "bundle", "verify", str(root / "payload/dotfiles.bundle")], capture=True)
    return manifest


def bootstrap_usb_info(device: str) -> tuple[Path, dict[str, Any]]:
    requested = Path(device)
    if not requested.is_absolute() or not requested.name.startswith("usb-"):
        raise DotError("Use an absolute stable /dev/disk/by-id/usb-* device path.")
    try:
        resolved = requested.resolve(strict=True)
    except OSError as exc:
        raise DotError(f"Cannot resolve bootstrap-media device {requested}: {exc}") from exc
    result = run(
        [
            "lsblk", "--json", "--tree", "--bytes", "--output",
            "PATH,TYPE,TRAN,RM,SIZE,MODEL,SERIAL,FSTYPE,LABEL,MOUNTPOINTS",
            str(resolved),
        ],
        capture=True,
    )
    payload = json.loads(result.stdout)
    devices = payload.get("blockdevices", [])
    if len(devices) != 1:
        raise DotError(f"Could not uniquely inspect {requested}")
    info = devices[0]
    if info.get("type") != "disk" or info.get("tran") != "usb" or not info.get("rm"):
        raise DotError(f"Refusing non-removable or non-USB target: {requested}")
    properties = run(
        ["udevadm", "info", "--query=property", f"--name={resolved}"],
        check=False,
        capture=True,
    )
    udev = dict(
        line.split("=", 1)
        for line in properties.stdout.splitlines()
        if "=" in line
    )
    if not info.get("serial"):
        info["serial"] = udev.get("ID_SERIAL_SHORT")
    if not info.get("model"):
        info["model"] = udev.get("ID_MODEL", "").replace("_", " ")
    for child in info.get("children", []) or []:
        if child.get("fstype") and child.get("label"):
            continue
        child_properties = run(
            ["udevadm", "info", "--query=property", f"--name={child['path']}"],
            check=False,
            capture=True,
        )
        child_udev = dict(
            line.split("=", 1)
            for line in child_properties.stdout.splitlines()
            if "=" in line
        )
        if not child.get("fstype"):
            child["fstype"] = child_udev.get("ID_FS_TYPE")
        if not child.get("label"):
            child["label"] = child_udev.get("ID_FS_LABEL")
    stable_serial = udev.get("ID_SERIAL_SHORT")
    if not stable_serial or stable_serial not in requested.name:
        raise DotError("The stable USB path does not contain the device's current udev serial.")
    root_source = run(["findmnt", "-n", "-o", "SOURCE", "/"], capture=True).stdout.strip()
    root_ancestry = run(
        ["lsblk", "--inverse", "--noheadings", "--output", "PATH", root_source],
        check=False,
        capture=True,
    )
    root_devices = {line.strip() for line in root_ancestry.stdout.splitlines()}
    if str(resolved) in root_devices:
        raise DotError("Refusing to use the active system disk as bootstrap media.")
    return resolved, info


def bootstrap_partition(info: dict[str, Any]) -> dict[str, Any] | None:
    children = info.get("children", []) or []
    partitions = [child for child in children if child.get("type") == "part"]
    return partitions[0] if len(partitions) == 1 else None


def mounted_bootstrap_path(partition: dict[str, Any]) -> Path:
    mounts = [item for item in (partition.get("mountpoints") or []) if item]
    if mounts:
        return Path(mounts[0])
    run(["udisksctl", "mount", "--block-device", partition["path"]])
    refreshed = run(
        ["lsblk", "--json", "--output", "PATH,MOUNTPOINTS", partition["path"]],
        capture=True,
    )
    values = json.loads(refreshed.stdout)["blockdevices"][0].get("mountpoints") or []
    mounts = [item for item in values if item]
    if len(mounts) != 1:
        raise DotError(f"Could not determine mount point for {partition['path']}")
    return Path(mounts[0])


def install_bootstrap_staging(staging: Path, mount: Path) -> None:
    if not mount.is_dir():
        raise DotError(f"Bootstrap media mount is unavailable: {mount}")
    for existing in mount.iterdir():
        if existing.is_dir() and not existing.is_symlink():
            shutil.rmtree(existing)
        else:
            existing.unlink()
    for source in staging.iterdir():
        destination = mount / source.name
        if source.is_dir():
            shutil.copytree(source, destination)
        else:
            shutil.copy2(source, destination)
    run(["sync"])
    verify_bootstrap_media(mount)


def confirm_bootstrap_erase(info: dict[str, Any], args: argparse.Namespace) -> None:
    serial = str(info.get("serial") or "").strip()
    if not serial:
        raise DotError("The USB target has no stable serial number; refusing erase.")
    print(
        "Bootstrap-media erase target:\n"
        f"  model: {str(info.get('model') or '').strip()}\n"
        f"  serial: {serial}\n"
        f"  size: {int(info.get('size') or 0) / (1024 ** 3):.1f} GiB"
    )
    if args.yes:
        if args.serial != serial:
            raise DotError("--yes requires the exact current --serial value.")
        return
    if not sys.stdin.isatty():
        raise DotError("Run interactively to confirm media erasure.")
    if input("Type the USB serial to continue: ").strip() != serial:
        raise DotError("USB serial confirmation did not match.")
    if input("Type ERASE to destroy the existing media: ").strip() != "ERASE":
        raise DotError("Erase confirmation was cancelled.")


def bootstrap_media_privilege_prefix() -> list[str]:
    passwordless = run(["sudo", "-n", "true"], check=False, capture=True)
    if passwordless.returncode == 0:
        return ["sudo", "-n"]
    if command_exists("pkexec"):
        return ["pkexec"]
    if sys.stdin.isatty():
        return ["sudo"]
    raise DotError("Administrator authorization requires an interactive terminal or PolicyKit agent.")


def cmd_bootstrap_media(args: argparse.Namespace) -> None:
    if args.media_action == "verify":
        manifest = verify_bootstrap_media(Path(args.path))
        print(f"Bootstrap media verified at commit {manifest['commit']}.")
        return
    prepared = tempfile.TemporaryDirectory(prefix="dot-bootstrap-media-")
    staging = Path(prepared.name)
    manifest = build_bootstrap_media(staging)
    resolved, info = bootstrap_usb_info(args.device)
    partition = bootstrap_partition(info)
    if args.media_action == "refresh":
        if partition is None or partition.get("label") != "DOTBOOT" or partition.get("fstype") not in {"vfat", "fat32"}:
            raise DotError("Refresh requires one existing FAT32 partition labeled DOTBOOT.")
    else:
        if any(item for child in (info.get("children") or []) for item in (child.get("mountpoints") or []) if item):
            raise DotError("Unmount every target partition before creating bootstrap media.")
        confirm_bootstrap_erase(info, args)
        require_commands(
            ["lsblk", "findmnt", "sfdisk", "mkfs.vfat", "partprobe", "udisksctl"],
            "Install util-linux, dosfstools, parted, and udisks2, then retry.",
        )
        privilege = bootstrap_media_privilege_prefix()
        run([*privilege, "wipefs", "--all", str(resolved)])
        subprocess.run(
            [*privilege, "sfdisk", str(resolved)],
            input="label: dos\n, , c, *\n",
            text=True,
            check=True,
        )
        run([*privilege, "partprobe", str(resolved)])
        for _ in range(20):
            time.sleep(0.25)
            _, refreshed = bootstrap_usb_info(args.device)
            partition = bootstrap_partition(refreshed)
            if partition:
                break
        if partition is None:
            raise DotError("The new USB partition did not appear.")
        run([*privilege, "mkfs.vfat", "-F", "32", "-n", "DOTBOOT", partition["path"]])
        _, refreshed = bootstrap_usb_info(args.device)
        partition = bootstrap_partition(refreshed)
        if partition is None:
            raise DotError("The formatted USB partition disappeared.")
    try:
        mount = mounted_bootstrap_path(partition)
        install_bootstrap_staging(staging, mount)
        run(["udisksctl", "unmount", "--block-device", partition["path"]])
        run(["udisksctl", "power-off", "--block-device", str(resolved)])
    finally:
        prepared.cleanup()
    print(f"Bootstrap media {args.media_action} complete at commit {manifest['commit']}; the USB is powered off.")


def panel_manifest() -> dict[str, Any]:
    payload = load_json(PANEL_PROFILES_FILE)
    profiles = payload.get("profiles")
    default = payload.get("default")
    tray = payload.get("tray")
    launchers = payload.get("launchers")
    if (
        payload.get("schema_version") != 1
        or not isinstance(profiles, dict)
        or default not in profiles
        or not isinstance(tray, dict)
        or payload.get("launcher_icon") != "windows11"
        or not isinstance(launchers, list)
        or not all(isinstance(item, str) and item for item in launchers)
        or len(launchers) != len(set(launchers))
    ):
        raise DotError(f"Invalid panel profile manifest: {PANEL_PROFILES_FILE}")
    for key in ("extra_items", "shown_items", "hidden_items"):
        items = tray.get(key)
        if (
            not isinstance(items, list)
            or not all(isinstance(item, str) and item for item in items)
            or len(items) != len(set(items))
        ):
            raise DotError(f"Panel tray policy {key!r} must be a unique string list.")
    if set(tray["shown_items"]) & set(tray["hidden_items"]):
        raise DotError("Panel tray items cannot be both shown and hidden.")
    required = {
        "label",
        "description",
        "floating",
        "length_mode",
        "width_percent",
        "height",
        "task_manager",
        "spacers",
        "show_date",
    }
    for name, profile in profiles.items():
        if not isinstance(profile, dict) or not required.issubset(profile):
            raise DotError(f"Panel profile {name!r} is incomplete.")
        if profile["length_mode"] not in {"fill", "fit", "custom"}:
            raise DotError(f"Panel profile {name!r} has an invalid length mode.")
        if profile["task_manager"] not in {"labels", "icons"}:
            raise DotError(f"Panel profile {name!r} has an invalid task manager.")
        if profile["length_mode"] == "custom" and not isinstance(
            profile["width_percent"], int
        ):
            raise DotError(f"Panel profile {name!r} requires a width percentage.")
    return payload


def panel_profiles() -> dict[str, dict[str, Any]]:
    return panel_manifest()["profiles"]


def panel_tray_policy() -> dict[str, list[str]]:
    return panel_manifest()["tray"]


def default_panel_profile() -> str:
    payload = panel_manifest()
    return str(payload["default"])


def active_panel_profile() -> str:
    profiles = panel_profiles()
    if not PANEL_PROFILE_STATE.is_file():
        return default_panel_profile()
    selected = PANEL_PROFILE_STATE.read_text(encoding="utf-8").strip()
    return selected if selected in profiles else default_panel_profile()


def panel_screen_width() -> int:
    """Read the active logical display width without consulting KScreen state."""
    if command_exists("qdbus6"):
        support = run(
            ["qdbus6", "org.kde.KWin", "/KWin", "org.kde.KWin.supportInformation"],
            check=False,
            capture=True,
        )
        if support.returncode == 0:
            widths = [
                int(match.group(1))
                for match in re.finditer(
                    r"^Geometry:\s*-?\d+,-?\d+,(\d+)x\d+\s*$",
                    support.stdout,
                    re.MULTILINE,
                )
            ]
            if widths:
                return max(widths)
    return 1646


def expected_kde_content(relative: str, profile_name: str | None = None) -> bytes:
    del profile_name
    return kde_source(relative).read_bytes()


def require_commands(names: list[str], remediation: str) -> None:
    missing = [name for name in names if not command_exists(name)]
    if missing:
        raise DotError(f"Missing prerequisites: {', '.join(missing)}\n{remediation}")


def ansible_become_arguments() -> list[str]:
    if hasattr(os, "geteuid") and os.geteuid() == 0:
        return []
    require_commands(["sudo"], "Install sudo or run the privileged operation as root.")
    sudo_path = Path(shutil.which("sudo") or "sudo")
    try:
        resolved_sudo = sudo_path.resolve()
    except OSError:
        resolved_sudo = sudo_path
    become_method = (
        ["--become-method", "sudo_rs"]
        if resolved_sudo == Path("/usr/lib/cargo/bin/sudo")
        or resolved_sudo.name == "sudo-rs"
        else []
    )
    if sys.stdin.isatty():
        print("Administrator access is required to update managed system packages.")
        return ["--ask-become-pass", *become_method]
    passwordless = run(["sudo", "-n", "true"], check=False, capture=True)
    if passwordless.returncode == 0:
        return become_method
    raise DotError(
        "Administrator access is required for managed system packages. "
        "Run this command in an interactive terminal so Ansible can request the password."
    )


def backup_paths(paths: list[Path]) -> str:
    run_id = dt.datetime.now().strftime("%Y%m%d-%H%M%S-%f")
    destination = BACKUP_DIR / run_id
    manifest: list[dict[str, Any]] = []
    for path in paths:
        expanded = path.expanduser()
        record: dict[str, Any] = {"path": str(expanded), "existed": expanded.exists()}
        if expanded.is_symlink():
            record["kind"] = "symlink"
            record["target"] = os.readlink(expanded)
        elif expanded.exists() and expanded.is_file():
            relative = str(expanded).lstrip("/")
            target = destination / "files" / relative
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(expanded, target)
            record["backup"] = str(target)
            record["kind"] = "file"
        elif expanded.exists() and expanded.is_dir() and not expanded.is_symlink():
            relative = str(expanded).lstrip("/")
            target = destination / "files" / relative
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copytree(expanded, target)
            record["backup"] = str(target)
            record["kind"] = "directory"
        manifest.append(record)
    destination.mkdir(parents=True, exist_ok=True)
    atomic_text(destination / "manifest.json", json.dumps(manifest, indent=2) + "\n", 0o600)
    return run_id


def restore_backup(run_id: str) -> None:
    root = BACKUP_DIR / run_id
    manifest = load_json(root / "manifest.json")
    for record in manifest:
        path = Path(record["path"])
        if record.get("kind") == "symlink":
            if path.is_dir() and not path.is_symlink():
                shutil.rmtree(path)
            elif path.exists() or path.is_symlink():
                path.unlink()
            path.parent.mkdir(parents=True, exist_ok=True)
            path.symlink_to(record["target"])
        elif record.get("existed") and record.get("backup"):
            backup = Path(record["backup"])
            if record.get("kind") == "directory":
                if path.is_symlink() or path.is_file():
                    path.unlink()
                elif path.is_dir():
                    shutil.rmtree(path)
                shutil.copytree(backup, path)
            else:
                if path.is_dir() and not path.is_symlink():
                    shutil.rmtree(path)
                atomic_bytes(path, backup.read_bytes())
        elif not record.get("existed") and (path.exists() or path.is_symlink()):
            if path.is_dir() and not path.is_symlink():
                shutil.rmtree(path)
            else:
                path.unlink()


def link_file(source: Path, destination: Path) -> bool:
    destination = destination.expanduser()
    if destination.is_symlink() and destination.resolve() == source.resolve():
        return False
    if destination.exists() or destination.is_symlink():
        backup_paths([destination])
        if destination.is_dir() and not destination.is_symlink():
            shutil.rmtree(destination)
        else:
            destination.unlink()
    destination.parent.mkdir(parents=True, exist_ok=True)
    destination.symlink_to(source)
    return True


def copy_managed_file(source: Path, destination: Path) -> bool:
    """Deploy an app-owned file without letting the app mutate the repository."""
    destination = destination.expanduser()
    content = source.read_bytes()
    mode = source.stat().st_mode & 0o777
    if not destination.is_symlink() and destination.exists() and destination.read_bytes() == content:
        destination.chmod(mode)
        return False
    if destination.exists() or destination.is_symlink():
        backup_paths([destination])
        destination.unlink()
    return atomic_bytes(destination, content, mode)


def lockscreen_greeter_path() -> Path | None:
    candidates = [
        shutil.which("kscreenlocker_greet"),
        "/usr/lib/x86_64-linux-gnu/libexec/kscreenlocker_greet",
        "/usr/libexec/kscreenlocker_greet",
    ]
    for candidate in candidates:
        if candidate and Path(candidate).is_file():
            return Path(candidate)
    return None


def provision_lockscreen_assets() -> int:
    """Install the public shell package and the private wallpaper separately."""
    stock_shell = Path("/usr/share/plasma/shells/org.kde.plasma.desktop")
    stock_main = stock_shell / "contents/main.js"
    if not stock_main.is_file():
        raise DotError(f"The stock Plasma desktop shell is incomplete: {stock_main}")
    # Link the package root as one unit. KPackage accepts a package whose root
    # resolves to the repository, but rejects nested links that escape an
    # otherwise real package directory as path traversal. The fallback package
    # declared in metadata.json supplies the stock shell contents we do not
    # override.
    changes = int(
        link_file(LOCKSCREEN_PACKAGE_SOURCE, LOCKSCREEN_PACKAGE_DESTINATION)
    )
    lock_wallpaper_source = Path.home() / "repos/files/leaves_wallpaper.jpg"
    lock_wallpaper = (
        Path.home() / ".local/share/wallpapers/dotfiles/leaves_wallpaper.jpg"
    )
    if not lock_wallpaper_source.is_file():
        print(
            "Skipped the leaves lock-screen wallpaper: expected private "
            f"source {lock_wallpaper_source}. Run `dot repos sync`, then "
            "reapply the lock screen."
        )
        return changes

    changes += int(copy_managed_file(lock_wallpaper_source, lock_wallpaper))
    image_value = f"file://{lock_wallpaper}"
    current_image = run(
        [
            "kreadconfig6",
            "--file",
            "kscreenlockerrc",
            "--group",
            "Greeter",
            "--group",
            "Wallpaper",
            "--group",
            "org.kde.image",
            "--group",
            "General",
            "--key",
            "Image",
        ],
        check=False,
        capture=True,
    )
    if current_image.stdout.strip() != image_value:
        run(
            [
                "kwriteconfig6",
                "--file",
                "kscreenlockerrc",
                "--group",
                "Greeter",
                "--group",
                "Wallpaper",
                "--group",
                "org.kde.image",
                "--group",
                "General",
                "--key",
                "Image",
                image_value,
            ]
        )
        changes += 1
    return changes


def portable_kde_content(relative: str, content: bytes) -> bytes:
    """Remove runtime residue from an otherwise portable KConfig file."""
    ignored_keys = KDE_IGNORED_KEYS.get(relative, set())
    ignored_sections = KDE_IGNORED_SECTIONS.get(relative, set())
    section = ""
    kept: list[str] = []
    for line in content.decode("utf-8").splitlines(keepends=True):
        stripped = line.strip()
        if not stripped:
            continue
        if stripped.startswith("[") and stripped.endswith("]"):
            section = stripped[1:-1]
            if section in ignored_sections or (
                relative == PANEL_GEOMETRY_FILE
                and section.startswith("PlasmaViews][Panel ")
            ):
                continue
        if section in ignored_sections or (
            relative == PANEL_GEOMETRY_FILE
            and section.startswith("PlasmaViews][Panel ")
        ):
            continue
        key = stripped.split("=", 1)[0] if "=" in stripped else ""
        if (section, key) in ignored_keys:
            continue
        if (
            relative == ".config/kglobalshortcutsrc"
            and section == "plasmashell"
            and key.startswith("activate widget ")
        ):
            continue
        if relative == ".config/kglobalshortcutsrc" and "=" in line:
            candidate, value = line.split("=", 1)
            if value.startswith(","):
                line = candidate + "=none" + value
        kept.append(line)
    # KConfig section order has no semantic meaning, and Plasma applications
    # routinely rewrite it. Canonicalizing blocks prevents reorder-only drift.
    preamble: list[str] = []
    blocks: list[tuple[str, list[str]]] = []
    current_name: str | None = None
    current_lines: list[str] = []
    for line in kept:
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            if current_name is not None:
                blocks.append((current_name, current_lines))
            current_name = stripped[1:-1]
            current_lines = [line]
        elif current_name is None:
            preamble.append(line)
        else:
            current_lines.append(line)
    if current_name is not None:
        blocks.append((current_name, current_lines))
    if relative == ".config/kglobalshortcutsrc":
        blocks = [
            (name, [block[0], *sorted(block[1:], key=str.casefold)])
            for name, block in blocks
        ]
    kept = preamble + [
        line
        for _, block in sorted(blocks, key=lambda item: item[0])
        for line in block
    ]
    normalized = "".join(kept).rstrip()
    return (normalized + "\n").encode("utf-8") if normalized else b""


def kde_section_blocks(content: bytes) -> dict[str, list[str]]:
    """Return complete KConfig section blocks, including their headers."""
    blocks: dict[str, list[str]] = {}
    section = ""
    for line in content.decode("utf-8").splitlines(keepends=True):
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            section = stripped[1:-1]
            blocks.setdefault(section, []).append(line)
        elif section:
            blocks.setdefault(section, []).append(line)
    return blocks


def kde_destination_content(relative: str, source: bytes, destination: Path) -> bytes:
    """Combine managed KDE state with host-local runtime residue."""
    managed = portable_kde_content(relative, source)
    if not destination.is_file() or destination.is_symlink():
        return managed

    live = destination.read_bytes()
    live_sections = kde_section_blocks(live)
    lines = managed.decode("utf-8").splitlines(keepends=True)

    for section, key in sorted(KDE_IGNORED_KEYS.get(relative, set())):
        value_line = next(
            (
                line
                for line in live_sections.get(section, [])
                if line.strip().split("=", 1)[0] == key
            ),
            None,
        )
        if value_line is None:
            continue
        header = f"[{section}]"
        try:
            start = next(index for index, line in enumerate(lines) if line.strip() == header)
        except StopIteration:
            if lines and lines[-1].strip():
                lines.append("\n")
            lines.extend([header + "\n", value_line])
            continue
        end = next(
            (
                index
                for index in range(start + 1, len(lines))
                if lines[index].strip().startswith("[")
                and lines[index].strip().endswith("]")
            ),
            len(lines),
        )
        lines.insert(end, value_line)

    for section in sorted(KDE_IGNORED_SECTIONS.get(relative, set())):
        block = live_sections.get(section)
        if not block:
            continue
        if lines and lines[-1].strip():
            lines.append("\n")
        lines.extend(block)
    if relative == PANEL_GEOMETRY_FILE:
        for section, block in sorted(live_sections.items()):
            if not section.startswith("PlasmaViews][Panel "):
                continue
            if section in KDE_IGNORED_SECTIONS.get(relative, set()):
                continue
            if lines and lines[-1].strip():
                lines.append("\n")
            lines.extend(block)

    normalized = "".join(lines).rstrip()
    return (normalized + "\n").encode("utf-8") if normalized else b""


def kde_digest(relative: str, path: Path) -> str:
    return hashlib.sha256(portable_kde_content(relative, path.read_bytes())).hexdigest()


def copy_managed_kde_file(
    relative: str,
    source: Path,
    destination: Path,
    *,
    backup: bool = True,
    profile_name: str | None = None,
) -> bool:
    source_content = (
        expected_kde_content(relative, profile_name)
        if source == kde_source(relative)
        else source.read_bytes()
    )
    content = kde_destination_content(relative, source_content, destination)
    mode = source.stat().st_mode & 0o777
    if (
        not destination.is_symlink()
        and destination.exists()
        and destination.read_bytes() == content
    ):
        destination.chmod(mode)
        return False
    if destination.exists() or destination.is_symlink():
        if backup:
            backup_paths([destination])
        destination.unlink()
    return atomic_bytes(destination, content, mode)


def kde_baseline() -> dict[str, str]:
    if not KDE_BASELINE.exists():
        return {}
    payload = load_json(KDE_BASELINE)
    return {
        str(path): str(digest)
        for path, digest in payload.get("files", {}).items()
    }


def record_kde_baseline(panel_profile: str | None = None) -> None:
    """Record only files whose repository and live copies currently agree."""
    files: dict[str, str] = {}
    for relative in KDE_FILES:
        expected = kde_source(relative)
        actual = Path.home() / relative
        if (
            expected.is_file()
            and actual.is_file()
            and not actual.is_symlink()
        ):
            expected_content = expected_kde_content(relative, panel_profile)
            if portable_kde_content(
                relative, expected_content
            ) != portable_kde_content(relative, actual.read_bytes()):
                continue
            files[relative] = hashlib.sha256(
                portable_kde_content(relative, expected_content)
            ).hexdigest()
    payload = {"schema_version": 1, "files": files}
    atomic_text(KDE_BASELINE, json.dumps(payload, indent=2) + "\n", 0o600)


def check_kde_apply_conflicts(
    *,
    force: bool = False,
    only: set[str] | None = None,
) -> None:
    if force:
        return
    baseline = kde_baseline()
    conflicts: list[str] = []
    for relative in KDE_FILES:
        if only is not None and relative not in only:
            continue
        expected = kde_source(relative)
        actual = Path.home() / relative
        if not expected.is_file() or not actual.is_file() or actual.is_symlink():
            continue
        expected_digest = hashlib.sha256(
            portable_kde_content(relative, expected_kde_content(relative))
        ).hexdigest()
        actual_digest = kde_digest(relative, actual)
        if expected_digest == actual_digest:
            continue
        previous_digest = baseline.get(relative)
        if previous_digest is None:
            reason = "has uncaptured local state"
        elif actual_digest == previous_digest:
            continue
        elif expected_digest == previous_digest:
            reason = "has newer local changes"
        else:
            reason = "changed both locally and in dotfiles"
        conflicts.append(f"{actual} {reason}")
    if conflicts:
        detail = "\n  ".join(conflicts)
        raise DotError(
            "Refusing to overwrite KDE configuration drift:\n"
            f"  {detail}\n"
            "Review with `dot diff kde`, then capture the intended files with "
            "`dot capture kde --only NAME`; use --force-kde only for an "
            "intentional repository-to-machine replacement."
        )


def kglobal_shortcut(action_id: tuple[str, str, str, str]) -> list[int]:
    proc = run(
        [
            "gdbus",
            "call",
            "--session",
            "--dest",
            "org.kde.kglobalaccel",
            "--object-path",
            "/kglobalaccel",
            "--method",
            "org.kde.KGlobalAccel.shortcut",
            repr(list(action_id)),
        ],
        check=False,
        capture=True,
    )
    if proc.returncode:
        raise DotError(
            "Could not read the live KDE shortcut registry: "
            + (proc.stderr.strip() or f"exit code {proc.returncode}")
        )
    # GLib may annotate an empty array with its D-Bus type (`@ai []`).
    match = re.fullmatch(r"\((?:@ai )?\[([0-9, ]*)\],\)\s*", proc.stdout)
    if not match:
        raise DotError(f"Could not parse KDE shortcut response: {proc.stdout.strip()}")
    return [int(value) for value in match.group(1).split(",") if value.strip()]


def set_kglobal_shortcut(
    action_id: tuple[str, str, str, str],
    keys: list[int],
) -> None:
    proc = run(
        [
            "gdbus",
            "call",
            "--session",
            "--dest",
            "org.kde.kglobalaccel",
            "--object-path",
            "/kglobalaccel",
            "--method",
            "org.kde.KGlobalAccel.setShortcut",
            repr(list(action_id)),
            repr(keys),
            "4",
        ],
        check=False,
        capture=True,
    )
    if proc.returncode:
        raise DotError(
            "Could not update the live KDE shortcut registry: "
            + (proc.stderr.strip() or f"exit code {proc.returncode}")
        )


def activate_kglobal_shortcuts(
    desired: dict[tuple[str, str, str, str], list[int]],
    *,
    label: str = "shortcut",
    timeout: float = 5.0,
) -> None:
    """Apply live shortcuts after asynchronous KWin action registration."""
    original = {action_id: kglobal_shortcut(action_id) for action_id in desired}
    deadline = time.monotonic() + timeout
    pending = list(desired)
    try:
        while pending:
            # Apply the full ordered mapping on every pass. Releasing stock
            # bindings before assigning managed ones avoids transient conflicts.
            for action_id, keys in desired.items():
                set_kglobal_shortcut(action_id, keys)
            pending = [
                action_id
                for action_id, keys in desired.items()
                if kglobal_shortcut(action_id) != keys
            ]
            if not pending:
                return
            if time.monotonic() >= deadline:
                action_id = pending[0]
                raise DotError(
                    f"KDE did not activate {label} "
                    f"{action_id[0]!r} / {action_id[1]!r} within {timeout:g} seconds."
                )
            time.sleep(0.1)
    except Exception:
        for action_id, keys in original.items():
            try:
                set_kglobal_shortcut(action_id, keys)
            except DotError:
                pass
        raise


