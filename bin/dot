            else "user is not assigned to docker group",
        )
        compose = run(["docker", "compose", "version"], check=False, capture=True)
        buildx = run(["docker", "buildx", "version"], check=False, capture=True)
        failures += not doctor_check(
            "Docker plugins",
            compose.returncode == 0 and buildx.returncode == 0,
            "Compose and Buildx available"
            if compose.returncode == 0 and buildx.returncode == 0
            else "Docker Compose or Buildx plugin is unavailable",
        )
        if profile.get("features", {}).get("wsl"):
            systemd_ready = Path("/run/systemd/system").is_dir()
            docker_socket = Path("/var/run/docker.sock")
            socket_target = str(docker_socket.resolve()) if docker_socket.exists() else ""
            desktop_integration = socket_target.startswith("/mnt/wsl/docker-desktop/")
            failures += not doctor_check(
                "WSL native Docker mode",
                systemd_ready and not desktop_integration,
                "systemd active; Docker Desktop integration absent"
                if systemd_ready and not desktop_integration
                else "enable WSL systemd and disable Docker Desktop WSL integration",
            )
    if profile.get("features", {}).get("memory_pressure_protection"):
        memory_packages = ("systemd-oomd", "systemd-zram-generator")
        missing_memory_packages = []
