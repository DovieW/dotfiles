#!/usr/bin/env bash
set -euo pipefail

mode="${1:---ensure}"
case "$mode" in
  --ensure | --install | --update | --check) ;;
  *)
    echo "Usage: install-codex [--ensure|--install|--update|--check]" >&2
    exit 2
    ;;
esac

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
manifest="$root/packages/codex.yml"
install_dir="${CODEX_INSTALL_DIR:-$HOME/.local/bin}"
codex_home="${CODEX_HOME:-$HOME/.codex}"
codex_path="$install_dir/codex"
standalone_root="$codex_home/packages/standalone"

command -v python3 >/dev/null 2>&1 || {
  echo "python3 is required to read the Codex package manifest." >&2
  exit 1
}

installer_url="$(
  python3 - "$manifest" <<'PY'
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
data = json.loads(path.read_text())
if data.get("schema_version") != 1:
    raise SystemExit(f"{path}: schema_version must be 1")
if data.get("channel") != "stable":
    raise SystemExit(f"{path}: channel must be stable")
url = data.get("installer_url", "")
if url != "https://chatgpt.com/codex/install.sh":
    raise SystemExit(f"{path}: installer_url must use the official HTTPS endpoint")
print(url)
PY
)"

installed_version=""
resolved_path=""
is_standalone=false
if [[ -x "$codex_path" ]]; then
  version_output="$("$codex_path" --version 2>/dev/null || true)"
  installed_version="${version_output##* }"
  resolved_path="$(readlink -f -- "$codex_path" 2>/dev/null || true)"
  case "$resolved_path" in
    "$standalone_root"/*) is_standalone=true ;;
  esac
fi

if [[ "$mode" == "--check" ]]; then
  if [[ "$is_standalone" == true && -n "$installed_version" ]]; then
    echo "Codex CLI $installed_version is installed from the managed stable channel."
    exit 0
  fi
  if [[ ! -x "$codex_path" ]]; then
    echo "Codex standalone CLI is missing at $codex_path." >&2
  else
    echo "Codex at $codex_path is not the managed standalone installation." >&2
  fi
  exit 1
fi

if [[ "$mode" == "--ensure" && "$is_standalone" == true && -n "$installed_version" ]]; then
  echo "Codex CLI $installed_version is installed from the managed stable channel."
  exit 0
fi

command -v curl >/dev/null 2>&1 || {
  echo "curl is required to install Codex." >&2
  exit 1
}

temporary_root="${TMPDIR:-/tmp}"
temporary_dir="$(mktemp -d "$temporary_root/dotfiles-codex.XXXXXX")"
cleanup() {
  case "$temporary_dir" in
    "$temporary_root"/dotfiles-codex.*) rm -rf -- "$temporary_dir" ;;
  esac
}
trap cleanup EXIT INT TERM
installer="$temporary_dir/install.sh"

curl \
  --proto '=https' \
  --tlsv1.2 \
  --fail \
  --location \
  --retry 3 \
  --connect-timeout 15 \
  --silent \
  --show-error \
  "$installer_url" \
  --output "$installer"

if [[ "$(sed -n '1p' "$installer")" != "#!/bin/sh" ]] ||
  ! grep -Fq 'https://releases.openai.com/codex' "$installer" ||
  ! grep -Fq 'verify_archive_digest' "$installer"; then
  echo "Downloaded Codex installer does not have the expected verified-release structure." >&2
  exit 1
fi

echo "Installing the latest stable Codex standalone release."
CODEX_NON_INTERACTIVE=1 \
  CODEX_INSTALL_DIR="$install_dir" \
  CODEX_HOME="$codex_home" \
  sh "$installer" --release latest

version_output="$("$codex_path" --version 2>/dev/null || true)"
installed_version="${version_output##* }"
resolved_path="$(readlink -f -- "$codex_path" 2>/dev/null || true)"
case "$resolved_path" in
  "$standalone_root"/*) ;;
  *)
    echo "Installed Codex command is not rooted in $standalone_root." >&2
    exit 1
    ;;
esac
if [[ -z "$installed_version" ]]; then
  echo "Installed Codex did not report a version." >&2
  exit 1
fi
echo "Latest stable Codex CLI $installed_version installed and verified."
