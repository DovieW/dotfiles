#!/usr/bin/env bash
set -euo pipefail

tailscale_ip="$(tailscale ip -4)"
if [[ ! "$tailscale_ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
  echo "KRdp requires one active Tailscale IPv4 address." >&2
  exit 1
fi

data_dir="${XDG_DATA_HOME:-$HOME/.local/share}/krdpserver"
certificate="$data_dir/krdp.crt"
certificate_key="$data_dir/krdp.key"
if [[ ! -r "$certificate" || ! -r "$certificate_key" ]]; then
  echo "KRdp TLS identity is missing; run dot apply --profile kubuntu-desktop --tags krdp." >&2
  exit 1
fi

# Let systemd retry startup until the portal can capture the Plasma session.
for interface in RemoteDesktop ScreenCast; do
  if ! busctl --user --timeout=10s get-property \
    org.freedesktop.portal.Desktop /org/freedesktop/portal/desktop \
    "org.freedesktop.portal.${interface}" version >/dev/null; then
    echo "KRdp is waiting for the Plasma ${interface} portal." >&2
    exit 1
  fi
done

exec /usr/bin/krdpserver \
  --address "$tailscale_ip" \
  --port 3389 \
  --certificate "$certificate" \
  --certificate-key "$certificate_key" \
  --quality 80 \
  --monitor 0
