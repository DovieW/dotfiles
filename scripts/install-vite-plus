#!/usr/bin/env bash
set -euo pipefail

mode="${1:---ensure}"
case "$mode" in
  --ensure | --install | --update | --check) ;;
  *)
    echo "Usage: install-vite-plus [--ensure|--install|--update|--check]" >&2
    exit 2
    ;;
esac

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
manifest="$root/packages/vite-plus.yml"
vp_home="${VP_HOME:-$HOME/.vite-plus}"
vp_path="$vp_home/bin/vp"

command -v python3 >/dev/null 2>&1 || {
  echo "python3 is required to read the Vite+ package manifest." >&2
  exit 1
}

installer_url="$(
  python3 - "$manifest" <<'PY'
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
data = json.loads(path.read_text())
if data.get("schema_version") != 1:
    raise SystemExit(f"{path}: schema_version must be 1")
if data.get("channel") != "stable":
    raise SystemExit(f"{path}: channel must be stable")
url = data.get("installer_url", "")
if url != "https://vite.plus":
    raise SystemExit(f"{path}: installer_url must use the official HTTPS endpoint")
print(url)
PY
)"

installed_version=""
resolved_path=""
is_managed=false
if [[ -x "$vp_path" ]]; then
  version_output="$("$vp_path" --version 2>/dev/null || true)"
  installed_version="$(sed -n '1s/^vp v//p' <<<"$version_output")"
  resolved_path="$(readlink -f -- "$vp_path" 2>/dev/null || true)"
  case "$resolved_path" in
    "$vp_home"/*/bin/vp) is_managed=true ;;
  esac
fi

if [[ "$mode" == "--check" ]]; then
  if [[ ! -x "$vp_path" ]]; then
    echo "Vite+ is missing at $vp_path." >&2
    exit 1
  fi
  if [[ "$is_managed" != true || -z "$installed_version" ]]; then
    echo "Vite+ at $vp_path is not a healthy managed installation." >&2
    exit 1
  fi
  if [[ ! -r "$vp_home/env" ]]; then
    echo "Vite+ shell integration is missing at $vp_home/env." >&2
    exit 1
  fi
  echo "Vite+ $installed_version is installed from the managed stable channel."
  exit 0
fi

if [[ "$mode" == "--ensure" && "$is_managed" == true && -n "$installed_version" ]]; then
  if [[ ! -r "$vp_home/env" ]]; then
    "$vp_path" env setup --env-only
    echo "Vite+ $installed_version shell integration generated."
  else
    echo "Vite+ $installed_version is installed from the managed stable channel."
  fi
  exit 0
fi

if [[ "$is_managed" == true && -n "$installed_version" ]]; then
  echo "Upgrading Vite+ from the stable channel."
  "$vp_path" upgrade --tag latest
else
  for required in bash curl; do
    command -v "$required" >/dev/null 2>&1 || {
      echo "$required is required to install Vite+." >&2
      exit 1
    }
  done

  temporary_root="${TMPDIR:-/tmp}"
  temporary_dir="$(mktemp -d "$temporary_root/dotfiles-vite-plus.XXXXXX")"
  cleanup() {
    case "$temporary_dir" in
      "$temporary_root"/dotfiles-vite-plus.*) rm -rf -- "$temporary_dir" ;;
    esac
  }
  trap cleanup EXIT INT TERM
  installer="$temporary_dir/install.sh"

  curl \
    --proto '=https' \
    --tlsv1.2 \
    --fail \
    --location \
    --retry 3 \
    --connect-timeout 15 \
    --silent \
    --show-error \
    "$installer_url" \
    --output "$installer"

  if [[ "$(sed -n '1p' "$installer")" != "#!/bin/bash" ]] ||
    ! grep -Fq '# Vite+ CLI Installer' "$installer"; then
    echo "Downloaded Vite+ installer does not have the expected structure." >&2
    exit 1
  fi

  echo "Installing the latest stable Vite+ release."
  CI=1 \
    VP_HOME="$vp_home" \
    VP_NODE_MANAGER=no \
    bash "$installer"
fi

"$vp_path" env setup --env-only
version_output="$("$vp_path" --version 2>/dev/null || true)"
installed_version="$(sed -n '1s/^vp v//p' <<<"$version_output")"
resolved_path="$(readlink -f -- "$vp_path" 2>/dev/null || true)"
case "$resolved_path" in
  "$vp_home"/*/bin/vp) ;;
  *)
    echo "Installed Vite+ command is not rooted in $vp_home." >&2
    exit 1
    ;;
esac
if [[ -z "$installed_version" ]]; then
  echo "Installed Vite+ did not report a version." >&2
  exit 1
fi
echo "Latest stable Vite+ $installed_version installed and verified."
