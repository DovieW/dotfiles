#!/usr/bin/env python3
"""Bridge KRdp TCP connection state to the shared Plasma panel manager."""

from __future__ import annotations

from pathlib import Path
import signal
import subprocess
import time


REMOTE_PANEL = "/usr/local/libexec/remote-panel"
KRDP_SCALE = str(Path.home() / ".local/libexec/krdp-scale")
KRDP_AUDIO = str(Path.home() / ".local/libexec/krdp-audio")
SOURCE = "krdp"
SESSION = "listener"
running = True


def connected() -> bool:
    result = subprocess.run(
        ["ss", "-Htn", "state", "established", "sport", "=", ":3389"],
        check=False,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        timeout=5,
    )
    return result.returncode == 0 and bool(result.stdout.strip())


def panel(action: str) -> None:
    subprocess.run(
        [REMOTE_PANEL, action, SOURCE, SESSION],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=20,
    )


def scale(action: str) -> None:
    subprocess.run(
        [KRDP_SCALE, action],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=20,
    )


def stop(_signum: int, _frame: object) -> None:
    global running
    running = False


def reap_audio() -> None:
    # A living audio helper holds a lock. If it was killed, restore its routes
    # even when video is still connected; never leave a dead microphone behind.
    subprocess.run([KRDP_AUDIO, "reap"], check=False, timeout=20)


def main() -> int:
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    active = False
    initialized = False
    while running:
        reap_audio()
        current = connected()
        # Reconcile every connected poll. Plasma can replace a panel and its
        # numeric ID while the RDP socket remains established; activating is
        # idempotent and lets the shared manager protect the replacement.
        if current:
            panel("activate")
        else:
            if active or not initialized:
                panel("deactivate")
            # Preparation happens before the client connects, while the portal
            # is closed. Expire abandoned preparations and restore on disconnect.
            # Do not release a lease here: a new client may have prepared its
            # display since the previous connection ended between polls.
            scale("restore-if-idle")
        active = current
        initialized = True
        time.sleep(1)
    if active:
        panel("deactivate")
    scale("restore-if-idle")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
