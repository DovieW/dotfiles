#!/usr/bin/env python3
"""Bridge KRdp TCP connection state to the shared Plasma panel manager."""

from __future__ import annotations

import signal
import subprocess
import time


REMOTE_PANEL = "/usr/local/libexec/remote-panel"
SOURCE = "krdp"
SESSION = "listener"
running = True


def connected() -> bool:
    result = subprocess.run(
        ["ss", "-Htn", "state", "established", "sport", "=", ":3389"],
        check=False,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        timeout=5,
    )
    return result.returncode == 0 and bool(result.stdout.strip())


def panel(action: str) -> None:
    subprocess.run(
        [REMOTE_PANEL, action, SOURCE, SESSION],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=20,
    )


def stop(_signum: int, _frame: object) -> None:
    global running
    running = False


def main() -> int:
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    active = False
    while running:
        current = connected()
        if current != active:
            panel("activate" if current else "deactivate")
            active = current
        time.sleep(1)
    if active:
        panel("deactivate")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
