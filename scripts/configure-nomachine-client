#!/usr/bin/env python3
"""Make NoMachine's legacy Linux UI readable on HiDPI Plasma displays."""

from __future__ import annotations

import json
from pathlib import Path
import subprocess
import sys
import xml.etree.ElementTree as ET


PLAYER_CONFIG = Path.home() / ".nx/config/player.cfg"
HIDPI_THRESHOLD = 1.5
DEFAULT_FONT = "Sans Serif,16,-1,5,50,0,0,0,0,0"
FIXED_FONT = "Monospace,14,-1,5,50,0,0,0,0,0"


def display_scale() -> float:
    result = subprocess.run(
        ["kscreen-doctor", "--json"],
        check=False,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=15,
    )
    if result.returncode != 0:
        return 1.0
    payload = json.loads(result.stdout)
    scales = [
        float(output.get("scale", 1))
        for output in payload.get("outputs", [])
        if output.get("enabled") and output.get("connected")
    ]
    return max(scales, default=1.0)


def configure() -> bool:
    if display_scale() < HIDPI_THRESHOLD or not PLAYER_CONFIG.is_file():
        return False
    tree = ET.parse(PLAYER_CONFIG)
    root = tree.getroot()
    desired = {"Default font": DEFAULT_FONT, "Fixed font": FIXED_FONT}
    changed = False
    for option in root.iter("option"):
        key = option.get("key")
        if key in desired and option.get("value") != desired[key]:
            option.set("value", desired[key])
            changed = True
    if changed:
        tree.write(PLAYER_CONFIG, encoding="unicode", xml_declaration=False)
    return changed


def main() -> int:
    try:
        changed = configure()
    except (ET.ParseError, OSError, ValueError, subprocess.SubprocessError) as error:
        print(f"NoMachine client HiDPI configuration skipped: {error}")
        return 0
    print(
        "NoMachine client HiDPI fonts updated; restart the client."
        if changed
        else "NoMachine client HiDPI fonts already current or not required."
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
