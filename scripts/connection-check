#!/usr/bin/python3
"""On-demand network health check; no network configuration changes."""
import concurrent.futures
import fcntl
import json
import os
from pathlib import Path
import re
import subprocess
import sys


def run(args, timeout=15):
    try:
        p = subprocess.run(args, capture_output=True, text=True, timeout=timeout,
                           env={**os.environ, "LC_ALL": "C"})
        return p.returncode, p.stdout.strip(), p.stderr.strip()
    except (OSError, subprocess.TimeoutExpired) as e:
        return 1, "", str(e)


def ping(target, interface):
    code, out, err = run(["ping", "-n", "-I", interface, "-c", "12", "-i", "0.25", "-W", "1", target], 17)
    loss = re.search(r"([\d.]+)% packet loss", out)
    times = re.search(r"= ([\d.]+)/([\d.]+)/([\d.]+)/", out)
    return {"loss": float(loss[1]) if loss else None,
            "avg": float(times[2]) if times else None,
            "max": float(times[3]) if times else None,
            "raw": out or err}


def metric(name, value, rating, guide):
    return {"name": name, "value": value, "rating": rating, "guide": guide}


def rate(value, good, fair):
    return "Good" if value >= good else "Fair" if value >= fair else "Poor"


def ping_metrics(name, sample, good, fair):
    latency_guide = f"Good ≤{good} ms · Poor >{fair} ms"
    loss_guide = "Good 0% · Poor ≥20% in this sample"
    if sample is None:
        return [metric(f"{name} ping", "No gateway to test", "Unavailable", "Skipped on this route")]
    avg, loss = sample["avg"], sample["loss"]
    if avg is None or loss is None:
        value = "No replies" if loss == 100 else "No measurement"
        return [metric(f"{name} ping", value, "Unrated", "Ping may be blocked")]
    return [
        metric(f"{name} latency", f"{avg:.1f} ms", rate(-avg, -good, -fair), latency_guide),
        metric(f"{name} packet loss", f"{loss:g}%", "Good" if loss == 0 else "Fair" if loss < 20 else "Poor",
               loss_guide),
    ]


def check(long=False):
    details = []
    _, routes, err = run(["ip", "-j", "-4", "route", "get", "1.1.1.1"])
    try:
        route = json.loads(routes)[0]
        interface = route["dev"]
    except (ValueError, KeyError, IndexError):
        return {"summary": "No usable IPv4 internet route", "details": err or routes,
                "verdict": "No usable IPv4 internet route", "rating": "Poor", "metrics": []}
    gateway = route.get("gateway")
    _, name, _ = run(["nmcli", "-g", "GENERAL.CONNECTION", "device", "show", interface])
    _, wifi, _ = run(["iw", "dev", interface, "link"])
    label = f"{name or interface} · {interface}"
    sig = re.search(r"signal: (-?\d+) dBm", wifi)
    freq = re.search(r"freq: ([\d.]+)", wifi)
    metrics = []
    if sig:
        signal = int(sig[1])
        if freq:
            frequency = float(freq[1])
            band = "6 GHz" if frequency >= 5925 else "5 GHz" if frequency >= 5000 else "2.4 GHz"
            label += f" · {band}"
        metrics.append(metric("Wi-Fi signal", f"{signal} dBm", rate(signal, -67, -75),
                              "Good ≥−67 dBm · Poor <−75 dBm"))
    details.extend([label, "Wi-Fi negotiated link rates (not internet speed):\n" + (wifi or "Unavailable / not Wi-Fi")])
    with concurrent.futures.ThreadPoolExecutor(max_workers=3) as pool:
        gw_task = pool.submit(ping, gateway, interface) if gateway else None
        internet_task = pool.submit(ping, "1.1.1.1", interface)
        https_task = pool.submit(run, ["curl", "-4", "--interface", interface, "--silent", "--show-error", "--fail", "--output", "/dev/null", "--connect-timeout", "5", "--max-time", "8", "--write-out", "%{http_code} %{time_namelookup} %{time_total}", "https://www.cloudflare.com/cdn-cgi/trace"])
        gw = gw_task.result() if gw_task else None
        internet = internet_task.result()
        https = https_task.result()
    metrics.extend(ping_metrics("Router", gw, 10, 30))
    metrics.extend(ping_metrics("Internet", internet, 50, 150))
    for title, sample in [("Router", gw), ("Internet", internet)]:
        if sample:
            details.append(title + " ping:\n" + sample["raw"])
    metrics.append(metric("DNS + HTTPS", "working" if https[0] == 0 else "check failed",
                          "Good" if https[0] == 0 else "Poor", "Can reach the Cloudflare test site"))
    details.append("HTTPS probe: " + " ".join(map(str, https)))
    # Latency probes finish before downloading so our traffic cannot bias them.
    size = 50_000_000 if long else 10_000_000
    code, out, err = run(["curl", "-4", "--interface", interface, "--silent", "--show-error", "--fail", "--output", "/dev/null", "--connect-timeout", "5", "--max-time", "20" if long else "10", "--write-out", "%{speed_download} %{size_download} %{time_total}", f"https://speed.cloudflare.com/__down?bytes={size}"], 23)
    try:
        speed, received, elapsed = map(float, out.split())
    except ValueError:
        speed = received = elapsed = 0
    complete = code == 0 and received == size
    mbps = speed * 8 / 1e6
    download = f"~{mbps:.1f} Mbps" if received else "No measurement"
    if not complete and received:
        download += " (partial)"
    metrics.append(metric("Download speed", download, rate(mbps, 25, 5) if complete else "Unrated",
                          "Good ≥25 Mbps · Poor <5 Mbps" if complete else "Transfer incomplete · longer test available"))
    details.append(f"Download: {received:g} bytes in {elapsed:g}s; exit {code}; {err}")
    # Detect connection changes rather than attributing mixed results to one AP.
    _, after, _ = run(["ip", "-j", "-4", "route", "get", "1.1.1.1"])
    changed = after != routes
    if changed:
        for row in metrics:
            row["rating"] = "Unrated"
    flags = [row for row in metrics if row["rating"] in ("Fair", "Poor")]
    flags.sort(key=lambda row: row["rating"] == "Poor", reverse=True)
    if changed:
        verdict, rating = "Connection changed during test — run again", "Unrated"
    elif https[0] != 0:
        verdict, rating = "Internet check encountered a problem", "Poor"
    elif flags:
        first = flags[0]
        rating = first["rating"]
        issue = first["name"]
        reason = f"{issue.lower()} detected" if "packet loss" in issue else f"check {issue}"
        verdict = f"Internet reachable · {reason}"
    elif not complete:
        verdict, rating = "Internet reachable · download check incomplete", "Unrated"
    elif any(row["rating"] == "Unrated" for row in metrics):
        verdict, rating = "Internet reachable · some measurements unavailable", "Unrated"
    else:
        verdict, rating = "Connection looks good in this sample", "Good"
    note = f"Fair is between the cutoffs. Short IPv4 sample via Cloudflare · Up to {size // 1_000_000} MB."
    lines = [f"{row['name']}: {row['value']} [{row['rating']}] · {row['guide']}" for row in metrics]
    summary = "\n".join([verdict, "", label, *lines, "", note])
    return {"summary": summary, "details": "\n\n".join(details), "verdict": verdict, "rating": rating,
            "connection": label, "metrics": metrics, "note": note}


def main():
    lock = open(Path(os.environ.get("XDG_RUNTIME_DIR", f"/tmp")) / f"connection-check-{os.getuid()}.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return
    if "--json" in sys.argv:
        print(json.dumps(check("--long" in sys.argv), indent=2))
        return
    from PyQt6.QtCore import Qt, QThread, pyqtSignal
    from PyQt6.QtGui import QIcon
    from PyQt6.QtWidgets import (
        QApplication, QDialog, QGridLayout, QHBoxLayout, QLabel, QPlainTextEdit,
        QProgressBar, QPushButton, QVBoxLayout, QWidget,
    )

    class Worker(QThread):
        done = pyqtSignal(object)

        def run(self):
            try:
                self.done.emit(check(self.long))
            except Exception as e:
                self.done.emit({"summary": "Check failed: " + str(e), "details": str(e)})

    app = QApplication(sys.argv)
    app.setDesktopFileName("io.github.doview.connection-check")
    icon_path = Path.home() / ".local/share/icons/hicolor/scalable/apps/io.github.doview.connection-check.svg"
    if not icon_path.exists():
        icon_path = Path(__file__).resolve().parents[1] / "config/applications/connection-check.svg"
    icon = QIcon(str(icon_path))
    app.setWindowIcon(icon)
    dialog = QDialog()
    dialog.setWindowTitle("Network Quality Test")
    dialog.setWindowIcon(icon)
    dialog.resize(740, 420)
    layout = QVBoxLayout(dialog)
    layout.setContentsMargins(22, 20, 22, 16)
    layout.setSpacing(12)

    def text_label(text="", wrap=False):
        widget = QLabel(text)
        widget.setTextFormat(Qt.TextFormat.PlainText)
        widget.setWordWrap(wrap)
        return widget

    def badge(rating):
        colors = {
            "Good": ("#dff4e8", "#145336"),
            "Fair": ("#fff0ce", "#674300"),
            "Poor": ("#fce2df", "#882823"),
            "Unrated": ("#e8ebf0", "#3c4654"),
            "Unavailable": ("#e8ebf0", "#3c4654"),
        }
        background, foreground = colors[rating]
        widget = text_label(rating)
        widget.setStyleSheet(
            f"background: {background}; color: {foreground}; font-weight: 600;"
            " padding: 3px 9px; border-radius: 8px;"
        )
        return widget

    header = QHBoxLayout()
    title = text_label(wrap=True)
    font = title.font()
    font.setPointSizeF(font.pointSizeF() * 1.35)
    font.setBold(True)
    title.setFont(font)
    header.addWidget(title, 1)
    layout.addLayout(header)
    connection = text_label(wrap=True)
    layout.addWidget(connection)
    results = QWidget()
    grid = QGridLayout(results)
    grid.setContentsMargins(0, 0, 0, 0)
    grid.setHorizontalSpacing(16)
    grid.setVerticalSpacing(8)
    grid.setColumnStretch(3, 1)
    layout.addWidget(results)
    note = text_label(wrap=True)
    layout.addWidget(note)
    progress = QProgressBar()
    progress.setRange(0, 0)
    layout.addWidget(progress)
    detail = QPlainTextEdit()
    detail.setReadOnly(True)
    detail.hide()
    layout.addWidget(detail)
    layout.addStretch()
    buttons = QHBoxLayout()
    layout.addLayout(buttons)
    again = QPushButton("Run again")
    longer = QPushButton("Longer test (50 MB)")
    show = QPushButton("Details")
    close = QPushButton("Close")
    for b in [show, again, longer, close]:
        buttons.addWidget(b)

    def finished(result):
        title.setText(result.get("verdict", result["summary"]))
        header.addWidget(badge(result.get("rating", "Unrated")), 0, Qt.AlignmentFlag.AlignTop)
        connection.setText(result.get("connection", ""))
        rows = result.get("metrics", [])
        for column, heading in enumerate(("Measurement", "Result", "Rating", "How to read it")):
            label = text_label(heading)
            heading_font = label.font()
            heading_font.setBold(True)
            label.setFont(heading_font)
            grid.addWidget(label, 0, column)
        for index, row in enumerate(rows, 1):
            grid.addWidget(text_label(row["name"]), index, 0)
            grid.addWidget(text_label(row["value"]), index, 1)
            grid.addWidget(badge(row["rating"]), index, 2, Qt.AlignmentFlag.AlignLeft)
            grid.addWidget(text_label(row["guide"], wrap=True), index, 3)
        results.setVisible(bool(rows))
        note.setText(result.get("note", ""))
        note.setVisible(bool(note.text()))
        detail.setPlainText(result["details"])
        progress.hide()
        for b in [show, again, longer, close]:
            b.setEnabled(True)

    def start(long=False):
        title.setText("Checking connection…")
        connection.setText("Measuring latency, DNS, HTTPS, then download speed.")
        if header.count() > 1:
            header.takeAt(1).widget().deleteLater()
        while grid.count():
            grid.takeAt(0).widget().deleteLater()
        results.hide()
        note.hide()
        detail.clear()
        detail.hide()
        progress.show()
        for b in [show, again, longer, close]:
            b.setEnabled(False)
        dialog.worker = Worker()
        dialog.worker.long = long
        dialog.worker.done.connect(finished)
        dialog.worker.start()

    # Closing while a worker owns subprocesses must not destroy a running QThread.
    dialog.rejected.connect(lambda: dialog.worker.wait())
    again.clicked.connect(lambda: start())
    longer.clicked.connect(lambda: start(True))
    show.clicked.connect(lambda: detail.setVisible(not detail.isVisible()))
    close.clicked.connect(dialog.accept)
    start()
    dialog.exec()
    dialog.worker.wait()


if __name__ == "__main__":
    main()
