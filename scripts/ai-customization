#!/usr/bin/python3
"""Reconcile the workstation's Codex customization and publish scoped changes."""
import argparse
import base64
from contextlib import contextmanager
import copy
import fcntl
import hashlib
import io
import json
import os
from pathlib import Path
import re
import select
import shlex
import shutil
import socket
import subprocess
import sys
import tarfile
import tempfile
import time
import tomllib
from urllib.request import urlopen
from urllib.parse import urlsplit
from uuid import uuid4

ROOT = Path(__file__).resolve().parents[1]
REL = "config/ai-customization"
PREFS = "preferences.json"
UPSTREAM = "refs/remotes/origin/master"
HOSTS = {"dovie-desktop-linux": "kubuntu-desktop", "dovie-ideapad-linux": "kubuntu-laptop"}
GROUPS = ("defaults", "skills", "mcp", "plugins", "plugin_mcp")
DEFAULTS = {"model", "model_reasoning_effort", "service_tier", "default_permissions", "approval_policy"}
MODES = ("automatic", "manual", "off")
IDENTIFIER = re.compile(r"[A-Za-z0-9_.@-]{1,160}")
ABSENT = object()
ENTRY_GROUPS = {"skills", "mcp", "plugins", "hooks", "config", "plugin_mcp"}
MAX_SKILL_BYTES = 5 * 1024 * 1024
DESKTOP_CODEX = Path("/usr/lib/chatgpt/resources/codex")
CODEX_SCHEMA = "https://raw.githubusercontent.com/openai/codex/rust-v{}/codex-rs/core/config.schema.json"
CODEX_VERSION = re.compile(r"[0-9]+\.[0-9]+\.[0-9]+(?:-[A-Za-z0-9.]+)?")
PRIVATE_KEY = re.compile(r"secret|token|password|cookie|credentials|api.key|headers", re.I)
RETIRED_STAGES = {"deprecated", "removed"}


class Error(Exception):
    pass


def encode(value):
    return json.dumps(value, indent=2, ensure_ascii=False) + "\n"


def load(path, default=None):
    return json.loads(path.read_text()) if path.is_file() else default


def atomic(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(mode="w", dir=path.parent, delete=False) as stream:
        temp = Path(stream.name)
        stream.write(text)
    try:
        temp.replace(path)
    finally:
        temp.unlink(missing_ok=True)


def digest(text):
    return hashlib.sha256(text.encode()).hexdigest()


def need(condition, message):
    if not condition:
        raise Error(message)


def validate(m):
    need(isinstance(m, dict) and set(m) == {"schema_version", "shared", "hosts"}
         and m["schema_version"] == 1, "Invalid customization manifest.")
    need(isinstance(m["hosts"], dict) and set(m["hosts"]) == set(HOSTS.values()),
         "Both workstation profiles must appear in the manifest.")
    for section in [m["shared"], *m["hosts"].values()]:
        need(isinstance(section, dict) and set(section) <= {"instructions", *GROUPS},
             "Unknown customization section.")
        need(isinstance(section.get("instructions", ""), str), "Instructions must be text.")
        for group in GROUPS:
            values = section.get(group, {})
            need(isinstance(values, dict), "Invalid customization entries.")
            for name, value in values.items():
                if group == "plugin_mcp":
                    good_name = len(name.split("/")) == 2 and all(
                        IDENTIFIER.fullmatch(part) for part in name.split("/"))
                else:
                    good_name = IDENTIFIER.fullmatch(name)
                need(good_name, "Invalid customization identifier.")
                if group == "defaults":
                    need(name in DEFAULTS and isinstance(value, str) and value,
                         "Unsupported Codex default.")
                elif group == "skills":
                    need(name not in (".", "..") and value in MODES, "Invalid skill setting.")
                else:
                    need(type(value) is bool or (group == "plugin_mcp" and value == "default"),
                         "Invalid tool enablement setting.")
        need("node_repl" not in section.get("mcp", {}), "node_repl is managed by the Codex app.")
    need(set(m["shared"].get("defaults", {})) == DEFAULTS, "Shared Codex defaults are incomplete.")
    return m


def effective(manifest, profile, private=""):
    shared, host = manifest["shared"], manifest["hosts"][profile]
    instructions = "\n\n".join(t.strip() for t in
                                 (shared.get("instructions", ""), host.get("instructions", ""), private) if t.strip()) + "\n"
    return {"instructions": instructions,
            **{group: {**shared.get(group, {}), **host.get(group, {})} for group in GROUPS}}


def removal_policies(settings, removal):
    group, name = removal["group"], removal["name"]
    if group == "config":
        path = removal["value"]["path"]
        if len(path) == 3 and path[-1] == "enabled" and path[0] in ("mcp_servers", "plugins"):
            group, name = ("mcp" if path[0] == "mcp_servers" else "plugins"), path[1]
            return [(group, name)] if name in settings.get(group, {}) else []
        if len(path) == 5 and path[0] == "plugins" and path[2] == "mcp_servers" and path[-1] == "enabled":
            group, name = "plugin_mcp", f"{path[1]}/{path[3]}"
        else:
            return []
    matches = [(group, name)] if name in settings.get(group, {}) else []
    if group == "plugins":
        matches.extend(("plugin_mcp", key) for key in settings.get("plugin_mcp", {})
                       if key.startswith(name + "/"))
    return matches


def removal_profiles(scope):
    need(scope in ("shared", *HOSTS.values()), "Select Desktop, IdeaPad, or both.")
    return tuple(HOSTS.values()) if scope == "shared" else (scope,)


def remove_policies(manifest, removal):
    profiles = removal_profiles(removal["scope"])
    for profile in profiles:
        for group, name in removal_policies(effective(manifest, profile), removal):
            shared = manifest["shared"].get(group, {})
            if name in shared:
                value = shared.pop(name)
                for other, section in manifest["hosts"].items():
                    if other not in profiles:
                        section.setdefault(group, {}).setdefault(name, value)
            manifest["hosts"][profile].get(group, {}).pop(name, None)


def merge(base, desired, latest):
    """Keep independent edits and reject overlapping changes."""
    if desired == base:
        return latest
    if latest == base or latest == desired:
        return desired
    if all(isinstance(x, dict) or x is ABSENT for x in (base, desired, latest)):
        a, b, c = ({} if x is ABSENT else x for x in (base, desired, latest))
        merged = {key: merge(a.get(key, ABSENT), b.get(key, ABSENT), c.get(key, ABSENT))
                  for key in sorted(a.keys() | b.keys() | c.keys())}
        return {key: value for key, value in merged.items() if value is not ABSENT}
    raise Error("Another machine changed the same setting. Review the synced values before publishing.")


def skill_policy(folder, mode):
    path = folder / "agents/openai.yaml"
    original = path.read_text() if path.is_file() else ""
    flag = "false" if mode == "manual" else "true"
    line = f"  allow_implicit_invocation: {flag}"
    if re.search(r"(?m)^  allow_implicit_invocation:.*$", original):
        return re.sub(r"(?m)^  allow_implicit_invocation:.*$", line, original)
    if re.search(r"(?m)^policy:\s*$", original):
        return re.sub(r"(?m)^policy:[ \t]*$", "policy:\n" + line, original)
    return original.rstrip() + ("\n\n" if original.strip() else "") + "policy:\n" + line + "\n"


def tool_values(settings):
    for name, value in settings["defaults"].items():
        yield (name,), value
    for group, table in (("mcp", "mcp_servers"), ("plugins", "plugins")):
        for name, value in settings[group].items():
            yield (table, name, "enabled"), value
    for key, value in settings["plugin_mcp"].items():
        plugin, server = key.split("/")
        yield ("plugins", plugin, "mcp_servers", server, "enabled"), None if value == "default" else value


def setting(data, key, default=None):
    for part in key:
        if not isinstance(data, dict) or part not in data:
            return default
        data = data[part]
    return data


def tool_available(raw, key):
    return key[0] not in ("mcp_servers", "plugins") or key[1] in raw.get(key[0], {})

def tool_value(raw, key, wanted):
    return setting(raw, key, None if wanted is None or len(key) == 1 else True)



def hook_entries(source, hooks):
    for event, groups in hooks.items():
        if not isinstance(groups, list):
            continue
        for group in groups:
            if not isinstance(group, dict):
                continue
            matcher = group.get("matcher", "")
            for handler in group.get("hooks", []):
                if not isinstance(handler, dict):
                    continue
                identity = digest(json.dumps([source, event, matcher, handler], sort_keys=True))
                yield identity, event, group, handler


def schema_fields(schema):
    """Collect named keys, including fields in dynamic tables and list items."""
    fields = {}

    def walk(node, path, seen, alternative=False):
        if not isinstance(node, dict):
            return
        metadata = fields.setdefault(path, {}) if path else {}
        description = node.get("description", "")
        if node.get("deprecated") is True or re.match(r"^(?:[\[*_]+)?deprecated\b", description, re.I):
            if not alternative:
                metadata["deprecated"] = True
            return
        for key in ("description", "default"):
            if key in node and node[key] is not None:
                metadata.setdefault(key, node[key])
        types = node.get("type", [])
        for kind in [types] if isinstance(types, str) else types:
            kinds = metadata.setdefault("type", [])
            if kind not in kinds:
                kinds.append(kind)
        for value in node.get("enum", [node["const"]] if "const" in node else []):
            options = metadata.setdefault("enum", [])
            if value not in options:
                options.append(value)
        ref = node.get("$ref", "")
        if ref.startswith("#/") and ref not in seen:
            lookup = [part.replace("~1", "/").replace("~0", "~") for part in ref[2:].split("/")]
            walk(setting(schema, lookup), path, seen | {ref}, alternative)
        for key in ("anyOf", "oneOf", "allOf"):
            for variant in node.get(key, []):
                walk(variant, path, seen, alternative or key != "allOf")
        for name, child in node.get("properties", {}).items():
            walk(child, (*path, name), seen)
        if isinstance(node.get("additionalProperties"), dict):
            walk(node["additionalProperties"], (*path, "<name>"), seen)
        if isinstance(node.get("items"), dict):
            walk(node["items"], (*path, "[]"), seen)

    walk(schema, (), set())
    return fields


def user_fields(raw, path=()):
    if path:
        yield path, raw
    if isinstance(raw, dict):
        for name, value in raw.items():
            yield from user_fields(value, (*path, name))
    elif isinstance(raw, list):
        for index, value in enumerate(raw):
            if isinstance(value, (list, dict)):
                yield from user_fields(value, (*path, index))


def path_matches(template, path):
    return len(template) == len(path) and all(
        expected == actual or expected == "<name>" and isinstance(actual, str)
        or expected == "[]" and type(actual) is int
        for expected, actual in zip(template, path))


def accepts_choice(choices, value):
    return any(type(value) is type(choice) and value == choice for choice in choices)


def field_for_path(rows, path):
    if path in rows:
        return rows[path]
    matches = ((key, row) for key, row in rows.items() if path_matches(key, path))
    return min(matches, key=lambda pair: pair[0].count("<name>") + pair[0].count("[]"), default=(None, {}))[1]


def config_edit(raw, path, value):
    # The native writer addresses TOML keys. Edit indexed fields through their containing array.
    first_index = next((i for i, part in enumerate(path) if type(part) is int), None)
    if first_index is None:
        return path, value
    prefix = path[:first_index]
    entries = copy.deepcopy(setting(raw, prefix))
    current = entries
    for part in path[first_index:-1]:
        if type(part) is int:
            need(isinstance(current, list) and part < len(current), "The selected list item no longer exists.")
            current = current[part]
        else:
            need(isinstance(current, dict), "The selected field is not inside a table.")
            if part not in current and value is None:
                return prefix, entries
            current = current.setdefault(part, {})
    need(isinstance(current, dict) and isinstance(path[-1], str), "Select a field inside the list item.")
    if value is None:
        current.pop(path[-1], None)
    else:
        current[path[-1]] = value
    return prefix, entries


def choice_spec(fields, path, feature):
    meta = fields.get(path, {})

    def constants(field):
        values = [v for v in field.get("enum", []) if type(v) in (str, bool, int, float)]
        return values or ([True, False] if "boolean" in field.get("type", []) else [])

    if "array" in meta.get("type", []):
        items = constants(fields.get((*path, "[]"), {}))
        if items:
            return {"multiple": True, "values": items}
    choices = constants(meta)
    if not choices and feature:
        choices = [True, False]
    if not choices:
        return None
    return {"multiple": False, "values": choices}


def active_config_fields(fields, features):
    paths = fields.keys() | {("features", flag) for flag in features}
    for path in paths:
        feature = features.get(path[1], {}) if len(path) >= 2 and path[0] == "features" else {}
        if feature.get("stage", "").casefold() in RETIRED_STAGES or any(
            fields.get(path[:i], {}).get("deprecated") for i in range(1, len(path) + 1)
        ):
            continue
        parent = choice_spec(fields, path[:-1], {}) if path[-1] == "[]" else None
        if parent and parent["multiple"]:
            continue  # The list itself has a multi-choice editor.
        yield path, feature if len(path) == 2 else {}


def config_value(path, value):
    if isinstance(value, dict):
        return f"Table · {len(value)} entries"
    if isinstance(value, list):
        return f"List · {len(value)} items"
    if isinstance(value, str) and (
        path[0] in {"mcp_servers", "model_providers", "hooks"} or
        any(isinstance(part, str) and (PRIVATE_KEY.search(part) or part in {"env", "env_vars", "url", "base_url"})
            for part in path)
    ):
        return "Set · value hidden"
    return json.dumps(value, ensure_ascii=False) if isinstance(value, (bool, str, int, float)) else str(value)


def field_path(path):
    name = ""
    for part in path:
        if type(part) is int:
            name += f"[{part}]"
        elif part == "[]":
            name += part
        else:
            label = part if part == "<name>" or re.fullmatch(r"[A-Za-z0-9_-]+", part) else json.dumps(part)
            name += ("." if name else "") + label
    return name


def run(args, cwd=ROOT, timeout=20, data=None, env=None):
    return subprocess.run(args, cwd=cwd, input=data, text=data is not None,
                          capture_output=True, timeout=timeout, env=env)


class Customization:
    def __init__(self, profile=None, home=None):
        self.home = home or Path.home()
        self.profile = profile or HOSTS.get(socket.gethostname())
        need(self.profile in HOSTS.values(), "Select a supported Kubuntu workstation profile.")
        self.codex = Path(os.environ.get("CODEX_HOME", self.home / ".codex"))
        self.state = Path(os.environ.get("XDG_STATE_HOME", self.home / ".local/state")) / "dotfiles/ai-customization"
        self.skills = self.home / ".agents/skills"
        self.git_env = dict(os.environ, GIT_TERMINAL_PROMPT="0", GCM_INTERACTIVE="never",
                            GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=6 -o StrictHostKeyChecking=yes")
        brew = Path("/home/linuxbrew/.linuxbrew/bin")
        if brew.is_dir():
            self.git_env["PATH"] = str(brew) + os.pathsep + os.environ.get("PATH", os.defpath)
        agent = self.home / ".bitwarden-ssh-agent.sock"
        if agent.is_socket():
            self.git_env["SSH_AUTH_SOCK"] = str(agent)

    @contextmanager
    def locked(self, filename="lock"):
        self.state.mkdir(parents=True, exist_ok=True, mode=0o700)
        with (self.state / filename).open("a") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            yield

    def git(self, *args, cwd=ROOT, fail=True, timeout=25):
        result = run(["git", *args], cwd=cwd, env=self.git_env, timeout=timeout)
        if fail:
            need(result.returncode == 0, f"Git {args[0]} failed. Check connectivity or unlock the signing agent.")
        return result

    def manifest(self, ref=UPSTREAM):
        result = self.git("show", f"{ref}:{REL}/{PREFS}", fail=False)
        return validate(json.loads(result.stdout)) if result.returncode == 0 else validate(load(ROOT / REL / PREFS))

    def config(self):
        path = self.codex / "config.toml"
        text = path.read_text() if path.exists() else ""
        return text, tomllib.loads(text)

    def config_binaries(self):
        return {"CLI": self.home / ".local/bin/codex", "Desktop app": DESKTOP_CODEX}

    def model_choices(self, executable):
        try:
            result = run([str(executable), "debug", "models"], cwd="/", timeout=8,
                         env=dict(os.environ, CODEX_HOME=str(self.codex)))
            if result.returncode != 0:
                return {}
            return {
                model["slug"]: {
                    "reasoning": [level["effort"] for level in model.get("supported_reasoning_levels", [])],
                    "tiers": ["default", *(tier["id"] for tier in model.get("service_tiers", []))],
                }
                for model in json.loads(result.stdout)["models"] if model.get("visibility") == "list"
            }
        except (OSError, ValueError, KeyError, TypeError, subprocess.TimeoutExpired):
            return {}

    def config_constraints(self, executable):
        options = {}
        try:
            with self.codex_rpc(executable, experimental=True, timeout=4) as request:
                profiles = request("permissionProfile/list", {"cwd": "/"})
                options["permissions"] = [item["id"] for item in profiles["data"] if item["allowed"]]
                response = request("configRequirements/read")
                requirements = response.get("requirements") or {}
                options["allowed_approvals"] = requirements.get("allowedApprovalPolicies")
                flags = requirements.get("featureRequirements") or {}
                options["blocked_tiers"] = [
                    tier for tier, flag in (("priority", "fast_mode"),
                                           ("ultrafast", "ultrafast_mode" if response.get(
                                               "supportsIndependentSpeedModes") else "fast_mode"))
                    if flags.get(flag) is False
                ]
        except (Error, OSError, ValueError, KeyError):
            pass
        return options

    def config_engines(self, include_choices=True):
        engines = {}
        for surface, executable in self.config_binaries().items():
            if not executable.is_file():
                continue
            try:
                result = run([str(executable), "--version"], cwd="/", timeout=3)
                parts = result.stdout.decode().strip().split()
                version = parts[-1] if result.returncode == 0 and parts else ""
                if not CODEX_VERSION.fullmatch(version):
                    continue
                engines[surface] = {"version": version, "features": {}}
                # Read the engine's stages and defaults without loading the user's config.
                with tempfile.TemporaryDirectory(prefix="dot-codex-features-") as temp:
                    result = run([str(executable), "features", "list"], cwd="/", timeout=4,
                                 env=dict(os.environ, CODEX_HOME=temp))
                for line in result.stdout.decode(errors="replace").splitlines() if result.returncode == 0 else []:
                    parts = line.split()
                    if len(parts) > 2 and parts[-1] in ("true", "false") and re.fullmatch(r"\w+", parts[0]):
                        engines[surface]["features"][parts[0]] = {
                            "stage": " ".join(parts[1:-1]), "enabled": parts[-1] == "true"}
                if include_choices:
                    engines[surface]["models"] = self.model_choices(executable)
                    constraints = self.config_constraints(executable)
                    engines[surface].update(constraints)
                    for model in engines[surface]["models"].values():
                        model["tiers"] = [tier for tier in model["tiers"]
                                          if tier not in constraints.get("blocked_tiers", [])]
                if surface == "Desktop app" and shutil.which("dpkg-query"):
                    package = run(["dpkg-query", "-W", "-f=${Version}", "chatgpt"], timeout=3)
                    if package.returncode == 0:
                        engines[surface]["package"] = package.stdout.decode().strip()
            except (OSError, subprocess.TimeoutExpired):
                continue
        return {"profile": self.profile, "engines": engines}

    def config_schema(self, version):
        need(CODEX_VERSION.fullmatch(version), "Invalid Codex version.")
        cache = self.state / "config-schemas" / f"{version}.json"
        try:
            data = load(cache)
            if data and isinstance(data.get("properties"), dict):
                return data
        except (OSError, ValueError, AttributeError):
            pass
        try:
            with urlopen(CODEX_SCHEMA.format(version), timeout=5) as response:
                data = json.loads(response.read(2 * 1024 * 1024))
            if not isinstance(data.get("properties"), dict):
                return None
        except (OSError, ValueError, AttributeError):
            return None
        try:
            atomic(cache, encode(data))
        except OSError:
            pass
        return data

    def config_rows(self, builds):
        schemas = {}
        rows = {}
        for identity, engine in builds.items():
            version = engine["version"]
            if version not in schemas:
                schema = self.config_schema(version)
                schemas[version] = schema_fields(schema) if schema else None
            fields = schemas[version] or {}
            engine["schema"] = schemas[version] is not None
            approvals = fields.get(("approval_policy",), {}).get("enum", [])
            allowed = engine.get("allowed_approvals")
            engine["approval_policies"] = approvals if allowed is None else [p for p in approvals if p in allowed]
            for path, feature in active_config_fields(fields, engine["features"]):
                row = rows.setdefault(path, {"support": {}, "options": {}, "metadata": fields.get(path, {})})
                if not row["metadata"]:
                    row["metadata"] = fields.get(path, {})
                row["support"][identity] = feature
                spec = choice_spec(fields, path, feature)
                if spec:
                    row["options"][identity] = spec
        return rows

    def config_catalog(self, with_peer):
        local = self.config_engines()
        peer = self.call_peer("config-engines", timeout=40) if with_peer else {}
        builds = {f'{workstation["profile"]}/{surface}': engine
                  for workstation in (local, peer)
                  for surface, engine in workstation.get("engines", {}).items()}
        rows = self.config_rows(builds)

        _, user = self.config()
        for path, value in user_fields(user):
            if path not in rows:
                template = field_for_path(rows, path)
                rows[path] = dict(template) if template else {"support": {}, "metadata": {}}
            rows[path]["value"] = config_value(path, value)
            for spec in rows[path].get("options", {}).values():
                options = spec["values"]
                if (spec["multiple"] and isinstance(value, list)
                        and all(accepts_choice(options, item) for item in value)
                        or not spec["multiple"] and accepts_choice(options, value)):
                    rows[path]["choice"] = value
                    break

        return {
            "builds": {identity: {key: data.get(key) for key in
                                 ("version", "schema", "package", "models", "permissions", "approval_policies")}
                       for identity, data in builds.items()},
            "peer_available": bool(peer),
            "settings": {field_path(path): {**info, "path": path} for path, info in rows.items()},
        }

    def instructions(self, manifest):
        private = self.codex / "AGENTS.local.md"
        return effective(manifest, self.profile, private.read_text() if private.is_file() else "")

    def skill_source(self, name, source):
        if name != "chrome-devtools-cli":
            return source / "skills" / name
        launcher = self.home / ".local/bin/chrome-devtools"
        package = next((p for p in launcher.resolve().parents if p.name == "chrome-devtools-mcp"), None)
        need(package is not None, "Install the managed Chrome DevTools CLI before applying its skill.")
        return package / "skills" / name

    def skill_target(self, name):
        path = self.skills / name
        return path.is_symlink() and (self.state / "skills") in path.resolve().parents

    def status(self, manifest=None):
        manifest = manifest or self.manifest()
        _, raw = self.config()
        expected = self.instructions(manifest)
        previous = load(self.state / "applied.json", {})
        guidance = self.codex / "AGENTS.md"
        installed_text = guidance.read_text() if guidance.is_file() else ""
        drift = {}
        for key, wanted in tool_values(expected):
            if not tool_available(raw, key):
                continue
            actual = tool_value(raw, key, wanted)
            baseline = previous.get("settings", {}).get(".".join(key), ABSENT)
            if baseline is not ABSENT and actual not in (baseline, wanted):
                drift[".".join(key)] = actual
        if installed_text.strip() and installed_text != expected["instructions"] and (
            digest(installed_text) != previous.get("instructions")
        ):
            drift["instructions"] = "Existing global instructions"
        if (self.codex / "AGENTS.override.md").is_file():
            if (self.codex / "AGENTS.override.md").read_text().strip():
                drift["override"] = "AGENTS.override.md takes precedence"
        hooks = load(self.codex / "hooks.json", {})
        handlers = {}
        for source, groups in (("hooks.json", hooks.get("hooks", {})), ("config.toml", raw.get("hooks", {}))):
            for identity, event, group, handler in hook_entries(source, groups):
                command = handler.get("command") or handler.get("tool") or handler.get("type", "Hook")
                description = " ".join(str(command).split())
                handlers[identity] = {"event": event, "matcher": group.get("matcher", ""),
                                      "description": description[:120], "source": source}
        plugin_servers = {name: {server: value.get("enabled", True)
                                 for server, value in item.get("mcp_servers", {}).items()}
                          for name, item in raw.get("plugins", {}).items()}
        # Inventory manifests from the local plugin cache without starting plugins.
        installed_plugins = {}
        for name in raw.get("plugins", {}):
            plugin, _, market = name.partition("@")
            folder = self.codex / "plugins/cache" / market / plugin
            releases = [p for p in folder.glob("*") if p.is_dir()]
            installed_plugins[name] = bool(releases)
            for release in sorted(releases, key=lambda p: p.stat().st_mtime, reverse=True)[:1]:
                declaration = load(release / ".mcp.json", {})
                for server in declaration.get("mcpServers", declaration):
                    plugin_servers.setdefault(name, {}).setdefault(server, True)
        available_skills = {p.name: "unmanaged" for p in self.skills.glob("*") if (p / "SKILL.md").is_file()}
        skill_sources = {}
        for name in expected["skills"]:
            if self.skill_target(name):
                policy = self.skills / name / "agents/openai.yaml"
                manual = policy.is_file() and bool(re.search(
                    r"(?m)^  allow_implicit_invocation: false\s*$", policy.read_text()))
                available_skills[name] = "manual" if manual else "automatic"
            else:
                available_skills.setdefault(name, "off")
            if name == "chrome-devtools-cli":
                launcher = (self.home / ".local/bin/chrome-devtools").resolve()
                package = next((p for p in launcher.parents if p.name == "chrome-devtools-mcp"), None)
                installed = load(package / "package.json", {}) if package else {}
                skill_sources[name] = "Google Chrome DevTools " + installed.get("version", "")
            else:
                skill_sources[name] = "Dotfiles"
        return {
            "profile": self.profile, "manifest": manifest, "drift": drift,
            "paths": {
                "instructions": str((self.codex / "AGENTS.md").absolute()),
                "config": str((self.codex / "config.toml").absolute()),
                "skills": str(self.skills.absolute()),
                "hooks": str((self.codex / "hooks.json").absolute()),
                "manifest": str(ROOT / REL / PREFS),
            },
            "actual_defaults": {k: raw.get(k) for k in sorted(DEFAULTS)},
            "skills": available_skills, "skill_sources": skill_sources,
            "plugin_installed": installed_plugins,
            "mcp": {k: v.get("enabled", True)
                                               for k, v in raw.get("mcp_servers", {}).items()},
            "plugins": {k: v.get("enabled", True) for k, v in raw.get("plugins", {}).items() if k != "_default"},
            "plugin_mcp": {f"{p}/{s}": v for p, servers in plugin_servers.items() for s, v in servers.items()},
            "hooks": sorted(set(hooks.get("hooks", {})) | (set(raw.get("hooks", {})) - {"state"})),
            "hook_entries": handlers,
            "applied": previous.get("revision"), "peer": load(self.state / "peer.json", {}),
            "pending": load(self.state / "pending.json"),
            "pending_removals": len(load(self.state / "pending-removals.json", [])),
            "instructions_outdated": installed_text != expected["instructions"],
        }

    @contextmanager
    def codex_rpc(self, codex, experimental=False, timeout=12):
        with subprocess.Popen([str(codex), "app-server"], cwd="/", stdin=subprocess.PIPE,
                              stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, bufsize=0,
                              env=dict(os.environ, CODEX_HOME=str(self.codex))) as process:
            buffer = b""
            next_id = 0

            def request(method, params=None):
                nonlocal buffer, next_id
                payload = {"id": next_id, "method": method, "params": params or {}}
                next_id += 1
                process.stdin.write((json.dumps(payload) + "\n").encode())
                deadline = time.monotonic() + timeout
                while True:
                    if b"\n" not in buffer:
                        if not select.select([process.stdout], [], [], max(0, deadline - time.monotonic()))[0]:
                            raise Error("Codex configuration request timed out.")
                        chunk = os.read(process.stdout.fileno(), 8192)
                        need(chunk, "Codex configuration server stopped.")
                        buffer += chunk
                        continue
                    line, buffer = buffer.split(b"\n", 1)
                    event = json.loads(line)
                    if event.get("id") == payload["id"]:
                        need("result" in event, f"Codex declined {method}.")
                        return event["result"]

            try:
                init = {"clientInfo": {"name": "dotfiles-ai-customization", "version": "1"}}
                if experimental:
                    init["capabilities"] = {"experimentalApi": True}
                request("initialize", init)
                process.stdin.write(b'{"method":"initialized"}\n')
                yield request
            finally:
                if process.poll() is None:
                    process.terminate()
                try:
                    process.wait(timeout=3)
                except subprocess.TimeoutExpired:
                    process.kill()
                    process.wait()

    def write_config(self, original, changes, codex=None):
        if not changes:
            return
        codex = codex or self.home / ".local/bin/codex"
        need(codex.is_file(), "Codex CLI is unavailable.")
        edits = [{"keyPath": ".".join(json.dumps(part) for part in key), "value": value,
                  "mergeStrategy": "replace"} for key, value in changes]
        with self.codex_rpc(codex) as request:
            params = {"edits": edits}
            layers = request("config/read", {"includeLayers": True})["layers"]
            for layer in layers or []:
                if layer["name"]["type"] == "user":
                    params["expectedVersion"] = layer["version"]
                    break
            need(self.config()[0] == original, "Codex settings changed during apply. Reload and retry.")
            request("config/batchWrite", params)

    def apply(self, manifest, source, revision, resolve=False, check=False, deferred_skills=()):
        expected = self.instructions(manifest)
        previous = load(self.state / "applied.json", {})
        status = self.status(manifest)
        need("override" not in status["drift"], "Global AGENTS.override.md takes precedence. Review it first.")
        need(resolve or not status["drift"], "Local settings differ. Review them in AI Customization.")
        original, raw = self.config()
        changes = []
        for key, wanted in tool_values(expected):
            if not tool_available(raw, key):
                continue  # Enablement policy cannot install entries.
            actual = tool_value(raw, key, wanted)
            if actual != wanted:
                changes.append((key, wanted))
        wanted_sources = {}
        stale = set(previous.get("skills", [])) - expected["skills"].keys()
        for name, mode in expected["skills"].items():
            if mode != "off":
                path = self.skills / name
                need(not (path.exists() or path.is_symlink()) or self.skill_target(name),
                     f"An unmanaged skill already occupies {name}.")
                folder = self.skill_source(name, source)
                need((folder / "SKILL.md").is_file(), f"Skill source is missing for {name}.")
                wanted_sources[name] = (folder, skill_policy(folder, mode))
        if check:
            need(not changes and (self.codex / "AGENTS.md").is_file()
                 and (self.codex / "AGENTS.md").read_text() == expected["instructions"]
                 and all(self.skill_target(n) for n in wanted_sources)
                 and all(not self.skill_target(n) for n in set(expected["skills"]) - wanted_sources.keys()),
                 "Codex customization requires apply.")
            return
        self.write_config(original, changes)
        guide = self.codex / "AGENTS.md"
        if not guide.is_file() or guide.read_text() != expected["instructions"]:
            atomic(guide, expected["instructions"])
        for name in ((set(expected["skills"]) - wanted_sources.keys()) | stale) - set(deferred_skills):
            if self.skill_target(name):
                (self.skills / name).unlink()
        for name, (folder, policy) in wanted_sources.items():
            self.install_skill(folder, name, policy)
        available = self.config()[1]
        atomic(self.state / "applied.json", encode({
            "revision": revision, "instructions": digest(expected["instructions"]),
            "chrome": status["skill_sources"].get("chrome-devtools-cli"),
            "settings": {".".join(key): tool_value(available, key, wanted)
                         for key, wanted in tool_values(expected) if tool_available(available, key)},
            "skills": sorted(expected["skills"]),
        }))

    def install_skill(self, folder, name, policy):
        paths = [p for p in sorted(folder.rglob("*")) if p.is_file()]
        h = hashlib.sha256(policy.encode())
        for path in paths:
            need(path.resolve().is_relative_to(folder.resolve()), f"Unsafe source path for {name}.")
            h.update(str(path.relative_to(folder)).encode() + b"\0" + path.read_bytes())
        target = self.state / "skills" / name / h.hexdigest()
        if not target.is_dir():
            target.parent.mkdir(parents=True, exist_ok=True)
            with tempfile.TemporaryDirectory(dir=target.parent) as stage:
                install = Path(stage) / name
                shutil.copytree(folder, install)
                atomic(install / "agents/openai.yaml", policy)
                install.rename(target)
        link = self.skills / name
        self.skills.mkdir(parents=True, exist_ok=True)
        if not link.is_symlink() or link.resolve() != target:
            with tempfile.TemporaryDirectory(dir=self.skills) as stage:
                temporary = Path(stage) / "skill"
                temporary.symlink_to(target, target_is_directory=True)
                temporary.replace(link)

    def edit_skill(self, name, files, remove):
        path = self.skills / name
        if remove and self.skill_target(name):
            need(name not in effective(self.manifest(), self.profile)["skills"],
                 "The dotfiles installation policy still includes this skill.")
            path.unlink()
            return
        need(not self.skill_target(name), "Change the installation policy for this dotfiles skill.")
        if remove:
            if path.exists() or path.is_symlink():
                backup = self.state / "removed-skills"
                backup.mkdir(exist_ok=True, mode=0o700)
                shutil.move(path, backup / f"{name}-{uuid4().hex}")
            return
        need(isinstance(files, dict) and "SKILL.md" in files, "Select a folder containing SKILL.md.")
        decoded = {}
        total = 0
        for relative, record in files.items():
            file = Path(relative)
            need(file.parts and not file.is_absolute() and all(p not in ("..", ".git") for p in file.parts),
                 "The skill contains an unsafe file path.")
            content = base64.b64decode(record["content"], validate=True)
            total += len(content)
            need(total <= MAX_SKILL_BYTES, "The skill exceeds the 5 MiB import limit.")
            decoded[file] = (content, record["executable"] is True)
        if path.exists() or path.is_symlink():
            need(path.is_dir() and not path.is_symlink()
                 and {p.relative_to(path) for p in path.rglob("*") if not p.is_dir()} == set(decoded)
                 and all((path / file).is_file() and not (path / file).is_symlink()
                         and (path / file).read_bytes() == content
                         and bool((path / file).stat().st_mode & 0o100) == executable
                         for file, (content, executable) in decoded.items()),
                 "A skill with this name already exists.")
            return
        self.skills.mkdir(parents=True, exist_ok=True)
        with tempfile.TemporaryDirectory(dir=self.skills) as folder:
            staged = Path(folder) / name
            for file, (content, executable) in decoded.items():
                dest = staged / file
                dest.parent.mkdir(parents=True, exist_ok=True)
                dest.write_bytes(content)
                dest.chmod(0o700 if executable else 0o600)
            staged.rename(path)

    def edit_hook(self, name, value, remove):
        path = self.codex / "hooks.json"
        document = load(path, {})
        hooks = document.setdefault("hooks", {})
        original, raw = self.config()
        if remove:
            for source, groups in (("hooks.json", hooks), ("config.toml", raw.get("hooks", {}))):
                matches = [(event, group, handler) for identity, event, group, handler in hook_entries(source, groups)
                           if identity == name]
                if not matches:
                    continue
                for event, group, handler in matches:
                    group["hooks"].remove(handler)
                    if not group["hooks"]:
                        groups[event].remove(group)
                if source == "config.toml":
                    self.write_config(original, [(("hooks", event), groups[event] or None)])
                else:
                    if not groups[event]:
                        groups.pop(event)
                    atomic(path, encode(document))
                return
            return
        need(re.fullmatch(r"[A-Z][A-Za-z0-9]+", name), "Enter a Codex hook event such as SessionStart.")
        handler = value["handler"]
        need(isinstance(handler, dict), "Enter a JSON object for the hook handler.")
        kind = handler.get("type")
        need((kind == "command" and isinstance(handler.get("command"), str) and handler["command"].strip())
             or (kind == "mcp_tool" and all(isinstance(handler.get(k), str) and handler[k].strip()
                                          for k in ("server", "tool"))),
             "A hook needs a command or an MCP server and tool.")
        matcher = value.get("matcher", "")
        need(isinstance(matcher, str), "Enter a hook matcher as text.")
        if any(event == name and group.get("matcher", "") == matcher and item == handler
               for _, event, group, item in hook_entries("hooks.json", hooks)):
            return
        group = {"hooks": [handler]}
        if matcher:
            group["matcher"] = matcher
        hooks.setdefault(name, []).append(group)
        atomic(path, encode(document))

    def edit_entry(self, request):
        group, name, operation = (request[key] for key in ("group", "name", "operation"))
        need(group in ENTRY_GROUPS and operation in ("add", "remove"), "Unknown entry action.")
        remove = operation == "remove"
        value = request.get("value")
        if group == "config":
            self.edit_config_choice(value["path"], None if remove else value["choice"])
            return
        if group == "hooks":
            self.edit_hook(name, value, remove)
            return
        if group == "plugin_mcp":
            parts = name.split("/")
            need(remove and len(parts) == 2 and all(IDENTIFIER.fullmatch(p) for p in parts),
                 "Invalid plugin MCP removal.")
            plugin, server = parts
            key = ("plugins", plugin, "mcp_servers", server)
            original, raw = self.config()
            if setting(raw, key) is not None:
                self.write_config(original, [(key, None)])
            return
        need(IDENTIFIER.fullmatch(name) and name not in (".", "..") and not name.startswith("-"),
             "Invalid entry name.")
        if group == "skills":
            self.edit_skill(name, value, remove)
        elif group == "plugins":
            need(re.fullmatch(r"[\w.-]+@[\w.-]+", name, re.ASCII), "Use a plugin name in plugin@marketplace form.")
            codex = self.home / ".local/bin/codex"
            result = run([str(codex), "plugin", operation, "--json", name], cwd="/", timeout=75,
                         env=dict(os.environ, CODEX_HOME=str(self.codex)))
            need(result.returncode == 0, "Codex could not change the plugin. Check its marketplace and access.")
            if not remove:
                original, raw = self.config()
                changes = [
                    (key, wanted) for key, wanted in tool_values(effective(self.manifest(), self.profile))
                    if key[:2] == ("plugins", name) and tool_value(raw, key, wanted) != wanted
                ]
                self.write_config(original, changes)
        else:
            original, raw = self.config()
            key = ("mcp_servers", name)
            existing = setting(raw, key)
            if not remove:
                need(isinstance(value, str), "Enter an MCP server URL or command.")
                url = urlsplit(value)
                if url.scheme in ("http", "https"):
                    need(url.hostname, "Enter a complete HTTP or HTTPS URL.")
                    value = {"url": value}
                else:
                    args = shlex.split(value)
                    need(args, "Enter an MCP server URL or command.")
                    value = {"command": args[0], "args": args[1:]}
                need(existing is None or all(existing.get(k, [] if k == "args" else None) == v
                                             for k, v in value.items()),
                     "An MCP server with this name already exists.")
                if existing is not None:
                    return
                policy = effective(self.manifest(), self.profile)["mcp"].get(name)
                if policy is not None:
                    value["enabled"] = policy
            wanted = None if remove else value
            if existing != wanted:
                self.write_config(original, [(key, wanted)])

    def edit_config_choice(self, parts, value):
        need(isinstance(parts, list) and parts and all(
            type(part) is int and part >= 0 or isinstance(part, str) and part and part not in ("<name>", "[]")
            for part in parts
        ), "Enter a concrete setting path.")
        path = tuple(parts)
        need(isinstance(path[0], str), "Enter a setting key.")
        policy = effective(self.manifest(), self.profile)
        need(path not in {key for key, _ in tool_values(policy)},
             "This setting is managed by Apply & Sync.")
        engines = self.config_engines(include_choices=False)["engines"]
        row = field_for_path(self.config_rows(engines), path)
        supported = row.get("support", {})
        specs = row.get("options", {})
        need(supported and set(supported) == set(specs), "The installed Codex versions do not report choices for this setting.")
        for spec in specs.values():
            valid = (isinstance(value, list) and all(accepts_choice(spec["values"], item) for item in value)
                     if spec["multiple"] else accepts_choice(spec["values"], value))
            need(value is None or valid, "That choice does not match the installed Codex versions. Reload and retry.")
        original, raw = self.config()
        key, wanted = config_edit(raw, path, value)
        existing = setting(raw, key)
        if type(existing) is not type(wanted) or existing != wanted:
            surface = "CLI" if "CLI" in supported else next(iter(supported))
            self.write_config(original, [(key, wanted)], codex=self.config_binaries()[surface])

    def entry_result(self, request):
        try:
            with self.locked():
                if request.get("revision"):
                    revision = request["revision"]
                    need(request["operation"] == "remove" and re.fullmatch(r"[0-9a-f]{40,64}", revision),
                         "Invalid published removal.")
                    self.git("fetch", "--quiet", "--no-tags", "origin", "master")
                    need(self.git("merge-base", "--is-ancestor", revision, UPSTREAM, fail=False).returncode == 0,
                         "The removal revision was not found on the published branch.")
                    need(not removal_policies(effective(self.manifest(), self.profile), request),
                         "A synced policy now includes this entry. Review it before removing it.")
                self.edit_entry(request)
            return {"ok": True}
        except Error as error:
            return {"error": str(error)}
        except subprocess.TimeoutExpired:
            return {"error": "The operation timed out. Reload before retrying."}
        except (OSError, ValueError, TypeError, KeyError, AttributeError) as error:
            return {"error": f"Could not change this entry ({type(error).__name__})."}

    def edit_scope(self, request):
        results = {}
        for profile in removal_profiles(request["scope"]):
            if profile == self.profile:
                results[profile] = self.entry_result(request)
            else:
                response = self.call_peer("entry-local", data=encode(request), timeout=95)
                results[profile] = response or {"error": "Could not reach the other computer or its app needs an update."}
        return results

    def sync(self, revision=None):
        need(not (self.state / "pending.json").exists(),
             "An unpublished local draft needs attention in AI Customization.")
        self.git("fetch", "--quiet", "--no-tags", "origin", "master")
        ref = self.git("rev-parse", UPSTREAM).stdout.decode().strip()
        if revision:
            need(re.fullmatch("[0-9a-f]{40,64}", revision) and
                 self.git("merge-base", "--is-ancestor", revision, ref, fail=False).returncode == 0,
                 "The requested revision was not found on the published branch.")
        published = self.git("rev-parse", f"{ref}:{REL}").stdout.decode().strip()
        previous = load(self.state / "applied.json", {})
        status = self.status()
        if (previous.get("revision") != published or status["drift"] or status["instructions_outdated"]
                or previous.get("chrome") != status["skill_sources"].get("chrome-devtools-cli")):
            archive = self.git("archive", ref, REL).stdout
            with tempfile.TemporaryDirectory() as temp, tarfile.open(fileobj=io.BytesIO(archive)) as tar:
                tar.extractall(temp, filter="data")
                source = Path(temp) / REL
                self.apply(validate(load(source / PREFS)), source, published)
        return {"revision": ref, "tree": published}

    def publish(self, request):
        base, desired = validate(request["base"]), validate(request["desired"])
        resolve = request.get("resolve") is True
        removals = request.get("removals", [])
        for removal in removals:
            need(removal["group"] in ENTRY_GROUPS and removal["operation"] == "remove", "Invalid staged removal.")
            removal_profiles(removal["scope"])
        atomic(self.state / "pending.json", encode(request))
        self.git("fetch", "--quiet", "--no-tags", "origin", "master")
        latest = self.manifest()
        candidate = copy.deepcopy(merge(base, desired, latest))
        for removal in removals:
            remove_policies(candidate, removal)
        validate(candidate)
        deferred_skills = {r["name"] for r in removals if r["group"] == "skills"
                           and self.profile in removal_profiles(r["scope"])}
        with tempfile.TemporaryDirectory(prefix="dot-ai-") as temp:
            work = Path(temp) / "work"
            self.git("worktree", "add", "--quiet", "--detach", str(work), UPSTREAM)
            try:
                source = work / REL
                local_changed = self.instructions(candidate) != self.instructions(latest)
                if candidate != latest:
                    atomic(source / PREFS, encode(candidate))
                    self.git("add", "--", f"{REL}/{PREFS}", cwd=work)
                    self.git("diff", "--cached", "--check", cwd=work)
                    scan = run(["gitleaks", "git", "--staged", "--redact", "--no-banner"],
                               cwd=work, env=self.git_env, timeout=30)
                    need(scan.returncode == 0, "The draft failed secret scanning.")
                if local_changed or resolve:
                    self.apply(candidate, source, "pending", resolve=resolve, deferred_skills=deferred_skills)
                if candidate != latest:
                    self.git("-c", "commit.gpgsign=true", "commit", "-m", "Update AI customization", cwd=work)
                    self.git("push", "origin", "HEAD:refs/heads/master", cwd=work, timeout=45)
                revision = self.git("rev-parse", "HEAD", cwd=work).stdout.decode().strip()
                tree = self.git("rev-parse", f"HEAD:{REL}", cwd=work).stdout.decode().strip()
                if local_changed or resolve:
                    state = load(self.state / "applied.json", {})
                    atomic(self.state / "applied.json", encode({**state, "revision": tree}))
            finally:
                self.git("worktree", "remove", "--force", str(work), fail=False)
        if removals:
            path = self.state / "pending-removals.json"
            pending = load(path, [])
            pending.extend({"id": uuid4().hex, "request": {**removal, "scope": profile, "revision": revision}}
                           for removal in removals for profile in removal_profiles(removal["scope"]))
            atomic(path, encode(pending))
        (self.state / "pending.json").unlink(missing_ok=True)
        return revision

    def finish_removals(self):
        path = self.state / "pending-removals.json"
        results = []
        # Never hold the application lock across a request to the other computer.
        with self.locked("removals.lock"):
            for job in load(path, []):
                request = job["request"]
                profile = request["scope"]
                result = self.edit_scope(request)[profile]
                results.append({"profile": profile, "group": request["group"], "name": request["name"], **result})
                if result.get("ok"):
                    with self.locked():
                        remaining = [item for item in load(path, []) if item["id"] != job["id"]]
                        if remaining:
                            atomic(path, encode(remaining))
                        else:
                            path.unlink(missing_ok=True)
        return results

    def notify_peer(self, revision):
        receipt = self.call_peer("sync", "--revision", revision, timeout=40)
        status = {"revision": revision, "state": "applied" if receipt.get("tree") else "pending"}
        atomic(self.state / "peer.json", encode(status))
        return status

    def call_peer(self, *args, timeout=8, data=None):
        current = next(host for host, profile in HOSTS.items() if profile == self.profile)
        peers = load(ROOT / "config/diagnostics/crash-peers.json")
        peer = peers[peers[current]["peer"]]
        target = peer["user"] + "@" + peer["hostname"]
        command = '"$HOME/.local/bin/dot-ai-customization" ' + shlex.join(args)
        try:
            # The approved peer record pins the full MagicDNS name even when
            # the user's known_hosts entry only covers the interactive alias.
            with tempfile.TemporaryDirectory(prefix="dot-ai-ssh-") as folder:
                known_hosts = Path(folder) / "known_hosts"
                known_hosts.write_text(peer["hostname"] + " " + peer["host_key"] + "\n")
                options = ["-o", f"UserKnownHostsFile={known_hosts}", "-o", "GlobalKnownHostsFile=/dev/null",
                           "-o", f'HostKeyAlias={peer["hostname"]}', "-o", "UpdateHostKeys=no"]
                result = run(shlex.split(self.git_env["GIT_SSH_COMMAND"]) + options + [target, command],
                             timeout=timeout, env=self.git_env, data=data)
            return json.loads(result.stdout) if result.returncode == 0 else {}
        except (OSError, ValueError, subprocess.TimeoutExpired):
            return {}

    def install(self):
        bin_dir = self.home / ".local/bin"
        systemd = self.home / ".config/systemd/user"
        share = self.home / ".local/share"
        desktop = share / "applications/io.github.doview.ai-customization.desktop"
        icon_name = f"{desktop.stem}.png"
        files = {
            bin_dir / "dot-ai-customization": ROOT / "scripts/ai-customization",
            bin_dir / "ai-customization": ROOT / "scripts/ai-customization-window",
            share / "icons/hicolor/512x512/apps" / icon_name: ROOT / "config/applications" / icon_name,
            **{systemd / f"dot-ai-customization.{kind}":
               ROOT / f"config/systemd/user/dot-ai-customization.{kind}" for kind in ("service", "timer")},
        }
        for path, src in files.items():
            path.parent.mkdir(parents=True, exist_ok=True)
            if path.is_symlink() and path.resolve() == src:
                continue
            need(not (path.exists() or path.is_symlink()), f"An unmanaged file already occupies {path.name}.")
            path.symlink_to(src)
        payload = (ROOT / "config/applications" / desktop.name).read_text().replace(
            "Exec=ai-customization", f'Exec="{bin_dir / "ai-customization"}"')
        if not desktop.is_file() or desktop.read_text() != payload:
            atomic(desktop, payload)
            desktop.chmod(0o644)
        runtime = Path(f"/run/user/{os.getuid()}")
        env = dict(os.environ, XDG_RUNTIME_DIR=str(runtime))
        if (runtime / "bus").is_socket():
            for args in (["daemon-reload"], ["enable", "--now", "dot-ai-customization.timer"]):
                result = run(["systemctl", "--user", *args], env=env)
                need(result.returncode == 0, "Could not enable the user sync timer.")
        else:
            wants = systemd / "timers.target.wants/dot-ai-customization.timer"
            wants.parent.mkdir(parents=True, exist_ok=True)
            if not wants.is_symlink():
                wants.symlink_to(systemd / wants.name)


def main():
    parser = argparse.ArgumentParser(prog="dot ai")
    parser.add_argument("action", choices=("status", "inventory", "preview", "apply", "sync",
                                           "publish", "install", "discard-draft", "entry", "entry-local",
                                           "config-engines", "config-catalog"))
    parser.add_argument("--profile", choices=tuple(HOSTS.values()))
    parser.add_argument("--revision")
    parser.add_argument("--check", action="store_true")
    parser.add_argument("--resolve", action="store_true")
    parser.add_argument("--with-peer", action="store_true")
    parser.add_argument("--json", action="store_true", help="Emit JSON (the default for status and sync).")
    args = parser.parse_args()
    try:
        app = Customization(args.profile)
        if args.action == "status":
            result = app.status()
            if args.with_peer:
                result["peer_inventory"] = app.call_peer("inventory")
            print(encode(result), end="")
        elif args.action == "inventory":
            result = app.status()
            print(encode({key: result[key] for key in
                          ("profile", "skills", "mcp", "plugins", "plugin_mcp", "hook_entries")}), end="")
        elif args.action in ("config-engines", "config-catalog"):
            result = app.config_engines() if args.action == "config-engines" else app.config_catalog(args.with_peer)
            print(encode(result), end="")
        elif args.action in ("entry", "entry-local"):
            request = json.load(sys.stdin)
            if request["operation"] == "remove":
                need(args.action == "entry-local" and request.get("revision"),
                     "Reopen AI Customization and use Apply & Sync to remove entries.")
            if args.action == "entry-local":
                need(request["scope"] in ("shared", app.profile), "The request targets a different computer.")
            result = app.edit_scope(request) if args.action == "entry" else app.entry_result(request)
            print(encode(result), end="")
        elif args.action == "preview":
            draft = sys.stdin.read() if not sys.stdin.isatty() else ""
            manifest = validate(json.loads(draft)) if draft.strip() else app.manifest()
            print(encode({profile: effective(manifest, profile) for profile in HOSTS.values()}), end="")
        elif args.action == "apply" and args.check:
            app.apply(validate(load(ROOT / REL / PREFS)), ROOT / REL, None, check=True)
        elif args.action == "discard-draft":
            with app.locked("removals.lock"), app.locked():
                (app.state / "pending.json").unlink(missing_ok=True)
                (app.state / "pending-removals.json").unlink(missing_ok=True)
            print("{}")
        else:
            published = None
            with app.locked():
                if args.action in ("apply", "install"):
                    tree = app.git("rev-parse", f"HEAD:{REL}", fail=False).stdout.decode().strip()
                    app.apply(validate(load(ROOT / REL / PREFS)), ROOT / REL, tree, resolve=args.resolve)
                    if args.action == "install":
                        app.install()
                elif args.action == "sync":
                    print(encode(app.sync(args.revision)), end="")
                elif args.action == "publish":
                    published = app.publish(json.load(sys.stdin))
            if published:
                results = app.finish_removals()
                print(encode({**app.notify_peer(published), "removals": results}), end="")
            elif args.action == "sync" and not args.revision:
                peer = load(app.state / "peer.json", {})
                if peer.get("state") == "pending":
                    app.notify_peer(peer["revision"])
        return 0
    except (Error, OSError, ValueError, KeyError, subprocess.TimeoutExpired) as error:
        print(f"AI Customization: {error if isinstance(error, Error) else type(error).__name__}",
              file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
