#!/usr/bin/env bash
set -euo pipefail

github_user="${1:-}"
tailscale_ip="${2:-}"
mode="${3:-}"
if [[ ! "$github_user" =~ ^[A-Za-z0-9-]+$ ]]; then
  echo "usage: bootstrap-remote-support GITHUB-USER TAILSCALE-IPV4 [--keys-only]" >&2
  exit 2
fi
if [[ -n "$mode" && "$mode" != "--keys-only" ]]; then
  echo "usage: bootstrap-remote-support GITHUB-USER TAILSCALE-IPV4 [--keys-only]" >&2
  exit 2
fi
python3 - "$tailscale_ip" <<'PY'
import ipaddress
import sys

address = ipaddress.ip_address(sys.argv[1])
if address.version != 4 or address not in ipaddress.ip_network("100.64.0.0/10"):
    raise SystemExit("remote support requires one Tailscale CGNAT IPv4 address")
PY

work_dir="$(mktemp -d)"
trap 'rm -rf -- "$work_dir"' EXIT
keys="$work_dir/github.keys"
curl --proto '=https' --tlsv1.2 --fail --silent --show-error --location \
  "https://github.com/${github_user}.keys" --output "$keys"

if [[ ! -s "$keys" ]]; then
  echo "GitHub account ${github_user} did not publish any SSH keys." >&2
  exit 1
fi
while IFS= read -r key; do
  [[ -z "$key" ]] && continue
  case "$key" in
    ssh-ed25519\ *|ssh-rsa\ *|ecdsa-sha2-nistp256\ *|ecdsa-sha2-nistp384\ *|ecdsa-sha2-nistp521\ *) ;;
    *) echo "GitHub returned an unsupported SSH public-key record." >&2; exit 1 ;;
  esac
  ssh-keygen -l -f <(printf '%s\n' "$key") >/dev/null
done <"$keys"

install -d -m 0700 "$HOME/.ssh" "$HOME/.ssh/authorized_keys.d"
install -m 0600 "$keys" "$HOME/.ssh/authorized_keys.d/dotfiles-github"

if [[ "$mode" == "--keys-only" ]]; then
  if [[ ! -f /etc/ssh/sshd_config.d/00-dotfiles-remote-support.conf ]]; then
    echo "Managed OpenSSH policy is missing; run the full remote-support setup." >&2
    exit 1
  fi
  echo "Refreshed ${github_user}'s published workstation keys for managed OpenSSH."
  exit 0
fi

if sudo -n true >/dev/null 2>&1; then
  privilege=(sudo -n)
elif command -v pkexec >/dev/null 2>&1; then
  privilege=(pkexec)
elif [[ -t 0 ]]; then
  privilege=(sudo)
else
  echo "Administrator authorization requires a terminal or PolicyKit agent." >&2
  exit 1
fi

if ! command -v sshd >/dev/null 2>&1; then
  "${privilege[@]}" /usr/bin/apt-get update
  "${privilege[@]}" /usr/bin/apt-get install -y openssh-server
fi

sshd_config="$work_dir/00-dotfiles-remote-support.conf"
cat >"$sshd_config" <<EOF
# Managed by dotfiles. Normal OpenSSH is transported over Tailscale.
ListenAddress ${tailscale_ip}
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
PubkeyAuthentication yes
AuthorizedKeysFile .ssh/authorized_keys .ssh/authorized_keys.d/dotfiles-github
EOF
"${privilege[@]}" /usr/bin/install -m 0644 "$sshd_config" /etc/ssh/sshd_config.d/00-dotfiles-remote-support.conf
"${privilege[@]}" /usr/sbin/sshd -t
"${privilege[@]}" /usr/bin/systemctl enable --now ssh
"${privilege[@]}" /usr/bin/systemctl restart ssh

effective="$("${privilege[@]}" /usr/sbin/sshd -T)"
grep -qx 'passwordauthentication no' <<<"$effective"
grep -qx 'kbdinteractiveauthentication no' <<<"$effective"
grep -qx 'permitrootlogin no' <<<"$effective"
grep -qx 'pubkeyauthentication yes' <<<"$effective"
echo "Secure normal OpenSSH is active on ${tailscale_ip} with ${github_user}'s published workstation keys."
