#!/usr/bin/env python3
"""Match the physical Plasma output to the managed KRDP laptop client."""

from __future__ import annotations

import fcntl
import json
import os
from pathlib import Path
import re
import subprocess
import sys
from typing import Any


STATE_DIR = Path.home() / ".local/state/dotfiles"
STATE_FILE = STATE_DIR / "krdp-display.json"
LOCK_FILE = STATE_DIR / "krdp-display.lock"
LOG_FILE = STATE_DIR / "krdp-display.log"
TARGET_WIDTH = 2560
TARGET_HEIGHT = 1600
TARGET_REFRESH = 60.0
TARGET_SCALE = 1.55


def log(message: str) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with LOG_FILE.open("a", encoding="utf-8") as stream:
        stream.write(message.rstrip() + "\n")


def graphical_environment() -> dict[str, str]:
    environment = os.environ.copy()
    runtime = Path(f"/run/user/{os.getuid()}")
    environment.setdefault("XDG_RUNTIME_DIR", str(runtime))
    environment.setdefault(
        "DBUS_SESSION_BUS_ADDRESS", f"unix:path={runtime}/bus"
    )
    if not environment.get("WAYLAND_DISPLAY"):
        sockets = sorted(
            path.name
            for path in runtime.glob("wayland-*")
            if re.fullmatch(r"wayland-\d+", path.name)
        )
        if sockets:
            environment["WAYLAND_DISPLAY"] = sockets[0]
    environment["QT_QPA_PLATFORM"] = "wayland"
    return environment


def enabled_outputs() -> list[dict[str, Any]]:
    result = subprocess.run(
        ["kscreen-doctor", "-j"],
        check=False,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        env=graphical_environment(),
        timeout=15,
    )
    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip()
        raise RuntimeError(f"cannot read Plasma output state: {detail}")
    payload = json.loads(result.stdout)
    return [
        output
        for output in payload.get("outputs", [])
        if output.get("connected") and output.get("enabled")
    ]


def target_mode(output: dict[str, Any]) -> str:
    candidates = [
        mode
        for mode in output.get("modes", [])
        if mode.get("size") == {"width": TARGET_WIDTH, "height": TARGET_HEIGHT}
    ]
    if not candidates:
        raise RuntimeError(
            f"{output.get('name', 'output')} has no "
            f"{TARGET_WIDTH}x{TARGET_HEIGHT} mode"
        )
    selected = min(
        candidates,
        key=lambda mode: abs(float(mode.get("refreshRate", 0)) - TARGET_REFRESH),
    )
    return str(selected["id"])


def set_output(name: str, mode: str, scale: float) -> None:
    result = subprocess.run(
        [
            "kscreen-doctor",
            f"output.{name}.mode.{mode}",
            f"output.{name}.scale.{scale:g}",
        ],
        check=False,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        env=graphical_environment(),
        timeout=20,
    )
    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip()
        raise RuntimeError(
            f"cannot set {name} to mode {mode} at {scale:g}: {detail}"
        )


def load_state() -> dict[str, dict[str, Any]]:
    if not STATE_FILE.is_file():
        return {}
    try:
        payload = json.loads(STATE_FILE.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError):
        return {}
    outputs = payload.get("outputs", {})
    if not isinstance(outputs, dict):
        return {}
    return {
        str(name): {
            "mode": str(settings["mode"]),
            "scale": float(settings["scale"]),
        }
        for name, settings in outputs.items()
        if isinstance(settings, dict)
        and "mode" in settings
        and isinstance(settings.get("scale"), (int, float))
    }


def save_state(outputs: dict[str, dict[str, Any]]) -> None:
    temporary = STATE_FILE.with_suffix(".tmp")
    temporary.write_text(
        json.dumps({"outputs": outputs}, indent=2) + "\n", encoding="utf-8"
    )
    temporary.replace(STATE_FILE)


def activate() -> None:
    current = enabled_outputs()
    original = load_state()
    changed = False
    if not original:
        original = {
            str(output["name"]): {
                "mode": str(output["currentModeId"]),
                "scale": float(output["scale"]),
            }
            for output in current
        }
        save_state(original)
        changed = True
    for output in current:
        mode = target_mode(output)
        if (
            str(output["currentModeId"]) != mode
            or abs(float(output["scale"]) - TARGET_SCALE) > 0.01
        ):
            set_output(str(output["name"]), mode, TARGET_SCALE)
            changed = True
    if changed:
        log(
            f"activated KRDP display {TARGET_WIDTH}x{TARGET_HEIGHT} "
            f"at scale {TARGET_SCALE:g}"
        )


def deactivate() -> None:
    original = load_state()
    if not original:
        return
    current_names = {str(output["name"]) for output in enabled_outputs()}
    for name, settings in original.items():
        if name in current_names:
            set_output(name, str(settings["mode"]), float(settings["scale"]))
    STATE_FILE.unlink(missing_ok=True)
    log("restored physical display scale")


def status() -> None:
    outputs = ", ".join(
        f"{output['name']}=mode {output['currentModeId']} "
        f"at {float(output['scale']):g}"
        for output in enabled_outputs()
    )
    original = load_state()
    print(f"outputs: {outputs}; saved: {original or 'none'}")


def main() -> int:
    if len(sys.argv) != 2 or sys.argv[1] not in {
        "activate",
        "deactivate",
        "status",
    }:
        print("usage: krdp-display activate|deactivate|status", file=sys.stderr)
        return 2
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    try:
        with LOCK_FILE.open("w", encoding="utf-8") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            if sys.argv[1] == "activate":
                activate()
            elif sys.argv[1] == "deactivate":
                deactivate()
            else:
                status()
    except Exception as error:
        log(f"{sys.argv[1]} failed: {error}")
        print(f"krdp-display {sys.argv[1]} failed: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
