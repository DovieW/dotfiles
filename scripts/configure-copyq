#!/usr/bin/env bash
set -euo pipefail

mode="${1:---ensure}"
case "$mode" in
  --ensure|--check) ;;
  *) echo "usage: configure-copyq [--ensure|--check]" >&2; exit 2 ;;
esac

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
copyq_bin="${XDG_BIN_HOME:-$HOME/.local/bin}/copyq"
[[ -x "$copyq_bin" ]] || { echo "CopyQ is not installed." >&2; exit 1; }

wait_until_ready() {
  for _ in {1..40}; do
    if [[ "$(timeout 1s "$copyq_bin" eval 'print("ready")' 2>/dev/null || true)" == ready ]]; then
      return 0
    fi
    sleep 0.1
  done
  echo "CopyQ server did not become ready." >&2
  return 1
}

archive_root="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/archives/klipper"
archive_marker="$archive_root/.archived"
klipper_root="${XDG_DATA_HOME:-$HOME/.local/share}/klipper"
if [[ "$mode" == --ensure && ! -f "$archive_marker" ]]; then
  install -d -m 0700 "$archive_root"
  if [[ -d "$klipper_root" ]]; then
    archive_name="klipper-$(date -u +%Y%m%dT%H%M%SZ).tar.gz"
    tar -czf "$archive_root/$archive_name" -C "$(dirname "$klipper_root")" "$(basename "$klipper_root")"
    chmod 0600 "$archive_root/$archive_name"
  fi
  printf 'Klipper history was archived before CopyQ became authoritative.\n' >"$archive_marker"
fi

if [[ "$mode" == --check ]]; then
  "$copyq_bin" eval "config('maxitems') == 999 && config('clipboard_mime_size_limit') == '.*:100M' && config('disable_tray') && tab().indexOf('Clipboard') >= 0 && tab().indexOf('Emoji') < 0" |
    grep -qx true || { echo "CopyQ clipboard settings drifted." >&2; exit 1; }
  "$copyq_bin" eval "commands().some(function(c){return c.name == 'Dotfiles Wayland paste' && c.isScript})" |
    grep -qx true || { echo "CopyQ Wayland paste command is missing." >&2; exit 1; }
  "$copyq_bin" eval "commands().every(function(c){return c.name != 'Dotfiles Clipboard History'})" |
    grep -qx true || { echo "CopyQ still owns a global shortcut that belongs to KDE." >&2; exit 1; }
  "$copyq_bin" eval "global.dotfilesPasteVersion == 4 && global.paste === global.dotfilesPaste" |
    grep -qx true || { echo "CopyQ Wayland paste override is not loaded." >&2; exit 1; }
  "$copyq_bin" eval "var theme = new Settings(info('config')); print(theme.value('Theme/bg') == '#0d1117' && theme.value('Theme/fg') == '#e6edf3' && theme.value('Theme/sel_bg') == '#1f6feb' && theme.value('Theme/style_main_window') == 'true')" |
    grep -qx true || { echo "CopyQ GitHub Dark theme drifted." >&2; exit 1; }
  echo "CopyQ clipboard history, GitHub Dark theme, and Wayland paste integration are configured."
  exit 0
fi

"$copyq_bin" --start-server >/dev/null 2>&1 || true
wait_until_ready
"$copyq_bin" eval 'loadTheme(arguments[1])' "$root/config/copyq/github-dark.ini"
"$copyq_bin" eval - <"$root/config/copyq/configure.js"

echo "CopyQ clipboard history and GitHub Dark theme configured."
