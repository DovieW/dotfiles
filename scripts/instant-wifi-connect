#!/usr/bin/python3
"""Connect to a saved Wi-Fi network or paired Bluetooth device on demand."""
from contextlib import closing
import subprocess
import sys
from time import sleep

import dbus
from PyQt6.QtCore import Qt, QThread, pyqtSignal
from PyQt6.QtGui import QIcon
from PyQt6.QtWidgets import QApplication, QComboBox, QDialog, QLabel, QPushButton, QVBoxLayout

# Display name and NetworkManager profile UUID. Add more choices here.
NETWORKS = [
    ("green", "92e02a67-be0e-429f-ac16-9baf3c73f641"),
    ("Tangerine", "8e4e21e0-f283-4644-9f2c-c71c87a66c26"),
    ("Dovie's S25 Ultra", "220d09db-7f51-41a6-8dd9-ff74dd176efb"),
    ("lxx", "5548bd05-5c93-4d40-9801-a54c30f697f6"),
]
DEVICE = "org.bluez.Device1"
ADAPTER = "org.bluez.Adapter1"
A2DP_SINK = "0000110b-0000-1000-8000-00805f9b34fb"
RETRYABLE_CONNECTION_ERRORS = {
    "org.bluez.Error.Failed",
    "org.bluez.Error.ConnectionAttemptFailed",
    "org.bluez.Error.InProgress",
    "org.freedesktop.DBus.Error.NoReply",
}


def connect_wifi(progress, name, uuid):
    active = subprocess.run(
        ["nmcli", "-t", "-f", "UUID", "connection", "show", "--active"],
        capture_output=True, text=True, timeout=10,
    )
    if uuid in active.stdout.splitlines():
        return f"Already connected to {name}."
    progress(f"Scanning for {name}…")
    # A scan may be throttled or unavailable; connection activation can still succeed.
    subprocess.run(
        ["nmcli", "device", "wifi", "rescan"],
        capture_output=True, text=True, timeout=15,
    )
    progress(f"Connecting to {name}…")
    result = subprocess.run(
        ["nmcli", "--wait", "30", "connection", "up", "uuid", uuid],
        capture_output=True, text=True, timeout=40,
    )
    if result.returncode == 0:
        return f"Connected to {name}."
    return (
        f"Could not connect to {name}. Check that the hotspot is on, then retry."
        f"\n\n{result.stderr.strip()}"
    )


def bluez_objects(bus):
    root = bus.get_object("org.bluez", "/", introspect=False)
    return dbus.Interface(root, "org.freedesktop.DBus.ObjectManager").GetManagedObjects(timeout=5)


def list_bluetooth(progress):
    with closing(dbus.SystemBus(private=True)) as bus:
        objects = bluez_objects(bus)
    if not any(ADAPTER in interfaces for interfaces in objects.values()):
        return [], "No Bluetooth adapter found."

    devices = [
        (str(device["Alias"]), str(path))
        for path, interfaces in objects.items()
        if (device := interfaces.get(DEVICE)) and device.get("Paired")
    ]
    message = "Choose a paired device and select Force Connect." if devices else "No paired Bluetooth devices found."
    return sorted(devices, key=lambda item: item[0].casefold()), message


def try_bluetooth_connection(connect, properties):
    try:
        connect(timeout=18)
    except dbus.DBusException as error:
        if error.get_dbus_name() != "org.bluez.Error.AlreadyConnected":
            if error.get_dbus_name() not in RETRYABLE_CONNECTION_ERRORS:
                raise
            return error.get_dbus_message()
    if properties.Get(DEVICE, "Connected", timeout=5):
        return None
    return "The connection dropped."


def recover_bluetooth(progress, name, interface, properties, supports_stereo):
    first_error = try_bluetooth_connection(interface.Connect, properties)
    if first_error is None:
        return f"Connected to {name}."

    progress(f"Clearing the failed connection to {name}…")
    try:
        interface.Disconnect(timeout=8)
    except dbus.DBusException as error:
        if error.get_dbus_name() != "org.bluez.Error.NotConnected":
            return f"Could not reset the connection to {name}.\n\n{error.get_dbus_message()}"
    sleep(1)

    progress(f"Retrying {name}…")
    retry_error = try_bluetooth_connection(interface.Connect, properties)
    if retry_error is None:
        return f"Connected to {name} after retrying."

    details = [f"First attempt: {first_error}", f"Retry: {retry_error}"]
    if supports_stereo:
        progress(f"Trying stereo audio directly for {name}…")
        try:
            interface.ConnectProfile(A2DP_SINK, timeout=18)
            if properties.Get(DEVICE, "Connected", timeout=5):
                return f"Connected to {name} for stereo playback."
            details.append("Stereo audio: The connection dropped.")
        except dbus.DBusException as error:
            details.append(f"Stereo audio: {error.get_dbus_message()}")

    return f"Could not connect to {name}.\n\n" + "\n".join(details)


def connect_bluetooth(progress, name, path):
    progress(f"Connecting to {name}…")
    try:
        with closing(dbus.SystemBus(private=True)) as bus:
            objects = bluez_objects(bus)
            device = objects.get(path, {}).get(DEVICE, {})
            if not device.get("Paired"):
                return f"{name} is no longer available as a paired device. Select Refresh."
            if device.get("Connected"):
                return f"Already connected to {name}."
            adapter = objects.get(device["Adapter"], {}).get(ADAPTER, {})
            if not adapter.get("Powered"):
                return "Turn on Bluetooth in System Settings, then try again."

            proxy = bus.get_object("org.bluez", path, introspect=False)
            interface = dbus.Interface(proxy, DEVICE)
            properties = dbus.Interface(proxy, "org.freedesktop.DBus.Properties")
            return recover_bluetooth(progress, name, interface, properties, A2DP_SINK in device.get("UUIDs", ()))
    except dbus.DBusException as error:
        return f"Could not connect to {name}.\n\n{error.get_dbus_message()}"


class Worker(QThread):
    progress = pyqtSignal(str)
    result = pyqtSignal(object)
    failed = pyqtSignal(str)

    def __init__(self, operation, *args):
        super().__init__()
        self.operation = operation
        self.args = args

    def run(self):
        try:
            self.result.emit(self.operation(self.progress.emit, *self.args))
        except dbus.DBusException as error:
            self.failed.emit(f"Could not read Bluetooth devices.\n\n{error.get_dbus_message()}")
        except (OSError, subprocess.TimeoutExpired) as error:
            self.failed.emit(f"Connection attempt failed: {error}")


class Window(QDialog):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Instant Connect")
        self.setMinimumWidth(400)
        layout = QVBoxLayout(self)
        self.connection_type = QComboBox()
        self.connection_type.addItems(["Wi-Fi", "Bluetooth"])
        layout.addWidget(self.connection_type)
        self.target = QComboBox()
        layout.addWidget(self.target)
        self.status = QLabel()
        self.status.setTextFormat(Qt.TextFormat.PlainText)
        self.status.setWordWrap(True)
        layout.addWidget(self.status)
        self.button = QPushButton("Connect")
        self.button.clicked.connect(self.connect_target)
        layout.addWidget(self.button)
        self.refresh = QPushButton("Refresh devices")
        self.refresh.clicked.connect(self.load_bluetooth)
        layout.addWidget(self.refresh)
        self.worker = None
        self.connection_type.currentIndexChanged.connect(self.change_type)
        self.change_type()

    def change_type(self):
        self.target.clear()
        bluetooth = self.connection_type.currentText() == "Bluetooth"
        self.button.setText("Force Connect" if bluetooth else "Connect")
        self.refresh.setVisible(bluetooth)
        if bluetooth:
            self.load_bluetooth()
        else:
            self.set_targets((NETWORKS, "Choose a saved network and select Connect."))
            self.button.setEnabled(True)

    def set_targets(self, result):
        choices, message = result
        selected = self.target.currentData()
        self.target.clear()
        for name, identifier in choices:
            self.target.addItem(name, identifier)
        index = self.target.findData(selected)
        if index >= 0:
            self.target.setCurrentIndex(index)
        self.status.setText(message)

    def load_bluetooth(self):
        self.status.setText("Reading paired Bluetooth devices…")
        self.start_worker(list_bluetooth, self.set_targets)

    def connect_target(self):
        operation = connect_wifi if self.connection_type.currentText() == "Wi-Fi" else connect_bluetooth
        self.start_worker(operation, self.status.setText, self.target.currentText(), self.target.currentData())

    def start_worker(self, operation, callback, *args):
        for widget in (self.connection_type, self.target, self.button, self.refresh):
            widget.setEnabled(False)
        self.worker = Worker(operation, *args)
        self.worker.progress.connect(self.status.setText)
        self.worker.result.connect(callback)
        self.worker.failed.connect(self.status.setText)
        self.worker.finished.connect(self.connection_finished)
        self.worker.start()

    def connection_finished(self):
        self.connection_type.setEnabled(True)
        self.refresh.setEnabled(True)
        has_targets = self.target.count() > 0
        self.target.setEnabled(has_targets)
        self.button.setEnabled(has_targets)


if __name__ == "__main__":
    app = QApplication(sys.argv)
    app.setDesktopFileName("io.github.doview.instant-wifi-connect")
    app.setWindowIcon(QIcon.fromTheme("network-wireless"))
    window = Window()
    window.show()
    exit_code = app.exec()
    # The dialog can close immediately while the bounded operation finishes.
    if window.worker is not None:
        window.worker.wait()
    sys.exit(exit_code)
