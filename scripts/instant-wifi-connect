#!/usr/bin/python3
"""Connect to a saved Wi-Fi network or paired Bluetooth device on demand."""
from contextlib import closing
import http.client
import json
import os
from pathlib import Path
import subprocess
import sys
from time import sleep

import dbus
from PyQt6.QtCore import Qt, QThread, pyqtSignal
from PyQt6.QtGui import QIcon
from PyQt6.QtWidgets import (
    QApplication, QDialog, QGroupBox, QHBoxLayout, QLabel, QPushButton,
    QScrollArea, QVBoxLayout, QWidget,
)

# Display name and NetworkManager profile UUID. Add more choices here.
NETWORKS = [
    ("green", "92e02a67-be0e-429f-ac16-9baf3c73f641"),
    ("Tangerine", "8e4e21e0-f283-4644-9f2c-c71c87a66c26"),
    ("Dovie's S25 Ultra", "220d09db-7f51-41a6-8dd9-ff74dd176efb"),
    ("lxx", "5548bd05-5c93-4d40-9801-a54c30f697f6"),
]
DEVICE = "org.bluez.Device1"
ADAPTER = "org.bluez.Adapter1"
A2DP_SINK = "0000110b-0000-1000-8000-00805f9b34fb"
BUSY_ERRORS = {"br-connection-busy", "le-connection-busy", "Bluetooth connection in progress"}
RETRYABLE_CONNECTION_ERRORS = {
    "org.bluez.Error.Failed",
    "org.bluez.Error.ConnectionAttemptFailed",
    "org.freedesktop.DBus.Error.NoReply",
}


class PhoneHandoffError(Exception):
    pass


def connect_wifi(progress, name, uuid):
    active = subprocess.run(
        ["nmcli", "-t", "-f", "UUID", "connection", "show", "--active"],
        capture_output=True, text=True, timeout=10,
    )
    if uuid in active.stdout.splitlines():
        return f"Already connected to {name}."
    progress(f"Scanning for {name}…")
    # A scan may be throttled or unavailable; connection activation can still succeed.
    subprocess.run(
        ["nmcli", "device", "wifi", "rescan"],
        capture_output=True, text=True, timeout=15,
    )
    progress(f"Connecting to {name}…")
    result = subprocess.run(
        ["nmcli", "--wait", "30", "connection", "up", "uuid", uuid],
        capture_output=True, text=True, timeout=40,
    )
    if result.returncode == 0:
        return f"Connected to {name}."
    return (
        f"Could not connect to {name}. Check that the hotspot is on, then retry."
        f"\n\n{result.stderr.strip()}"
    )


def bluez_objects(bus):
    root = bus.get_object("org.bluez", "/", introspect=False)
    return dbus.Interface(root, "org.freedesktop.DBus.ObjectManager").GetManagedObjects(timeout=5)


def list_bluetooth(progress):
    with closing(dbus.SystemBus(private=True)) as bus:
        objects = bluez_objects(bus)
    if not any(ADAPTER in interfaces for interfaces in objects.values()):
        return [], "No Bluetooth adapter found."

    devices = [
        (str(device["Alias"]), str(path))
        for path, interfaces in objects.items()
        if (device := interfaces.get(DEVICE)) and device.get("Paired")
    ]
    message = "" if devices else "No paired Bluetooth devices found."
    return sorted(devices, key=lambda item: item[0].casefold()), message


def try_bluetooth_connection(connect, properties):
    try:
        connect(timeout=18)
    except dbus.DBusException as error:
        code = error.get_dbus_name()
        if code == "org.bluez.Error.InProgress":
            return "Bluetooth connection in progress"
        if code != "org.bluez.Error.AlreadyConnected":
            if code not in RETRYABLE_CONNECTION_ERRORS:
                raise
            return error.get_dbus_message()
    if properties.Get(DEVICE, "Connected", timeout=5):
        return None
    return "The connection dropped."


def reset_idle_adapter(bus, path):
    objects = bluez_objects(bus)
    interfaces = objects.get(path, {})
    adapter = interfaces.get(ADAPTER, {})
    advertising = interfaces.get("org.bluez.LEAdvertisingManager1", {})
    if not adapter.get("Powered") or adapter.get("Discovering") or adapter.get("Discoverable"):
        return False
    if advertising.get("ActiveInstances") or any(
        device.get("Adapter") == path and device.get("Connected")
        for interfaces in objects.values()
        if (device := interfaces.get(DEVICE))
    ):
        return False

    proxy = bus.get_object("org.bluez", path, introspect=False)
    properties = dbus.Interface(proxy, "org.freedesktop.DBus.Properties")
    properties.Set(ADAPTER, "Powered", dbus.Boolean(False), signature="ssv", timeout=5)
    properties.Set(ADAPTER, "Powered", dbus.Boolean(True), signature="ssv", timeout=8)
    return True


def recover_bluetooth(progress, name, interface, properties, supports_stereo, reset_adapter):
    first_error = try_bluetooth_connection(interface.Connect, properties)
    if first_error is None:
        return f"Connected to {name}."

    progress(f"Clearing the failed connection to {name}…")
    try:
        interface.Disconnect(timeout=8)
    except dbus.DBusException as error:
        if error.get_dbus_name() != "org.bluez.Error.NotConnected":
            return f"Could not reset the connection to {name}.\n\n{error.get_dbus_message()}"
    sleep(1)

    progress(f"Retrying {name}…")
    retry_error = try_bluetooth_connection(interface.Connect, properties)
    if retry_error is None:
        return f"Connected to {name} after retrying."

    details = [f"First attempt: {first_error}", f"Retry: {retry_error}"]
    if retry_error in BUSY_ERRORS:
        progress(f"Bluetooth is busy. Waiting briefly before retrying {name}…")
        sleep(2)
        retry_error = try_bluetooth_connection(interface.Connect, properties)
        if retry_error is None:
            return f"Connected to {name} after retrying."
        details.append(f"Delayed retry: {retry_error}")

    if retry_error in BUSY_ERRORS:
        progress("Checking whether the laptop Bluetooth adapter can be reset…")
        try:
            if reset_adapter():
                progress(f"Reconnecting to {name} after resetting the adapter…")
                retry_error = try_bluetooth_connection(interface.Connect, properties)
                if retry_error is None:
                    return f"Connected to {name} after resetting the laptop Bluetooth adapter."
                details.append(f"After adapter reset: {retry_error}")
            else:
                details.append("Adapter reset skipped because laptop Bluetooth was not idle.")
        except dbus.DBusException as error:
            details.append(f"Bluetooth recovery: {error.get_dbus_message()}")

    if supports_stereo:
        progress(f"Trying stereo audio directly for {name}…")
        try:
            interface.ConnectProfile(A2DP_SINK, timeout=18)
            if properties.Get(DEVICE, "Connected", timeout=5):
                return f"Connected to {name} for stereo playback."
            details.append("Stereo audio: The connection dropped.")
        except dbus.DBusException as error:
            details.append(f"Stereo audio: {error.get_dbus_message()}")

    message = f"Could not connect to {name}."
    if retry_error in BUSY_ERRORS and supports_stereo:
        message += " Bluetooth stayed busy. If your phone keeps reconnecting, turn Bluetooth off on it and tap the earbuds again."
    return message + "\n\n" + "\n".join(details)


def release_phone_earbuds(progress, address):
    config_dir = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")
    try:
        config = json.loads((config_dir / "instant-connect/phone-handoff.json").read_text())
        if not isinstance(config, dict) or not isinstance(config.get("device"), str):
            raise ValueError("Missing Bluetooth device address")
    except FileNotFoundError:
        return None
    except (OSError, ValueError):
        return "Could not read the phone handoff settings."

    if address.upper() != config["device"].upper():
        return None
    host, token = config.get("host"), config.get("token")
    if not isinstance(host, str) or not host.endswith(".ts.net") or not isinstance(token, str) or not token:
        return "The phone handoff needs a Tailscale hostname and a token."

    progress("Releasing the earbuds from your phone…")
    with closing(http.client.HTTPConnection(host, 7334, timeout=12)) as connection:
        try:
            connection.request("POST", "/7334", body=token.encode("ascii"),
                               headers={"Content-Type": "text/plain"})
            with connection.getresponse() as response:
                if response.status == 200:
                    state = response.read(64)
                    if state == b"false":
                        return None
                    if state == b"true":
                        return ("The earbuds are still connected to your phone. "
                                "Open their Bluetooth settings on your phone, tap Disconnect, then try again.")
                if response.status == 503:
                    return "Tasker timed out before it could confirm the earbuds were disconnected."
        except (OSError, ValueError, http.client.HTTPException):
            return "Could not confirm the earbuds were released by your phone. Check that Tasker is reachable."
    return "Tasker did not confirm that the phone released the earbuds."


def connect_bluetooth(progress, name, path, *, phone_handoff=True):
    progress(f"Connecting to {name}…")
    try:
        with closing(dbus.SystemBus(private=True)) as bus:
            objects = bluez_objects(bus)
            device = objects.get(path, {}).get(DEVICE, {})
            if not device.get("Paired"):
                return f"{name} is no longer available as a paired device. Select Refresh."
            if device.get("Connected"):
                return f"Already connected to {name}."
            adapter = objects.get(device["Adapter"], {}).get(ADAPTER, {})
            if not adapter.get("Powered"):
                return "Turn on Bluetooth in System Settings, then try again."

            if phone_handoff:
                handoff_error = release_phone_earbuds(progress, device["Address"])
                if handoff_error:
                    raise PhoneHandoffError(handoff_error)

            proxy = bus.get_object("org.bluez", path, introspect=False)
            interface = dbus.Interface(proxy, DEVICE)
            properties = dbus.Interface(proxy, "org.freedesktop.DBus.Properties")
            return recover_bluetooth(
                progress, name, interface, properties, A2DP_SINK in device.get("UUIDs", ()),
                lambda: reset_idle_adapter(bus, device["Adapter"]),
            )
    except dbus.DBusException as error:
        return f"Could not connect to {name}.\n\n{error.get_dbus_message()}"


def restart_bluetooth(progress, target):
    with closing(dbus.SystemBus(private=True)) as bus:
        connected = [
            str(device.get("Alias") or device["Address"])
            for interfaces in bluez_objects(bus).values()
            if (device := interfaces.get(DEVICE)) and device.get("Connected")
        ]
    if connected:
        return "Disconnect Bluetooth devices before restarting. Connected: " + ", ".join(sorted(connected))

    progress("Restarting laptop Bluetooth. Approve the desktop prompt if shown…")
    result = subprocess.run(
        ["/usr/bin/pkexec", "/usr/bin/systemctl", "restart", "bluetooth.service"],
        capture_output=True, text=True, timeout=45,
    )
    if result.returncode != 0:
        detail = result.stderr.strip()
        return "Could not restart laptop Bluetooth." + (f"\n\n{detail}" if detail else "")
    if target is None:
        return "Laptop Bluetooth restarted."
    name, path, phone_handoff = target
    return connect_bluetooth(progress, name, path, phone_handoff=phone_handoff)


class Worker(QThread):
    progress = pyqtSignal(str)
    result = pyqtSignal(object)
    failed = pyqtSignal(str)
    handoff_failed = pyqtSignal(str)

    def __init__(self, operation, *args):
        super().__init__()
        self.operation = operation
        self.args = args

    def run(self):
        try:
            self.result.emit(self.operation(self.progress.emit, *self.args))
        except PhoneHandoffError as error:
            self.handoff_failed.emit(str(error))
        except dbus.DBusException as error:
            self.failed.emit(f"Could not read Bluetooth devices.\n\n{error.get_dbus_message()}")
        except (OSError, subprocess.TimeoutExpired) as error:
            self.failed.emit(f"Connection attempt failed: {error}")


class Window(QDialog):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Instant Connect")
        self.resize(560, 380)
        layout = QVBoxLayout(self)
        layout.setContentsMargins(16, 16, 16, 16)
        layout.setSpacing(12)
        choices = QHBoxLayout()
        choices.setSpacing(12)
        layout.addLayout(choices, 1)
        self.wifi = QGroupBox("Wi-Fi")
        wifi = QVBoxLayout(self.wifi)
        wifi.setSpacing(8)
        for name, uuid in NETWORKS:
            wifi.addWidget(self.target_button(connect_wifi, name, uuid))
        wifi.addStretch()
        choices.addWidget(self.wifi, 1)

        self.bluetooth = QGroupBox("Bluetooth")
        bluetooth = QVBoxLayout(self.bluetooth)
        bluetooth.setSpacing(8)
        self.bluetooth_status = QLabel()
        self.bluetooth_status.setWordWrap(True)
        self.bluetooth_status.setTextFormat(Qt.TextFormat.PlainText)
        bluetooth.addWidget(self.bluetooth_status)
        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setFrameShape(QScrollArea.Shape.NoFrame)
        self.devices = QWidget()
        self.device_buttons = QVBoxLayout(self.devices)
        self.device_buttons.setContentsMargins(0, 0, 0, 0)
        self.device_buttons.setSpacing(8)
        self.device_buttons.addStretch()
        scroll.setWidget(self.devices)
        bluetooth.addWidget(scroll, 1)
        self.refresh = QPushButton("Refresh devices")
        self.refresh.setIcon(QIcon.fromTheme("view-refresh"))
        self.refresh.clicked.connect(self.load_bluetooth)
        bluetooth.addWidget(self.refresh)
        self.restart = QPushButton("Restart Bluetooth")
        self.restart.clicked.connect(self.restart_bluetooth_service)
        bluetooth.addWidget(self.restart)
        choices.addWidget(self.bluetooth, 1)

        self.status = QLabel()
        self.status.setTextFormat(Qt.TextFormat.PlainText)
        self.status.setWordWrap(True)
        self.status.setMargin(10)
        self.status.setStyleSheet("background-color: palette(alternate-base); border-radius: 6px;")
        self.status.setText("Click a network or device to connect.")
        layout.addWidget(self.status)
        self.retry_without_phone = QPushButton("Try laptop connection anyway")
        self.retry_without_phone.hide()
        self.retry_without_phone.clicked.connect(self.retry_bluetooth)
        layout.addWidget(self.retry_without_phone)
        self.bluetooth_target = None
        self.worker = None
        self.device_worker = None
        self.load_bluetooth()

    def target_button(self, operation, name, identifier):
        button = QPushButton(name.replace("&", "&&"))
        button.setMinimumHeight(38)
        button.setAutoDefault(False)
        button.clicked.connect(lambda: self.start_connection(operation, name, identifier))
        return button

    def set_devices(self, result):
        choices, message = result
        while self.device_buttons.count() > 1:
            self.device_buttons.takeAt(0).widget().deleteLater()
        for name, identifier in choices:
            self.device_buttons.insertWidget(self.device_buttons.count() - 1,
                                             self.target_button(connect_bluetooth, name, identifier))
        self.show_bluetooth_status(message)

    def show_bluetooth_status(self, message):
        self.bluetooth_status.setText(message)
        self.bluetooth_status.setVisible(bool(message))

    def load_bluetooth(self):
        self.devices.setEnabled(False)
        self.refresh.setEnabled(False)
        self.show_bluetooth_status("Reading paired devices…")
        self.device_worker = Worker(list_bluetooth)
        self.device_worker.result.connect(self.set_devices)
        self.device_worker.failed.connect(self.show_bluetooth_status)
        self.device_worker.finished.connect(self.device_list_finished)
        self.device_worker.start()

    def device_list_finished(self):
        self.devices.setEnabled(True)
        self.refresh.setEnabled(True)

    def start_connection(self, operation, name, identifier):
        if operation is connect_bluetooth:
            self.bluetooth_target = (name, identifier, True)
        self.start_worker(operation, f"Connecting to {name}…", name, identifier)

    def start_worker(self, operation, message, *args):
        self.retry_without_phone.hide()
        self.retry_without_phone.setEnabled(False)
        self.wifi.setEnabled(False)
        self.bluetooth.setEnabled(False)
        self.status.setText(message)
        self.worker = Worker(operation, *args)
        self.worker.progress.connect(self.status.setText)
        self.worker.result.connect(self.status.setText)
        self.worker.failed.connect(self.status.setText)
        self.worker.handoff_failed.connect(self.show_handoff_failure)
        self.worker.finished.connect(self.connection_finished)
        self.worker.start()

    def show_handoff_failure(self, message):
        self.status.setText(message)
        self.retry_without_phone.show()

    def retry_bluetooth(self):
        if self.bluetooth_target is not None:
            name, identifier, _ = self.bluetooth_target
            self.bluetooth_target = (name, identifier, False)
            self.start_worker(
                lambda progress, label, path: connect_bluetooth(progress, label, path, phone_handoff=False),
                f"Connecting to {name}…",
                name, identifier,
            )

    def restart_bluetooth_service(self):
        self.start_worker(restart_bluetooth, "Checking connected Bluetooth devices…", self.bluetooth_target)

    def connection_finished(self):
        self.wifi.setEnabled(True)
        self.bluetooth.setEnabled(True)
        self.retry_without_phone.setEnabled(True)


if __name__ == "__main__":
    app = QApplication(sys.argv)
    app.setDesktopFileName("io.github.doview.instant-wifi-connect")
    app.setWindowIcon(QIcon.fromTheme("network-wireless"))
    window = Window()
    window.show()
    exit_code = app.exec()
    # The dialog can close immediately while the bounded operation finishes.
    for worker in (window.worker, window.device_worker):
        if worker is not None:
            worker.wait()
    sys.exit(exit_code)
