#!/usr/bin/env python3
"""Fail closed while scanning every outgoing Git ref with Gitleaks."""
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]


def git(*args):
    return subprocess.run(["git", *args], check=True, capture_output=True, text=True)


def scan_ranges(lines):
    ranges = set()
    for line in lines:
        fields = line.split()
        if len(fields) != 4:
            raise ValueError("invalid pre-push ref input")
        _, local_oid, _, remote_oid = fields
        for oid in (local_oid, remote_oid):
            if not re.fullmatch(r"(?:[0-9a-f]{40}|[0-9a-f]{64})", oid):
                raise ValueError("invalid Git object ID")
        if set(local_oid) == {"0"}:
            continue  # Ref deletion sends no objects.
        # Annotated tags are peeled; a tag pointing at a blob cannot be scanned
        # as commit history, so it blocks rather than silently passing.
        local_commit = git("rev-parse", "--verify", local_oid + "^{commit}").stdout.strip()
        revision = local_commit
        if set(remote_oid) != {"0"}:
            try:
                old = git("rev-parse", "--verify", remote_oid + "^{commit}").stdout.strip()
                revision = f"{old}..{local_commit}"
            except subprocess.CalledProcessError:
                pass  # Unknown remote base: scan all reachable local history.
        ranges.add(revision)
    return sorted(ranges)


def main():
    try:
        lines = list(sys.stdin)
        ranges = scan_ranges(lines)
        if not ranges:
            return 0
        scanner = shutil.which("gitleaks")
        if scanner is None:
            brew_scanner = Path("/home/linuxbrew/.linuxbrew/bin/gitleaks")
            if brew_scanner.is_file() and os.access(brew_scanner, os.X_OK):
                scanner = str(brew_scanner)
        if scanner is None:
            raise ValueError("Gitleaks is required; install it with `brew install gitleaks`")
        print("Scanning outgoing commits for secrets before push...", file=sys.stderr)
        common = [scanner, "--redact", "--no-banner", "--verbose",
                  "--ignore-gitleaks-allow", "--gitleaks-ignore-path", os.devnull,
                  "--config", str(ROOT / ".gitleaks.toml")]

        def scan(command, content=None):
            result = subprocess.run(command, input=content, text=True)
            if result.returncode:
                raise ValueError("Gitleaks found a secret or could not complete its scan")

        for revision in ranges:
            scan([*common, "git", "--log-opts", f"--full-history -m {revision}", "."])
            # Patch scanning alone does not cover credentials in commit messages.
            messages = git("log", "--format=%B", revision).stdout
            scan([*common, "stdin"], messages)
        for line in lines:
            oid = line.split()[1]
            if set(oid) == {"0"}:
                continue
            # Scan annotations too, including nested annotated tags.
            while git("cat-file", "-t", oid).stdout.strip() == "tag":
                annotation = git("cat-file", "-p", oid).stdout
                scan([*common, "stdin"], annotation)
                oid = annotation.splitlines()[0].split()[1]
        return 0
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        # Git failures may contain file contents; report only the error category.
        detail = str(error) if isinstance(error, ValueError) else type(error).__name__
        print(f"Push blocked: {detail}. No refs were updated.\n"
              "Remove credentials from every outgoing commit, then retry.", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
