#!/usr/bin/env bash
set -euo pipefail

mode="${1:---ensure}"
case "$mode" in
  --ensure|--check) ;;
  *) echo "usage: install-copyq [--ensure|--check]" >&2; exit 2 ;;
esac

api="https://api.github.com/repos/hluk/CopyQ/releases/latest"
app_root="${XDG_DATA_HOME:-$HOME/.local/share}/dotfiles/apps/copyq"
bin_dir="${XDG_BIN_HOME:-$HOME/.local/bin}"
marker="$app_root/current-release"

release_json="$(curl --proto '=https' --tlsv1.2 -fsSL "$api")"
readarray -t resolved < <(python3 -c '
import json, sys
d=json.load(sys.stdin)
tag=d.get("tag_name", "")
assets={a["name"]:a["browser_download_url"] for a in d.get("assets", [])}
version=tag.removeprefix("v")
name=f"CopyQ-{version}-x86_64.AppImage"
print(tag)
print(name)
print(assets.get(name, ""))
print(assets.get("checksums-sha512.txt", ""))
' <<<"$release_json")
release="${resolved[0]:-}"
asset_name="${resolved[1]:-}"
asset_url="${resolved[2]:-}"
checksums_url="${resolved[3]:-}"

if [[ ! "$release" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] ||
   [[ -z "$asset_url" || -z "$checksums_url" ]]; then
  echo "CopyQ: latest stable Linux release assets could not be resolved." >&2
  exit 1
fi

release_dir="$app_root/releases/$release"
image="$release_dir/$asset_name"
app_dir="$release_dir/app"
app_run="$app_dir/AppRun"
installed=""
[[ -f "$marker" ]] && installed="$(<"$marker")"

install_wrapper() {
  local wrapper
  wrapper="$(mktemp "$bin_dir/.copyq-wrapper.XXXXXX")"
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'set -euo pipefail' \
    'export QT_QPA_PLATFORM=wayland' \
    'export COPYQ_CLIPBOARD_MIME_SIZE_LIMIT="image/.*:0;application/x-qt-image:0;.*:100M"' \
    "export APPDIR=\"$app_dir\"" \
    "exec \"$app_run\" \"\$@\"" >"$wrapper"
  chmod 0755 "$wrapper"
  mv -f -- "$wrapper" "$bin_dir/copyq"
}

runtime_ready=false
if [[ "$installed" == "$release" && -x "$image" && -x "$app_run" ]]; then
  runtime_ready=true
fi
wrapper_ready=false
if [[ -x "$bin_dir/copyq" && ! -L "$bin_dir/copyq" ]] &&
   grep -Fqx -- "export APPDIR=\"$app_dir\"" "$bin_dir/copyq" &&
   grep -Fqx -- "export COPYQ_CLIPBOARD_MIME_SIZE_LIMIT=\"image/.*:0;application/x-qt-image:0;.*:100M\"" "$bin_dir/copyq" &&
   grep -Fq -- "$app_run" "$bin_dir/copyq"; then
  wrapper_ready=true
fi
if [[ "$runtime_ready" == true && "$wrapper_ready" == true ]]; then
  echo "CopyQ $release is installed from the official stable channel."
  exit 0
fi
if [[ "$runtime_ready" == true && "$mode" == --ensure ]]; then
  install -d -m 0755 "$bin_dir"
  install_wrapper
  echo "CHANGED CopyQ $release launcher updated."
  exit 0
fi
if [[ "$mode" == --check ]]; then
  echo "CopyQ requires update: ${installed:-missing} -> $release" >&2
  exit 1
fi

work_dir="$(mktemp -d)"
trap 'rm -rf -- "$work_dir"' EXIT
curl --proto '=https' --tlsv1.2 -fsSL "$checksums_url" -o "$work_dir/checksums-sha512.txt"
expected="$(awk -v n="$asset_name" '$2 == n || $2 == "*" n {print $1; exit}' "$work_dir/checksums-sha512.txt")"
if [[ ! "$expected" =~ ^[[:xdigit:]]{128}$ ]]; then
  echo "CopyQ: official SHA-512 entry is missing or malformed." >&2
  exit 1
fi
source_image="$image"
if [[ ! -f "$source_image" ]] ||
   ! printf '%s  %s\n' "$expected" "$source_image" | sha512sum --check --status; then
  source_image="$work_dir/$asset_name"
  curl --proto '=https' --tlsv1.2 -fsSL "$asset_url" -o "$source_image"
  printf '%s  %s\n' "$expected" "$source_image" | sha512sum --check --status
fi

# CopyQ keeps its server and clipboard monitor alive after the launcher exits.
# An AppImage FUSE mount can disappear while those processes still use its
# executable and plugins, causing SIGBUS crashes. Keep the verified image for
# updates, but execute CopyQ from a persistent extracted release directory.
(
  cd -- "$work_dir"
  "$source_image" --appimage-extract >/dev/null
)
[[ -x "$work_dir/squashfs-root/AppRun" ]] || {
  echo "CopyQ: extracted AppImage does not contain an executable AppRun." >&2
  exit 1
}

install -d -m 0755 "$release_dir" "$bin_dir"
if [[ "$source_image" != "$image" ]]; then
  install -m 0755 "$source_image" "$image"
fi
rm -rf -- "$app_dir"
mv -- "$work_dir/squashfs-root" "$app_dir"
install_wrapper
printf '%s\n' "$release" >"$marker"
echo "CHANGED CopyQ $release installed from the official stable channel."
