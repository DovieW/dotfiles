#!/usr/bin/env bash
set -euo pipefail

mode="${1:---ensure}"
case "$mode" in
  --ensure|--check) ;;
  *) echo "usage: install-emoji-picker [--ensure|--check]" >&2; exit 2 ;;
esac

repo="https://github.com/jockel09/emoji-picker.git"
api="https://api.github.com/repos/jockel09/emoji-picker/releases/latest"
app_root="${XDG_DATA_HOME:-$HOME/.local/share}/dotfiles/apps/emoji-picker"
bin_dir="${XDG_BIN_HOME:-$HOME/.local/bin}"
marker="$app_root/current-release"

release="$(
  curl --proto '=https' --tlsv1.2 -fsSL "$api" |
    python3 -c 'import json,sys; print(json.load(sys.stdin).get("tag_name", ""))'
)"
if [[ ! "$release" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "Emoji Picker: latest stable release could not be resolved." >&2
  exit 1
fi

target="$app_root/releases/$release"
installed=""
[[ -f "$marker" ]] && installed="$(<"$marker")"
if [[ "$installed" == "$release" && -f "$target/emoji_picker.py" &&
      -x "$bin_dir/emoji-picker" ]] &&
   grep -q 'readlink -f.*BASH_SOURCE' "$target/emoji-picker" &&
   grep -q 'linuxbrew/.linuxbrew/bin' "$target/emoji-picker" &&
   grep -q 'exec /usr/bin/python3' "$target/emoji-picker"; then
  echo "Emoji Picker $release is installed from the official stable channel."
  exit 0
fi
if [[ "$mode" == --check ]]; then
  echo "Emoji Picker requires update: ${installed:-missing} -> $release" >&2
  exit 1
fi

work_dir="$(mktemp -d)"
trap 'rm -rf -- "$work_dir"' EXIT
git -c advice.detachedHead=false clone --quiet --depth 1 --branch "$release" "$repo" "$work_dir/repo"

install -d -m 0755 "$target/locales" "$bin_dir"
for name in emoji_picker.py emoji_data.py search_tags.py LICENSE; do
  install -m 0644 "$work_dir/repo/$name" "$target/$name"
done
for locale in "$work_dir/repo"/locales/*.json; do
  install -m 0644 "$locale" "$target/locales/$(basename "$locale")"
done

launcher="$target/emoji-picker"
# The following strings intentionally become the generated launcher's shell code.
# shellcheck disable=SC2016
printf '%s\n' \
  '#!/usr/bin/env bash' \
  'set -euo pipefail' \
  'if [[ -d /home/linuxbrew/.linuxbrew/bin ]]; then export PATH="/home/linuxbrew/.linuxbrew/bin:$PATH"; fi' \
  'app_dir="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"' \
  'cd "$app_dir"' \
  'exec /usr/bin/python3 emoji_picker.py "$@"' >"$launcher"
chmod 0755 "$launcher"
ln -sfn "$launcher" "$bin_dir/emoji-picker"
printf '%s\n' "$release" >"$marker"

echo "Emoji Picker $release installed from the official stable channel."
