#!/usr/bin/env bash
set -euo pipefail

capture="$(mktemp --suffix=.png)"
cleanup() {
    if [[ -e "$capture" ]]; then
        unlink "$capture"
    fi
}
trap cleanup EXIT

QT_QPA_PLATFORM=wayland spectacle \
    --activewindow \
    --background \
    --nonotify \
    --output "$capture"

[[ -s "$capture" ]] || {
    printf 'Active-window capture did not produce an image.\n' >&2
    exit 1
}

wl-copy --foreground --type image/png < "$capture" &
clipboard_owner=$!

# wl-copy has the image open now, so the temporary pathname is no longer needed.
unlink "$capture"
trap - EXIT

# Keep the Wayland clipboard owner alive until another application replaces it.
wait "$clipboard_owner"
