#!/usr/bin/python3
"""Save the current or newest CopyQ clipboard image in /tmp and type its path."""

import argparse
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import time


def run(args, **kwargs):
    return subprocess.run(args, check=True, timeout=10, **kwargs)


def check():
    if not os.environ.get("WAYLAND_DISPLAY"):
        raise RuntimeError("A Wayland desktop session is required.")
    run(["/usr/bin/systemctl", "--user", "is-active", "--quiet", "ydotool.service"])
    socket = Path(os.environ.get("YDOTOOL_SOCKET", os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}") + "/.ydotool_socket"))
    if not socket.is_socket() or not os.access("/dev/uinput", os.W_OK):
        raise RuntimeError("The managed ydotool socket and uinput access are required.")
    run(["wl-paste", "--version"], stdout=subprocess.DEVNULL)


# Evaluate via stdin: CopyQ interprets backslash escapes in CLI arguments.
# Read bytes directly without selecting an item or changing the clipboard/UI.
COPYQ_IMAGE_SCRIPT = r"""
if (tab().indexOf("Clipboard") < 0) fail();
tab("Clipboard");
var found = false;
for (var row = 0; row < size() && !found; ++row) {
    var formats = str(read("?", row)).split("\n");
    var images = formats.filter(function(mime) { return mime.indexOf("image/") === 0; });
    if (!images.length) continue;
    var mime = images.indexOf("image/png") >= 0 ? "image/png" : images[0];
    print(read(mime, row));
    found = true;
}
if (!found) fail();
"""


def read_image_data():
    try:
        types = run(["wl-paste", "--list-types"], capture_output=True).stdout.decode().splitlines()
        mime = next((item for item in ["image/png", *types] if item in types and item.startswith("image/")), None)
        if mime is not None:
            return run(["wl-paste", "--no-newline", "--type", mime], capture_output=True).stdout
    except (OSError, subprocess.SubprocessError):
        # Empty/unavailable live clipboards must not prevent reading history.
        pass
    copyq = Path(os.environ.get("XDG_BIN_HOME", Path.home() / ".local/bin")) / "copyq"
    try:
        return run([str(copyq), "eval", "-"], input=COPYQ_IMAGE_SCRIPT.encode(), capture_output=True).stdout
    except (OSError, subprocess.SubprocessError) as error:
        raise RuntimeError("No clipboard image is available; CopyQ history has no image or is unavailable.") from error


def save_image():
    data = read_image_data()
    from PyQt6.QtGui import QImage

    image = QImage.fromData(data)
    if image.isNull():
        raise RuntimeError("The clipboard image could not be decoded.")
    # Never trust clipboard filenames. mkstemp creates a private, unique file.
    fd, name = tempfile.mkstemp(prefix="dot-image-", suffix=".png", dir="/tmp")
    os.close(fd)
    path = Path(name)
    try:
        if not image.save(str(path), "PNG"):
            raise RuntimeError("Could not save the clipboard image.")
    except Exception:
        path.unlink(missing_ok=True)
        raise
    return path


def wait_for_modifiers(read_held, process_events, timeout=10):
    """Wait for a stable release, allowing Wayland's initial state to arrive."""
    deadline = time.monotonic() + timeout
    clear_since = None
    while time.monotonic() < deadline:
        process_events()
        if read_held():
            clear_since = None
        elif clear_since is None:
            clear_since = time.monotonic()
        elif time.monotonic() - clear_since >= 0.35:
            return
        time.sleep(0.02)
    raise RuntimeError("Release the shortcut modifiers before pasting.")


def wait_for_desktop_release():
    # KDE's Wayland key-state provider observes physical modifiers across
    # devices. Releasing ydotool's virtual keys cannot release physical keys.
    from PyQt6.QtCore import QUrl
    from PyQt6.QtGui import QGuiApplication
    from PyQt6.QtQml import QQmlComponent, QQmlEngine

    app = QGuiApplication.instance() or QGuiApplication([])
    engine = QQmlEngine()
    component = QQmlComponent(engine)
    component.setData(b"""
import QtQuick
import org.kde.plasma.private.keyboardindicator as KI
QtObject {
    property KI.KeyState meta: KI.KeyState { key: Qt.Key_Meta }
    property KI.KeyState shift: KI.KeyState { key: Qt.Key_Shift }
    property KI.KeyState ctrl: KI.KeyState { key: Qt.Key_Control }
    property KI.KeyState alt: KI.KeyState { key: Qt.Key_Alt }
    property KI.KeyState altgr: KI.KeyState { key: Qt.Key_AltGr }
    property bool held: meta.pressed || meta.latched || shift.pressed || shift.latched
                        || ctrl.pressed || ctrl.latched || alt.pressed || alt.latched
                        || altgr.pressed || altgr.latched
}
""", QUrl())
    state = component.create()
    if state is None:
        raise RuntimeError("KDE modifier-state monitoring is unavailable; refusing to type.")
    wait_for_modifiers(lambda: state.property("held"), app.processEvents)
    # Destroy QML objects before their engine and application.
    from PyQt6 import sip
    sip.delete(state)
    sip.delete(component)
    sip.delete(engine)


def paste_path(path):
    wait_for_desktop_release()
    # No synthetic modifier releases, clipboard replacement, or Enter.
    run(["/usr/bin/ydotool", "type", "--key-delay=5", "--key-hold=5", "--", str(path) + " "], stdout=subprocess.DEVNULL)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true", help="Check readiness without saving or typing")
    args = parser.parse_args()
    try:
        check()
        if args.check:
            print("Image-path paste is ready.")
            return 0
        paste_path(save_image())
        return 0
    except (RuntimeError, OSError, subprocess.SubprocessError) as error:
        # Do not put clipboard contents or subprocess output in desktop notices.
        print(f"Image-path paste failed: {type(error).__name__}: {error}", file=sys.stderr)
        subprocess.run(["notify-send", "--app-name=Image Path Paste", "Image Path Paste", "Could not insert an image path. Check the clipboard image and dot-paste-image-path service log."], check=False)
        return 1


if __name__ == "__main__":
    sys.exit(main())
