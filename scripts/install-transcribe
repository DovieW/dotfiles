#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SOURCE="$ROOT/config/transcription"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
INSTALL_ROOT="$DATA_HOME/dotfiles/transcribe"
CURRENT="$INSTALL_ROOT/current/transcribe"
BIN_HOME="${XDG_BIN_HOME:-$HOME/.local/bin}"

usage() {
  printf 'Usage: install-transcribe --install|--update|--check\n'
}

source_hash() {
  find "$SOURCE/src" "$SOURCE/tests" -type f -print0 \
    | sort -z \
    | xargs -0 sha256sum
  sha256sum "$SOURCE/package.json" "$SOURCE/package-lock.json" \
    "$SOURCE/tsconfig.json" "$SOURCE/build.ts"
}

expected_hash() {
  source_hash | sha256sum | cut -d' ' -f1
}

check_install() {
  local wanted installed=""
  wanted="$(expected_hash)"
  [[ -f "$INSTALL_ROOT/source-hash" ]] && installed="$(<"$INSTALL_ROOT/source-hash")"
  if [[ -x "$CURRENT" && "$installed" == "$wanted" ]] \
    && "$CURRENT" version | grep -qx 'transcribe 2.0.0'; then
    printf 'transcribe 2.0.0 standalone executable is current\n'
    return 0
  fi
  printf 'transcribe is missing or stale; run dot transcribe install\n' >&2
  return 1
}

install_app() {
  local npm_path release hash temp_link
  npm_path="$(command -v npm || true)"
  if [[ -z "$npm_path" && -x "$HOME/.vite-plus/bin/npm" ]]; then
    npm_path="$HOME/.vite-plus/bin/npm"
  fi
  [[ -n "$npm_path" ]] || {
    printf 'npm is required to build transcribe. Run dot vite-plus install first.\n' >&2
    return 1
  }
  hash="$(expected_hash)"
  release="$INSTALL_ROOT/releases/$hash"
  if [[ ! -x "$release/transcribe" ]]; then
    "$npm_path" ci --no-audit --no-fund --prefix "$SOURCE"
    "$SOURCE/node_modules/.bin/bun" run --cwd "$SOURCE" build
    mkdir -p "$release"
    install -m 0755 "$SOURCE/dist/transcribe" "$release/transcribe"
  fi
  mkdir -p "$INSTALL_ROOT" "$BIN_HOME"
  ln -sfn "$release" "$INSTALL_ROOT/current"
  printf '%s\n' "$hash" > "$INSTALL_ROOT/source-hash"
  chmod 0600 "$INSTALL_ROOT/source-hash"
  temp_link="$BIN_HOME/.transcribe-link-$$"
  ln -s "$CURRENT" "$temp_link"
  mv -Tf "$temp_link" "$BIN_HOME/transcribe"
  printf 'Installed transcribe 2.0.0 to %s\n' "$CURRENT"
}

case "${1:-}" in
  --check) check_install ;;
  --install|--update) install_app ;;
  *) usage; exit 2 ;;
esac
