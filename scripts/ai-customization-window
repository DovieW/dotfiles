    def instructions_panel(self):
        panel = QWidget()
        layout = QVBoxLayout(panel)
        self.instructions_context = QPushButton("Context size · —")
        self.instructions_context.setToolTip("Measure the effective instructions for a fresh Codex session.")
        self.instructions_context.clicked.connect(self.show_instruction_context)
        layout.addWidget(self.instructions_context, alignment=Qt.AlignmentFlag.AlignRight)
        layout.addWidget(self.instructions, 1)
        return panel

    def measure_context(self):
        if not self.data or self.context_process.state() != QProcess.ProcessState.NotRunning:
            return
        dialog = QDialog(self)
        dialog.setWindowTitle("Measure context")
        dialog.resize(590, 190)
        remote, project_path, model_name = self.context_options
        host = ComboBox()
        host.addItems(["This computer", "Other computer"])
        host.setCurrentIndex(int(remote))
        project = QLineEdit(project_path)
        browse = QPushButton("Browse…")
        def choose_project():
            selected = QFileDialog.getExistingDirectory(dialog, "Choose a Codex working directory", project.text())
            if selected:
                project.setText(selected)
        browse.clicked.connect(choose_project)
        model = QLineEdit(model_name)
        model.setPlaceholderText("Configured model")
        buttons = QDialogButtonBox(QDialogButtonBox.StandardButton.Ok | QDialogButtonBox.StandardButton.Cancel)
        buttons.button(QDialogButtonBox.StandardButton.Ok).setText("Measure")
        buttons.accepted.connect(dialog.accept)
        buttons.rejected.connect(dialog.reject)
        layout = QVBoxLayout(dialog)
        for label, widgets in (("Computer", (host,)), ("Project folder", (project, browse)), ("Model", (model,))):
            row = QHBoxLayout()
            row.addWidget(QLabel(label))
            for widget in widgets:
                row.addWidget(widget, 1 if isinstance(widget, QLineEdit) else 0)
            layout.addLayout(row)
        layout.addWidget(buttons)
        if dialog.exec() != QDialog.DialogCode.Accepted:
            return
        remote, project_path, model_name = host.currentIndex() == 1, project.text().strip(), model.text().strip()
        self.context_options = (remote, project_path, model_name)
        self.start_context()

    def maybe_measure_context(self):
        title = self.active_table()
        if (self.data and self.isEnabled() and not self.context_started
                and self.context_process.state() == QProcess.ProcessState.NotRunning
                and (title == "Instructions" or title in INTEGRATION_GROUPS and title != "Hooks")):
            self.start_context()

    def start_context(self):
        remote, project_path, model_name = self.context_options
        self.context_started = True
        self.context_button.setEnabled(False)
        self.context_button.setText("Measuring context…")
        if not self.context_result:
            self.instructions_context.setText("Measuring context…")
            self.refresh_context_cells()
        args = ["context-sizes", "--project", project_path]
        if model_name:
            args.extend(["--model", model_name])
        if remote:
            args.append("--with-peer")
        self.context_process.start(str(BACKEND), args)

    def context_error(self, _error):
        if self.context_process.state() == QProcess.ProcessState.NotRunning:
            if self.context_invalidated:
                self.context_invalidated = False
                self.context_button.setEnabled(True)
                self.context_button.setText("Measure context…")
                self.maybe_measure_context()
                return
            self.context_failure("Could not start the context measurement.")

    def context_failure(self, message):
        self.context_button.setEnabled(True)
        self.context_button.setText("Measure context…")
        self.info.setText(message)
        if not self.context_result:
            self.instructions_context.setText("Context size · Unavailable")
            self.refresh_context_cells()

    def context_finished(self, code, _status):
        self.context_button.setEnabled(True)
        self.context_button.setText("Measure context…")
        output = bytes(self.context_process.readAllStandardOutput())
        error = bytes(self.context_process.readAllStandardError()).decode(errors="replace").strip()
        if self.context_invalidated:
            self.context_invalidated = False
            self.maybe_measure_context()
            return
        if code:
            self.context_failure(error or "Context measurement failed.")
            return
        try:
            self.context_result = json.loads(output)
        except ValueError:
            self.context_failure("Codex returned an invalid context measurement.")
            return
        self.refresh_context_cells()
        self.instructions_context.setText(f"Context size · {self.token_text(self.instruction_count().get('upfront'))}")
        self.instructions_context.setToolTip(self.context_details(self.instruction_count()))
        self.context_button.setToolTip(self.context_label())
        self.info.setText(f"Context estimates from {HOST_LABELS[self.context_result['profile']]} · {self.context_result['model']}")

    def refresh_context_cells(self):
        for title in INTEGRATION_GROUPS:
            table = self.tables[title]
            for row in range(table.rowCount()):
                self.set_context_cell(title, row)
            self.restore_context_order(table)

    def instruction_count(self):
        return next((row for row in self.context_result.get("rows", []) if row["kind"] == "Instructions"), {})

    def show_instruction_context(self):
        if not self.context_result:
            if self.context_process.state() == QProcess.ProcessState.NotRunning:
                self.measure_context()
            return
        self.detail_dialog("Context size", "Effective instructions", self.context_details(self.instruction_count()))

    @staticmethod
    def token_text(count, partial=False):
        return ("At least " if partial else "") + f"{count:,} tokens" if count is not None else "Unavailable"

    def context_label(self):
        result = self.context_result
        if not result:
            if self.context_started and not self.context_button.isEnabled():
                return "Measuring the saved context for a fresh Codex session."
            return "Measure saved settings for a fresh Codex session."
        encoding = result["encoding"] + (" (fallback)" if result["fallback"] else "")
        return f"{HOST_LABELS[result['profile']]} · {result['model']} · {encoding}\n{result['project']}"

    def context_details(self, record):
        if not self.context_result:
            return self.context_label()
        parts = [self.context_label()]
        for key, label in (("upfront", "Upfront"), ("full", "Fully loaded")):
            parts.append(f"{label} · {self.token_text(record.get(key), record.get(key + '_partial', False))}")
        if record.get("references") is not None:
            parts.append(f"References · {self.token_text(record['references'])}")
        if record.get("detail"):
            parts.append(record["detail"])
        parts.extend(self.context_result["notes"])
        return "\n\n".join(parts)

    def integration_columns(self, title, labels, widths):
        table = self.tables[title]
        table.clearContents()
        if table.columnCount() == len(labels) + 2:
            return
        table.setColumnCount(len(labels) + 2)
        table.setHorizontalHeaderLabels([*labels, "Description", "Context size"])
        table.setWordWrap(False)
        table.setTextElideMode(Qt.TextElideMode.ElideRight)
        header = table.horizontalHeader()
        heading = table.horizontalHeaderItem(len(labels) + 1)
        heading.setToolTip("Estimated tokens · upfront / fully loaded")
        header.setStretchLastSection(False)
        header.setSectionResizeMode(len(labels), QHeaderView.ResizeMode.Stretch)
        for column, width in enumerate(widths):
            header.resizeSection(column, width)
        header.resizeSection(len(labels) + 1, 120)

    def set_integration_description(self, title, row, text, url=None):
        table = self.tables[title]
        item = self.cell(" ".join(text.split()) if text else "—")
        details = text or "No description is available from the integration’s metadata."
        item.setToolTip(f"<p>{escape(details).replace(chr(10), '<br>')}</p>")
        item.setData(Qt.ItemDataRole.UserRole, {"text": details, "url": url})
        table.setItem(row, table.columnCount() - 2, item)

    def set_context_cell(self, title, row):
        table = self.tables[title]
        name = table.item(row, 0)
        if title == "Hooks":
            detail = "Hook output can contribute context at runtime. The size depends on what the handler returns."
            item = TokenCount({}, "Varies")
        else:
            key = name.data(Qt.ItemDataRole.UserRole) or name.text()
            record = self.context_result.get("tables", {}).get(INTEGRATION_GROUPS[title], {}).get(key) or {}
            detail = self.context_details(record)
            measuring = not self.context_result and not self.context_button.isEnabled() and self.context_started
            item = TokenCount(record, "…" if measuring else None)
        item.setToolTip(f"<p>{escape(detail).replace(chr(10), '<br>')}</p>")
        item.setData(Qt.ItemDataRole.UserRole, detail)
        table.setItem(row, table.columnCount() - 1, item)

    def show_integration_detail(self, title, row, column):
        table = self.tables[title]
        if column not in (table.columnCount() - 2, table.columnCount() - 1):
            return
        key = table.item(row, 0).text()
        data = table.item(row, column).data(Qt.ItemDataRole.UserRole)
        if column == table.columnCount() - 2:
            self.detail_dialog("Description", key, data["text"], data.get("url"))
        else:
            self.detail_dialog("Context size", key, data)

    def sort_context(self, title, column):
        table = self.tables[title]
        if title == "Hooks" or column != table.columnCount() - 1:
            return
        header = table.horizontalHeader()
        ascending = header.isSortIndicatorShown() and header.sortIndicatorOrder() == Qt.SortOrder.DescendingOrder
        order = Qt.SortOrder.AscendingOrder if ascending else Qt.SortOrder.DescendingOrder
        header.setSortIndicator(column, order)
        header.setSortIndicatorShown(True)
        table.sortItems(column, order)

    @staticmethod
    def restore_context_order(table):
        header = table.horizontalHeader()
        if header.isSortIndicatorShown():
            table.sortItems(table.columnCount() - 1, header.sortIndicatorOrder())

    def content_panel(self, title, table):
        search = QLineEdit()
        search.setPlaceholderText(f"Search {title.lower()}")
        state = ComboBox()
        state.addItems(["All states", "Enabled here", "Disabled here"])
        self.filters[title] = search, state
        search.textChanged.connect(lambda: self.filter_content(title))
        state.currentIndexChanged.connect(lambda: self.filter_content(title))
        filters = QHBoxLayout()
        filters.addWidget(search, 1)
        filters.addWidget(state)
        panel = QWidget()
        layout = QVBoxLayout(panel)
        layout.addLayout(filters)
        layout.addWidget(table)
        return panel

    def fill_content(self, title, group):
        table = self.tables[title]
        self.integration_columns(title, ["Name", "Plugin", "This computer", "Other computer", "Edit selected scope"],
                                 (140, 130, 105, 110, 150))
        local = self.data.get("plugin_content", {}).get(group, {})
        peer = self.data.get("peer_inventory", {}).get("plugin_content", {}).get(group, {})
        rows = sorted((peer | local).items(), key=lambda entry: entry[1]["title"].casefold())
        table.setRowCount(len(rows))
        for row, (name, info) in enumerate(rows):
            item = self.cell(info["title"])
            item.setToolTip(f"{name}\n{info['description']}")
            item.setData(Qt.ItemDataRole.UserRole, name)
            table.setItem(row, 0, item)
            table.setItem(row, 1, self.cell(info["source"]))
            table.setItem(row, 2, self.cell(label(local[name]["enabled"]) if name in local else "—"))
            table.setItem(row, 3, self.cell(label(peer[name]["enabled"]) if name in peer else "—"))
            combo = ComboBox()
            choices = [None, True, False]
            combo.addItems(["Keep local" if self.target == "shared" else "Inherit", "On", "Off"])
            combo.setCurrentIndex(choices.index(self.section().get(group, {}).get(name)))
            combo.currentIndexChanged.connect(
                lambda index, g=group, n=name: self.set_option(g, n, choices[index]))
            table.setCellWidget(row, 4, combo)
            self.set_integration_description(title, row, info.get("description", ""))
            self.set_context_cell(title, row)
        self.restore_context_order(table)
        self.filter_content(title)

    def filter_content(self, title):
        table = self.tables[title]
        search, status = self.filters[title]
        needle = search.text().strip().casefold()
        state = (None, "On", "Off")[status.currentIndex()]
        for row in range(table.rowCount()):
            name = table.item(row, 0)
            searchable = " ".join((name.text(), name.toolTip(), table.item(row, 1).text())).casefold()
            table.setRowHidden(row, (bool(needle) and needle not in searchable)
                               or (state is not None and table.item(row, 2).text() != state))

    def config_panel(self, table):
        panel = QWidget()
        table.setColumnCount(6)
        table.setHorizontalHeaderLabels(["Setting", "Description", "This computer", "Known to", "Shared policy",
                                         "Edit selected scope"])
        table.setWordWrap(False)
        table.setTextElideMode(Qt.TextElideMode.ElideRight)
        table.cellClicked.connect(self.open_config_description)
        header = table.horizontalHeader()
        for column, width in ((0, 185), (2, 130), (3, 115), (4, 105), (5, 154)):
            header.resizeSection(column, width)
        header.setSectionResizeMode(CONFIG_DESCRIPTION, QHeaderView.ResizeMode.Stretch)
        self.config_search = QLineEdit()
        self.config_search.setPlaceholderText("Search settings")
        self.config_search.textChanged.connect(self.filter_config)
        self.config_filter = ComboBox()
        self.config_filter.addItems(["All settings", "Configured", "Managed", "Experimental",
                                     "Has choices", "CLI", "Desktop app", "CLI only", "Desktop app only",
                                     "Legacy or unknown"])
        self.config_filter.currentTextChanged.connect(self.filter_config)
        self.open_config = QPushButton("Open local config.toml")
        self.open_config.setEnabled(False)
        self.open_config.clicked.connect(self.open_user_config)
        self.config_versions = QLabel("Loading installed Codex versions…")
        self.config_versions.setTextFormat(Qt.TextFormat.PlainText)
        tools = QHBoxLayout()
        tools.addWidget(self.config_search, 1)
        tools.addWidget(self.config_filter)
        tools.addWidget(self.open_config)
        layout = QVBoxLayout(panel)
        layout.setContentsMargins(0, 6, 0, 0)
        layout.addLayout(tools)
        layout.addWidget(self.config_versions)
        layout.addWidget(table)
        return panel

    def open_user_config(self):
        if self.data is not None:
            QDesktopServices.openUrl(QUrl.fromLocalFile(self.data["paths"]["config"]))

    def open_config_description(self, row, column):
        if column != CONFIG_DESCRIPTION:
            return
        table = self.tables["Config"]
        key = table.item(row, 0).text()
        notes = self.catalog.get("settings", {}).get(key, {}).get("documentation", [])
        text = "\n\n".join(f"{note['source']}\n{config_description(note)}" for note in notes) or NO_CONFIG_DESCRIPTION
        self.detail_dialog("Codex setting", key, text, notes[0]["url"] if notes else None)

    def detail_dialog(self, caption, key, text, url=None):
        dialog = QDialog(self)
        dialog.setWindowTitle(caption)
        dialog.resize(660, 370)
        title = QLabel()
        title.setTextFormat(Qt.TextFormat.PlainText)
        title.setTextInteractionFlags(Qt.TextInteractionFlag.TextSelectableByMouse)
        title.setText(key)
        title.setWordWrap(True)
        body = QPlainTextEdit()
        body.setReadOnly(True)
        body.setPlainText(text)
        buttons = QDialogButtonBox(QDialogButtonBox.StandardButton.Close)
        buttons.rejected.connect(dialog.reject)
        if url:
            source = buttons.addButton("Open documentation", QDialogButtonBox.ButtonRole.ActionRole)
            source.clicked.connect(lambda: QDesktopServices.openUrl(QUrl(url)))
        layout = QVBoxLayout(dialog)
        layout.addWidget(title)
        layout.addWidget(body, 1)
        layout.addWidget(buttons)
        dialog.exec()

    def filter_config(self):
        table = self.tables["Config"]
        terms = self.config_search.text().casefold().split()
        scope = self.config_filter.currentText()
        for row, (text, configured, managed, experimental, surfaces, choices) in enumerate(self.catalog_rows):
            legacy = not surfaces and not managed
            matches = {
                "Configured": configured, "Managed": managed, "Experimental": experimental,
                "Has choices": choices, "Legacy or unknown": legacy,
                "CLI": "CLI" in surfaces, "Desktop app": "Desktop app" in surfaces,
                "CLI only": surfaces == {"CLI"}, "Desktop app only": surfaces == {"Desktop app"},
            }
            visible = matches.get(scope, True) and (not legacy or scope == "Legacy or unknown")
            table.setRowHidden(row, not (visible and all(term in text for term in terms)))

    def catalog_error(self, _):
        if self.catalog_process.state() == QProcess.ProcessState.NotRunning:
            self.config_versions.setText("Could not load the installed Codex setting catalog.")

    def refresh_catalog(self):
        if self.catalog_process.state() != QProcess.ProcessState.NotRunning:
            self.catalog_refresh_pending = True
            return
        self.catalog_refresh_pending = False
        self.catalog_process.start(str(BACKEND), ["config-catalog", "--with-peer"])

    def finish_catalog(self, code, _):
        output = bytes(self.catalog_process.readAllStandardOutput())
        self.catalog_process.readAllStandardError()
        if self.catalog_refresh_pending:
            self.refresh_catalog()
            return
        if code:
            self.config_versions.setText("Could not load the installed Codex setting catalog.")
            return
        try:
            self.catalog = json.loads(output)
        except ValueError:
            self.config_versions.setText("Could not read the installed Codex setting catalog.")
            return
        if self.data is not None:
            self.fill_config()

    def refresh_peer_inventory(self):
        if self.peer_process.state() != QProcess.ProcessState.NotRunning:
            self.peer_refresh_pending = True
            return
        self.peer_refresh_pending = False
        self.peer_process.start(str(BACKEND), ["inventory", "--with-peer"])

    def finish_peer_inventory(self, code, _):
        output = bytes(self.peer_process.readAllStandardOutput())
        self.peer_process.readAllStandardError()
        if not self.data:
            return
        if self.peer_refresh_pending:
            self.refresh_peer_inventory()
            return
        try:
            peer = json.loads(output) if code == 0 else {}
        except ValueError:
            peer = {}
        if peer != self.data.get("peer_inventory"):
            self.data["peer_inventory"] = peer
            self.fill_integrations()
            self.update_entry_controls()

    @property
    def target(self):
        return SCOPES[self.scope.currentText()]

    def section(self):
        return self.draft["shared"] if self.target == "shared" else self.draft["hosts"][self.target]

    def launch(self, action, data=None):
        self.action = action
        self.setEnabled(False)
        if action == "status":
            self.context_result = {}
            self.context_started = False
            self.context_invalidated = self.context_process.state() != QProcess.ProcessState.NotRunning
            self.instructions_context.setText("Context size · —")
            self.instructions_context.setToolTip(self.context_label())
            self.context_button.setToolTip(self.context_label())
        self.process.start(str(BACKEND), [action])
        if data is not None:
            self.process.write(json.dumps(data).encode())
        self.process.closeWriteChannel()

    def process_error(self, _):
        if self.process.state() == QProcess.ProcessState.NotRunning:
            self.setEnabled(True)
            self.info.setText("Could not run the customization backend.")

    def read(self):
        if self.data and (self.removals or self.installs or self.draft != self.data["manifest"] and not self.resolve):
            choice = QMessageBox.question(self, "Discard draft?", "Reload synced preferences and discard unsaved edits?")
            if choice != QMessageBox.StandardButton.Yes:
                return
        self.launch("status")

    def finished(self, code, _):
        self.setEnabled(True)
        out = bytes(self.process.readAllStandardOutput()).decode(errors="replace")
        err = bytes(self.process.readAllStandardError()).decode(errors="replace").strip()
        if code:
            self.info.setText(err or "The operation failed.")
            if self.action == "publish":
                self.info.setText(self.info.text() + " Your draft is still available. Apply & Sync retries it.")
            return
        try:
            value = json.loads(out)
        except ValueError:
            self.info.setText("The customization backend returned an invalid response.")
            return
        if self.action == "entry":
            self.entry_feedback = "  ·  ".join(
                f"{HOST_LABELS[host]}: {result.get('error') or 'Done'}" for host, result in value.items()
            )
            self.launch("status")
            return
        if self.action in ("publish", "discard-draft"):
            self.removals = []
            self.installs = []
            if self.action == "publish" and value.get("removals"):
                results = value["removals"]
                problems = [f"{HOST_LABELS[item['profile']]} · {item['name']}: {item['error']}"
                            for item in results if "error" in item]
                self.removal_feedback = "  ·  ".join(problems) if problems else "Removals applied."
            if self.action == "publish" and value.get("installs"):
                installs = []
                for item in value["installs"]:
                    outcome = item.get("error") or ("Updated" if item.get("operation") == "update" else "Added")
                    installs.append(f"{HOST_LABELS[item['profile']]} · {item['name']}: {outcome}")
                self.removal_feedback = "  ·  ".join(filter(None, [self.removal_feedback, *installs]))
            self.data = None
            self.info.setText("Refreshing workstation status…")
            self.launch("status")
            return
        if self.entry_feedback and self.draft != self.data["manifest"]:
            value["manifest"] = self.data["manifest"]
        else:
            self.draft = copy.deepcopy(value["manifest"])
            pending = value.get("pending")
            self.resolve = False
            if pending:
                self.draft = pending["desired"]
                self.resolve = pending.get("resolve", False)
            if not self.entry_feedback:
                self.removals = pending.get("removals", []) if pending else []
                self.installs = pending.get("installs", []) if pending else []
        value["peer_inventory"] = (self.data or {}).get("peer_inventory", {})
        self.data = value
        self.render()
        self.refresh_peer_inventory()
        self.refresh_catalog()
        QTimer.singleShot(0, self.maybe_measure_context)
        if self.entry_feedback:
            feedback = self.entry_feedback
            if self.draft != self.data["manifest"]:
                feedback += "  ·  Unapplied policy edits"
            if self.removals:
                feedback += f"  ·  {len(self.removals)} removals staged"
            self.info.setText(feedback)
            self.entry_feedback = None
        if self.removal_feedback:
            self.info.setText(self.info.text() + "  ·  " + self.removal_feedback)
            self.removal_feedback = None

    def render(self):
        if self.draft is None:
            return
        local = self.data["profile"]
        self.check_updates.setEnabled(True)
        self.machine.setText("This computer  ·  " + ("Desktop" if local.endswith("desktop") else "IdeaPad"))
        self.instructions.blockSignals(True)
        self.instructions.setPlainText(self.section().get("instructions", ""))
        self.instructions.blockSignals(False)
        self.fill_config()
        self.fill_integrations()
        drift = self.data["drift"]
        self.adopt.setVisible(any(key != "override" for key in drift))
        self.restore.setVisible(bool(drift) and "override" not in drift)
        self.discard.setVisible(bool(self.removals or self.installs or self.data.get("pending")
                                     or self.data.get("pending_removals") or self.data.get("pending_installs")))
        peer = self.data.get("peer", {}).get("state")
        status = {
            "applied": "Peer confirmed the synced revision.",
            "pending": "Published. Peer confirmation is pending.",
        }.get(peer, "Changes take effect in a fresh Codex session.")
        if self.data.get("pending"):
            status = "There is an unpublished draft. Review it and choose Apply & Sync."
        if drift:
            status = "Local changes need review  ·  " + ", ".join(drift)
        if self.removals:
            status = f"Removals staged ({len(self.removals)}). Choose Apply & Sync to remove them."
        if self.data.get("pending_removals"):
            status += f"  ·  {self.data['pending_removals']} pending removals. Apply & Sync retries them."
        if self.installs:
            status += f"  ·  {len(self.installs)} staged installs or updates."
        if self.data.get("pending_installs"):
            status += f"  ·  {self.data['pending_installs']} pending installs or updates. Apply & Sync retries them."
        self.info.setText(status)
        self.update_file_indicator()
        self.update_entry_controls()

    def fill_integrations(self):
        for title, (group, options) in TABLES.items():
            self.fill(title, group, options)
        self.fill_content("Plugin Skills", "plugin_skills")
        self.fill_content("Apps", "apps")
        self.fill_hooks()

    def fill_config(self):
        table = self.tables["Config"]
        scroll = table.verticalScrollBar().value()
        self.open_config.setEnabled(Path(self.data["paths"]["config"]).is_file())
        managed = self.data["actual_defaults"]
        settings = self.catalog.get("settings", {})
        builds = self.catalog.get("builds", {})
        names = [*managed, *sorted(settings.keys() - managed.keys())]
        profiles = set(self.draft["hosts"]) if self.target == "shared" else {self.target}
        table.clearContents()
        table.setRowCount(len(names))
        self.catalog_rows = []
        for row, key in enumerate(names):
            setting = settings.get(key, {})
            metadata = setting.get("metadata", {})
            support = setting.get("support", {})
            surfaces = {identity.split("/", 1)[1] for identity in support}
            stages = {item["stage"] for item in support.values() if "stage" in item}
            notes = setting.get("documentation", [])
            description = config_description(notes[0]) if notes else ""
            details = [key, description]
            for field, label_text in (("type", "Type"), ("enum", "Values"), ("default", "Schema default")):
                if field in metadata:
                    details.append(f"{label_text}: {json.dumps(metadata[field], ensure_ascii=False)}")
            for identity, feature in support.items():
                profile, surface = identity.split("/", 1)
                note = f"{HOST_LABELS[profile]} · {surface} {builds[identity]['version']}"
                if feature:
                    note += f" · {feature['stage']} · {'on' if feature['enabled'] else 'off'} by default"
                details.append(note)
            item = self.cell(key)
            item.setToolTip("\n".join(line for line in details if line))
            table.setItem(row, 0, item)
            item = self.cell(" ".join(description.split()) if description else "—")
            tooltip = escape(description or NO_CONFIG_DESCRIPTION).replace("\n", "<br>")
            item.setToolTip(f"<p>{tooltip}</p>")
            table.setItem(row, CONFIG_DESCRIPTION, item)
            actual = managed.get(key) if key in managed else setting.get("value")
            item = self.cell(actual if actual is not None else "Not set")
            item.setToolTip(item.text())
            table.setItem(row, 2, item)
            item = self.cell(" · ".join(surface for surface in ("CLI", "Desktop app") if surface in surfaces) or "—")
            item.setToolTip(item.text())
            table.setItem(row, 3, item)
            choices = config_choices(setting, profiles)
            if key in managed:
                shared = self.draft["shared"]["defaults"][key]
                table.setItem(row, 4, self.cell(shared))
                table.setCellWidget(row, CONFIG_EDITOR, self.default_editor(key))
            elif choices:
                table.setCellWidget(row, CONFIG_EDITOR, self.config_option_editor(key, setting, choices))
            text = " ".join((key, *(note["text"] for note in notes), str(actual or ""), *stages, *surfaces)).casefold()
            self.catalog_rows.append((text, actual is not None, key in managed,
                                      bool(stages & {"experimental", "under development"}), surfaces,
                                      choices is not None or key in managed))
        if self.catalog:
            local = self.data["profile"]
            local_builds = []
            for identity, info in builds.items():
                profile, surface = identity.split("/", 1)
                if profile == local:
                    if surface == "CLI":
                        local_builds.append(f"CLI {info['version']}")
                    elif info.get("package"):
                        local_builds.append(f"ChatGPT Desktop {info['package']}")
                    else:
                        local_builds.append(f"Desktop engine {info['version']}")
            notices = [f"Schema unavailable for {identity.split('/', 1)[1]} {info['version']}"
                       for identity, info in builds.items() if not info["schema"]]
            if not self.catalog["peer_available"]:
                notices.append("Peer versions unavailable")
            self.config_versions.setText("  ·  ".join(local_builds + list(dict.fromkeys(notices)))
                                         or "No Codex engines found")
            self.config_versions.setToolTip("\n".join(
                f"{HOST_LABELS[identity.split('/', 1)[0]]} · "
                f"{'Desktop engine' if identity.endswith('/Desktop app') else 'CLI'} {info['version']}"
                for identity, info in builds.items()))
        self.filter_config()
        table.verticalScrollBar().setValue(scroll)

    def config_option_editor(self, name, setting, choices):
        path = setting["path"]
        selected = setting.get("choice") if self.target == self.data["profile"] else None
        if choices["multiple"]:
            button = QPushButton("Choose values…")
            menu = QMenu(button)
            container = QWidget(menu)
            layout = QVBoxLayout(container)
            checks = []
            for value in choices["values"]:
                check = QCheckBox(choice_label(value), container)
                check.setChecked(isinstance(selected, list) and value in selected)
                layout.addWidget(check)
                checks.append((value, check))
            picker = QWidgetAction(menu)
            picker.setDefaultWidget(container)
            menu.addAction(picker)
            menu.addAction("Replace with selected values…", lambda: self.change_config_option(
                name, path, [value for value, check in checks if check.isChecked()]))
            menu.addAction("Use Codex default…", lambda: self.change_config_option(name, path, None))
            button.setMenu(menu)
            return button

        combo = ComboBox()
        combo.addItem("Choose…")
        index = 0
        for value in choices["values"]:
            combo.addItem(choice_label(value), value)
            if type(value) is type(selected) and value == selected:
                index = combo.count() - 1
        combo.addItem("Use Codex default")
        combo.setCurrentIndex(index)

        def choose(selected_index):
            combo.setCurrentIndex(index)
            if selected_index:
                self.change_config_option(name, path, combo.itemData(selected_index))

        combo.activated.connect(choose)
        return combo

    def tool_policy(self, path):
        if len(path) == 3 and path[-1] == "enabled" and path[0] in ("mcp_servers", "plugins"):
            group, name = {"mcp_servers": "mcp", "plugins": "plugins"}[path[0]], path[1]
        elif len(path) == 5 and path[0] == "plugins" and path[2] == "mcp_servers" and path[-1] == "enabled":
            group, name = "plugin_mcp", f"{path[1]}/{path[3]}"
        else:
            return None
        profiles = set(self.draft["hosts"]) if self.target == "shared" else {self.target}
        for manifest in (self.data["manifest"], self.draft):
            if name in manifest["shared"].get(group, {}) or any(
                name in manifest["hosts"][profile].get(group, {}) for profile in profiles
            ):
                return group, name
        return None

    def change_config_option(self, name, path, value):
        path = list(path)
        for index, part in enumerate(path):
            if part == "<name>":
                entered, ok = QInputDialog.getText(self, "Setting name", "Name for " + name)
                if not ok or not entered.strip():
                    return
                path[index] = entered.strip()
            elif part == "[]":
                item, ok = QInputDialog.getInt(self, "List item", "Item number for " + name, 1, 1)
                if not ok:
                    return
                path[index] = item - 1
        policy = self.tool_policy(path)
        if policy and value is not None:
            group, tool = policy
            self.stage_policy(group, tool, value)
            return
        display = name
        for original, concrete in zip(self.catalog["settings"][name]["path"], path):
            if original == "<name>":
                display = display.replace("<name>", json.dumps(concrete), 1)
            elif original == "[]":
                display = display.replace("[]", f"[{concrete}]", 1)
        if value is None:
            message = f"Stage a reset for {display} on {self.scope.currentText()}? Apply & Sync will apply it."
        else:
            summary = "[" + ", ".join(map(choice_label, value)) + "]" if isinstance(value, list) else choice_label(value)
            message = f"Set {display} to {summary} on {self.scope.currentText()}?"
        box = QMessageBox(QMessageBox.Icon.Question, "Change Codex configuration", message,
                          QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.Cancel, self)
        box.setTextFormat(Qt.TextFormat.PlainText)
        box.setDefaultButton(QMessageBox.StandardButton.Cancel)
        if box.exec() == QMessageBox.StandardButton.Yes:
            request = {"scope": self.target, "operation": "remove" if value is None else "add",
                       "group": "config", "name": display, "value": {"path": path, "choice": value}}
            if value is None:
                self.stage_removal(request)
            else:
                self.launch("entry", request)

    def default_editor(self, key):
        combo = ComboBox()
        current = self.section().get("defaults", {}).get(key, "")
        choices = default_choices(self.catalog.get("builds", {}), self.draft, self.target, key)
        if self.target != "shared":
            inherited = self.draft["shared"]["defaults"][key]
            combo.addItem(f"Inherit {inherited}", "")
        for value in choices:
            text = "default · Standard" if key == "service_tier" and value == "default" else value
            combo.addItem(text, value)
        index = combo.findData(current)
        if index < 0:
            combo.addItem(f"{current} · saved" if current else "No verified choices", current)
            index = combo.count() - 1
            combo.model().item(index).setEnabled(False)
            combo.setToolTip("The saved value is outside the choices reported for this scope.")
        combo.setCurrentIndex(index)
        combo.setEnabled(bool(choices) or self.target != "shared" and bool(current))
        combo.currentIndexChanged.connect(lambda index: self.choose_default(key, combo.itemData(index)))
        return combo

    def choose_default(self, key, value):
        if value is None:
            return
        self.set_default(key, value)
        if key == "model":
            table = self.tables["Config"]
            names = list(self.data["actual_defaults"])
            for dependent in ("model_reasoning_effort", "service_tier"):
                table.setCellWidget(names.index(dependent), CONFIG_EDITOR, self.default_editor(dependent))

    def update_file_indicator(self):
        if self.data is None:
            return
        paths = self.data["paths"]
        tab = self.active_table()
        if tab == "Hooks":
            prefix, keys = "Local files", ("hooks", "config")
        elif tab == "Instructions":
            prefix, keys = "Local file", ("instructions",)
        elif tab == "Skills":
            prefix, keys = "Local folder", ("skills",)
        else:
            prefix, keys = "Local file", ("config",)

        home = Path.home()
        selected = [Path(paths[key]) for key in keys]
        names = [str(Path("~") / path.relative_to(home)) if path.is_relative_to(home) else str(path)
                 for path in selected]
        self.files.setText(prefix + "  ·  " + "  ·  ".join(names))
        details = "\n".join(map(str, selected))
        if tab != "Hooks":
            details += "\nApply & Sync tracks edited preferences in " + paths["manifest"]
        self.files.setToolTip(details)

    @staticmethod
    def cell(value):
        item = QTableWidgetItem(str(value))
        item.setFlags(item.flags() & ~Qt.ItemFlag.ItemIsEditable)
        return item

    def active_table(self):
        title = self.tabs.tabText(self.tabs.currentIndex())
        if title == "Skills" and self.skill_tabs.currentIndex() == 1:
            return "Plugin Skills"
        if title == "MCP Servers" and self.server_tabs.currentIndex() == 1:
            return "Plugin MCP Servers"
        return title

    def entry_selection(self):
        title = self.active_table()
        group = ENTRY_GROUPS.get(title)
        table = self.tables[title] if group else None
        item = table.item(table.currentRow(), 0) if table is not None else None
        return group, item

    def update_entry_controls(self):
        if not hasattr(self, "add_entry"):
            return
        group, item = self.entry_selection()
        for button in (self.add_entry, self.remove_entry):
            button.setVisible(group is not None)
        self.add_entry.setText("Add Override…" if group == "plugin_mcp" else "Add…")
        self.remove_entry.setText("Remove Override…" if group == "plugin_mcp" else "Remove…")
        self.add_entry.setEnabled(self.data is not None and group is not None)
        self.remove_entry.setEnabled(self.data is not None and item is not None)
        title = self.active_table()
        self.context_button.setVisible(title in INTEGRATION_GROUPS or title == "Instructions")
        if title in ("Apps", "Plugin Skills"):
            self.add_entry.setVisible(True)
            self.add_entry.setText("Browse Marketplace…")
            self.add_entry.setEnabled(self.data is not None)
        has_tools = title in ("Apps", "MCP Servers", "Plugin MCP Servers")
        self.tools_button.setVisible(has_tools)
        table = self.tables.get(title)
        self.tools_button.setEnabled(self.data is not None and has_tools and table.currentRow() >= 0)

    def open_integration_tools(self):
        title = self.active_table()
        table = self.tables[title]
        item = table.item(table.currentRow(), 0)
        if item is None:
            return
        group = "apps" if title == "Apps" else TABLES[title][0]
        target = f"{group}|{item.data(Qt.ItemDataRole.UserRole) or item.text()}"
        box = QDialog(self)
        box.setWindowTitle(f"Tools · {item.text()}")
        box.resize(640, 420)
        layout = QVBoxLayout(box)
        host = self.data["profile"] if self.target == "shared" else self.target
        local = QLabel(f"Tool list from {HOST_LABELS[host]}  ·  Edit scope {self.scope.currentText()}")
        message = QLabel("Discovering tools…")
        message.setWordWrap(True)
        search = QLineEdit()
        search.setPlaceholderText("Search tools")
        rows = QTableWidget(0, 3, box)
        rows.setHorizontalHeaderLabels(["Tool", "Current", "Edit selected scope"])
        rows.horizontalHeader().setStretchLastSection(True)
        buttons = QDialogButtonBox(QDialogButtonBox.StandardButton.Ok | QDialogButtonBox.StandardButton.Cancel)
        buttons.button(QDialogButtonBox.StandardButton.Ok).setEnabled(False)
        buttons.accepted.connect(box.accept)
        buttons.rejected.connect(box.reject)
        for widget in (local, message, search, rows, buttons):
            layout.addWidget(widget)
        process = QProcess(box)
        choices = [None, True, False]
        edited = {}

        def filter_tools():
            query = search.text().strip().casefold()
            for row in range(rows.rowCount()):
                item = rows.item(row, 0)
                rows.setRowHidden(row, query not in f"{item.text()} {item.toolTip()}".casefold())

        def loaded(code, _status):
            if code:
                message.setText("Could not read tools from Codex.")
                return
            try:
                data = json.loads(bytes(process.readAllStandardOutput()))
            except ValueError:
                message.setText("Codex returned an invalid tool list.")
                return
            message.setText(data["error"] or "Changes are staged for Apply & Sync.")
            for row, (name, info) in enumerate(sorted(data["tools"].items())):
                key = f"{target}|{name}"
                rows.insertRow(row)
                name_item = self.cell(name)
                name_item.setToolTip(info["description"])
                rows.setItem(row, 0, name_item)
                rows.setItem(row, 1, self.cell(label(info["enabled"])))
                editor = ComboBox()
                editor.addItems(["Keep local" if self.target == "shared" else "Inherit", "On", "Off"])
                editor.setCurrentIndex(choices.index(self.section().get("tool_states", {}).get(key)))
                editor.currentIndexChanged.connect(lambda index, k=key: edited.update({k: choices[index]}))
                rows.setCellWidget(row, 2, editor)
            rows.resizeColumnsToContents()
            filter_tools()
            buttons.button(QDialogButtonBox.StandardButton.Ok).setEnabled(bool(data["tools"]))

        search.textChanged.connect(filter_tools)
        process.finished.connect(loaded)
        process.errorOccurred.connect(lambda _: message.setText("Could not start the Codex inventory."))
        args = ["integration-tools", "--target", target]
        if host != self.data["profile"]:
            args.append("--with-peer")
        process.start(str(BACKEND), args)
        accepted = box.exec()
        if process.state() != QProcess.ProcessState.NotRunning:
            process.kill()
            process.waitForFinished(1000)
        if accepted:
            for key, value in edited.items():
                self.set_option("tool_states", key, value)

    def fill_hooks(self):
        table = self.tables["Hooks"]
        local = self.data.get("hook_entries", {})
        peer = self.data.get("peer_inventory", {})
        remote = peer.get("hook_entries", {})
        self.integration_columns("Hooks", ["Event", "Handler", "File", "Installed on"], (130, 210, 95, 110))
        entries = sorted((local | remote).items(), key=lambda item: item[1]["event"])
        table.setRowCount(len(entries))
        for row, (identity, hook) in enumerate(entries):
            item = self.cell(hook["event"])
            item.setData(Qt.ItemDataRole.UserRole, identity)
            table.setItem(row, 0, item)
            handler = f'{hook["matcher"]} · {hook["description"]}' if hook["matcher"] else hook["description"]
            item = self.cell(handler)
            item.setToolTip(handler)
            table.setItem(row, 1, item)
            table.setItem(row, 2, self.cell(hook["source"]))
            hosts = [HOST_LABELS[host] for host, entries in (
                (self.data["profile"], local), (peer.get("profile"), remote)) if identity in entries]
            table.setItem(row, 3, self.cell(", ".join(hosts)))
            event = hook["event"]
            description = HOOK_DESCRIPTIONS.get(event, "")
            self.set_integration_description("Hooks", row, description, f"{HOOKS_URL}#{event.casefold()}" if description else None)
            self.set_context_cell("Hooks", row)

    def managed_skills(self):
        return set().union(*(section.get("skills", {}) for section in
                             (self.draft["shared"], *self.draft["hosts"].values())))

    def import_skill(self):
        selected = QFileDialog.getExistingDirectory(self, "Choose a folder containing SKILL.md")
        if not selected:
            return
        folder = Path(selected).resolve()
        if not (folder / "SKILL.md").is_file():
            QMessageBox.warning(self, "Skill import", "The folder needs a SKILL.md file.")
            return
        if folder.name in self.managed_skills():
            QMessageBox.warning(self, "Skill import", "That name belongs to a dotfiles skill. Enable it from the Skills tab.")
            return
        files = {}
        total = 0
        try:
            for file in folder.rglob("*"):
                relative = file.relative_to(folder)
                if ".git" in relative.parts or file.is_symlink() or not file.is_file():
                    continue
                if not file.resolve().is_relative_to(folder):
                    raise ValueError("The skill contains a file outside the selected folder.")
                info = file.stat()
                total += info.st_size
                if total > 5 * 1024 * 1024:
                    raise ValueError("The skill exceeds the 5 MiB import limit.")
                files[str(relative)] = {"content": base64.b64encode(file.read_bytes()).decode("ascii"),
                                        "executable": bool(info.st_mode & stat.S_IXUSR)}
        except (OSError, ValueError) as error:
            QMessageBox.warning(self, "Skill import", str(error))
            return
        if "SKILL.md" not in files:
            QMessageBox.warning(self, "Skill import", "SKILL.md must be a file within the selected folder.")
            return
        self.submit_entry("add", "skills", folder.name, files)

    def add_selected_entry(self):
        group, item = self.entry_selection()
        if self.active_table() in ("Apps", "Plugin Skills"):
            self.open_marketplace("plugins" if self.active_table() == "Apps" else "skills")
            return
        if group == "skills":
            sources = ["Browse Marketplace…", "Import a folder…", "Enable a dotfiles skill…"]
            source, accepted = QInputDialog.getItem(self, "Add skill", "Source", sources, editable=False)
            if accepted and source == sources[0]:
                self.open_marketplace("skills")
            elif accepted and source == sources[1]:
                self.import_skill()
            elif accepted:
                names = sorted(self.managed_skills() | {path.parent.name for path in SKILL_SOURCE.glob("*/SKILL.md")})
                if names:
                    name, selected = QInputDialog.getItem(self, "Enable skill", "Dotfiles skill", names, editable=False)
                    if selected:
                        self.stage_policy(group, name, "automatic")
            return
        if group in ("mcp", "plugins"):
            sources = ["Browse Marketplace…", "Add manually…"]
            source, accepted = QInputDialog.getItem(self, "Add integration", "Source", sources, editable=False)
            if not accepted:
                return
            if source == sources[0]:
                self.open_marketplace(group)
                return
        if group == "plugin_mcp":
            names = sorted(set(self.data["plugin_mcp"]) | set(self.data.get("peer_inventory", {}).get("plugin_mcp", {})))
            if not names:
                QMessageBox.information(self, "Add override", "Install a plugin that provides an MCP server first.")
                return
            name, ok = QInputDialog.getItem(self, "Add override", "Plugin MCP server", names,
                                            names.index(item.text()) if item and item.text() in names else 0,
                                            editable=False)
            if ok:
                value, accepted = QInputDialog.getItem(self, "Add override", "Enablement", ["On", "Off"], editable=False)
                if accepted:
                    self.stage_policy(group, name, value == "On")
            return
        title = f"Add {ENTRY_LABELS[group]}"
        prompt = {"mcp": "Server name", "plugins": "Plugin name (plugin@marketplace)", "hooks": "Codex hook event"}
        name, ok = QInputDialog.getText(self, title, prompt[group], text="SessionStart" if group == "hooks" else "")
        if not ok or not name.strip():
            return
        value = None
        if group == "mcp":
            value, ok = QInputDialog.getText(self, title, "HTTP URL or command with arguments")
        elif group == "hooks":
            matcher, ok = QInputDialog.getText(self, title, "Matcher (optional)")
            if not ok:
                return
            handler, ok = QInputDialog.getMultiLineText(
                self, title, "Handler JSON", '{\n  "type": "command",\n  "command": ""\n}')
            if ok:
                try:
                    value = {"matcher": matcher.strip(), "handler": json.loads(handler)}
                except ValueError:
                    QMessageBox.warning(self, title, "Enter valid JSON for the hook handler.")
                    return
        if ok:
            self.submit_entry("add", group, name.strip(), value)

    def open_marketplace(self, group):
        from marketplace_window import MarketplaceWindow

        peer = self.target not in ("shared", self.data["profile"])
        dialog = MarketplaceWindow(self, group, ComboBox, BACKEND, peer)
        dialog.exec()

    def open_updates(self):
        from marketplace_updates_window import UpdatesWindow

        UpdatesWindow(self, BACKEND, HOST_LABELS).exec()

    def stage_updates(self, rows):
        draft = copy.deepcopy(self.draft)
        installs = list(self.installs)
        skill_updates = {}
        for row in rows:
            group, name, host, value = (row[key] for key in ("group", "name", "profile", "value"))
            if any(item["group"] == group and item["name"] == name and item["scope"] in ("shared", host)
                   for item in self.removals):
                return f"{name} is staged for removal on {HOST_LABELS[host]}."
            if group == "skills":
                inherited = draft["shared"].get("skill_pins", {})
                pins = draft["hosts"][host].get("skill_pins", {})
                if pins.get(name, inherited.get(name)) not in (value["previous"], value["next"]):
                    return f"The source for {name} changed in your draft. Reload before staging its update."
                skill_updates.setdefault(name, {})[host] = value["next"]
            else:
                request = {"group": group, "name": name, "scope": host, "operation": "update", "value": value}
                installs = [item for item in installs if not (
                    item["operation"] == "update" and all(item[key] == request[key] for key in ("group", "name", "scope"))
                )]
                installs.append(request)
        for name, by_host in skill_updates.items():
            first = next(iter(by_host.values()))
            if (by_host.keys() == draft["hosts"].keys() and all(pin == first for pin in by_host.values())
                    and all(name not in section.get("skill_pins", {}) for section in draft["hosts"].values())):
                draft["shared"].setdefault("skill_pins", {})[name] = first
            else:
                for host, pin in by_host.items():
                    draft["hosts"][host].setdefault("skill_pins", {})[name] = pin
        self.draft = draft
        self.installs = installs
        self.render()
        self.info.setText(f"{len(rows)} updates staged. Choose Apply & Sync to apply them.")

    def skill_link_parents(self, child):
        profiles = self.draft["hosts"] if self.target == "shared" else (self.target,)
        shared = self.draft["shared"].get("skills", {})
        active = [shared | self.draft["hosts"][host].get("skills", {}) for host in profiles]
        return sorted(path.parent.name for path in SKILL_SOURCE.glob("*/SKILL.md")
                      if path.parent.name != child
                      and all(modes.get(path.parent.name) in ("manual", "automatic") for modes in active))

    def stage_marketplace(self, group, preview, choice, mode, parent=None):
        name = preview["name"]
        if group == "skills":
            scope = self.target
            local = self.data["profile"]
            peer = self.data.get("peer_inventory", {})
            visible = {local: self.data["skills"], peer.get("profile"): peer.get("skills", {})}
            profiles = set(self.draft["hosts"]) if scope == "shared" else {scope}
            if ((SKILL_SOURCE / name).is_dir() or any(visible.get(host, {}).get(name) == "unmanaged"
                                                     for host in profiles)):
                return "A skill already uses this name."
            pin = preview["pin"]
            for host in profiles:
                previous = self.draft["hosts"][host].get("skill_pins", {}).get(
                    name, self.draft["shared"].get("skill_pins", {}).get(name))
                if previous and previous["source"] != pin["source"]:
                    return "A skill with this name is pinned to a different source."
            if parent and parent not in self.skill_link_parents(name):
                return "Choose a custom skill enabled on every selected computer."
            self.set_option("skill_pins", name, pin)
            self.set_option("skills", name, mode)
            if parent:
                self.set_option("skill_links", f"{parent}/{name}", True)
        else:
            request = {"group": group, "name": name, "operation": "add", "scope": self.target, "value": choice}
            if request not in self.installs:
                self.installs.append(request)
        self.render()
        self.info.setText(f"{name} staged. Choose Apply & Sync to install.")
        if parent:
            return f"{name} and its link from {parent} staged for {self.scope.currentText()}."
        return f"{name} staged for {self.scope.currentText()}."

    def stage_policy(self, group, name, mode):
        self.set_option(group, name, mode)
        self.render()
        self.info.setText("Change staged. Choose Apply & Sync to apply it to the selected computers.")

    def stage_removal(self, request):
        if request not in self.removals:
            self.removals.append(request)
        self.render()

    def remove_selected_entry(self):
        group, item = self.entry_selection()
        if item is None:
            return
        name = item.text()
        identity = name
        if group == "hooks":
            identity = item.data(Qt.ItemDataRole.UserRole)
            handler = self.tables["Hooks"].item(item.row(), 1)
            name = f"{name} ({handler.text()})"
        self.submit_entry("remove", group, identity, description=name)

    def confirm_entry(self, operation, group, name):
        verb = operation.title()
        message = f"{verb} {name} on {self.scope.currentText()}?"
        if operation == "remove":
            message = f"Stage removal of {name} on {self.scope.currentText()}? Apply & Sync will apply it."
        box = QMessageBox(QMessageBox.Icon.Question, f"{verb} {ENTRY_LABELS[group]}",
                          message,
                          QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.Cancel, self)
        box.setTextFormat(Qt.TextFormat.PlainText)
        box.setDefaultButton(QMessageBox.StandardButton.Cancel)
        return box.exec() == QMessageBox.StandardButton.Yes

    def submit_entry(self, operation, group, name, value=None, description=None):
        if self.confirm_entry(operation, group, description or name):
            request = {"scope": self.target, "operation": operation, "group": group,
                       "name": name, "value": value}
            if operation == "remove":
                self.stage_removal(request)
            else:
                self.launch("entry", request)

    def fill(self, title, group, options):
        table = self.tables[title]
        local = self.data[group]
        remote = self.data.get("peer_inventory", {})
        live = {self.data["profile"]: local, remote.get("profile"): remote.get(group, {})}
        shared = self.draft["shared"].get(group, {})
        hosts = self.draft["hosts"]
        names = sorted(set(local) | set(remote.get(group, {})) | set(shared)
                       | {name for p in hosts.values() for name in p.get(group, {})})
        links = []
        if group == "skills":
            scopes = hosts if self.target == "shared" else (self.target,)
            shared_links = self.draft["shared"].get("skill_links", {})
            keys = {key for host in scopes for key, enabled in
                    (shared_links | hosts[host].get("skill_links", {})).items() if enabled}
            links = [key.split("/") for key in sorted(keys)]
        self.integration_columns(title, ["Name", "This computer", "Desktop policy", "IdeaPad policy", "Edit selected scope"],
                                 (150, 115, 112, 112, 150))
        table.setRowCount(len(names))
        lookup_group = "plugins" if group == "plugin_mcp" else group
        descriptions = remote.get("descriptions", {}).get(lookup_group, {}) | self.data.get("descriptions", {}).get(lookup_group, {})
        for row, name in enumerate(names):
            item = self.cell(name)
            if group == "skills":
                notes = [self.data.get("skill_sources", {}).get(name, "Local skill")]
                notes.extend(f"Linked from {parent}" if name == child else f"Links to {child}"
                             for parent, child in links
                             if name in (parent, child))
                item.setToolTip("\n".join(notes))
            else:
                item.setToolTip(name)
            table.setItem(row, 0, item)
            state = label(local[name]) if name in local else "—"
            if group == "plugins" and name in local:
                state += " · " + ("installed" if self.data["plugin_installed"].get(name) else "cache unavailable")
            table.setItem(row, 1, self.cell(state))
            for col, host in enumerate(("kubuntu-desktop", "kubuntu-laptop"), 2):
                want = hosts[host].get(group, {}).get(name, shared.get(name))
                self.show_policy(table, row, col, want, live.get(host, {}).get(name))
            lookup_name = name.rsplit("/", 1)[0] if group == "plugin_mcp" else name
            description = descriptions.get(lookup_name, "")
            if description and group == "plugin_mcp":
                description = f"About {lookup_name}\n{description}"
            self.set_integration_description(title, row, description)
            self.set_context_cell(title, row)
            staged = [HOST_LABELS[request["scope"]] for request in self.removals
                      if request["group"] == group and request["name"] == name]
            if staged:
                table.setItem(row, 4, self.cell("Removal staged · " + ", ".join(staged)))
                continue
            if name in {"node_repl", "_default"} or group == "skills" and local.get(name) == "unmanaged":
                table.setItem(row, 4, self.cell("App-owned" if name == "node_repl" else "Unmanaged"))
                continue
            combo = ComboBox()
            selections = [None, *options]
            combo.addItems(["Keep local" if self.target == "shared" else "Inherit", *map(label, options)])
            combo.setCurrentIndex(selections.index(self.section().get(group, {}).get(name)))
            combo.currentIndexChanged.connect(
                lambda index, g=group, n=name, modes=selections: self.set_option(g, n, modes[index]))
            table.setCellWidget(row, 4, combo)
        self.restore_context_order(table)

    def set_option(self, group, name, value):
        section = self.section().setdefault(group, {})
        if value is None:
            section.pop(name, None)
        else:
            section[name] = value
        if self.target == "shared":
            for host in self.draft["hosts"].values():
                host.get(group, {}).pop(name, None)
        if group in ("plugin_skills", "apps", "tool_states", "skill_pins", "skill_links"):
            return
        table = next(table for title, table in self.tables.items() if title in TABLES and TABLES[title][0] == group)
        shared = self.draft["shared"].get(group, {})
        remote = self.data.get("peer_inventory", {})
        live = {self.data["profile"]: self.data[group], remote.get("profile"): remote.get(group, {})}
        for row in range(table.rowCount()):
            if table.item(row, 0).text() == name:
                for col, host in enumerate(("kubuntu-desktop", "kubuntu-laptop"), 2):
                    value = self.draft["hosts"][host].get(group, {}).get(name, shared.get(name))
                    self.show_policy(table, row, col, value, live.get(host, {}).get(name))
                break

    def show_policy(self, table, row, column, desired, actual):
        text = label(desired) if desired is not None else "Local"
        if actual is not None:
            text += " · " + label(actual)
        table.setItem(row, column, self.cell(text))

    def edit(self):
        if self.draft is not None:
            self.section()["instructions"] = self.instructions.toPlainText()

    def set_default(self, key, value):
        values = self.section().setdefault("defaults", {})
        if not value.strip() and self.target != "shared":
            values.pop(key, None)
        else:
            values[key] = value.strip()
        if self.target == "shared":
            for host in self.draft["hosts"].values():
                host.get("defaults", {}).pop(key, None)

    def edit_skill_source(self, row, column):
        if column >= self.tables["Skills"].columnCount() - 2:
            return
        selected = self.tables["Skills"].item(row, 0).text()
        source = SKILL_SOURCE / selected / "SKILL.md"
        if source.is_file():
            QDesktopServices.openUrl(QUrl.fromLocalFile(str(source)))

    def show_preview(self):
        text = []
        for host, section in self.draft["hosts"].items():
            text.append(host + "\n\n" + self.draft["shared"].get("instructions", "") + "\n\n"
                        + section.get("instructions", ""))
        box = QMessageBox(self)
        box.setWindowTitle("Generated Codex instructions")
        box.setText("Preview of the shared text and host additions. Local-only notes are kept on each computer.")
        box.setDetailedText("\n\n".join(text))
        box.exec()

    def adopt_drift(self):
        drift = self.data["drift"]
        host = self.draft["hosts"][self.data["profile"]]
        if "instructions" in drift:
            QMessageBox.information(self, "Local instructions",
                                    "Copy the private portion of ~/.codex/AGENTS.md to ~/.codex/AGENTS.local.md. "
                                    "Add any shareable text in the Instructions tab before restoring.")
            return
        for key, value in drift.items():
            if key in self.data["actual_defaults"] and isinstance(value, str):
                host.setdefault("defaults", {})[key] = value
            else:
                for group, prefix in (("mcp", "mcp_servers."), ("plugins", "plugins.")):
                    if key.startswith(prefix) and key.endswith(".enabled") and isinstance(value, bool):
                        name = key[len(prefix):-len(".enabled")]
                        if ".mcp_servers." in name:
                            host.setdefault("plugin_mcp", {})[name.replace(".mcp_servers.", "/", 1)] = value
                        else:
                            host.setdefault(group, {})[name] = value
        self.resolve = True
        self.render()
        self.info.setText("Local settings are in the draft. Apply & Sync publishes them for this computer.")

    def restore_drift(self):
        if QMessageBox.question(self, "Restore synced values?",
                                "Apply the displayed synced settings over the identified local changes?") == QMessageBox.StandardButton.Yes:
            self.resolve = True
            self.info.setText("Restore selected. Choose Apply & Sync to confirm.")

    def discard_pending(self):
        if QMessageBox.question(self, "Discard pending changes?",
                                "Discard unpublished edits and cancel pending installs and removals?") == QMessageBox.StandardButton.Yes:
            self.launch("discard-draft")

    def publish(self):
        if self.draft is not None:
            pending = self.data.get("pending")
            base = pending["base"] if pending else self.data["manifest"]
            builds = self.catalog.get("builds", {})
            for profile in self.draft["hosts"]:
                previous = host_defaults(base, profile)
                chosen = host_defaults(self.draft, profile)
                for key in ("model_reasoning_effort", "service_tier"):
                    if previous["model"] == chosen["model"] and previous[key] == chosen[key]:
                        continue
                    choices = default_choices(builds, self.draft, profile, key)
                    if choices and chosen[key] not in choices:
                        QMessageBox.warning(self, "Choose a supported option",
                                            f"{HOST_LABELS[profile]} reports different {key} choices for "
                                            f"{chosen['model']}. Choose a supported value before applying.")
                        return
            self.launch("publish", {
                "base": base,
                "desired": self.draft, "resolve": self.resolve, "removals": self.removals,
                "installs": self.installs,
            })


def main():
    app = QApplication(sys.argv)
    app.setApplicationName(APP_ID)
    app.setApplicationDisplayName("AI Customization")
    app.setDesktopFileName(APP_ID)
    app.setWindowIcon(QIcon.fromTheme(APP_ID, QIcon(str(ICON))))
    window = Window()
    window.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
