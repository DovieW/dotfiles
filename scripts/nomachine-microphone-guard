#!/usr/bin/env python3
"""Mute NoMachine microphone capture without disabling remote audio output."""

from __future__ import annotations

import fcntl
import json
import os
from pathlib import Path
import subprocess
import time


LOCK = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / (
    "dotfiles-nomachine-microphone.lock"
)


def player_running() -> bool:
    return subprocess.run(
        ["pgrep", "-x", "nxplayer.bin"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    ).returncode == 0


def mute_nomachine_sources() -> None:
    result = subprocess.run(
        ["pactl", "--format=json", "list", "source-outputs"],
        check=False,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    if result.returncode != 0:
        return
    for stream in json.loads(result.stdout or "[]"):
        properties = stream.get("properties", {})
        if (
            properties.get("application.process.binary") == "nxplayer.bin"
            or properties.get("application.name") == "NoMachine"
        ) and not stream.get("mute"):
            subprocess.run(
                [
                    "pactl",
                    "set-source-output-mute",
                    str(stream["index"]),
                    "1",
                ],
                check=False,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )


def main() -> None:
    LOCK.parent.mkdir(parents=True, exist_ok=True)
    with LOCK.open("w", encoding="utf-8") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        deadline = time.monotonic() + 30
        while time.monotonic() < deadline or player_running():
            mute_nomachine_sources()
            time.sleep(0.5)


if __name__ == "__main__":
    main()
