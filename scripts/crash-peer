#!/usr/bin/python3
"""Observe a paired workstation over a restricted SSH connection."""

import argparse
import contextlib
import datetime as dt
import fcntl
import json
import os
from pathlib import Path
import re
import runpy
import selectors
import subprocess
import sys
import time


CONFIG = Path('/etc/dot-crash-peer')
STATE = Path('/var/lib/dot-crash-peer')
LIBEXEC = Path('/usr/local/libexec')
BOOT = Path('/proc/sys/kernel/random/boot_id').read_text().strip()
INTERVAL = 15
HEARTBEAT_TIMEOUT = 45
RECONNECT_DELAY = 30
SNAPSHOT_COOLDOWN = 300
POST_RESUME = Path('/run/dot-diagnostics-post-resume')
CAPTURE_NAME = re.compile(r'\d{8}T\d{6}\.\d{6}Z-[a-f0-9]{32}')
MIRROR_LIMIT = 3500
MIRROR_BUDGET = 1024 * 1024


def emit(event, **fields):
    print(json.dumps(dict(event=event, **fields), separators=(',', ':')), flush=True)


def home_network():
    """Require the configured unmetered home connection on the default uplink."""
    try:
        profile = json.loads((CONFIG / 'peer.json').read_text()).get('mirror_connection_uuid')
        if not profile:
            return False
        routes = subprocess.check_output(['/usr/bin/ip', '-j', '-4', 'route', 'show', 'default'],
                                         text=True, timeout=2)
        devices = {route.get('dev') for route in json.loads(routes)}
        if len(devices) != 1 or not (device := next(iter(devices))):
            return False
        active = subprocess.check_output(
            ['/usr/bin/nmcli', '-t', '-f', 'UUID,DEVICE', 'connection', 'show', '--active'],
            text=True, timeout=2)
        if f'{profile}:{device}' not in active.splitlines():
            return False
        metered = subprocess.check_output(['/usr/bin/nmcli', '-g', 'GENERAL.METERED', 'device', 'show', device],
                                          text=True, timeout=2).strip()
        return metered in ('no', 'no (guessed)')
    except (OSError, ValueError, TypeError, subprocess.SubprocessError):
        return False


def mirror_file():
    paths = sorted(POST_RESUME.glob('*.jsonl'), reverse=True)
    if paths and time.time() - paths[0].stat().st_mtime < 30:
        return paths[0]


def mirror_rows(path, cursor):
    position = cursor[1] if cursor[0] == path.name else 0
    rows = []
    with path.open('rb') as stream:
        stream.seek(position)
        for _ in range(120):
            line = stream.readline(MIRROR_LIMIT + 1)
            if not line.endswith(b'\n'):
                break
            position += len(line)
            try:
                row = json.loads(line)
                if row.get('event') == 'post_resume' and row.get('run') == path.stem:
                    rows.append(row)
            except (ValueError, AttributeError):
                continue
    return (path.name, position), rows


def serve(mirror=False):
    session_state = runpy.run_path(str(LIBEXEC / 'dot-diagnostic-resume'))['session_state']
    next_heartbeat = 0
    cursor = (None, 0)
    while True:
        now = time.monotonic()
        if now >= next_heartbeat:
            try:
                session = session_state(include_lock_screen=False)
            except OSError:
                session = {'status': 'unavailable'}
            emit('heartbeat', boot_id=BOOT, uptime_s=int(time.monotonic()),
                 suspended_s=int(time.clock_gettime(time.CLOCK_BOOTTIME) - time.monotonic()),
                 kwin=session.get('kwin', {}).get('status', session.get('status', 'unavailable')))
            next_heartbeat = time.monotonic() + INTERVAL
        pending = None
        if mirror:
            with contextlib.suppress(OSError):
                pending = mirror_file()
        if pending and home_network():
            try:
                cursor, rows = mirror_rows(pending, cursor)
            except OSError:
                rows = []
            for row in rows:
                emit('post_resume', **{key: value for key, value in row.items() if key != 'event'})
        delay = max(0, next_heartbeat - time.monotonic())
        time.sleep(min(5, delay) if pending else delay)


def inbound():
    request = os.environ.get('SSH_ORIGINAL_COMMAND')
    if request == 'watch':
        serve()
    elif request == 'watch-home':
        serve(mirror=True)
    elif request == 'snapshot':
        os.execv('/usr/bin/sudo', ['/usr/bin/sudo', '-n', str(LIBEXEC / 'dot-crash-peer'), 'snapshot'])
    else:
        sys.exit('This key accepts only watch, watch-home, and snapshot.')


def kernel_stacks():
    # Read only messages generated after the cursor was opened, up to a fixed limit.
    fd = os.open('/dev/kmsg', os.O_RDONLY | os.O_NONBLOCK)
    try:
        os.lseek(fd, 0, os.SEEK_END)
        Path('/proc/sysrq-trigger').write_text('_wl')
        messages = []
        size = 0
        while size < 256 * 1024:
            try:
                data = os.read(fd, 8192)
            except BlockingIOError:
                break
            if not data:
                break
            size += len(data)
            messages.append(data.decode(errors='replace').partition(';')[2].rstrip())
        emit('kernel_stacks', messages=messages, byte_limit_reached=size >= 256 * 1024)
    finally:
        os.close(fd)


def snapshot():
    if os.geteuid() != 0:
        sys.exit('The snapshot requires the restricted administrator entry point.')
    guard = Path('/var/lib/dot-diagnostics/crash-peer-snapshot.lock')
    with guard.open('a+') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            emit('snapshot_skipped', reason='already_running')
            return
        lock.seek(0)
        now = time.time()
        previous = lock.read().strip()
        if previous and 0 <= now - float(previous) < SNAPSHOT_COOLDOWN:
            emit('snapshot_skipped', reason='cooldown')
            return
        lock.seek(0)
        lock.truncate()
        lock.write(str(now))
        lock.flush()
        diagnostics = runpy.run_path(str(LIBEXEC / 'dot-diagnostics'))
        emit('threads', data=diagnostics['thread_snapshot']())
        try:
            kernel_stacks()
        except OSError as exc:
            emit('kernel_stacks_unavailable', error=str(exc))


def ssh_command(peer, request):
    key = Path.home() / '.local/state/dotfiles/crash-peer/id_ed25519'
    return ['/usr/bin/ssh', '-4', '-F', '/dev/null', '-T', '-i', str(key),
            '-o', 'IdentityAgent=none', '-o', 'IdentitiesOnly=yes', '-o', 'BatchMode=yes',
            '-o', 'StrictHostKeyChecking=yes', '-o', 'HostKeyAlgorithms=ssh-ed25519',
            '-o', f'UserKnownHostsFile={CONFIG / "known_hosts"}', '-o', 'GlobalKnownHostsFile=/dev/null',
            '-o', 'ConnectTimeout=5', '-o', f'ServerAliveInterval={INTERVAL}', '-o', 'ServerAliveCountMax=2',
            f'{peer["user"]}@{peer["hostname"]}', request]


def collect(peer, reason):
    code = None
    try:
        result = subprocess.run(ssh_command(peer, 'snapshot'), stdout=subprocess.PIPE, timeout=20)
        payload, code = result.stdout, result.returncode
    except subprocess.TimeoutExpired as exc:
        payload = exc.stdout or b''
    if payload:
        name = dt.datetime.now(dt.timezone.utc).strftime('%Y%m%dT%H%M%S.%fZ') + '.jsonl'
        path = STATE / name
        with path.open('xb') as stream:
            stream.write(payload)
            stream.flush()
            os.fsync(stream.fileno())
        for old in sorted(STATE.glob('*.jsonl'), reverse=True)[20:]:
            old.unlink()
    emit('snapshot_result', reason=reason, exit_code=code, bytes=len(payload), file=name if payload else None)


def reconnect_event(previous, current):
    if previous['boot_id'] != current['boot_id']:
        return 'peer_rebooted'
    if current['suspended_s'] - previous['suspended_s'] >= 2:
        return 'peer_slept_during_gap'
    return 'peer_reachable_again'


def store_mirror(row, received):
    run = row.get('run')
    seq = row.get('sequence')
    if (not isinstance(run, str) or not CAPTURE_NAME.fullmatch(run)
            or type(seq) is not int or not 0 <= seq <= 120 or seq <= received.get(run, -1)):
        return
    data = (json.dumps(row, separators=(',', ':')) + '\n').encode()
    if len(data) > MIRROR_LIMIT:
        return
    directory = STATE / 'post-resume'
    directory.mkdir(mode=0o700, exist_ok=True)
    path = directory / (run + '.jsonl')
    if path.exists() and path.stat().st_size + len(data) > MIRROR_BUDGET:
        return
    # On observer restarts the watch starts at offset zero. Preserve one copy.
    if run not in received and path.exists():
        with path.open() as stream:
            for line in stream:
                try:
                    received[run] = max(received.get(run, -1), json.loads(line)['sequence'])
                except (ValueError, KeyError, TypeError):
                    pass
        if seq <= received.get(run, -1):
            return
    new = not path.exists()
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'ab') as stream:
        stream.write(data)
        stream.flush()
        os.fsync(stream.fileno())
    received[run] = seq
    if new:
        for old in sorted(directory.glob('*.jsonl'), reverse=True)[12:]:
            old.unlink()
            received.pop(old.stem, None)
        fd = os.open(directory, os.O_DIRECTORY)
        try:
            os.fsync(fd)
        finally:
            os.close(fd)
        emit('post_resume_mirror_started', run=run)


def watch_stream(peer):
    mirror = home_network()
    child = subprocess.Popen(ssh_command(peer, 'watch-home' if mirror else 'watch'),
                             stdout=subprocess.PIPE, bufsize=0)
    received = {}
    try:
        with selectors.DefaultSelector() as selector:
            selector.register(child.stdout, selectors.EVENT_READ)
            while selector.select(HEARTBEAT_TIMEOUT):
                line = child.stdout.readline(4096)
                if not line:
                    break
                try:
                    row = json.loads(line)
                except ValueError:
                    break
                if row.get('event') == 'post_resume' and mirror:
                    if not home_network():
                        break
                    store_mirror(row, received)
                if row.get('event') == 'heartbeat':
                    yield row
                    if mirror != home_network():
                        break
    finally:
        if child.poll() is None:
            child.terminate()
            try:
                child.wait(timeout=2)
            except subprocess.TimeoutExpired:
                child.kill()
        child.wait()
        child.stdout.close()


def observe():
    peer = json.loads((CONFIG / 'peer.json').read_text())
    previous = None
    unreachable = False
    last_capture = float('-inf')
    last_status = float('-inf')
    timeouts = 0
    while True:
        # Closing the generator also terminates SSH if a record raises an error.
        with contextlib.closing(watch_stream(peer)) as stream:
            for row in stream:
                now = time.monotonic()
                if previous is None or unreachable:
                    event = reconnect_event(previous, row) if previous else 'peer_connected'
                    emit(event, peer=peer['hostname'], heartbeat=row)
                    unreachable = False
                    last_status = now
                elif now - last_status >= 60:
                    emit('peer_alive', peer=peer['hostname'], heartbeat=row)
                    last_status = now
                previous = row
                timeouts = timeouts + 1 if row['kwin'] == 'timeout' else 0
                if timeouts >= 3 and now - last_capture >= SNAPSHOT_COOLDOWN:
                    emit('peer_kwin_timeout', peer=peer['hostname'], heartbeat=row)
                    last_capture = now
                    collect(peer, 'kwin_timeout')
        if not unreachable:
            unreachable = True
            emit('peer_unreachable', peer=peer['hostname'], last_heartbeat=previous)
        timeouts = 0
        time.sleep(RECONNECT_DELAY)


def grab():
    peer = json.loads((CONFIG / 'peer.json').read_text())
    collect(peer, 'manual')


if __name__ == '__main__':
    os.umask(0o077)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=('observe', 'inbound', 'snapshot', 'grab'))
    globals()[parser.parse_args().action]()
